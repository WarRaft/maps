function Trig_Cinematic_Tesseract_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Cinematic_skipped = false
    // НАЧАЛО СЪЁМОК
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.40 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( true )
    call IssueImmediateOrderBJ( udg_Hero_mechanic, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_shaman, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_warrior, "stop" )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.00 )
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Tesseract_Func016A )
    // Ввод изображения
    call CinematicModeExBJ( true, GetPlayersAll(), 0.60 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    call ForForce( udg_Players, function Trig_Cinematic_Tesseract_Func021A )
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_Tesseract_Func023C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    if ( Trig_Cinematic_Tesseract_Func024C() ) then
        loop
            exitwhen ( Trig_Cinematic_Tesseract_Func024Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Сообщение Тетинумми 1
    if ( Trig_Cinematic_Tesseract_Func026C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic14, udg_TEXT_Mechanic[14], bj_TIMETYPE_SET, 11.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Таймер ожидания 11 с.
    if ( Trig_Cinematic_Tesseract_Func028C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 11.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    if ( Trig_Cinematic_Tesseract_Func029C() ) then
        loop
            exitwhen ( Trig_Cinematic_Tesseract_Func029Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Сообщение Тетинумми 2
    if ( Trig_Cinematic_Tesseract_Func031C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic15, udg_TEXT_Mechanic[15], bj_TIMETYPE_SET, 6.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Таймер ожидания 6 с.
    if ( Trig_Cinematic_Tesseract_Func033C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 6.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    if ( Trig_Cinematic_Tesseract_Func034C() ) then
        loop
            exitwhen ( Trig_Cinematic_Tesseract_Func034Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Сообщение Тетинумми 3
    if ( Trig_Cinematic_Tesseract_Func036C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic16, udg_TEXT_Mechanic[16], bj_TIMETYPE_SET, 8.10, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Таймер ожидания 9.2 с.
    if ( Trig_Cinematic_Tesseract_Func038C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 9.20 )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    if ( Trig_Cinematic_Tesseract_Func039C() ) then
        loop
            exitwhen ( Trig_Cinematic_Tesseract_Func039Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Смена камеры
    if ( Trig_Cinematic_Tesseract_Func041C() ) then
        call ForForce( udg_Players, function Trig_Cinematic_Tesseract_Func041Func001A )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    call TriggerSleepAction( 0.30 )
    // Сообщение Нитнарак
    if ( Trig_Cinematic_Tesseract_Func044C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_warrior, GetHeroProperName(udg_Hero_warrior), gg_snd_Warrior10, udg_TEXT_Warrior[10], bj_TIMETYPE_SET, 2.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Таймер ожидания 2.5 с.
    if ( Trig_Cinematic_Tesseract_Func046C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 2.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    if ( Trig_Cinematic_Tesseract_Func047C() ) then
        loop
            exitwhen ( Trig_Cinematic_Tesseract_Func047Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Сообщение Тетинумми 4
    if ( Trig_Cinematic_Tesseract_Func049C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic17, udg_TEXT_Mechanic[17], bj_TIMETYPE_SET, 1.50, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // Таймер ожидания 3 с.
    if ( Trig_Cinematic_Tesseract_Func051C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 3.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    if ( Trig_Cinematic_Tesseract_Func052C() ) then
        loop
            exitwhen ( Trig_Cinematic_Tesseract_Func052Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
        return
    endif
    // ЗАВЕРШЕНИЕ СЪЁМОК
    call TriggerExecute( gg_trg_Cinematic_Tesseract_Ending )
endfunction

//===========================================================================
function InitTrig_Cinematic_Tesseract takes nothing returns nothing
    set gg_trg_Cinematic_Tesseract = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Cinematic_Tesseract, gg_rct_REG_Tesseract_Entrance )
    call TriggerAddAction( gg_trg_Cinematic_Tesseract, function Trig_Cinematic_Tesseract_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Tesseract Ending
//===========================================================================
function Trig_Cinematic_Tesseract_Ending_Func010A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Tesseract_05, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_Tesseract_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.30 )
    call TriggerSleepAction( 0.10 )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Tesseract_Ending_Func010A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call CinematicModeExBJ( false, GetPlayersAll(), 0.60 )
endfunction

//===========================================================================
function InitTrig_Cinematic_Tesseract_Ending takes nothing returns nothing
    set gg_trg_Cinematic_Tesseract_Ending = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_Tesseract_Ending )
    call TriggerAddAction( gg_trg_Cinematic_Tesseract_Ending, function Trig_Cinematic_Tesseract_Ending_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Book
//
// Смотрите! Какая-то книга!
// Что означают эти рисунки?
// Проклятье! Куда она исчезла?
// Похоже, что когда мы встаём вместе на руны, то на небольшой промежуток времени появляется эта книга. 
// Уверен, что нам нужна эта информация. Но для чего?
//===========================================================================
function Trig_Cinematic_Book_Func015A takes nothing returns nothing
    call ClearSelectionForPlayer( GetEnumPlayer() )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Book1, GetEnumPlayer(), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Book2, GetEnumPlayer(), 40.00 )
