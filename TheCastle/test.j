    set gg_trg_Init_Skills = CreateTrigger(  )
    call DisableTrigger( gg_trg_Init_Skills )
    call TriggerAddAction( gg_trg_Init_Skills, function Trig_Init_Skills_Actions )
endfunction

//===========================================================================
// Trigger: Load Game
//===========================================================================
function Trig_Load_Game_Func008Func006C takes nothing returns boolean
    if ( not ( udg_Robot_Repair_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Game_Func008C takes nothing returns boolean
    if ( not ( udg_Robot_Activation_Bool == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_UNIT_Robot) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Game_Actions takes nothing returns nothing
    call SetAllyColorFilterState( 1 )
    call EnableMinimapFilterButtons( false, false )
    call UseTimeOfDayBJ( false )
    call SetGameSpeed( MAP_SPEED_FASTEST )
    call LockGameSpeedBJ(  )
    call ForceCinematicSubtitlesBJ( true )
    call TriggerExecute( gg_trg_Init_Environment )
    if ( Trig_Load_Game_Func008C() ) then
        call ReplaceUnitBJ( udg_UNIT_Robot, 'n006', bj_UNIT_STATE_METHOD_RELATIVE )
        set udg_UNIT_Robot = GetLastReplacedUnitBJ()
        call TriggerRegisterUnitEvent( gg_trg_Reload_robot, udg_UNIT_Robot, EVENT_UNIT_DAMAGED )
        call TriggerRegisterUnitInRangeSimple( gg_trg_Deactivation_robot, 200.00, udg_UNIT_Robot )
        call TriggerRegisterUnitEvent( gg_trg_Death_of_Robot, udg_UNIT_Robot, EVENT_UNIT_DEATH )
        if ( Trig_Load_Game_Func008Func006C() ) then
            call UnitAddAbilityBJ( 'A02H', udg_UNIT_Robot )
        else
        endif
        call TriggerSleepAction( 0.10 )
        call SetUnitTimeScalePercent( udg_UNIT_Robot, 0.00 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Load_Game takes nothing returns nothing
    set gg_trg_Load_Game = CreateTrigger(  )
    call TriggerRegisterGameLoadedEventBJ( gg_trg_Load_Game )
    call TriggerAddAction( gg_trg_Load_Game, function Trig_Load_Game_Actions )
endfunction

//===========================================================================
// Trigger: Translation
//===========================================================================
function Trig_Translation_Func178C takes nothing returns boolean
    if ( not ( udg_CONSTANT_LANGUAGE == "RU" ) ) then
        return false
    endif
    return true
endfunction

function Trig_Translation_Actions takes nothing returns nothing
    // Текст орка-воина
    set udg_RU_Warrior[1] = "Вот, мы и добрались."
    set udg_EN_Warrior[1] = "Here we are, we have arrived."
    set udg_RU_Warrior[2] = "Я чувствую сильную слабость."
    set udg_EN_Warrior[2] = "I feel a strong weakness."
    set udg_RU_Warrior[3] = "Это ещё что такое?"
    set udg_EN_Warrior[3] = "What is this?"
    set udg_RU_Warrior[4] = "Я сотру их в порошок!"
    set udg_EN_Warrior[4] = "I'll grind them to powder!"
    set udg_RU_Warrior[5] = "Что означают эти рисунки?"
    set udg_EN_Warrior[5] = "What do these drawings mean?"
    set udg_RU_Warrior[6] = "Проклятье! Куда она исчезла?"
    set udg_EN_Warrior[6] = "Damn it! Where did it disappear?"
    set udg_RU_Warrior[7] = "Похоже, что каждой руне соответствует своя кнопка."
    set udg_EN_Warrior[7] = "It is like that each rune matches its button."
    set udg_RU_Warrior[8] = "Этот Пожиратель Мёртвых постепенно умирает сам от своего же зловония. Но что-то поддерживает в нем жизнь."
    set udg_EN_Warrior[8] = "The devourer of the dead. He is gradually dying from his stench. But something is keeping it alive. "
    set udg_RU_Warrior[9] = "Какое потрясающее пламя! Этот Рыцарь Тьмы знает толк в интерьерах."
    set udg_EN_Warrior[9] = "What an amazing flame! This death knight knows a lot about interiors."
    set udg_RU_Warrior[10] = "Это сумка что ли?"
    set udg_EN_Warrior[10] = " "
    // Текст гоблина-механика
    set udg_RU_Mechanic[1] = "В этом Замке нас ждут трудные испытания. Нам нужно держаться вместе, чтобы преодолеть их все."
    set udg_EN_Mechanic[1] = "Difficult challenges are waiting for us in the castle. We need to keep together to overcome them all."
    set udg_RU_Mechanic[2] = "Подожди, Акнеладу! Опять ты со своими легендами. Лучше посмотри внимательнее на эти обелиски!"
    set udg_EN_Mechanic[2] = "Wait, Akneladu! Here you go with your legends again. Better look at these obelisks more attentively!"
    set udg_RU_Mechanic[3] = "Я чувствую сильную слабость."
    set udg_EN_Mechanic[3] = "I feel a strong weakness."
    set udg_RU_Mechanic[4] = "Похоже, что каждой руне соответствует своя кнопка."
    set udg_EN_Mechanic[4] = "It is like that each rune matches its button."
    set udg_RU_Mechanic[5] = "Oни сдeлaны из арканита! Похоже, что они каким-то образом сдерживают его невероятную силу. Нужно попробовать активировать их."
    set udg_EN_Mechanic[5] = "They are made of arcane! It's like they are somehow restaining his incredible force! We need to try to activate them."
    set udg_RU_Mechanic[6] = "Этот Пожиратель Мёртвых постепенно умирает сам от своего же зловония. Но что-то поддерживает в нем жизнь."
    set udg_EN_Mechanic[6] = "The devourer of the dead. He is gradually dying from his stench. But something is keeping it alive. "
    set udg_RU_Mechanic[7] = "Какое потрясающее пламя! Этот Рыцарь Тьмы знает толк в интерьерах."
    set udg_EN_Mechanic[7] = "What an amazing flame! This death knight knows a lot about interiors."
    set udg_RU_Mechanic[8] = "Похоже, что синие генераторы обеспечивают работу подъемника. Но прежде, чем их уничтожить, необходимо остановить заводы."
    set udg_EN_Mechanic[8] = "It's like the blue generators are powering the lift operation. We need to shut down the factories before we destroy them."
    set udg_RU_Mechanic[9] = "Погоди, Нитнарак! Не всё так просто. Танков слишком много."
    set udg_EN_Mechanic[9] = "Wait, Nitnarak! It's not that simple. There are too many tanks."
    set udg_RU_Mechanic[10] = "Cмoтpитe, этa бoeвaя мaшинa oтключeнa. Я мoг бы eй вocпoльзoвaтьcя! Нyжнo тoлькo дeaктивиpoвaть силовое поле, чтобы я смог подобраться поближе."
    set udg_EN_Mechanic[10] = "Look it, this is a combat vehicle disabled. I could use it! I need to deactivate a power field, so that i can get closer."
    set udg_RU_Mechanic[11] = "Эти красные генераторы как раз должны отвечать за работу силового поля. Поэтому давайте разрушим их в первую очередь."
    set udg_EN_Mechanic[11] = "These red generators must be just responsible for the operation of the power field. So let's destroy them first."
    set udg_RU_Mechanic[12] = "Оказывается, синие генераторы связаны не только с подъёмником, но и с этой машиной. Они не дают ей разрушиться."
    set udg_EN_Mechanic[12] = "It turns out, the blue generators are not just connected to lift, but with this machine. They are not letting it destroy."
    set udg_RU_Mechanic[13] = "А зaвoды кaким-тo oбpaзoм дaют энepгию для этиx гeнepaтopoв. Пoэтoмy нyжнo yничтoжить кaк мoжнo бoльшe тaнкoв, пpeждe чeм пocлeдний зaвoд бyдeт рaзpyшeн."
    set udg_EN_Mechanic[13] = "And factories are somehow powering for these generators. Therefore it's necessary to destroy as many tanks as possible, before the final factory is destroyed."
    set udg_RU_Mechanic[14] = "Это же легендарный Тессеракт! Древний магический артефакт, способный уменьшать предметы внутри себя до мельчайших частиц."
    set udg_EN_Mechanic[14] = " "
    set udg_RU_Mechanic[15] = "При этом сам Тессеракт и предметы внутри него не имеют массы."
    set udg_EN_Mechanic[15] = " "
    set udg_RU_Mechanic[16] = "Тессеракт может вместить в себя до шести предметов. Маги часто использовали его в своих опытах."
    set udg_EN_Mechanic[16] = " "
    set udg_RU_Mechanic[17] = "Ну, можно и так сказать."
    set udg_EN_Mechanic[17] = " "
    set udg_RU_Mechanic[18] = "Похоже, что когда мы встаём вместе на руны, то на небольшой промежуток времени появляется эта книга."
    set udg_EN_Mechanic[18] = "It's like that when we step on runes together, this book shows up for a short period of time."
    set udg_RU_Mechanic[19] = "Уверен, что нам нужна эта информация. Но для чего?"
    set udg_EN_Mechanic[19] = "I'm sure that we need this information, but for what?"
    set udg_RU_Mechanic[20] = "Переместитель! Не думал, что когда-нибудь увижу его. Он может перенести нас в другое место, если мы сможем настроить его!"
    set udg_EN_Mechanic[20] = " "
    // Текст тролля-шамана
    set udg_RU_Shaman[1] = "Мы - надежда наших народов. Наши навыки и умения помогут нам справиться с любой опасностью. Вперёд, друзья!"
    set udg_EN_Shaman[1] = "We are the hope of our people! Our skills will help us to cope with any danger! Forward, friends!"
    set udg_RU_Shaman[2] = "Это же Демон Огня Суртур! Его мощь безгранична. Ходит легенда, что победить его невозможно."
    set udg_EN_Shaman[2] = "This is Surtur a fire demon his power is limitless! According to legend it is impossible to defeat him!"
    set udg_RU_Shaman[3] = "Смотрите! Какая-то книга!"
    set udg_EN_Shaman[3] = "Look it! What kind of book is this?!"
    set udg_RU_Shaman[4] = "Я мог бы попробовать перескочить через этих скелетов."
    set udg_EN_Shaman[4] = "I can try to jump over these skeletons."
    set udg_RU_Shaman[5] = "Я чувствую сильную слабость. Должно быть, это оберег. Маги, которые обитали здесь раньше, использовали их для защиты Зaмкa, ocлaбляя врагов."
    set udg_EN_Shaman[5] = "I feel a strong weakness. It must be amulet. The mages who lived here they were using the amulet in order to defend the castle, weakening enemies."
    set udg_RU_Shaman[6] = "Должно быть, это оберег. Маги, которые обитали здесь раньше, использовали их для защиты Замка, ослабляя врагов."
    set udg_EN_Shaman[6] = "It must be amulet. The mages who lived here they were using the amulet in order to defend the castle, weakening enemies."
    set udg_RU_Shaman[7] = "Нужно найти и уничтожить его или смириться  с этой ужасной слабостью."
    set udg_EN_Shaman[7] = "We need to find and destroy it or we can just accept this terrible weakness."
    set udg_RU_Shaman[8] = "Похоже, что каждой руне соответствует своя кнопка."
    set udg_EN_Shaman[8] = "It is like that each rune matches its button."
    set udg_RU_Shaman[9] = "Этот Пожиратель Мёртвых постепенно умирает сам от своего же зловония. Но что-то поддерживает в нем жизнь."
    set udg_EN_Shaman[9] = "The devourer of the dead. He is gradually dying from his stench. But something is keeping it alive. "
    set udg_RU_Shaman[10] = "Кровавые кристаллы... Похоже, что тьма действительно поглощает этот Замок."
    set udg_EN_Shaman[10] = "The blood crystals... It's like that darkness indeed absorbs this Castle."
    set udg_RU_Shaman[11] = "Какое потрясающее пламя! Этот Рыцарь Тьмы знает толк в интерьерах."
    set udg_EN_Shaman[11] = "What an amazing flame! This death knight knows a lot about interiors."
    set udg_RU_Shaman[12] = "Эти тени словно растворились. Но что же их уничтожило?"
    set udg_EN_Shaman[12] = "These shadows look like upset. But what were they eliminated? "
    set udg_RU_Shaman[13] = "Значит, нам придётся уничтожить эту штуковину, чтобы пройти дальше. Но как нам до неё добраться?"
    set udg_EN_Shaman[13] = "It means, we have to destroy this thing to pass further. But how can we get to it?"
    // Текст подсказок
    set udg_RU_Hint[1] = "|cff32cd32ПОДСКАЗКА:|r Обыщите лагерь разбойников!"
    set udg_EN_Hint[1] = "|cff32cd32HINT:|r Search the camp of the robbers!"
    set udg_RU_Hint[2] = "|cff32cd32ПОДСКАЗКА:|r Используйте умение Гоблина-механика |cffF2D800\"Энергетический щит\"|r, чтобы увеличить защиту Героев."
    set udg_EN_Hint[2] = "|cff32cd32HINT:|r Use Goblin Mechanic skill |cffF2D800\"Energy shield\"|r, to enhance the defense of the heroes."
    set udg_RU_Hint[3] = "|cff32cd32ПОДСКАЗКА:|r Используйте умение Тролля-шамана |cffF2D800\"Массовое лечение\"|r, чтобы после боя восстановить здоровье Героев."
    set udg_EN_Hint[3] = "|cff32cd32HINT:|r Use the Shaman Troll skill |cffF2D800\"Mass Treatment\"|r, to restore the health of the heroes after the fight."
    set udg_RU_Hint[4] = "|cff32cd32ПОДСКАЗКА:|r Используйте умение Гоблина-механика |cffF2D800\"Книга чертежей\"|r, чтобы произвести взрывчатку."
    set udg_EN_Hint[4] = "|cff32cd32HINT:|r Use Goblin Mechanic skill |cffF2D800\"The Book of Drawings\"|r, to make explosives."
    set udg_RU_Hint[5] = "|cff32cd32ПОДСКАЗКА:|r Используйте взрывчатку, чтобы уничтожить ворота."
    set udg_EN_Hint[5] = "|cff32cd32HINT:|r Use explosives to eliminate the gate."
    set udg_RU_Hint[6] = "|cff32cd32ПОДСКАЗКА:|r Найдите Дневник ученика около фонтана!"
    set udg_EN_Hint[6] = "|cff32cd32HINT:|r Find the apprentice's diary near the fountain!"
    set udg_RU_Hint[7] = "|cff32cd32ПОДСКАЗКА:|r Изyчитe дoпoлнитeльныe нaвыки чepeз |cffF2D800\"Cпocoбнocти\"|r. Изyчeнныe нaвыки бyдyт oтoбpaжaтьcя в видe икoнoк в cтaтyce Героя."
    set udg_EN_Hint[7] = "|cff32cd32HINT:|r Learn the extra skills through |cffF2D800\"Skills\"|r. Skills will be reflected in the form of icons in the hero status."
    set udg_RU_Hint[8] = "|cff32cd32ПОДСКАЗКА:|r Koгдa Гepoй yмиpaeт, тo pacxoдyeтcя oднo |cffF2D800Bocкpeшeниe|r. Игpa бyдeт oкoнчeнa, ecли пpи cмepти Гepoя нe бyдeт ни oднoгo |cffF2D800Воскрешения|r."
    set udg_EN_Hint[8] = "|cff32cd32HINT:|r When hero dies you will lose one |cffF2D800Resurrection|r. The game will be over, if at the death of the hero there will not be a single |cffF2D800Resurrection|r."
    set udg_RU_Hint[9] = "|cff32cd32ПОДСКАЗКА:|r Изучен новый чертёж."
    set udg_EN_Hint[9] = " "
    set udg_RU_Hint[10] = "|cff32cd32ПОДСКАЗКА:|r Камень Воскрешения позволяет воскрешать убитых Героев. Необходимо  |cffF2D800активировать|r."
    set udg_EN_Hint[10] = "|cff32cd32HINT:|r The resurrection stone lets resurrect the killed heroes. It's necessary |cffF2D800activate|r."
    set udg_RU_Hint[11] = "|cff32cd32ПОДСКАЗКА:|r Нужен ключ, чтобы открыть эти ворота."
    set udg_EN_Hint[11] = "  "
    set udg_RU_Hint[12] = "|cff32cd32ПОДСКАЗКА:|r Эти ворота заперты каким-то механизмом!"
    set udg_EN_Hint[12] = "  "
    set udg_RU_Hint[13] = "|cff32cd32ПОДСКАЗКА:|r Эти ворота совсем прогнили!"
    set udg_EN_Hint[13] = "  "
    set udg_RU_Hint[14] = "|cff32cd32ПОДСКАЗКА:|r Главные ворота Замка надёжно закрыты!"
    set udg_EN_Hint[14] = "  "
    set udg_RU_Hint[15] = "|cff32cd32ПОДСКАЗКА:|r Используйте умение Гоблина-механика |cffF2D800\"Использовать механизм\"|r, чтобы переключить рычаг."
    set udg_EN_Hint[15] = "  "
    set udg_RU_Hint[16] = "|cff32cd32ПОДСКАЗКА:|r Найден торговец."
    set udg_EN_Hint[16] = "  "
    set udg_RU_Hint[17] = "|cff32cd32ПОДСКАЗКА:|r Силовое поле отключено."
    set udg_EN_Hint[17] = "  "
    set udg_RU_Hint[18] = "|cff32cd32ПОДСКАЗКА:|r Способности Героев изменились."
    set udg_EN_Hint[18] = "  "
    // Текст различных сообщений
    set udg_RU_Msg[1] = "|cffffcc00В инвентаре нет необходимого предмета|r"
    set udg_EN_Msg[1] = " "
    set udg_RU_Msg[2] = "|cffffcc00Недостаточно материалов|r"
    set udg_EN_Msg[2] = " "
    set udg_RU_Msg[3] = "|cffffcc00Невозможно изучить|r"
    set udg_EN_Msg[3] = " "
    // Текст для команд чата
    set udg_RU_Cheat[1] = "|cffff0000Свободная камера включена|r"
    set udg_EN_Cheat[1] = " "
    set udg_RU_Cheat[2] = "|cffff0000Свободная камера отключена|r"
    set udg_EN_Cheat[2] = " "
    set udg_RU_Cheat[3] = "Репутация"
    set udg_EN_Cheat[3] = "Reputation"
    set udg_RU_Cheat[4] = "|cff32cd32Репутация изменена на положительную|r"
    set udg_EN_Cheat[4] = " "
    set udg_RU_Cheat[5] = "|cffff0000Репутация изменена на отрицательную|r"
    set udg_EN_Cheat[5] = " "
    // Текст заданий
    set udg_RU_Quest[1] = "Начало испытаний"
    set udg_EN_Quest[1] = "The beginning"
    set udg_RU_Quest[2] = "Блуждающие во тьме"
    set udg_EN_Quest[2] = "Wandering in the dark"
    set udg_RU_Quest[3] = "Исследование"
    set udg_EN_Quest[3] = "Research"
    set udg_RU_Req[1] = "Для начала необходимо открыть ворота Замка, чтобы начать приключение."
    set udg_EN_Req[1] = "At first you need to open the gate of the сastle to start adventure."
    set udg_RU_Req[2] = "Необходимо найти источник тьмы и уничтожить его."
    set udg_EN_Req[2] = "It's necessary to find the source of the darkness and destroy it."
    //                                                                            
    // ТЕКСТ ВТОРОСТЕПЕННЫХ ПЕРСОНАЖЕЙ
    //                                                                            
    // Текст странника
    set udg_RU_Traveler[1] = "Как хорошо, что я встретил вас, а не бандитов. Не откажите в помощи бедному страннику."
    set udg_EN_Traveler[1] = " "
    set udg_RU_Traveler[2] = "Моя бедная ящерка! Моя Дори! Её что-то спугнуло и она убежала. Я видел, как она пролезла под стену Замка."
    set udg_EN_Traveler[2] = " "
    set udg_RU_Traveler[3] = "Если вы вдруг встретите её, угостите листьями этого растения. Она должна сразу вспомнить меня и вернуться."
    set udg_EN_Traveler[3] = " "
    set udg_RU_Traveler[4] = "Только, пожалуйста, аккуратнее! Дори сильно напугана и может быть агрессивной."
    set udg_EN_Traveler[4] = " "
    set udg_RU_Traveler[5] = "К сожалению, мне нечего вам предложить. Но если вы поможете мне, то я буду молиться за вас всю свою жизнь!"
    set udg_EN_Traveler[5] = " "
    // Текст зомби
    set udg_RU_Zombie[1] = "Вам никогда не подобрать комбинацию, глупцы!"
    set udg_EN_Zombie[1] = " "
    set udg_RU_Zombie[2] = "Вы сгинете в этом Замке, глупцы!"
    set udg_EN_Zombie[2] = " "
    // Текст Тралла
    set udg_RU_Thrall[1] = "Предатели! Сейчас вы все умрёте!"
    set udg_EN_Thrall[1] = " "
    if ( Trig_Translation_Func178C() ) then
        set udg_TEXT_N = 1
        loop
            exitwhen udg_TEXT_N > 30
            set udg_TEXT_Quest[udg_TEXT_N] = udg_RU_Quest[udg_TEXT_N]
            set udg_TEXT_Req[udg_TEXT_N] = udg_RU_Req[udg_TEXT_N]
            set udg_TEXT_Hint[udg_TEXT_N] = udg_RU_Hint[udg_TEXT_N]
            set udg_TEXT_Msg[udg_TEXT_N] = udg_RU_Msg[udg_TEXT_N]
            set udg_TEXT_Warrior[udg_TEXT_N] = udg_RU_Warrior[udg_TEXT_N]
            set udg_TEXT_Mechanic[udg_TEXT_N] = udg_RU_Mechanic[udg_TEXT_N]
            set udg_TEXT_Shaman[udg_TEXT_N] = udg_RU_Shaman[udg_TEXT_N]
            set udg_TEXT_Zombie[udg_TEXT_N] = udg_RU_Zombie[udg_TEXT_N]
            set udg_TEXT_Traveler[udg_TEXT_N] = udg_RU_Traveler[udg_TEXT_N]
            set udg_TEXT_Thrall[udg_TEXT_N] = udg_RU_Thrall[udg_TEXT_N]
            set udg_TEXT_Cheat[udg_TEXT_N] = udg_RU_Cheat[udg_TEXT_N]
            set udg_TEXT_N = udg_TEXT_N + 1
        endloop
    else
        set udg_TEXT_N = 1
        loop
            exitwhen udg_TEXT_N > 30
            set udg_TEXT_Quest[udg_TEXT_N] = udg_EN_Quest[udg_TEXT_N]
            set udg_TEXT_Req[udg_TEXT_N] = udg_EN_Req[udg_TEXT_N]
            set udg_TEXT_Hint[udg_TEXT_N] = udg_EN_Hint[udg_TEXT_N]
            set udg_TEXT_Msg[udg_TEXT_N] = udg_EN_Msg[udg_TEXT_N]
            set udg_TEXT_Warrior[udg_TEXT_N] = udg_EN_Warrior[udg_TEXT_N]
            set udg_TEXT_Mechanic[udg_TEXT_N] = udg_EN_Mechanic[udg_TEXT_N]
            set udg_TEXT_Shaman[udg_TEXT_N] = udg_EN_Shaman[udg_TEXT_N]
            set udg_TEXT_Zombie[udg_TEXT_N] = udg_EN_Zombie[udg_TEXT_N]
            set udg_TEXT_Traveler[udg_TEXT_N] = udg_EN_Traveler[udg_TEXT_N]
            set udg_TEXT_Thrall[udg_TEXT_N] = udg_EN_Thrall[udg_TEXT_N]
            set udg_TEXT_Cheat[udg_TEXT_N] = udg_EN_Cheat[udg_TEXT_N]
            set udg_TEXT_N = udg_TEXT_N + 1
        endloop
    endif
endfunction

