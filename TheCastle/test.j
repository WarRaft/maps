    set gg_trg_Lightning_Discharge = CreateTrigger(  )
    call DisableTrigger( gg_trg_Lightning_Discharge )
    call TriggerAddCondition( gg_trg_Lightning_Discharge, Condition( function Trig_Lightning_Discharge_Conditions ) )
    call TriggerAddAction( gg_trg_Lightning_Discharge, function Trig_Lightning_Discharge_Actions )
endfunction

