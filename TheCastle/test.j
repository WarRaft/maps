//===========================================================================
// Trigger: Init Teleporter
//===========================================================================
function Trig_Init_Teleporter_Actions takes nothing returns nothing
    set udg_Spatial_Cube[1] = gg_unit_n00V_0362
    set udg_Spatial_Cube[2] = gg_unit_n024_0369
    set udg_Spatial_Cube[3] = gg_unit_n025_0366
    call ShowUnitHide( gg_unit_n022_0203 )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call ShowUnitHide( udg_Spatial_Cube[GetForLoopIndexA()] )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

