    if ( not ( udg_Cinematic_skipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Teleporter_Actions takes nothing returns nothing
    set udg_Cinematic_skipped = false
    // НАЧАЛО СЪЁМОК
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.40 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( true )
    call IssueImmediateOrderBJ( udg_Hero_mechanic, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_shaman, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_warrior, "stop" )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.00 )
    call ShowUnitShow( gg_unit_n022_0203 )
    call SetUnitAnimation( gg_unit_n022_0203, "birth" )
    call UnitAddAbilityBJ( 'A043', gg_unit_n022_0203 )
    call AddItemToStockBJ( 'I01Z', gg_unit_n022_0203, 1, 1 )
    call AddItemToStockBJ( 'I020', gg_unit_n022_0203, 1, 1 )
    call AddItemToStockBJ( 'I021', gg_unit_n022_0203, 1, 1 )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 3
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call ShowUnitShow( udg_Spatial_Cube[GetForLoopIndexB()] )
        call SetUnitAnimation( udg_Spatial_Cube[GetForLoopIndexB()], "birth" )
        call UnitAddAbilityBJ( 'A050', udg_Spatial_Cube[GetForLoopIndexB()] )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Teleporter_Func021A )
    // Ввод изображения
    call CinematicModeExBJ( true, GetPlayersAll(), 0.60 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    // Таймер ожидания 1.5 с.
    if ( Trig_Cinematic_Teleporter_Func027C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_Teleporter_Ending )
        return
    endif
    if ( Trig_Cinematic_Teleporter_Func028C() ) then
        loop
            exitwhen ( Trig_Cinematic_Teleporter_Func028Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Teleporter_Ending )
        return
    endif
    // Эффект появления
    if ( Trig_Cinematic_Teleporter_Func030C() ) then
        call AddSpecialEffectLocBJ( GetUnitLoc(gg_unit_n022_0203), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl" )
        call SetUnitAnimation( gg_unit_n022_0203, "stand" )
        set bj_forLoopBIndex = 1
        set bj_forLoopBIndexEnd = 3
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call AddSpecialEffectLocBJ( GetUnitLoc(udg_Spatial_Cube[GetForLoopIndexB()]), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl" )
            call SetUnitAnimation( udg_Spatial_Cube[GetForLoopIndexB()], "stand" )
            set bj_forLoopBIndex = bj_forLoopBIndex + 1
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Teleporter_Ending )
        return
    endif
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_Teleporter_Func032C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Teleporter_Ending )
        return
    endif
    if ( Trig_Cinematic_Teleporter_Func033C() ) then
        loop
            exitwhen ( Trig_Cinematic_Teleporter_Func033Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Teleporter_Ending )
        return
    endif
    // Сообщение Тетинумми
    if ( Trig_Cinematic_Teleporter_Func035C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic20, udg_TEXT_Mechanic[20], bj_TIMETYPE_SET, 10.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Teleporter_Ending )
        return
    endif
    // Таймер ожидания 10 с.
    if ( Trig_Cinematic_Teleporter_Func037C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 10.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Teleporter_Ending )
        return
    endif
    if ( Trig_Cinematic_Teleporter_Func038C() ) then
        loop
            exitwhen ( Trig_Cinematic_Teleporter_Func038Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Teleporter_Ending )
        return
    endif
    // ЗАВЕРШЕНИЕ СЪЁМОК
    call TriggerExecute( gg_trg_Cinematic_Teleporter_Ending )
endfunction

