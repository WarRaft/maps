//===========================================================================
// Trigger: adm
//===========================================================================
function Trig_adm_Conditions takes nothing returns boolean
    if ( not ( SubStringBJ(GetEventPlayerChatString(), 1, 4) == "-adm" ) ) then
        return false
    endif
    return true
endfunction

function Trig_adm_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call DisplayTextToForce( GetPlayersAll(), ( "Items [" + ( I2S(GetForLoopIndexA()) + ( "] = " + I2S(udg_Items[GetForLoopIndexA()]) ) ) ) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = udg_Note_num
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call DisplayTextToForce( GetPlayersAll(), ( "Note [" + ( I2S(GetForLoopIndexB()) + ( "] = " + GetItemName(udg_Note[GetForLoopIndexB()]) ) ) ) )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    call DisplayTextToForce( GetPlayersAll(), ( "Count_Life = " + I2S(udg_Count_Life) ) )
    call DisplayTextToForce( GetPlayersAll(), ( "All_Items_num = " + I2S(udg_All_Items_num) ) )
    call DisplayTextToForce( GetPlayersAll(), ( "Hero_mechanic = " + GetUnitName(udg_Hero_mechanic) ) )
    call DisplayTextToForce( GetPlayersAll(), ( "UNIT_Robot_mechanic = " + GetUnitName(udg_UNIT_Robot_Mechanic) ) )
    call DisplayTextToForce( GetPlayersAll(), ( "Hero_shaman = " + GetUnitName(udg_Hero_shaman) ) )
    call DisplayTextToForce( GetPlayersAll(), ( "Hero_warrior = " + GetUnitName(udg_Hero_warrior) ) )
    call DisplayTextToForce( GetPlayersAll(), ( "UNIT_Traveler = " + GetUnitName(udg_UNIT_Traveler) ) )
    call DisplayTextToForce( GetPlayersAll(), ( "UNIT_Lizard = " + GetUnitName(udg_UNIT_Lizard) ) )
    call DisplayTextToForce( GetPlayersAll(), ( "UNIT_Marauder = " + GetUnitName(udg_UNIT_Marauder) ) )
    call DisplayTextToForce( GetPlayersAll(), ( "UNIT_Merchant = " + GetUnitName(udg_UNIT_Merchant) ) )
endfunction

