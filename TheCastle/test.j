//===========================================================================
// Trigger: freecam
//===========================================================================
function Trig_freecam_Conditions takes nothing returns boolean
    if ( not ( SubStringBJ(GetEventPlayerChatString(), 1, 9) == "-freecam " ) ) then
        return false
    endif
    return true
endfunction

function Trig_freecam_Func001Func001C takes nothing returns boolean
    if ( not ( S2I(SubStringBJ(GetEventPlayerChatString(), 10, 2)) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_freecam_Func001C takes nothing returns boolean
    if ( not ( S2I(SubStringBJ(GetEventPlayerChatString(), 10, 2)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_freecam_Actions takes nothing returns nothing
    if ( Trig_freecam_Func001C() ) then
        set udg_FREECAM[GetConvertedPlayerId(GetTriggerPlayer())] = true
        call ResetToGameCameraForPlayer( GetTriggerPlayer(), 0 )
        call DisplayTextToForce( GetForceOfPlayer(GetTriggerPlayer()), udg_TEXT_Cheat[1] )
    else
        if ( Trig_freecam_Func001Func001C() ) then
            set udg_FREECAM[GetConvertedPlayerId(GetTriggerPlayer())] = false
            call DisplayTextToForce( GetForceOfPlayer(GetTriggerPlayer()), udg_TEXT_Cheat[2] )
        else
        endif
    endif
endfunction

//===========================================================================
function InitTrig_freecam takes nothing returns nothing
    set gg_trg_freecam = CreateTrigger(  )
    call TriggerRegisterPlayerChatEvent( gg_trg_freecam, Player(0), "", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_freecam, Player(1), "", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_freecam, Player(2), "", true )
    call TriggerAddCondition( gg_trg_freecam, Condition( function Trig_freecam_Conditions ) )
    call TriggerAddAction( gg_trg_freecam, function Trig_freecam_Actions )
endfunction

