//===========================================================================
// Trigger: Foggy Mind
//===========================================================================
function Trig_Foggy_Mind_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A044' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foggy_Mind_Func008Func001C takes nothing returns boolean
    if ( not ( GetEnumUnit() != GetTriggerUnit() ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foggy_Mind_Func008A takes nothing returns nothing
    if ( Trig_Foggy_Mind_Func008Func001C() ) then
        call IssueImmediateOrderBJ( GetEnumUnit(), "stop" )
    else
    endif
endfunction

function Trig_Foggy_Mind_Actions takes nothing returns nothing
    local player dummy_player = Player(PLAYER_NEUTRAL_PASSIVE)
    local unit dummy_unit
    // Даем щит молний
    set dummy_unit = TeoCreateDummyUnit( dummy_player, 'n00X', GetUnitX (GetTriggerUnit()), GetUnitY (GetTriggerUnit()), 'A045' )
    call IssueTargetOrder( dummy_unit, "lightningshield", GetTriggerUnit() )
    call GroupEnumUnitsInRange (udg_TempGroup, GetUnitX (GetTriggerUnit()), GetUnitY (GetTriggerUnit()), 300, null) 
    call ForGroupBJ( udg_TempGroup, function Trig_Foggy_Mind_Func008A )
    call EnableTrigger( gg_trg_Foggy_Mind_Object_Warrior )
    call EnableTrigger( gg_trg_Foggy_Mind_Object_Mechanic )
    call EnableTrigger( gg_trg_Foggy_Mind_Object_Shaman )
    call EnableTrigger( gg_trg_Foggy_Mind_Point_Mechanic )
    call EnableTrigger( gg_trg_Foggy_Mind_Point_Shaman )
    call EnableTrigger( gg_trg_Foggy_Mind_Point_Warrior )
    call StartTimerBJ( udg_Foggy_Mind_Timer, false, 12.00 )
endfunction

//===========================================================================
function InitTrig_Foggy_Mind takes nothing returns nothing
    set gg_trg_Foggy_Mind = CreateTrigger(  )
    call DisableTrigger( gg_trg_Foggy_Mind )
    call TriggerAddCondition( gg_trg_Foggy_Mind, Condition( function Trig_Foggy_Mind_Conditions ) )
    call TriggerAddAction( gg_trg_Foggy_Mind, function Trig_Foggy_Mind_Actions )
endfunction

