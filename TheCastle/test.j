//===========================================================================
// Trigger: Init Buttons
//
// При добавлении кнопки также необходимо увеличить размерность массива Button_Units в настройках переменных.
//===========================================================================
function Trig_Init_Buttons_Actions takes nothing returns nothing
    //      Кнопки с рунами (Рунные врата)     
    set udg_Button[1] = gg_dest_DTfx_0147
    call SetDestructableAnimationBJ( udg_Button[1], "stand alternate" )
    set udg_Button[2] = gg_dest_DTfx_0367
    call SetDestructableAnimationBJ( udg_Button[2], "stand alternate" )
    set udg_Button[3] = gg_dest_DTfx_0351
    call SetDestructableAnimationBJ( udg_Button[3], "stand alternate" )
    //      Кнопка для проверки кода (Вход к Боссу1)      
    set udg_Button[4] = gg_dest_DTfx_0485
    call SetDestructableAnimationBJ( udg_Button[4], "stand alternate" )
    //      Кнопки открытия решетки (Некрономикон)     
    set udg_Button[5] = gg_dest_DTfx_1045
    call SetDestructableAnimationBJ( udg_Button[5], "stand alternate" )
    set udg_Button[6] = gg_dest_DTfx_1530
    call SetDestructableAnimationBJ( udg_Button[6], "stand alternate" )
    //      Кнопки открытия портала (Лабиринт)     
    set udg_Button[7] = gg_dest_DTfx_1506
    call SetDestructableAnimationBJ( udg_Button[7], "stand alternate" )
    set udg_Button[8] = gg_dest_DTfx_1507
    call SetDestructableAnimationBJ( udg_Button[8], "stand alternate" )
    set udg_Button[9] = gg_dest_DTfx_1509
    call SetDestructableAnimationBJ( udg_Button[9], "stand alternate" )
    set udg_Button[10] = gg_dest_DTfx_1508
    call SetDestructableAnimationBJ( udg_Button[10], "stand alternate" )
    //      Кнопка сброса простой головоломки (Головоломки с кубами)     
    set udg_Button[11] = gg_dest_DTfx_1673
    call SetDestructableAnimationBJ( udg_Button[11], "stand alternate" )
    //      Кнопка сброса сложной головоломки (Головоломки с кубами)     
    set udg_Button[12] = gg_dest_DTfx_2454
    call SetDestructableAnimationBJ( udg_Button[12], "stand alternate" )
    //      Кнопка от решетки (Головоломка с порталами)     
    set udg_Button[13] = gg_dest_DTfx_0767
    call SetDestructableAnimationBJ( udg_Button[13], "stand alternate" )
    //      Кнопки вызова портала (Головоломка с порталами)     
    set udg_Button[14] = gg_dest_DTfx_9988
    call SetDestructableAnimationBJ( udg_Button[14], "stand alternate" )
    set udg_Button[15] = gg_dest_DTfx_9987
    call SetDestructableAnimationBJ( udg_Button[15], "stand alternate" )
    //      Кнопки доступа к рычагу (Головоломка с порталами)     
    set udg_Button[16] = gg_dest_DTfx_9994
    call SetDestructableAnimationBJ( udg_Button[16], "stand alternate" )
    set udg_Button[17] = gg_dest_DTfx_9995
    call SetDestructableAnimationBJ( udg_Button[17], "stand alternate" )
    //      Кнопки для вызова моста (Темница)     
    set udg_Button[18] = gg_dest_DTfx_5360
    call SetDestructableAnimationBJ( udg_Button[18], "stand alternate" )
    set udg_Button[19] = gg_dest_DTfx_5361
    call SetDestructableAnimationBJ( udg_Button[19], "stand alternate" )
    //      Кнопки музыкальной головоломки (Темница)     
    set udg_Button[20] = gg_dest_B01H_10390
    call SetDestructableAnimationBJ( udg_Button[20], "stand alternate" )
    set udg_Button[21] = gg_dest_B01I_10788
    call SetDestructableAnimationBJ( udg_Button[21], "stand alternate" )
    set udg_Button[22] = gg_dest_B01J_10392
    call SetDestructableAnimationBJ( udg_Button[22], "stand alternate" )
    set udg_Button[23] = gg_dest_B01K_10389
    call SetDestructableAnimationBJ( udg_Button[23], "stand alternate" )
endfunction

