//===========================================================================
// Trigger: Chain Lightning
//===========================================================================
function Trig_Chain_Lightning_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chain_Lightning_Func004C takes nothing returns boolean
    if ( not ( udg_Random == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chain_Lightning_Actions takes nothing returns nothing
    local location point1 = GetRectCenter(gg_rct_REG_Boss3_Sphere1)
    local location point2 = GetRectCenter(gg_rct_REG_Boss3_Sphere2)
    set udg_Random = GetRandomInt(1, 2)
    if ( Trig_Chain_Lightning_Func004C() ) then
        set udg_Boss3_Archmage_Sphere = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'n02V', GetLocationX(point1), GetLocationY(point1), 0 )
        call UnitApplyTimedLifeBJ( 2.70, 'BTLF', udg_Boss3_Archmage_Sphere )
        call SetUnitFlyHeightBJ( udg_Boss3_Archmage_Sphere, 160.00, 50.00 )
        // Создание эффекта появления
        call DestroyEffect( AddSpecialEffect( "Abilities\\Weapons\\Bolt\\BoltImpact.mdl", GetLocationX(point1), GetLocationY(point1) ) )
        call TriggerSleepAction( 1.00 )
        call IssueTargetOrderBJ( udg_Boss3_Archmage_Sphere, "chainlightning", gg_unit_n02U_0595 )
    else
        set udg_Boss3_Archmage_Sphere = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'n02V', GetLocationX(point2), GetLocationY(point2), 0 )
        call UnitApplyTimedLifeBJ( 2.70, 'BTLF', udg_Boss3_Archmage_Sphere )
        call SetUnitFlyHeightBJ( udg_Boss3_Archmage_Sphere, 160.00, 50.00 )
        // Создание эффекта появления
        call DestroyEffect( AddSpecialEffect( "Abilities\\Weapons\\Bolt\\BoltImpact.mdl", GetLocationX(point2), GetLocationY(point2) ) )
        call TriggerSleepAction( 1.00 )
        call IssueTargetOrderBJ( udg_Boss3_Archmage_Sphere, "chainlightning", gg_unit_n02U_0598 )
    endif
    // Обнуление переменных
    call RemoveLocation(point1)
    call RemoveLocation(point2)
    set point1 = null
    set point2 = null
endfunction

