//===========================================================================
// Trigger: Magic Destroyer
//===========================================================================
function Trig_Magic_Destroyer_Conditions takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetEventDamageSource()) > 0.00 ) ) then
        return false
    endif
    if ( not ( IsPlayerInForce(GetOwningPlayer(GetEventDamageSource()), udg_Players) == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B00O') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Magic_Destroyer_Actions takes nothing returns nothing
    local player dummy_player = Player(4)
    local unit target_unit = GetEventDamageSource()
    local unit dummy_unit
    local real target_x = GetUnitX (target_unit)
    local real target_y = GetUnitY (target_unit)
    call SetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE,  ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + 30.00 ))
    call SetUnitManaBJ( target_unit, ( GetUnitStateSwap(UNIT_STATE_MANA, target_unit) - GetEventDamage() ) )
    call UnitDamageTargetBJ( GetTriggerUnit(), target_unit, ( 0.50 * GetEventDamage() ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNKNOWN )
    call DestroyEffect(AddSpecialEffectTargetUnitBJ( "origin", target_unit, "Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl" ))
    set dummy_unit = TeoCreateDummyUnit( dummy_player, 'n00X', target_x, target_y, 'A053' )
    call IssueTargetOrder( dummy_unit, "slow", target_unit )
    // Обнуление переменных
    set target_unit = null
    set dummy_unit = null
endfunction

//===========================================================================
function InitTrig_Magic_Destroyer takes nothing returns nothing
    set gg_trg_Magic_Destroyer = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Magic_Destroyer, Condition( function Trig_Magic_Destroyer_Conditions ) )
    call TriggerAddAction( gg_trg_Magic_Destroyer, function Trig_Magic_Destroyer_Actions )
endfunction

//===========================================================================
// Trigger: Disintegration
//===========================================================================
function Trig_Disintegration_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00O' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Disintegration_Actions takes nothing returns nothing
    local player dummy_player = Player(4)
    local unit dummy_unit
    local unit target_unit = GetSpellTargetUnit()
    local real target_x = GetUnitX (target_unit)
    local real target_y = GetUnitY (target_unit)
    // Проверка на уничтожение трупов Пожирателя
    if (GetUnitTypeId(target_unit) == 'n00W') then
        call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl", target_x, target_y ))
    endif
    call TriggerSleepAction( 0.05 )
    if (IsUnitAliveBJ(target_unit) == false) then
        call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", target_x, target_y ))
        set dummy_unit = TeoCreateDummyUnit( dummy_player, 'n00X', target_x, target_y, 'A02A' )
        call IssuePointOrder( dummy_unit, "dreadlordinferno", target_x, target_y )
    endif
    // Обнуление переменных
    set target_unit = null
    set dummy_unit = null
endfunction

