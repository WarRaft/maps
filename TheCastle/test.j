function Trig_Starting_Cinematic_Actions takes nothing returns nothing
    set udg_Cinematic_skipped = false
    // НАЧАЛО СЪЁМОК
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call ShowInterfaceForceOff( GetPlayersAll(), 0.00 )
    call TriggerSleepAction( 0.30 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.00 )
    call IssuePointOrderLocBJ( udg_Hero_warrior, "move", GetRectCenter(gg_rct_REG_Warrior_Start) )
    call IssuePointOrderLocBJ( udg_Hero_shaman, "move", GetRectCenter(gg_rct_REG_Shaman_Start) )
    call IssuePointOrderLocBJ( udg_Hero_mechanic, "move", GetRectCenter(gg_rct_REG_Mechanic_Start) )
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Starting_Cinematic_Func014A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    // Таймер ожидания 1.6 с.
    if ( Trig_Starting_Cinematic_Func019C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.60 )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    if ( Trig_Starting_Cinematic_Func020C() ) then
        loop
            exitwhen ( Trig_Starting_Cinematic_Func020Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.40))
        endloop
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // Смена камеры
    if ( Trig_Starting_Cinematic_Func022C() ) then
        call ForForce( udg_Players, function Trig_Starting_Cinematic_Func022Func001A )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // Таймер ожидания 1 с.
    if ( Trig_Starting_Cinematic_Func024C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    if ( Trig_Starting_Cinematic_Func025C() ) then
        loop
            exitwhen ( Trig_Starting_Cinematic_Func025Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // Сообщение Нитнарака
    if ( Trig_Starting_Cinematic_Func027C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_warrior, GetHeroProperName(udg_Hero_warrior), gg_snd_Warrior01, udg_TEXT_Warrior[1], bj_TIMETYPE_SET, 2.00, false )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // Таймер ожидания 2.5 с.
    if ( Trig_Starting_Cinematic_Func029C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 2.50 )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    if ( Trig_Starting_Cinematic_Func030C() ) then
        loop
            exitwhen ( Trig_Starting_Cinematic_Func030Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // Сообщение Тетинумми
    if ( Trig_Starting_Cinematic_Func032C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic01, udg_TEXT_Mechanic[1], bj_TIMETYPE_SET, 7.00, false )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // Таймер ожидания 8.5 с.
    if ( Trig_Starting_Cinematic_Func034C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 8.50 )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    if ( Trig_Starting_Cinematic_Func035C() ) then
        loop
            exitwhen ( Trig_Starting_Cinematic_Func035Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // Смена камеры
    if ( Trig_Starting_Cinematic_Func037C() ) then
        call ForForce( udg_Players, function Trig_Starting_Cinematic_Func037Func001A )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    call TriggerSleepAction( 0.40 )
    // Сообщение Акнеладу
    if ( Trig_Starting_Cinematic_Func040C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman01, udg_TEXT_Shaman[1], bj_TIMETYPE_SET, 7.50, false )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // Таймер ожидания 8 с.
    if ( Trig_Starting_Cinematic_Func042C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 8.50 )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    if ( Trig_Starting_Cinematic_Func043C() ) then
        loop
            exitwhen ( Trig_Starting_Cinematic_Func043Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // ЗАВЕРШЕНИЕ СЪЁМОК
    call TriggerExecute( gg_trg_Starting_Game )
endfunction

