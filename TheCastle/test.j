    endif
    return true
endfunction

function Trig_Prison_Func002001 takes nothing returns boolean
    return ( GetDyingDestructable() == gg_dest_DTg1_0502 )
endfunction

function Trig_Prison_Func003001 takes nothing returns boolean
    return ( GetDyingDestructable() == gg_dest_DTg1_0501 )
endfunction

