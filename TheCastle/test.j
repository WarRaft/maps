//===========================================================================
// Trigger: Init Events
//===========================================================================
function Trig_Init_Events_Actions takes nothing returns nothing
    call TriggerRegisterUnitEvent( gg_trg_Found_Item, udg_Hero_mechanic, EVENT_UNIT_PICKUP_ITEM )
    call TriggerRegisterUnitEvent( gg_trg_Lost_Item, udg_Hero_mechanic, EVENT_UNIT_DROP_ITEM )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Devouer, udg_UNIT_Devouer, EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Attacking_Devouer, udg_UNIT_Devouer, EVENT_UNIT_DAMAGED )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Overseer, udg_UNIT_Overseer, EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Boss1, udg_UNIT_Boss1, EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Devastator, udg_UNIT_Devastator, EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Fatal_Strike_Actions, udg_UNIT_FS_Dummy, EVENT_UNIT_DAMAGED )
    // БОСС 2
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Boss2, udg_UNIT_Boss2, EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Reload_robot, udg_UNIT_Robot, EVENT_UNIT_DAMAGED )
    call TriggerRegisterUnitInRangeSimple( gg_trg_Deactivation_robot, 200.00, udg_UNIT_Robot )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Robot, udg_UNIT_Robot, EVENT_UNIT_DEATH )
    // Королева Змей
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Naga, udg_UNIT_Naga, EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Naga_Shield, udg_UNIT_Naga, EVENT_UNIT_TARGET_IN_RANGE )
    call TriggerRegisterUnitEvent( gg_trg_Naga_Shield, udg_UNIT_Naga, EVENT_UNIT_ATTACKED )
    call TriggerRegisterUnitEvent( gg_trg_Naga_Help, udg_UNIT_Naga, EVENT_UNIT_SPELL_EFFECT )
    // Странник с ящерицей
    call TriggerRegisterUnitInRangeSimple( gg_trg_Cinematic_Traveler, 320.00, udg_UNIT_Traveler )
    call TriggerRegisterUnitEvent( gg_trg_Attack_of_Traveler, udg_UNIT_Traveler, EVENT_UNIT_DAMAGED )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Lizard, udg_UNIT_Lizard, EVENT_UNIT_DEATH )
    // Встреча с мародером
    call TriggerRegisterUnitInRangeSimple( gg_trg_Cinematic_Marauder, 200.00, udg_UNIT_Marauder )
    call TriggerRegisterUnitEvent( gg_trg_Attack_of_Marauder, udg_UNIT_Marauder, EVENT_UNIT_DAMAGED )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Marauder, udg_UNIT_Marauder, EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Marauder2, udg_UNIT_Marauder, EVENT_UNIT_DEATH )
    // Встреча с пленником
    call TriggerRegisterUnitInRangeSimple( gg_trg_Cinematic_Prisoner1, 300.00, udg_UNIT_Prisoner )
    call TriggerRegisterUnitEvent( gg_trg_Attack_of_Prisoner, udg_UNIT_Prisoner, EVENT_UNIT_DAMAGED )
    // Адское создание
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Hellish_Creature, udg_UNIT_HellishCreature, EVENT_UNIT_DEATH )
    // Стражи
    call TriggerRegisterUnitEvent( gg_trg_Death_of_EarthGuard, udg_UNIT_EarthGuard, EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Attacking_EarthGuard, udg_UNIT_EarthGuard, EVENT_UNIT_DAMAGED )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_WaterGuard, udg_UNIT_WaterGuard, EVENT_UNIT_DEATH )
    // БОСС 3
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Archmage, udg_UNIT_Boss3_Archmage, EVENT_UNIT_DEATH )
endfunction

