    call TriggerRegisterPlayerStateEvent( gg_trg_Total_Gold, Player(1), PLAYER_STATE_RESOURCE_GOLD, GREATER_THAN_OR_EQUAL, 0.00 )
    call TriggerRegisterPlayerStateEvent( gg_trg_Total_Gold, Player(2), PLAYER_STATE_RESOURCE_GOLD, GREATER_THAN_OR_EQUAL, 0.00 )
    call TriggerAddAction( gg_trg_Total_Gold, function Trig_Total_Gold_Actions )
endfunction

