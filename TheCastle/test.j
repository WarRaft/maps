//===========================================================================
// Trigger: Corpses death
//===========================================================================
function Trig_Corpses_death_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'n00W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Corpses_death_Func003C takes nothing returns boolean
    if ( not ( GetKillingUnitBJ() == udg_UNIT_Devouer ) ) then
        return false
    endif
    return true
endfunction

function Trig_Corpses_death_Actions takes nothing returns nothing
    local effect temp_effect
    call GroupRemoveUnitSimple( GetDyingUnit(), udg_Corpses_Group )
    if ( Trig_Corpses_death_Func003C() ) then
        set udg_HP_Devouer = GetUnitState(udg_UNIT_Devouer, UNIT_STATE_LIFE )
        call SetUnitState( udg_UNIT_Devouer, UNIT_STATE_LIFE, (udg_HP_Devouer + 1200.00) )
        set temp_effect = AddSpecialEffectTarget( "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", udg_UNIT_Devouer, "origin" )
        call TriggerSleepAction( 2.00 )
        call DestroyEffect( temp_effect )
        set temp_effect = null
    else
    endif
endfunction

