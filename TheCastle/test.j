    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Victory_01, GetEnumPlayer(), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Victory_02, GetEnumPlayer(), 40.00 )
