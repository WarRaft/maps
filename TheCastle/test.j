    set gg_trg_Marauder = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Marauder, gg_rct_REG_Marauder_Entrance )
    call TriggerAddCondition( gg_trg_Marauder, Condition( function Trig_Marauder_Conditions ) )
    call TriggerAddAction( gg_trg_Marauder, function Trig_Marauder_Actions )
endfunction

