//===========================================================================
function InitTrig_Cinematic_BOSS3_alternate takes nothing returns nothing
    set gg_trg_Cinematic_BOSS3_alternate = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_BOSS3_alternate )
    call TriggerAddAction( gg_trg_Cinematic_BOSS3_alternate, function Trig_Cinematic_BOSS3_alternate_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic BOSS3 alternate Ending
//===========================================================================
function Trig_Cinematic_BOSS3_alternate_Ending_Func001C takes nothing returns boolean
    if ( not ( udg_Darkening_Bool == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_BOSS3_alternate_Ending_Func023A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Boss3_08_alternate, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_BOSS3_alternate_Ending_Actions takes nothing returns nothing
    if ( Trig_Cinematic_BOSS3_alternate_Ending_Func001C() ) then
        call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
        call TriggerSleepAction( 0.90 )
    else
    endif
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call TriggerExecute( gg_trg_Init_Boss3_alternate )
    call DestructableRestoreLife( gg_dest_B00S_9043, 500.00, false )
    call DestructableRestoreLife( gg_dest_B00S_9044, 500.00, false )
    call DestructableRestoreLife( gg_dest_B00S_1954, 500.00, false )
    call RemoveUnit( udg_UNIT_Boss3_Archmage )
    call SetUnitPositionLocFacingBJ( udg_Hero_warrior, GetRectCenter(gg_rct_REG_Warrior_Ending3_alternate), 0.00 )
    call SetUnitPositionLocFacingBJ( udg_Hero_mechanic, GetRectCenter(gg_rct_REG_Mechanic_Ending3_alternate), 0.00 )
    call SetUnitPositionLocFacingBJ( udg_Hero_shaman, GetRectCenter(gg_rct_REG_Shaman_Ending3_alternate), 0.00 )
    call TriggerExecute( gg_trg_Heroes_Transformation )
    set udg_Portal_num = 20
    call TriggerExecute( gg_trg_PORTAL_OPENING )
    set udg_Portal_num = 21
    call TriggerExecute( gg_trg_PORTAL_OPENING )
    set udg_Portal_num = 22
    call TriggerExecute( gg_trg_PORTAL_OPENING )
    call CameraSetSmoothingFactorBJ( 0.30 )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_BOSS3_alternate_Ending_Func023A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call CinematicModeExBJ( false, GetPlayersAll(), 1.00 )
    call TriggerSleepAction( 1.30 )
    call TriggerExecute( gg_trg_Help10 )
    call TriggerSleepAction( 5.00 )
    call TriggerExecute( gg_trg_Help11 )
endfunction

//===========================================================================
function InitTrig_Cinematic_BOSS3_alternate_Ending takes nothing returns nothing
    set gg_trg_Cinematic_BOSS3_alternate_Ending = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_BOSS3_alternate_Ending )
    call TriggerAddAction( gg_trg_Cinematic_BOSS3_alternate_Ending, function Trig_Cinematic_BOSS3_alternate_Ending_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Victory
//
// Победив Архилича Дивока, герои спасли свои народы от неминуемой гибели. Источник тьмы был уничтожен, а значит, распространение тёмной силы было остановлено. 
// Теперь им предстояло вернуться домой. Путь их был долгим, но уже не столь опасным . . .
// Герои покинули Замок, а стены его продолжали хранить секреты. Кто знает, сколько еще тайн скрыто в коридорах Замка? Быть может, прямо сейчас в одной из дальних и забытых комнат зарождается нечто ужасное и могущественное . . .
// ТИТРЫ
// |cffffcc00ИДЕЯ И РЕАЛИЗАЦИЯ|r
// Артемий Фёдоров (Teo/Lord_Teo)
// |cffffcc00МУЗЫКА|r
// Atrium Carceri - Ego Death
// Atrium Carceri & Cities Last Broadcast - Prepare the Stage of Night
// David Chas - Legions Are Marching
// Rok Nardin - Where is Your God Now
// Если Вам понравилась карта, то можете оставить положительный отзыв на сайте XGM.GURU - ресурс |cffffcc00"Замок (The Castle)"|r. Или можете оставить критику и замечания, если были найдены какие-либо ошибки или неприятные моменты.
// Спасибо за игру!
// |cffffcc00ТЕСТИРОВАНИЕ|r
// Lord_Teo
// ABATAPA_PEKCAPA
// Андреич
// |cffffcc00МОДЕЛИ|r
// Использовались модели с сайтов: |cffffcc00xgm.guru|r и |cffffcc00hiveworkshop.com|r
// Авторы моделей: Lord_Teo, WARCRAFT MODELS, Bergi, LongbowMan, sleep, FEARSTARTER, TassAvadar, Андреич.
//===========================================================================
function Trig_Cinematic_Victory_Func005A takes nothing returns nothing
    call SetCameraFieldForPlayer( GetEnumPlayer(), CAMERA_FIELD_TARGET_DISTANCE, 80.00, 50.00 )
endfunction

