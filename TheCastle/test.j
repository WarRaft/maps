    if ( not ( GetSpellAbilityId() == 'A00J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fatal_Strike_Func022Func001C takes nothing returns boolean
    if ( ( UnitHasBuffBJ(udg_Hero_warrior, 'B001') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Hero_warrior, 'B01L') == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Fatal_Strike_Func022C takes nothing returns boolean
    if ( not Trig_Fatal_Strike_Func022Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Fatal_Strike_Actions takes nothing returns nothing
    local location Hero_point
    local location Target_point
    local unit dummy_unit
    local unit copy_unit
    set udg_FS_Target_Unit = GetSpellTargetUnit()
    set Hero_point = GetUnitLoc(udg_Hero_warrior)
    set Target_point = GetUnitLoc(udg_FS_Target_Unit)
    set udg_FS_Angle = AngleBetweenPoints(Hero_point, Target_point)
    // Параметры Героя
    set udg_FS_Level = GetHeroLevel(udg_Hero_warrior)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_FS_Items[GetForLoopIndexA()] = UnitItemInSlotBJ(udg_Hero_warrior, GetForLoopIndexA())
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call SetUnitTimeScalePercent( udg_Hero_warrior, 150.00 )
    // Создаем копию Героя
    set copy_unit = TeoCreateDummyUnit( Player(5), 'O001', 6600, 12940, 0 )
    call SetHeroLevelBJ( copy_unit, udg_FS_Level, false )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 6
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
         call UnitAddItemByIdSwapped( GetItemTypeId(udg_FS_Items[GetForLoopIndexB()]), copy_unit )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    // Проверяем на наличие Безумия и кидаем бафф, если нужно
    if ( Trig_Fatal_Strike_Func022C() ) then
        call IssueImmediateOrder( udg_UNIT_FS_Dummy, "roar" )
    else
    endif
    // Наносим урон по Дамми-юниту
    call IssueTargetOrder( copy_unit, "attackonce", udg_UNIT_FS_Dummy )
    // Обнуление переменных
    call RemoveLocation(Hero_point)
    call RemoveLocation(Target_point)
    set Hero_point = null
    set Target_point = null
    set dummy_unit = null
    set copy_unit = null
endfunction

//===========================================================================
function InitTrig_Fatal_Strike takes nothing returns nothing
    set gg_trg_Fatal_Strike = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Fatal_Strike, Player(0), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Fatal_Strike, Player(1), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Fatal_Strike, Player(2), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Fatal_Strike, Condition( function Trig_Fatal_Strike_Conditions ) )
    call TriggerAddAction( gg_trg_Fatal_Strike, function Trig_Fatal_Strike_Actions )
endfunction

//===========================================================================
// Trigger: Fatal Strike Actions
//===========================================================================
function Trig_Fatal_Strike_Actions_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_warrior) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fatal_Strike_Actions_Func005C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_FS_Target_Unit) == 'nmgv' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fatal_Strike_Actions_Actions takes nothing returns nothing
    call SetUnitTimeScalePercent( udg_Hero_warrior, 100.00 )
    set udg_FS_Final_Damage = ( 2.50 * GetEventDamage() )
    call UnitDamageTargetBJ( udg_Hero_warrior, udg_FS_Target_Unit, udg_FS_Final_Damage, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL )
    // Цель: Магические ящики
    if ( Trig_Fatal_Strike_Actions_Func005C() ) then
        // См. папку "Головоломки с кубами" (Движение ящиков)
        call TriggerExecute( gg_trg_Direction_Selection )
    else
        call IssueTargetOrderBJ( udg_Hero_warrior, "attack", udg_FS_Target_Unit )
        call DoNothing(  )
    endif
endfunction

