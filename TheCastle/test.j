//===========================================================================
// Trigger: Foggy Mind Object Warrior
//===========================================================================
function Trig_Foggy_Mind_Object_Warrior_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B015') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foggy_Mind_Object_Warrior_Actions takes nothing returns nothing
    local unit hero = udg_Hero_warrior
    local unit hero1 = udg_Hero_shaman
    local unit hero2 = udg_Hero_mechanic
    local unit target_unit
    local location point_hero = GetUnitLoc(hero)
    local location point_1
    local location point_2
    // Если юнит живой, то запоминаем его местоположение
    if (IsUnitAliveBJ(hero1) ) then
        set point_1 = GetUnitLoc(hero1)
    else
        set point_1 = Location (-13000, -13000)
    endif
    if (IsUnitAliveBJ(hero2) ) then
        set point_2 = GetUnitLoc(hero2)
    else
        set point_2 = Location (-13000, -13000)
    endif
    // Определяем ближайшего к Герою юнита
    if ( DistanceBetweenPoints(point_hero, point_1) < DistanceBetweenPoints(point_hero, point_2) ) then
        set target_unit = hero1
    else
        set target_unit = hero2
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call IssueTargetOrder( hero, "attack", target_unit )
    call EnableTrigger( GetTriggeringTrigger() )
    // Обнуление переменных
    call RemoveLocation(point_hero)
    call RemoveLocation(point_1)
    call RemoveLocation(point_2)
    set point_hero = null
    set point_1 = null
    set point_2 = null
    set hero = null
    set hero1 = null
    set hero2 = null
    set target_unit = null
endfunction

//===========================================================================
function InitTrig_Foggy_Mind_Object_Warrior takes nothing returns nothing
    set gg_trg_Foggy_Mind_Object_Warrior = CreateTrigger(  )
    call DisableTrigger( gg_trg_Foggy_Mind_Object_Warrior )
    call TriggerAddCondition( gg_trg_Foggy_Mind_Object_Warrior, Condition( function Trig_Foggy_Mind_Object_Warrior_Conditions ) )
