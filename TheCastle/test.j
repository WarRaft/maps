    call ClearSelectionForPlayer( GetEnumPlayer() )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Marauder1, GetEnumPlayer(), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Marauder2, GetEnumPlayer(), 40.00 )
endfunction

