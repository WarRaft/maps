        call GroupRemoveUnitSimple( GetLeavingUnit(), udg_Victims_Group )
        call TriggerExecute( gg_trg_Hunting )
    else
    endif
    if ( Trig_Exit_from_Hunting_Zone_Func002C() ) then
        call IssuePointOrderLocBJ( GetLeavingUnit(), "move", GetRectCenter(gg_rct_REG_Start_of_Hunting) )
    else
