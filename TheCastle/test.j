//===========================================================================
// Trigger: Attacking EarthGuard
//===========================================================================
function Trig_Attacking_EarthGuard_Func002C takes nothing returns boolean
    if ( not ( GetEventDamage() <= 1.00 ) ) then
        return false
    endif
    if ( not ( GetEventDamage() > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Attacking_EarthGuard_Actions takes nothing returns nothing
    local effect temp_effect
    if ( Trig_Attacking_EarthGuard_Func002C() ) then
        call SetUnitLifeBJ( udg_UNIT_EarthGuard, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_UNIT_EarthGuard) + 100.00 ) )
        set temp_effect = AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl", udg_UNIT_EarthGuard, "origin")
        call TriggerSleepAction( 2.00 )
        call DestroyEffect( temp_effect )
        set temp_effect = null
    else
    endif
endfunction

