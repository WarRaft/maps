//===========================================================================
// Trigger: Stomp
//===========================================================================
function Trig_Stomp_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A03R' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stomp_Func004A takes nothing returns nothing
    local unit dummy_unit
    local unit temp_unit = GetEnumUnit()
    // Оглушаем каждого юнита
    set dummy_unit = TeoCreateDummyUnit( GetOwningPlayer(GetTriggerUnit()), 'n00X', GetUnitX (GetTriggerUnit()), GetUnitY (GetTriggerUnit()), 'A03S' )
    call IssueTargetOrder( dummy_unit, "thunderbolt", temp_unit )
    set dummy_unit = null
    set temp_unit = null
endfunction

function Trig_Stomp_Actions takes nothing returns nothing
    call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()) ) )
    // Выбираем группу юнитов
    call GroupEnumUnitsInRange (udg_TempGroup, GetUnitX (GetTriggerUnit()), GetUnitY (GetTriggerUnit()), 250, null) 
    call ForGroupBJ( udg_TempGroup, function Trig_Stomp_Func004A )
    // Обнуление переменных
    call GroupClear( udg_TempGroup )
endfunction

//===========================================================================
function InitTrig_Stomp takes nothing returns nothing
    set gg_trg_Stomp = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Stomp, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Stomp, Condition( function Trig_Stomp_Conditions ) )
    call TriggerAddAction( gg_trg_Stomp, function Trig_Stomp_Actions )
endfunction

