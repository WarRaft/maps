//===========================================================================
// Trigger: Button22 Action
//===========================================================================
function Trig_Button22_Action_Func002Func001Func001C takes nothing returns boolean
    if ( not ( udg_Music == 9 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Button22_Action_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Music == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Button22_Action_Func002C takes nothing returns boolean
    if ( not ( udg_Music == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Button22_Action_Actions takes nothing returns nothing
    // Проигрывание звука и проверка на правильность
    if ( Trig_Button22_Action_Func002C() ) then
        set udg_Music = ( udg_Music + 1 )
        call ShowDestructableBJ( true, gg_dest_B006_10784 )
        call StartTimerBJ( udg_Music_Timer, false, udg_Music_Timer_count )
    else
        if ( Trig_Button22_Action_Func002Func001C() ) then
            set udg_Music = ( udg_Music + 1 )
            call ShowDestructableBJ( true, gg_dest_B006_10785 )
            call StartTimerBJ( udg_Music_Timer, false, udg_Music_Timer_count )
        else
            if ( Trig_Button22_Action_Func002Func001Func001C() ) then
                set udg_Music = ( udg_Music + 1 )
                call ShowDestructableBJ( true, gg_dest_B006_10786 )
                call StartTimerBJ( udg_Music_Timer, false, 3.00 )
            else
                call PauseTimerBJ( true, udg_Music_Timer )
                call TriggerExecute( gg_trg_Music_note_Timer )
            endif
        endif
    endif
endfunction

