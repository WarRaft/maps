function InitTrig_Starting_Cinematic takes nothing returns nothing
    set gg_trg_Starting_Cinematic = CreateTrigger(  )
    call DisableTrigger( gg_trg_Starting_Cinematic )
    call TriggerAddAction( gg_trg_Starting_Cinematic, function Trig_Starting_Cinematic_Actions )
endfunction

//===========================================================================
// Trigger: Starting Game
//===========================================================================
function Trig_Starting_Game_Func011A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Intro_007, GetEnumPlayer(), 0 )
endfunction

function Trig_Starting_Game_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call SetUnitPositionLoc( udg_Hero_mechanic, GetRectCenter(gg_rct_REG_Mechanic_Start) )
    call SetUnitPositionLoc( udg_Hero_shaman, GetRectCenter(gg_rct_REG_Shaman_Start) )
    call SetUnitPositionLoc( udg_Hero_warrior, GetRectCenter(gg_rct_REG_Warrior_Start) )
    call CameraSetSmoothingFactorBJ( 0.30 )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Starting_Game_Func011A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call ShowInterfaceForceOn( GetPlayersAll(), 0.60 )
    call TriggerSleepAction( 1.50 )
    call TriggerExecute( gg_trg_Help1_Training )
endfunction

//===========================================================================
function InitTrig_Starting_Game takes nothing returns nothing
    set gg_trg_Starting_Game = CreateTrigger(  )
    call DisableTrigger( gg_trg_Starting_Game )
    call TriggerAddAction( gg_trg_Starting_Game, function Trig_Starting_Game_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic BOSS1
//
// TEXT_Shaman[2] = Это же Демон Огня Суртур! Его мощь безгранична. Ходит легенда, что победить его невозможно.
// TEXT_Mechanic[2] = Подожди, Акнеладу! Опять ты со своими легендами. Лучше посмотри внимательнее на эти обелиски!
// TEXT_Mechanic[5] = Они сделаны из арканита! Похоже, что они каким-то образом сдерживают его невероятную силу. Нужно попробовать активировать их.
//===========================================================================
function Trig_Cinematic_BOSS1_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_BOSS1_Func019A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Boss1_01, GetEnumPlayer(), 0.00 )
