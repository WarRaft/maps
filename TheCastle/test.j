    set gg_trg_Portal04 = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Portal04, gg_rct_REG_Portal04_Gate1 )
    call TriggerAddCondition( gg_trg_Portal04, Condition( function Trig_Portal04_Conditions ) )
