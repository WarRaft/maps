//===========================================================================
// Trigger: Init Boss3 alternate
//
// Game_Stage - отвечает за область воскрешения героев, если воскрешение происходит не около Камня воскрешения
// 0 - воскрешение в стартовой области
// 1- воскрешение в конечной области
// 2- воскрешение в альтернативной области
//===========================================================================
function Trig_Init_Boss3_alternate_Actions takes nothing returns nothing
    set udg_ResurrectionsStones_condition[0] = false
    set udg_Game_Stage = 2
    call TriggerExecute( gg_trg_Boss3_Waves_settings )
    call EnableTrigger( gg_trg_Boss3_Spawn_security_Timer )
    call EnableTrigger( gg_trg_Boss3_Death_of_Monster )
    // Запускаем таймер до начала усиленной волны с монстрами
    call StartTimerBJ( udg_Boss3_Wave_Timer, false, 90.00 )
    call EnableTrigger( gg_trg_Boss3_Monsters_wave_Timer )
    call RemoveDestructable( gg_dest_B00Y_1999 )
endfunction

//===========================================================================
function InitTrig_Init_Boss3_alternate takes nothing returns nothing
    set gg_trg_Init_Boss3_alternate = CreateTrigger(  )
