// Trigger: Cinematic Teleporter
//
// Переместитель? Не думал, что когда-нибудь увижу его. Он может перенести нас в другое место, если мы сможем настроить его!
//===========================================================================
function Trig_Cinematic_Teleporter_Func021A takes nothing returns nothing
    call ClearSelectionForPlayer( GetEnumPlayer() )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Teleporter1, Player(0), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Teleporter2, Player(0), 50.00 )
endfunction

function Trig_Cinematic_Teleporter_Func027C takes nothing returns boolean
    if ( not ( udg_Cinematic_skipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Teleporter_Func028Func001001 takes nothing returns boolean
    return ( TimerGetRemaining(udg_Cinematic_Timer) == 0.00 )
endfunction

