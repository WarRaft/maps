//===========================================================================
// Trigger: Obelisks Checking
//===========================================================================
function Trig_Obelisks_Checking_Func001Func015C takes nothing returns boolean
    if ( not ( udg_Obelisk_condition[1] == true ) ) then
        return false
    endif
    if ( not ( udg_Obelisk_condition[2] == true ) ) then
        return false
    endif
    if ( not ( udg_Obelisk_condition[3] == true ) ) then
        return false
    endif
    if ( not ( udg_Obelisk_condition[4] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Obelisks_Checking_Func001C takes nothing returns boolean
    if ( not Trig_Obelisks_Checking_Func001Func015C() ) then
        return false
    endif
    return true
endfunction

function Trig_Obelisks_Checking_Actions takes nothing returns nothing
    if ( Trig_Obelisks_Checking_Func001C() ) then
        call PauseTimerBJ( true, udg_Obelisk_Timer[1] )
        call PauseTimerBJ( true, udg_Obelisk_Timer[2] )
        call PauseTimerBJ( true, udg_Obelisk_Timer[3] )
        call PauseTimerBJ( true, udg_Obelisk_Timer[4] )
        call DisableTrigger( gg_trg_Obelisk1_Entrance )
        call DisableTrigger( gg_trg_Obelisk1_Exit )
        call DisableTrigger( gg_trg_Obelisk2_Entrance )
        call DisableTrigger( gg_trg_Obelisk2_Exit )
        call DisableTrigger( gg_trg_Obelisk3_Entrance )
        call DisableTrigger( gg_trg_Obelisk3_Exit )
        call DisableTrigger( gg_trg_Obelisk4_Entrance )
        call DisableTrigger( gg_trg_Obelisk4_Exit )
        call TriggerSleepAction( 1.00 )
        call TriggerExecute( gg_trg_Cinematic_Teleporter )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Obelisks_Checking takes nothing returns nothing
    set gg_trg_Obelisks_Checking = CreateTrigger(  )
    call DisableTrigger( gg_trg_Obelisks_Checking )
    call TriggerAddAction( gg_trg_Obelisks_Checking, function Trig_Obelisks_Checking_Actions )
endfunction

//===========================================================================
// Trigger: Algorithm1
//===========================================================================
function Trig_Algorithm1_Func007C takes nothing returns boolean
    if ( ( GetItemTypeId(GetSoldItem()) == 'I01Z' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I020' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I021' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Algorithm1_Conditions takes nothing returns boolean
    if ( not Trig_Algorithm1_Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_Algorithm1_Func002C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I01Z' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Algorithm1_Func004C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I021' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Algorithm1_Func006C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I020' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Algorithm1_Actions takes nothing returns nothing
    // Дотронуться до шара
    if ( Trig_Algorithm1_Func002C() ) then
        call SetUnitAnimation( gg_unit_n022_0203, "stand work" )
        call RemoveItemFromStockBJ( 'I020', gg_unit_n022_0203 )
        call RemoveItemFromStockBJ( 'I021', gg_unit_n022_0203 )
        call TriggerSleepAction( 0.70 )
        call SetUnitAnimation( gg_unit_n022_0203, "stand" )
        call AddItemToStockBJ( 'I01Z', gg_unit_n022_0203, 0, 1 )
        call AddItemToStockBJ( 'I020', gg_unit_n022_0203, 0, 1 )
        call AddItemToStockBJ( 'I021', gg_unit_n022_0203, 0, 1 )
        // Действие
        call CreateNUnitsAtLoc( 1, 'n023', Player(PLAYER_NEUTRAL_PASSIVE), GetUnitLoc(gg_unit_n022_0203), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", GetBuyingUnit() )
        return
    else
    endif
    // Ударить структуру
    if ( Trig_Algorithm1_Func004C() ) then
        call SetUnitAnimation( gg_unit_n022_0203, "stand work" )
        call RemoveItemFromStockBJ( 'I01Z', gg_unit_n022_0203 )
        call RemoveItemFromStockBJ( 'I020', gg_unit_n022_0203 )
        call TriggerSleepAction( 0.70 )
        call TriggerExecute( gg_trg_Security1 )
        call TriggerSleepAction( 1.00 )
        call SetUnitAnimation( gg_unit_n022_0203, "stand" )
        call TriggerSleepAction( 4.00 )
        call AddItemToStockBJ( 'I01Z', gg_unit_n022_0203, 0, 1 )
        call AddItemToStockBJ( 'I020', gg_unit_n022_0203, 0, 1 )
        call AddItemToStockBJ( 'I021', gg_unit_n022_0203, 0, 1 )
        return
    else
    endif
    // Дотронуться до рисунков
    if ( Trig_Algorithm1_Func006C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_Algorithm2 )
        call SetUnitAnimation( gg_unit_n022_0203, "stand work" )
        call RemoveItemFromStockBJ( 'I01Z', gg_unit_n022_0203 )
        call RemoveItemFromStockBJ( 'I021', gg_unit_n022_0203 )
        call TriggerSleepAction( 0.70 )
        call SetUnitAnimation( gg_unit_n022_0203, "stand" )
        call AddItemToStockBJ( 'I022', gg_unit_n022_0203, 1, 1 )
        return
    else
    endif
endfunction

//===========================================================================
function InitTrig_Algorithm1 takes nothing returns nothing
    set gg_trg_Algorithm1 = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Algorithm1, Player(PLAYER_NEUTRAL_PASSIVE), EVENT_PLAYER_UNIT_SELL_ITEM )
    call TriggerAddCondition( gg_trg_Algorithm1, Condition( function Trig_Algorithm1_Conditions ) )
    call TriggerAddAction( gg_trg_Algorithm1, function Trig_Algorithm1_Actions )
endfunction

//===========================================================================
// Trigger: Algorithm2
//===========================================================================
function Trig_Algorithm2_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I022' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Algorithm2_Func001Func005C takes nothing returns boolean
    if ( ( GetBuyingUnit() == udg_Hero_shaman ) ) then
        return true
    endif
    if ( ( GetBuyingUnit() == udg_Hero_warrior ) ) then
        return true
    endif
    return false
endfunction

function Trig_Algorithm2_Func001C takes nothing returns boolean
    if ( not Trig_Algorithm2_Func001Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Algorithm2_Func002C takes nothing returns boolean
    if ( not ( GetBuyingUnit() == udg_Hero_mechanic ) ) then
        return false
    endif
    return true
endfunction

function Trig_Algorithm2_Actions takes nothing returns nothing
    if ( Trig_Algorithm2_Func001C() ) then
        call AddItemToStockBJ( 'I022', gg_unit_n022_0203, 0, 1 )
        call PlaySoundOnUnitBJ( gg_snd_Error, 100, GetTriggerUnit() )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetBuyingUnit())), "TRIGSTR_3319" )
        return
    else
    endif
    if ( Trig_Algorithm2_Func002C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_Algorithm3 )
        call AddItemToStockBJ( 'I023', gg_unit_n022_0203, 1, 1 )
        call UnitAddAbilityBJ( 'A00K', gg_unit_n022_0203 )
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 3
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call UnitAddAbilityBJ( 'A043', udg_Spatial_Cube[GetForLoopIndexA()] )
            call AddItemToStockBJ( 'I027', udg_Spatial_Cube[GetForLoopIndexA()], 1, 1 )
            call AddItemToStockBJ( 'I025', udg_Spatial_Cube[GetForLoopIndexA()], 1, 1 )
            call AddItemToStockBJ( 'I026', udg_Spatial_Cube[GetForLoopIndexA()], 1, 1 )
            call AddItemToStockBJ( 'I024', udg_Spatial_Cube[GetForLoopIndexA()], 1, 1 )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    else
    endif
endfunction

//===========================================================================
function InitTrig_Algorithm2 takes nothing returns nothing
    set gg_trg_Algorithm2 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Algorithm2 )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Algorithm2, Player(PLAYER_NEUTRAL_PASSIVE), EVENT_PLAYER_UNIT_SELL_ITEM )
    call TriggerAddCondition( gg_trg_Algorithm2, Condition( function Trig_Algorithm2_Conditions ) )
    call TriggerAddAction( gg_trg_Algorithm2, function Trig_Algorithm2_Actions )
endfunction

//===========================================================================
// Trigger: Algorithm3
//===========================================================================
function Trig_Algorithm3_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I023' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Algorithm3_Func005C takes nothing returns boolean
    if ( not ( udg_Spatial_Cubes_Checking[1] == 1 ) ) then
        return false
    endif
    if ( not ( udg_Spatial_Cubes_Checking[2] == 1 ) ) then
        return false
    endif
    if ( not ( udg_Spatial_Cubes_Checking[3] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Algorithm3_Actions takes nothing returns nothing
    call SetUnitAnimation( gg_unit_n022_0203, "stand work" )
    call RemoveItemFromStockBJ( 'I023', gg_unit_n022_0203 )
    call TriggerSleepAction( 0.70 )
    // Если комбинация правильная
    if ( Trig_Algorithm3_Func005C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call AddItemToStockBJ( 'I029', gg_unit_n022_0203, 1, 1 )
        call UnitRemoveAbilityBJ( 'A00K', gg_unit_n022_0203 )
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 3
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call RemoveItemFromStockBJ( 'I028', udg_Spatial_Cube[GetForLoopIndexA()] )
            call UnitRemoveAbilityBJ( 'A043', udg_Spatial_Cube[GetForLoopIndexA()] )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    else
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 3
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetUnitAnimation( gg_unit_n022_0203, "stand" )
            call SetUnitAnimation( udg_Spatial_Cube[GetForLoopIndexA()], "stand" )
            call SetUnitColor( udg_Spatial_Cube[GetForLoopIndexA()], ConvertPlayerColor(12) )
            call RemoveItemFromStockBJ( 'I028', udg_Spatial_Cube[GetForLoopIndexA()] )
            call AddItemToStockBJ( 'I027', udg_Spatial_Cube[GetForLoopIndexA()], 0, 1 )
            call AddItemToStockBJ( 'I025', udg_Spatial_Cube[GetForLoopIndexA()], 0, 1 )
            call AddItemToStockBJ( 'I026', udg_Spatial_Cube[GetForLoopIndexA()], 0, 1 )
            call AddItemToStockBJ( 'I024', udg_Spatial_Cube[GetForLoopIndexA()], 0, 1 )
            set udg_Spatial_Cubes_Checking[GetForLoopIndexA()] = 0
            call AddItemToStockBJ( 'I023', gg_unit_n022_0203, 0, 1 )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    endif
endfunction

//===========================================================================
function InitTrig_Algorithm3 takes nothing returns nothing
    set gg_trg_Algorithm3 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Algorithm3 )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Algorithm3, Player(PLAYER_NEUTRAL_PASSIVE), EVENT_PLAYER_UNIT_SELL_ITEM )
    call TriggerAddCondition( gg_trg_Algorithm3, Condition( function Trig_Algorithm3_Conditions ) )
    call TriggerAddAction( gg_trg_Algorithm3, function Trig_Algorithm3_Actions )
