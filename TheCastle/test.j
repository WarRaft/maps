//===========================================================================
// Trigger: Tanks respawn
//===========================================================================
function Trig_Tanks_respawn_Func005C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_h000_0031) == true ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Tanks_Group) < 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tanks_respawn_Func006C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_h000_0027) == true ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Tanks_Group) < 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tanks_respawn_Func007A takes nothing returns nothing
    local unit temp_unit = GetEnumUnit()
    local location point = GetRandomLocInRect(gg_rct_REG_Tanks)
    call IssuePointOrderLocBJ( temp_unit, "attack", point )
    call RemoveLocation(point)
    set point = null
    set temp_unit = null
endfunction

function Trig_Tanks_respawn_Actions takes nothing returns nothing
    local unit tank_unit1
    local unit tank_unit2
    local location point1 = GetRectCenter(gg_rct_REG_Factory1)
    local location point2 = GetRectCenter(gg_rct_REG_Factory2)
    if ( Trig_Tanks_respawn_Func005C() ) then
        set tank_unit1 = TeoCreateUnit( Player(11), 'h001', GetLocationX(point1),GetLocationY(point1), 315.00 )
        call GroupAddUnitSimple( tank_unit1, udg_Tanks_Group )
        call RemoveLocation(point1)
        set point1 = null
        set tank_unit1 = null
    else
    endif
    if ( Trig_Tanks_respawn_Func006C() ) then
        set tank_unit2 = TeoCreateUnit( Player(11), 'h001', GetLocationX(point2),GetLocationY(point2), 45.00 )
        call GroupAddUnitSimple( tank_unit2, udg_Tanks_Group )
        call RemoveLocation(point2)
        set point2 = null
        set tank_unit2 = null
    else
    endif
    call ForGroupBJ( udg_Tanks_Group, function Trig_Tanks_respawn_Func007A )
endfunction

