        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Prisoner2_Ending )
        return
    endif
    // Исчезновение Заключённого
    if ( Trig_Cinematic_Prisoner2_Func055C() ) then
        call PauseUnitBJ( false, udg_UNIT_Prisoner )
        call IssuePointOrderLocBJ( udg_UNIT_Prisoner, "move", Location(8620.00, -2020.00) )
        call TriggerSleepAction( 0.40 )
        call RemoveUnit( udg_UNIT_Prisoner )
        call KillDestructable( LoadDestructableHandleBJ(23, 1, GetLastCreatedHashtableBJ()) )
    else
        call TriggerExecute( gg_trg_Cinematic_Prisoner2_Ending )
        return
    endif
    // Таймер ожидания 2 с.
    if ( Trig_Cinematic_Prisoner2_Func057C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 2.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Prisoner2_Ending )
        return
    endif
    if ( Trig_Cinematic_Prisoner2_Func058C() ) then
        loop
            exitwhen ( Trig_Cinematic_Prisoner2_Func058Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Prisoner2_Ending )
        return
    endif
    // ЗАВЕРШЕНИЕ СЪЁМОК
    call TriggerExecute( gg_trg_Cinematic_Prisoner2_Ending )
endfunction

//===========================================================================
function InitTrig_Cinematic_Prisoner2 takes nothing returns nothing
    set gg_trg_Cinematic_Prisoner2 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_Prisoner2 )
    call TriggerAddCondition( gg_trg_Cinematic_Prisoner2, Condition( function Trig_Cinematic_Prisoner2_Conditions ) )
    call TriggerAddAction( gg_trg_Cinematic_Prisoner2, function Trig_Cinematic_Prisoner2_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Prisoner2 Ending
//===========================================================================
function Trig_Cinematic_Prisoner2_Ending_Func009C takes nothing returns boolean
    if ( not ( udg_Cinematic_Prisoner == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Prisoner2_Ending_Func012A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Prisoner5, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_Prisoner2_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.30 )
    call RemoveUnit( udg_UNIT_Prisoner )
    if ( Trig_Cinematic_Prisoner2_Ending_Func009C() ) then
        call CreateItemLoc( 'I02W', Location(8560.00, -2075.00) )
    else
    endif
    call KillDestructable( LoadDestructableHandleBJ(23, 1, GetLastCreatedHashtableBJ()) )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Prisoner2_Ending_Func012A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call CinematicModeExBJ( false, GetPlayersAll(), 0.60 )
    call TriggerSleepAction( 0.50 )
    call TeoTextTag ("Репутация изменена", udg_Hero_warrior, 0,80,0)
    call TeoTextTag ("Репутация изменена", udg_Hero_shaman, 0,80,0)
    call TeoTextTag ("Репутация изменена", udg_Hero_mechanic, 0,80,0)
    set udg_Reputation = ( udg_Reputation + 10.00 )
endfunction

//===========================================================================
function InitTrig_Cinematic_Prisoner2_Ending takes nothing returns nothing
    set gg_trg_Cinematic_Prisoner2_Ending = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_Prisoner2_Ending )
    call TriggerAddAction( gg_trg_Cinematic_Prisoner2_Ending, function Trig_Cinematic_Prisoner2_Ending_Actions )
endfunction

