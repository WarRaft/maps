        set text = "Т Р Е Б У Е Т С Я   Р Е М О Н Т"
        call SetTextTagTextBJ(msg, text, 10 )
    else
    endif
    call TriggerSleepAction( 0.05 )
    call DestroyTextTagBJ( msg )
    if ( Trig_Reload_robot_Func043C() ) then
        call SetUnitMoveSpeed( udg_UNIT_Robot, 270.00 )
        call SetUnitTurnSpeedBJ( udg_UNIT_Robot, 0.50 )
        call UnitAddAbilityBJ( 'A02H', udg_UNIT_Robot )
        call StartTimerBJ( udg_Repair_Timer, false, 0.50 )
        if ( Trig_Reload_robot_Func043Func005C() ) then
            call IssueTargetOrderBJ( udg_UNIT_Robot, "unload", udg_UNIT_Robot_Mechanic )
        else
        endif
    else
    endif
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

