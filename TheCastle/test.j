//===========================================================================
// Trigger: Soul Stone death
//
// Воскрешает умерших воинов.
//===========================================================================
function Trig_Soul_Stone_death_Func007Func002C takes nothing returns boolean
    if ( not ( IsUnitDeadBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Stone_death_Func007A takes nothing returns nothing
    local unit dummy_unit
    if ( Trig_Soul_Stone_death_Func007Func002C() ) then
        set dummy_unit = TeoCreateDummyUnit( Player(bj_PLAYER_NEUTRAL_EXTRA), 'n00X', GetUnitX(GetEnumUnit()), GetUnitY(GetEnumUnit()), 'A02Y' )
        call IssueImmediateOrder( dummy_unit, "instant" )
        set dummy_unit = null
    else
    endif
endfunction

function Trig_Soul_Stone_death_Actions takes nothing returns nothing
    local destructable dest = GetDyingDestructable()
    local real dest_x = GetDestructableX(dest)
    local real dest_y = GetDestructableY(dest)
    call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", dest_x, dest_y ))
    // Выбираем группу юнитов
    call GroupEnumUnitsInRange (udg_TempGroup, dest_x, dest_y, 600, null) 
    call ForGroupBJ( udg_TempGroup, function Trig_Soul_Stone_death_Func007A )
    // Обнуление переменных
    call GroupClear( udg_TempGroup )
    set dest = null
endfunction

