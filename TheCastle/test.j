function Trig_Switch_Actions takes nothing returns nothing
    // 1 переключатель (двери западни)
    if ( Trig_Switch_Func002C() ) then
        call TriggerExecute( gg_trg_Hunting )
        if ( Trig_Switch_Func002Func002C() ) then
            call KillDestructable( gg_dest_B00S_4127 )
            call KillDestructable( gg_dest_B00S_4129 )
            call DestructableRestoreLife( gg_dest_B00S_4128, 500.00, true )
            set udg_Switch_condition[1] = true
        else
            call DestructableRestoreLife( gg_dest_B00S_4127, 500.00, true )
            call DestructableRestoreLife( gg_dest_B00S_4129, 500.00, true )
            call KillDestructable( gg_dest_B00S_4128 )
            set udg_Switch_condition[1] = false
        endif
        return
    else
    endif
    // 2 переключатель (двери западни)
    if ( Trig_Switch_Func004C() ) then
        call TriggerExecute( gg_trg_Hunting )
        if ( Trig_Switch_Func004Func002C() ) then
            call KillDestructable( gg_dest_B00S_1184 )
            call DestructableRestoreLife( gg_dest_B00S_1183, 500.00, true )
            set udg_Switch_condition[2] = true
        else
            call KillDestructable( gg_dest_B00S_1183 )
            call DestructableRestoreLife( gg_dest_B00S_1184, 500.00, true )
            set udg_Switch_condition[2] = false
        endif
        return
    else
    endif
    // 3 переключатель (двери западни)
    if ( Trig_Switch_Func006C() ) then
        call TriggerExecute( gg_trg_Hunting )
        if ( Trig_Switch_Func006Func002C() ) then
            call KillDestructable( gg_dest_B00S_1180 )
            call KillDestructable( gg_dest_B00S_1182 )
            call DestructableRestoreLife( gg_dest_B00S_1185, 500.00, true )
            set udg_Switch_condition[3] = true
        else
            call DestructableRestoreLife( gg_dest_B00S_1180, 500.00, true )
            call DestructableRestoreLife( gg_dest_B00S_1182, 500.00, true )
            call KillDestructable( gg_dest_B00S_1185 )
            set udg_Switch_condition[3] = false
        endif
        return
    else
    endif
    // 4 переключатель (двери западни)
    if ( Trig_Switch_Func008C() ) then
        call TriggerExecute( gg_trg_Hunting )
        if ( Trig_Switch_Func008Func002C() ) then
            call KillDestructable( gg_dest_B00S_0971 )
            set udg_Switch_condition[4] = true
        else
            call DestructableRestoreLife( gg_dest_B00S_0971, 500.00, true )
            set udg_Switch_condition[4] = false
        endif
        return
    else
    endif
    // 5 переключатель (включение лифта)
    if ( Trig_Switch_Func010C() ) then
        if ( Trig_Switch_Func010Func001C() ) then
            set udg_Switch_condition[5] = true
            call ChangeElevatorWalls( false, bj_ELEVATOR_WALL_TYPE_ALL, gg_dest_DTrx_0972 )
            call ChangeElevatorHeight( gg_dest_DTrx_0972, 3 )
            call PauseTimerBJ( true, udg_Elevator_Timer[1] )
            call DisableTrigger( gg_trg_ElevatorTimer1 )
            call TriggerSleepAction( 1.00 )
            call ChangeElevatorWalls( true, bj_ELEVATOR_WALL_TYPE_SOUTH, gg_dest_DTrx_0972 )
        else
            set udg_Switch_condition[5] = false
            call ChangeElevatorWalls( false, bj_ELEVATOR_WALL_TYPE_ALL, gg_dest_DTrx_0972 )
            call ChangeElevatorHeight( gg_dest_DTrx_0972, 1 )
            call StartTimerBJ( udg_Elevator_Timer[1], false, 4.00 )
            call EnableTrigger( gg_trg_ElevatorTimer1 )
            call TriggerSleepAction( 1.00 )
            call ChangeElevatorWalls( true, bj_ELEVATOR_WALL_TYPE_NORTH, gg_dest_DTrx_0972 )
        endif
        return
    else
    endif
    // 6 переключатель (подъемник лифта № 1)
    if ( Trig_Switch_Func012C() ) then
        if ( Trig_Switch_Func012Func001C() ) then
            call ChangeElevatorWalls( false, bj_ELEVATOR_WALL_TYPE_ALL, gg_dest_DTrx_1204 )
            if ( Trig_Switch_Func012Func001Func002C() ) then
                call ChangeElevatorHeight( gg_dest_DTrx_1204, 3 )
            else
                call ChangeElevatorHeight( gg_dest_DTrx_1204, 1 )
            endif
            call TriggerSleepAction( 0.70 )
            call SetDestructableAnimationBJ( udg_Switch[6], "death" )
            call TriggerSleepAction( 0.30 )
            if ( Trig_Switch_Func012Func001Func006C() ) then
                call ChangeElevatorWalls( true, bj_ELEVATOR_WALL_TYPE_SOUTH, gg_dest_DTrx_1204 )
            else
                call ChangeElevatorWalls( true, bj_ELEVATOR_WALL_TYPE_NORTH, gg_dest_DTrx_1204 )
            endif
        else
        endif
        return
    else
    endif
    // 7 переключатель (подъемник лифта № 2)
    if ( Trig_Switch_Func014C() ) then
        if ( Trig_Switch_Func014Func001C() ) then
            call ChangeElevatorWalls( false, bj_ELEVATOR_WALL_TYPE_ALL, gg_dest_DTrx_1204 )
            if ( Trig_Switch_Func014Func001Func002C() ) then
                call ChangeElevatorHeight( gg_dest_DTrx_1204, 3 )
            else
                call ChangeElevatorHeight( gg_dest_DTrx_1204, 1 )
            endif
            call TriggerSleepAction( 0.70 )
            call SetDestructableAnimationBJ( udg_Switch[7], "death" )
            call TriggerSleepAction( 0.30 )
            if ( Trig_Switch_Func014Func001Func006C() ) then
                call ChangeElevatorWalls( true, bj_ELEVATOR_WALL_TYPE_SOUTH, gg_dest_DTrx_1204 )
            else
                call ChangeElevatorWalls( true, bj_ELEVATOR_WALL_TYPE_NORTH, gg_dest_DTrx_1204 )
            endif
        else
        endif
        return
    else
    endif
    // 8 переключатель (огненная казнь)
    if ( Trig_Switch_Func016C() ) then
        if ( Trig_Switch_Func016Func001C() ) then
            set udg_Switch_condition[8] = true
            call DisableTrigger( gg_trg_Fire_Execution )
        else
            set udg_Switch_condition[8] = false
            call TriggerExecute( gg_trg_Fire_Execution )
            call EnableTrigger( gg_trg_Fire_Execution )
        endif
    else
    endif
endfunction

