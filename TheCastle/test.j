    else
        if ( Trig_Button20_Action_Func002Func001C() ) then
            set udg_Music = ( udg_Music + 1 )
            call ShowDestructableBJ( true, gg_dest_B009_10787 )
            call StartTimerBJ( udg_Music_Timer, false, udg_Music_Timer_count )
        else
