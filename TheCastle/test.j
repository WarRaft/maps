//===========================================================================
function Trig_Rune_Activation_Func007C takes nothing returns boolean
    if ( ( GetItemTypeId(GetSoldItem()) == 'I027' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I025' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I026' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetSoldItem()) == 'I024' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Rune_Activation_Conditions takes nothing returns boolean
    if ( not Trig_Rune_Activation_Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Activation_Func009C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I027' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Activation_Func011Func002C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Spatial_Cube[3] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Activation_Func011C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I025' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Activation_Func013C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I026' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Activation_Func015Func002C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Spatial_Cube[1] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Activation_Func015Func003C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Spatial_Cube[2] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Activation_Func015C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I024' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Activation_Actions takes nothing returns nothing
    call SetUnitAnimation( GetTriggerUnit(), "stand work" )
    call RemoveItemFromStockBJ( 'I027', GetTriggerUnit() )
    call RemoveItemFromStockBJ( 'I025', GetTriggerUnit() )
    call RemoveItemFromStockBJ( 'I026', GetTriggerUnit() )
    call RemoveItemFromStockBJ( 'I024', GetTriggerUnit() )
    call AddItemToStockBJ( 'I028', GetTriggerUnit(), 0, 1 )
    // Желтая руна
    if ( Trig_Rune_Activation_Func009C() ) then
        call SetUnitColor( GetTriggerUnit(), PLAYER_COLOR_YELLOW )
        return
    else
    endif
    // Зеленая руна
    if ( Trig_Rune_Activation_Func011C() ) then
        call SetUnitColor( GetTriggerUnit(), PLAYER_COLOR_GREEN )
        if ( Trig_Rune_Activation_Func011Func002C() ) then
            set udg_Spatial_Cubes_Checking[3] = 1
        else
        endif
        return
    else
    endif
    // Красная руна
    if ( Trig_Rune_Activation_Func013C() ) then
        call SetUnitColor( GetTriggerUnit(), PLAYER_COLOR_RED )
        return
    else
    endif
    // Синяя руна
    if ( Trig_Rune_Activation_Func015C() ) then
        call SetUnitColor( GetTriggerUnit(), PLAYER_COLOR_BLUE )
        if ( Trig_Rune_Activation_Func015Func002C() ) then
            set udg_Spatial_Cubes_Checking[1] = 1
        else
        endif
        if ( Trig_Rune_Activation_Func015Func003C() ) then
            set udg_Spatial_Cubes_Checking[2] = 1
        else
        endif
    else
    endif
endfunction

