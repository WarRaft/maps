//===========================================================================
function Trig_Altar1_Func001C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetBuyingUnit(), 'I017') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Altar1_Actions takes nothing returns nothing
    if ( Trig_Altar1_Func001C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitAnimation( gg_unit_u00A_0522, "stand work" )
        call RemoveItem( GetItemOfTypeFromUnitBJ(GetBuyingUnit(), 'I017') )
        call UnitRemoveAbilityBJ( 'A019', gg_unit_u00A_0522 )
        call TriggerExecute( gg_trg_Bridge_Open )
    else
        call AddItemToStockBJ( 'I02C', gg_unit_u00A_0522, 1, 1 )
        call PlaySoundOnUnitBJ( gg_snd_Error, 100, GetBuyingUnit() )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetBuyingUnit())), "TRIGSTR_3588" )
    endif
endfunction

