    set gg_trg_Boss1_AI = CreateTrigger(  )
    call DisableTrigger( gg_trg_Boss1_AI )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Boss1_AI, 2.30 )
    call TriggerAddAction( gg_trg_Boss1_AI, function Trig_Boss1_AI_Actions )
endfunction

