    set gg_trg_Boss_Obelisk_Attack = CreateTrigger(  )
    call DisableTrigger( gg_trg_Boss_Obelisk_Attack )
    call TriggerAddAction( gg_trg_Boss_Obelisk_Attack, function Trig_Boss_Obelisk_Attack_Actions )
endfunction

