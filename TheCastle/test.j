//===========================================================================
function Trig_Init_Skills_Func001A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A01Y', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A01Z', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A02I', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A01U', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A01T', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A01V', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A01X', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A020', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A021', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A02L', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A02N', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A02M', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A05B', GetEnumPlayer() )
endfunction

function Trig_Init_Skills_Actions takes nothing returns nothing
    call ForForce( udg_Players, function Trig_Init_Skills_Func001A )
    // Для Фатального удара
    call SetPlayerAbilityAvailableBJ( false, 'A02L', Player(4) )
    call SetPlayerAbilityAvailableBJ( false, 'A02N', Player(4) )
    call SetPlayerAbilityAvailableBJ( false, 'A02M', Player(4) )
    call UnitRemoveAbilityBJ( 'A04W', udg_Hero_mechanic )
    call UnitRemoveAbilityBJ( 'A04R', udg_Hero_mechanic )
    call UnitAddAbilityBJ( 'A01Z', udg_Hero_mechanic )
    call UnitAddAbilityBJ( 'A001', udg_Hero_mechanic )
endfunction

