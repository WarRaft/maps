        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman06, udg_TEXT_Shaman[6], bj_TIMETYPE_SET, 4.00, false )
        call TriggerSleepAction( 7.00 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman07, udg_TEXT_Shaman[7], bj_TIMETYPE_SET, 4.00, false )
        call TriggerSleepAction( 7.00 )
    else
    endif
    // Сообщение Тетинумми
    if ( Trig_Enchanted_crystals_msg_Func010C() ) then
        call UnitAddIndicatorBJ( udg_Hero_mechanic, 100, 100, 100, 0 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic03, udg_TEXT_Mechanic[3], bj_TIMETYPE_SET, 1.00, false )
        call TriggerSleepAction( 3.00 )
        call UnitAddIndicatorBJ( udg_Hero_shaman, 100, 100, 100, 0 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman06, udg_TEXT_Shaman[6], bj_TIMETYPE_SET, 4.00, false )
        call TriggerSleepAction( 7.00 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman07, udg_TEXT_Shaman[7], bj_TIMETYPE_SET, 4.00, false )
        call TriggerSleepAction( 7.00 )
    else
    endif
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 100.00 )
endfunction

