//===========================================================================
// Trigger: Trolls Count
//===========================================================================
function Trig_Trolls_Count_Func003C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'o006' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'n02I' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'n02J' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'o005' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Trolls_Count_Conditions takes nothing returns boolean
    if ( not Trig_Trolls_Count_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Trolls_Count_Func002C takes nothing returns boolean
    if ( not ( GetItemCharges(udg_Boss3_Troll_Item) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Trolls_Count_Actions takes nothing returns nothing
    call SetItemCharges( udg_Boss3_Troll_Item, ( GetItemCharges(udg_Boss3_Troll_Item) - 1 ) )
    if ( Trig_Trolls_Count_Func002C() ) then
        call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_3769" )
        call RemoveItem( udg_Boss3_Troll_Item )
        call DisableTrigger( GetTriggeringTrigger() )
        call DisableTrigger( gg_trg_Troll_Invulnerability )
        call UnitRemoveAbilityBJ( 'A059', udg_UNIT_Boss3_Troll )
        call UnitRemoveAbilityBJ( 'A062', udg_UNIT_Boss3_Troll )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Trolls_Count takes nothing returns nothing
    set gg_trg_Trolls_Count = CreateTrigger(  )
    call DisableTrigger( gg_trg_Trolls_Count )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Trolls_Count, Player(PLAYER_NEUTRAL_AGGRESSIVE), EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Trolls_Count, Condition( function Trig_Trolls_Count_Conditions ) )
    call TriggerAddAction( gg_trg_Trolls_Count, function Trig_Trolls_Count_Actions )
