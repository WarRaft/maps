//===========================================================================
// Trigger: Corpses respawn
//===========================================================================
function Trig_Corpses_respawn_Actions takes nothing returns nothing
    local unit temp_unit
    local location point = GetRandomLocInRect(gg_rct_REG_Corpses_spawn)
    set temp_unit = TeoCreateUnit( Player(bj_PLAYER_NEUTRAL_VICTIM), 'n00W', GetLocationX(point),GetLocationY(point), GetRandomDirectionDeg() )
    call GroupAddUnitSimple( temp_unit, udg_Corpses_Group )
    call SetUnitAnimation( temp_unit, "decay flesh" )
    call SetUnitExploded( temp_unit, true )
    call SetUnitTimeScalePercent( temp_unit, 70.00 )
    // Создание эффекта появления
    call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl", GetUnitX(temp_unit), GetUnitY(temp_unit) ) )
    // Обнуление переменных
    call RemoveLocation(point)
    set point = null
    set temp_unit = null
endfunction

