//===========================================================================
// Trigger: Stone1 Activate
//===========================================================================
function Trig_Stone1_Activate_Func010A takes nothing returns nothing
    call SetCameraQuickPositionLocForPlayer( GetEnumPlayer(), GetUnitLoc(gg_unit_ncop_0093) )
endfunction

function Trig_Stone1_Activate_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    // Любой из камней активирован
    set udg_ResurrectionsStones_condition[0] = true
    // Обнуляем активацию всех камней
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_ResurrectionStones_num
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_ResurrectionsStones_condition[GetForLoopIndexA()] = false
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_ResurrectionsStones_condition[1] = true
    // Меняем цвет круга воскрешения
    call SetUnitColor( udg_ResurrectionCircle[1], PLAYER_COLOR_LIGHT_BLUE )
    call TriggerExecute( gg_trg_Verify_stone_conditions )
    call ForForce( udg_Players, function Trig_Stone1_Activate_Func010A )
endfunction

