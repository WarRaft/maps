    if ( Trig_Repair_Timer_Func001C() ) then
        set udg_Robot_Repair_Bool = false
        call UnitRemoveAbilityBJ( 'A02H', udg_UNIT_Robot )
    else
        call StartTimerBJ( udg_Repair_Timer, false, 0.50 )
    endif
endfunction

