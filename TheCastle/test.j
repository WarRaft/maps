//===========================================================================
// Trigger: Init Boss3
//
// Game_Stage - отвечает за область воскрешения героев, если воскрешение происходит не около Камня воскрешения
// 0 - воскрешение в стартовой области
// 1- воскрешение в конечной области
// 2- воскрешение в альтернативной области
//===========================================================================
function Trig_Init_Boss3_Actions takes nothing returns nothing
    set udg_ResurrectionsStones_condition[0] = false
    set udg_Game_Stage = 1
    // События
    call TriggerExecute( gg_trg_Foggy_Mind_Events )
    call TriggerExecute( gg_trg_Lightning_Storm_Events )
    call TriggerExecute( gg_trg_Chain_Lightning_Events )
    call TriggerExecute( gg_trg_Summon_Skeleton_healers_Events )
    call EnableTrigger( gg_trg_Archmage_AI )
    call SetUnitUserData( udg_UNIT_Boss3_Archmage, 4 )
endfunction

//===========================================================================
function InitTrig_Init_Boss3 takes nothing returns nothing
    set gg_trg_Init_Boss3 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Init_Boss3 )
    call TriggerAddAction( gg_trg_Init_Boss3, function Trig_Init_Boss3_Actions )
endfunction

//===========================================================================
// Trigger: Archmage AI
//
// 1 - Цепная молния
// 2 - Шторм молний
// 3 - Призыв скелетов-целителей
// 4 - Затуманенный разум
//===========================================================================
function Trig_Archmage_AI_Func017Func001C takes nothing returns boolean
    if ( not ( GetUnitUserData(udg_UNIT_Boss3_Archmage) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Archmage_AI_Func017Func002Func001C takes nothing returns boolean
    if ( not ( GetUnitUserData(udg_UNIT_Boss3_Archmage) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Archmage_AI_Func017Func002Func002Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitUserData(udg_UNIT_Boss3_Archmage) == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Archmage_AI_Func017Func002Func002Func001C takes nothing returns boolean
    if ( not ( udg_Archmage_type_attack == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Archmage_AI_Func017Func002Func002Func002C takes nothing returns boolean
    if ( not ( GetUnitUserData(udg_UNIT_Boss3_Archmage) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Archmage_AI_Func017Func002Func002C takes nothing returns boolean
    if ( not ( udg_Archmage_type_attack == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Archmage_AI_Func017Func002C takes nothing returns boolean
    if ( not ( udg_Archmage_type_attack == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Archmage_AI_Func017C takes nothing returns boolean
    if ( not ( udg_Archmage_type_attack == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Archmage_AI_Actions takes nothing returns nothing
    local location archmage_point = GetUnitLoc(udg_UNIT_Boss3_Archmage)
    local location hero_point1 = GetUnitLoc(udg_Hero_mechanic)
    local location hero_point2 = GetUnitLoc(udg_Hero_shaman)
    local location hero_point3 = GetUnitLoc(udg_Hero_warrior)
    local real distance1 = DistanceBetweenPoints(archmage_point, hero_point1)
    local real distance2 = DistanceBetweenPoints(archmage_point, hero_point2)
    local real distance3 = DistanceBetweenPoints(archmage_point, hero_point3)
    if ( distance1 > 600 and distance2 > 600 and distance3 > 600 ) then
        set udg_Archmage_type_attack = GetRandomInt(1, 3)
    else
        if ( distance1 < 200 and distance2 < 200 and distance3 < 200 ) then
            set udg_Archmage_type_attack = GetRandomInt(2, 4)
        else
            set udg_Archmage_type_attack = GetRandomInt(1, 4)
        endif
    endif
    if ( Trig_Archmage_AI_Func017C() ) then
        if ( Trig_Archmage_AI_Func017Func001C() ) then
            call TriggerExecute( GetTriggeringTrigger() )
            return
        else
            call SetUnitUserData( udg_UNIT_Boss3_Archmage, udg_Archmage_type_attack )
            call IssueImmediateOrder( udg_UNIT_Boss3_Archmage, "fanofknives" )
            return
        endif
    else
        if ( Trig_Archmage_AI_Func017Func002C() ) then
            if ( Trig_Archmage_AI_Func017Func002Func001C() ) then
                call TriggerExecute( GetTriggeringTrigger() )
                return
            else
                call SetUnitUserData( udg_UNIT_Boss3_Archmage, udg_Archmage_type_attack )
                call IssueImmediateOrder( udg_UNIT_Boss3_Archmage, "evileye" )
                return
            endif
        else
            if ( Trig_Archmage_AI_Func017Func002Func002C() ) then
                if ( Trig_Archmage_AI_Func017Func002Func002Func002C() ) then
                    call TriggerExecute( GetTriggeringTrigger() )
                    return
                else
                    call SetUnitUserData( udg_UNIT_Boss3_Archmage, udg_Archmage_type_attack )
                    call IssueImmediateOrder( udg_UNIT_Boss3_Archmage, "militia" )
                    return
                endif
            else
                if ( Trig_Archmage_AI_Func017Func002Func002Func001C() ) then
                    if ( Trig_Archmage_AI_Func017Func002Func002Func001Func001C() ) then
                        call TriggerExecute( GetTriggeringTrigger() )
                        return
                    else
                        call SetUnitUserData( udg_UNIT_Boss3_Archmage, udg_Archmage_type_attack )
                        call IssueImmediateOrderBJ( udg_UNIT_Boss3_Archmage, "howlofterror" )
                        return
                    endif
                else
                endif
            endif
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Archmage_AI takes nothing returns nothing
    set gg_trg_Archmage_AI = CreateTrigger(  )
    call DisableTrigger( gg_trg_Archmage_AI )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Archmage_AI, 10.00 )
    call TriggerAddAction( gg_trg_Archmage_AI, function Trig_Archmage_AI_Actions )
endfunction

