//===========================================================================
// Trigger: Robot Generator
//===========================================================================
function Trig_Robot_Generator_Func003Func005Func005Func005C takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Robot_Generator[4] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Robot_Generator_Func003Func005Func005C takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Robot_Generator[3] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Robot_Generator_Func003Func005C takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Robot_Generator[2] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Robot_Generator_Func003C takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Robot_Generator[1] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Robot_Generator_Actions takes nothing returns nothing
    local unit dummy_unit
    call DisableTrigger( GetTriggeringTrigger() )
    if ( Trig_Robot_Generator_Func003C() ) then
        set udg_TempGenerator[1] = udg_Robot_Generator[1]
        set udg_TempGenerator[2] = udg_Robot_Generator[2]
        set udg_TempGenerator[3] = udg_Robot_Generator[3]
        set udg_TempGenerator[4] = udg_Robot_Generator[4]
    else
        if ( Trig_Robot_Generator_Func003Func005C() ) then
            set udg_TempGenerator[1] = udg_Robot_Generator[2]
            set udg_TempGenerator[2] = udg_Robot_Generator[3]
            set udg_TempGenerator[3] = udg_Robot_Generator[4]
            set udg_TempGenerator[4] = udg_Robot_Generator[1]
        else
            if ( Trig_Robot_Generator_Func003Func005Func005C() ) then
                set udg_TempGenerator[1] = udg_Robot_Generator[3]
                set udg_TempGenerator[2] = udg_Robot_Generator[4]
                set udg_TempGenerator[3] = udg_Robot_Generator[1]
                set udg_TempGenerator[4] = udg_Robot_Generator[2]
            else
                if ( Trig_Robot_Generator_Func003Func005Func005Func005C() ) then
                    set udg_TempGenerator[1] = udg_Robot_Generator[4]
                    set udg_TempGenerator[2] = udg_Robot_Generator[1]
                    set udg_TempGenerator[3] = udg_Robot_Generator[2]
                    set udg_TempGenerator[4] = udg_Robot_Generator[3]
                else
                endif
            endif
        endif
    endif
    set dummy_unit = TeoCreateDummyUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'n00X', GetUnitX(udg_TempGenerator[1]), GetUnitY(udg_TempGenerator[1]), 'A02X' )
    call IssueTargetOrder( dummy_unit, "fingerofdeath", udg_TempGenerator[2] )
    call TriggerSleepAction( 0.05 )
    call IssueTargetOrderBJ( udg_TempGenerator[2], "fingerofdeath", udg_TempGenerator[3] )
    call TriggerSleepAction( 0.05 )
    call KillUnit( udg_TempGenerator[2] )
    call IssueTargetOrderBJ( udg_TempGenerator[3], "fingerofdeath", udg_TempGenerator[4] )
    call TriggerSleepAction( 0.05 )
    call KillUnit( udg_TempGenerator[3] )
    call TriggerSleepAction( 0.05 )
    call KillUnit( udg_TempGenerator[4] )
    call KillUnit( udg_UNIT_Robot )
    call TriggerExecute( gg_trg_Boss2_Elevator )
endfunction

