function Trig_Book_Effect_Actions takes nothing returns nothing
    local location point
    set point = Location(GetRectCenterX(gg_rct_REG_Fire1_Top), GetRectCenterY(gg_rct_REG_Fire1_Top))
    call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
    call RemoveLocation(point)
    set point = Location(GetRectCenterX(gg_rct_REG_Fire1_Mid), GetRectCenterY(gg_rct_REG_Fire1_Mid))
    call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
    call RemoveLocation(point)
    set point = Location(GetRectCenterX(gg_rct_REG_Fire1_Bot), GetRectCenterY(gg_rct_REG_Fire1_Bot))
    call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
    call RemoveLocation(point)
    call TriggerSleepAction( 0.01 )
    set point = Location(GetRectCenterX(gg_rct_REG_Fire2_Top), GetRectCenterY(gg_rct_REG_Fire2_Top))
    call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
    call RemoveLocation(point)
