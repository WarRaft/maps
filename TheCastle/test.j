//===========================================================================
function Trig_Array_of_Items_Func001C takes nothing returns boolean
    if ( ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_PERMANENT ) ) then
        return true
    endif
    if ( ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_CHARGED ) ) then
        return true
    endif
    if ( ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_POWERUP ) ) then
        return true
    endif
    if ( ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_ARTIFACT ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I00K' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I00Z' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I00Y' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I010' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I00X' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I00W' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Array_of_Items_Conditions takes nothing returns boolean
    if ( not Trig_Array_of_Items_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Array_of_Items_Func003Func002A takes nothing returns nothing
    call SetPlayerStateBJ( GetEnumPlayer(), PLAYER_STATE_RESOURCE_LUMBER, ( udg_Count_Life - 1 ) )
endfunction

function Trig_Array_of_Items_Func003C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I012' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Array_of_Items_Func006Func001C takes nothing returns boolean
    if ( not ( GetManipulatedItem() == udg_All_Items[GetForLoopIndexA()] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Array_of_Items_Actions takes nothing returns nothing
    // Руна Воскрешения
    if ( Trig_Array_of_Items_Func003C() ) then
        set udg_Count_Life = ( udg_Count_Life + 1 )
        call ForForce( udg_Players, function Trig_Array_of_Items_Func003Func002A )
        return
    else
    endif
    set udg_All_Items_num = ( udg_All_Items_num + 1 )
    set udg_All_Items[udg_All_Items_num] = GetManipulatedItem()
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = ( udg_All_Items_num - 1 )
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Array_of_Items_Func006Func001C() ) then
            set udg_All_Items_num = ( udg_All_Items_num - 1 )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

