    call DisableTrigger( gg_trg_Foggy_Mind_Object_Mechanic )
    call DisableTrigger( gg_trg_Foggy_Mind_Object_Shaman )
    call DisableTrigger( gg_trg_Foggy_Mind_Object_Warrior )
    call DisableTrigger( gg_trg_Foggy_Mind_Point_Mechanic )
    call DisableTrigger( gg_trg_Foggy_Mind_Point_Shaman )
    call DisableTrigger( gg_trg_Foggy_Mind_Point_Warrior )
endfunction

