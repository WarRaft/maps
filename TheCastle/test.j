//===========================================================================
// Trigger: Portal Buttons Checking
//===========================================================================
function Trig_Portal_Buttons_Checking_Func001Func010C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(udg_Button[14]) == false ) ) then
        return false
    endif
    if ( not ( IsDestructableAliveBJ(udg_Button[15]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Buttons_Checking_Func001C takes nothing returns boolean
    if ( not Trig_Portal_Buttons_Checking_Func001Func010C() ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Buttons_Checking_Actions takes nothing returns nothing
    if ( Trig_Portal_Buttons_Checking_Func001C() ) then
        // Открываем портал № 19
        call TeoPortalRevival(19)
        call EnableTrigger( gg_trg_Portal19 )
        call EnableTrigger( gg_trg_Portal20 )
    else
        call KillDestructable( LoadDestructableHandleBJ(19, 1, GetLastCreatedHashtableBJ()) )
        call KillDestructable( LoadDestructableHandleBJ(19, 2, GetLastCreatedHashtableBJ()) )
        call DisableTrigger( gg_trg_Portal19 )
        call DisableTrigger( gg_trg_Portal20 )
        set udg_Portal_Activity_Bool[19] = false
    endif
endfunction

