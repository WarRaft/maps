        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS2_Ending )
        return
    endif
    // Сообщение Тетинумми
    if ( Trig_Cinematic_BOSS2_Func043C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic08, udg_TEXT_Mechanic[8], bj_TIMETYPE_SET, 9.00, false )
    else
