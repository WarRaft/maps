//===========================================================================
function Trig_gm_Conditions takes nothing returns boolean
    if ( not ( SubStringBJ(GetEventPlayerChatString(), 1, 4) == "-gm " ) ) then
        return false
    endif
    return true
endfunction

function Trig_gm_Func001Func002C takes nothing returns boolean
    if ( not ( S2I(SubStringBJ(GetEventPlayerChatString(), 5, 2)) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_gm_Func001C takes nothing returns boolean
    if ( not ( S2I(SubStringBJ(GetEventPlayerChatString(), 5, 2)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_gm_Actions takes nothing returns nothing
    if ( Trig_gm_Func001C() ) then
        call TriggerExecute( gg_trg_HandleCounter )
    else
        if ( Trig_gm_Func001Func002C() ) then
            call DestroyLeaderboardBJ( udg_HandleBoard )
