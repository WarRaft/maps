//===========================================================================
// Trigger: Cinematic Traveler
//
// Как хорошо, что я встретил вас, а не бандитов. Не откажите в помощи бедному страннику.
// Моя бедная ящерка! Моя Дори! Её что-то спугнуло и она убежала. Я видел, как она пролезла под стену Замка.
// Если вы вдруг встретите её, угостите листьями этого растения. Она должна сразу вспомнить меня и вернуться. Только, пожалуйста, аккуратнее! Дори сильно напугана и может быть агрессивной!
// К сожалению, мне нечего вам предложить. Но если вы поможете мне, то я буду молиться за вас всю свою жизнь!
//===========================================================================
function Trig_Cinematic_Traveler_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Traveler_Func019A takes nothing returns nothing
    call ClearSelectionForPlayer( GetEnumPlayer() )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Traveler1, GetEnumPlayer(), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Traveler2, GetEnumPlayer(), 60.00 )
endfunction

