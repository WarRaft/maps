function Trig_Library_Pedestal_put_a_Book_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I02O' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Library_Pedestal_put_a_Book_Func003C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetBuyingUnit(), 'I02P') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Library_Pedestal_put_a_Book_Actions takes nothing returns nothing
    if ( Trig_Library_Pedestal_put_a_Book_Func003C() ) then
        call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_B00S_7958 )
        call SetUnitAnimation( GetTriggerUnit(), "stand" )
        call RemoveItem( GetItemOfTypeFromUnitBJ(GetBuyingUnit(), 'I02P') )
    else
        call AddItemToStockBJ( 'I02O', GetTriggerUnit(), 1, 1 )
        call PlaySoundOnUnitBJ( gg_snd_Error, 100, GetBuyingUnit() )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetBuyingUnit())), "TRIGSTR_4038" )
    endif
endfunction

