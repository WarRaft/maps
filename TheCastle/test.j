function InitTrig_Lightning_Storm_timer takes nothing returns nothing
    set gg_trg_Lightning_Storm_timer = CreateTrigger(  )
    call DisableTrigger( gg_trg_Lightning_Storm_timer )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Lightning_Storm_timer, udg_Lighting_Storm_Timer )
    call TriggerAddAction( gg_trg_Lightning_Storm_timer, function Trig_Lightning_Storm_timer_Actions )
