function Trig_Exchange_Actions takes nothing returns nothing
    if ( Trig_Exchange_Func001C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'rlif', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func002C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'rde1', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func003C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'gcel', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func004C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'bspd', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func005C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'I008', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func006C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'I002', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func007C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'prvt', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func008C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'stwa', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func009C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'I01B', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func010C() ) then
        call RemoveItem( GetSoldItem() )
        call RemoveItemFromStockBJ( 'I01P', udg_UNIT_Marauder )
        call UnitAddItemByIdSwapped( 'I00C', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func011C() ) then
        call RemoveItem( GetSoldItem() )
        call RemoveItemFromStockBJ( 'I01Q', udg_UNIT_Marauder )
        call UnitAddItemByIdSwapped( 'I00B', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func012C() ) then
        call RemoveItem( GetSoldItem() )
        call RemoveItemFromStockBJ( 'I01R', udg_UNIT_Marauder )
        call UnitAddItemByIdSwapped( 'I00D', GetBuyingUnit() )
        return
    else
    endif
    // Предметы 2 уровня
    if ( Trig_Exchange_Func014C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'I006', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func015C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'I009', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func016C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'I013', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func017C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'I00F', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func018C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'I005', GetBuyingUnit() )
        return
    else
    endif
    if ( Trig_Exchange_Func019C() ) then
        call RemoveItem( GetSoldItem() )
        call UnitAddItemByIdSwapped( 'I00H', GetBuyingUnit() )
        return
    else
    endif
