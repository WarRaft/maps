//===========================================================================
// Trigger: WaterGuard Security
//===========================================================================
function Trig_WaterGuard_Security_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_UNIT_WaterGuard) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_WaterGuard_Security_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_WaterGuard_Worker) <= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WaterGuard_Security_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_WaterGuard_Warrior) <= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WaterGuard_Security_Actions takes nothing returns nothing
    local unit new_unit
    if ( Trig_WaterGuard_Security_Func002C() ) then
        set new_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'n02X', -1210, -12400, 180 )
        call UnitApplyTimedLife( new_unit, 'BTLF', 300 )
        call GroupAddUnitSimple( new_unit, udg_WaterGuard_Worker )
        // Создание эффекта появления
        call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl", GetUnitX(new_unit), GetUnitY(new_unit) ) )
    else
    endif
    if ( Trig_WaterGuard_Security_Func003C() ) then
        set new_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'n02Y', -2640, -12400, 0 )
        call UnitApplyTimedLife( new_unit, 'BTLF', 300 )
        call GroupAddUnitSimple( new_unit, udg_WaterGuard_Warrior )
        // Создание эффекта появления
        call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl", GetUnitX(new_unit), GetUnitY(new_unit) ) )
    else
    endif
    // Обнуление переменных
    set new_unit = null
endfunction

//===========================================================================
function InitTrig_WaterGuard_Security takes nothing returns nothing
    set gg_trg_WaterGuard_Security = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_WaterGuard_Security, 3.00 )
    call TriggerAddCondition( gg_trg_WaterGuard_Security, Condition( function Trig_WaterGuard_Security_Conditions ) )
    call TriggerAddAction( gg_trg_WaterGuard_Security, function Trig_WaterGuard_Security_Actions )
endfunction

