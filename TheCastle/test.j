//===========================================================================
function Trig_Activation_Frenzy_and_Beast_Ramage_Func003C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_Hero_warrior) < 30.00 ) ) then
        return false
    endif
    if ( not ( udg_Frenzy_Bool == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Activation_Frenzy_and_Beast_Ramage_Func004C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_Hero_warrior) >= 30.00 ) ) then
        return false
    endif
    if ( not ( udg_Frenzy_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Activation_Frenzy_and_Beast_Ramage_Func006C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_Hero_warrior) > 30.00 ) ) then
        return false
    endif
    if ( not ( udg_Beast_Rampage_bool == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Activation_Frenzy_and_Beast_Ramage_Func007C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_Hero_warrior) <= 30.00 ) ) then
        return false
    endif
    if ( not ( udg_Beast_Rampage_bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Activation_Frenzy_and_Beast_Ramage_Actions takes nothing returns nothing
    local player dummy_player = GetOwningPlayer(udg_Hero_warrior)
    // Проверяем Безумие
    if ( Trig_Activation_Frenzy_and_Beast_Ramage_Func003C() ) then
        set udg_Frenzy_Bool = true
        set udg_Frenzy_Unit = CreateUnit(dummy_player, 'n01I', 6280.00, 13000.00, 0)
    else
    endif
    if ( Trig_Activation_Frenzy_and_Beast_Ramage_Func004C() ) then
        set udg_Frenzy_Bool = false
        call RemoveUnit( udg_Frenzy_Unit )
    else
    endif
    // Проверяем Буйство зверя
    if ( Trig_Activation_Frenzy_and_Beast_Ramage_Func006C() ) then
        set udg_Beast_Rampage_bool = true
        set udg_Beast_Rampage_Unit = CreateUnit(dummy_player, 'n01H', 6280.00, 13000.00, 0)
    else
    endif
    if ( Trig_Activation_Frenzy_and_Beast_Ramage_Func007C() ) then
        set udg_Beast_Rampage_bool = false
        call RemoveUnit( udg_Beast_Rampage_Unit )
    else
    endif
    set dummy_player = null
endfunction

