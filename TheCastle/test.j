function Trig_Fire_Golems_Actions takes nothing returns nothing
    local unit dummy_unit
    local real random_x = GetRandomReal( GetRectMinX(gg_rct_REG_Fire_Golems), GetRectMaxX(gg_rct_REG_Fire_Golems) )
    local real random_y = GetRandomReal( GetRectMinY(gg_rct_REG_Fire_Golems), GetRectMaxY(gg_rct_REG_Fire_Golems) )
    set dummy_unit = TeoCreateDummyUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'n00X', random_x,random_y, 'A039' )
    call IssueImmediateOrder( dummy_unit, "lavamonster" )
    // Обнуление переменных
    set dummy_unit = null
endfunction

