//===========================================================================
// Trigger: Lever05
//
// Рычаг для ворот от Лабиринта
//===========================================================================
function Trig_Lever05_Func008Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B01M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lever05_Func008A takes nothing returns nothing
    if ( Trig_Lever05_Func008Func001C() ) then
        call RemoveDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_Lever05_Actions takes nothing returns nothing
    call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_LTg3_0447 )
    call DisableTrigger( gg_trg_Shadow_respawn )
    call SetDoodadAnimationBJ( "stand", 'LOlp', 1000.00, Location(0.00, 9500.00) )
    // Свет от фонаря
    call CreateNUnitsAtLoc( 1, 'n00F', Player(bj_PLAYER_NEUTRAL_EXTRA), Location(0, 9500.00), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.50, 'BTLF', GetLastCreatedUnit() )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "flamestrike", Location(0, 9500.00) )
    call EnumDestructablesInRectAll( gg_rct_REG_Destructable06, function Trig_Lever05_Func008A )
    // Убираем ограничение опыта (защита от фарма)
    call SuspendHeroXPBJ( true, udg_Hero_warrior )
    call SuspendHeroXPBJ( true, udg_Hero_shaman )
    call SuspendHeroXPBJ( true, udg_Hero_mechanic )
    // См. папку "Ограничение опыта"
    call DisableTrigger( gg_trg_ExpBlock2 )
endfunction

