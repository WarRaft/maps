// Trigger: Bridge Open
//===========================================================================
function Trig_Bridge_Open_Func001Func009Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bridge_Open_Func001Func009A takes nothing returns nothing
    if ( Trig_Bridge_Open_Func001Func009Func001C() ) then
        call RemoveDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_Bridge_Open_Func001C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Altar1) == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_Altar2) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bridge_Open_Actions takes nothing returns nothing
    if ( Trig_Bridge_Open_Func001C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call TriggerSleepAction( 1.00 )
        call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_u00A_0522, "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl" )
        call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_u00A_0520, "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl" )
        call TriggerSleepAction( 1.00 )
        call SetUnitAnimation( gg_unit_u00A_0522, "stand" )
        call SetUnitAnimation( gg_unit_u00A_0520, "stand" )
        call DestructableRestoreLife( gg_dest_DTs2_8189, 2500.00, true )
        call EnumDestructablesInRectAll( gg_rct_REG_Destructable11, function Trig_Bridge_Open_Func001Func009A )
    else
    endif
endfunction

