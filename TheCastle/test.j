endfunction

function Trig_Boss1_AI_Func002Func003Func001C takes nothing returns boolean
    if ( not ( udg_Boss1_stage == 2 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_UNIT_Boss1, 'B000') == false ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_Cooldown_Boss1) <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss1_AI_Func002Func003C takes nothing returns boolean
    if ( not ( udg_Trigger_for_Boss1 == 15 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss1_AI_Func002C takes nothing returns boolean
    if ( not ( IsUnitGroupEmptyBJ(udg_Units_in_the_boss1_area) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_UNIT_Boss1) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss1_AI_Actions takes nothing returns nothing
    local location point = GetUnitLoc(GroupPickRandomUnit(udg_Units_in_the_boss1_area))
    if ( Trig_Boss1_AI_Func002C() ) then
        set udg_Trigger_for_Boss1 = ( udg_Trigger_for_Boss1 + 1 )
        if ( Trig_Boss1_AI_Func002Func003C() ) then
            set udg_Trigger_for_Boss1 = 0
            call IssueImmediateOrderBJ( udg_UNIT_Boss1, "lavamonster" )
        else
            if ( Trig_Boss1_AI_Func002Func003Func001C() ) then
                // Активируем Огненный щит для Повелителя Огня
                call IssueTargetOrderBJ( udg_UNIT_Boss1, "antimagicshell", udg_UNIT_Boss1 )
                call StartTimerBJ( udg_Cooldown_Boss1, false, 15.00 )
            else
                call IssuePointOrder( udg_UNIT_Boss1, "flamestrike", GetLocationX(point), GetLocationY(point) )
            endif
        endif
    else
        if ( Trig_Boss1_AI_Func002Func001C() ) then
            // Активируем Огненный щит для Повелителя Огня
            call IssueTargetOrderBJ( udg_UNIT_Boss1, "antimagicshell", udg_UNIT_Boss1 )
            call StartTimerBJ( udg_Cooldown_Boss1, false, 15.00 )
        else
            call DoNothing(  )
        endif
    endif
    // Обнуление переменных
    call RemoveLocation(point)
    set point = null
endfunction

