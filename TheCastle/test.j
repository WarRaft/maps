function Trig_Cinematic_Lattice1_Actions takes nothing returns nothing
    set udg_Cinematic_skipped = false
    // НАЧАЛО СЪЁМОК
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call ShowInterfaceForceOff( GetPlayersAll(), 0.00 )
    call TriggerSleepAction( 0.40 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( true )
    call IssueImmediateOrderBJ( udg_Hero_mechanic, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_shaman, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_warrior, "stop" )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.00 )
    call CreateFogModifierRadiusLocBJ( true, Player(0), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_REG_Point_of_View4), 800.00 )
    set udg_Eye[4] = GetLastCreatedFogModifier()
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Lattice1_Func017A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_Lattice1_Func022C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Lattice1_Ending )
        return
    endif
    if ( Trig_Cinematic_Lattice1_Func023C() ) then
        loop
            exitwhen ( Trig_Cinematic_Lattice1_Func023Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Lattice1_Ending )
        return
    endif
    call KillDestructable( gg_dest_B00S_0760 )
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_Lattice1_Func026C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Lattice1_Ending )
        return
    endif
    if ( Trig_Cinematic_Lattice1_Func027C() ) then
        loop
            exitwhen ( Trig_Cinematic_Lattice1_Func027Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Lattice1_Ending )
        return
    endif
    // ЗАВЕРШЕНИЕ СЪЁМОК
    call TriggerExecute( gg_trg_Cinematic_Lattice1_Ending )
endfunction

