function Trig_Cinematic_BOSS1_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Cinematic_skipped = false
    // НАЧАЛО СЪЁМОК
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.40 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( true )
    call IssueImmediateOrderBJ( udg_Hero_mechanic, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_shaman, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_warrior, "stop" )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call StopMusicBJ( false )
    call PlayMusicBJ( gg_snd_Boss1 )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.00 )
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_BOSS1_Func019A )
    // Ввод изображения
    call CinematicModeExBJ( true, GetPlayersAll(), 0.60 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_BOSS1_Func025C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS1_Func026C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS1_Func026Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Сообщение Акнеладу
    if ( Trig_Cinematic_BOSS1_Func028C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman02, udg_TEXT_Shaman[2], bj_TIMETYPE_SET, 6.50, false )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Таймер ожидания 8 с.
    if ( Trig_Cinematic_BOSS1_Func030C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 8.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS1_Func031C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS1_Func031Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Сообщение Тетинумми 1
    if ( Trig_Cinematic_BOSS1_Func033C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, "TRIGSTR_2437", gg_snd_Mechanic02, udg_TEXT_Mechanic[2], bj_TIMETYPE_SET, 7.50, false )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_BOSS1_Func035C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS1_Func036C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS1_Func036Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Смена камеры
    if ( Trig_Cinematic_BOSS1_Func038C() ) then
        call ForForce( udg_Players, function Trig_Cinematic_BOSS1_Func038Func001A )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Таймер ожидания 3 с.
    if ( Trig_Cinematic_BOSS1_Func040C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 3.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS1_Func041C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS1_Func041Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Смена камеры
    if ( Trig_Cinematic_BOSS1_Func043C() ) then
        call ForForce( udg_Players, function Trig_Cinematic_BOSS1_Func043Func001A )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Таймер ожидания 3.5 с.
    if ( Trig_Cinematic_BOSS1_Func045C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 3.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS1_Func046C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS1_Func046Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Смена камеры
    if ( Trig_Cinematic_BOSS1_Func048C() ) then
        call ForForce( udg_Players, function Trig_Cinematic_BOSS1_Func048Func001A )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    call TriggerSleepAction( 0.30 )
    // Сообщение Тетинумми 2
    if ( Trig_Cinematic_BOSS1_Func051C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic05, udg_TEXT_Mechanic[5], bj_TIMETYPE_SET, 9.50, false )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Таймер ожидания 4 с.
    if ( Trig_Cinematic_BOSS1_Func053C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 4.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS1_Func054C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS1_Func054Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Смена камеры
    if ( Trig_Cinematic_BOSS1_Func056C() ) then
        call ForForce( udg_Players, function Trig_Cinematic_BOSS1_Func056Func001A )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Таймер ожидания 4 с.
    if ( Trig_Cinematic_BOSS1_Func058C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 4.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS1_Func059C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS1_Func059Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Смена камеры
    if ( Trig_Cinematic_BOSS1_Func061C() ) then
        call ForForce( udg_Players, function Trig_Cinematic_BOSS1_Func061Func001A )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // Таймер ожидания 3 с.
    if ( Trig_Cinematic_BOSS1_Func063C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 3.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS1_Func064C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS1_Func064Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
        return
    endif
    // ЗАВЕРШЕНИЕ СЪЁМОК
    call TriggerExecute( gg_trg_Cinematic_BOSS1_Ending )
endfunction

//===========================================================================
function InitTrig_Cinematic_BOSS1 takes nothing returns nothing
    set gg_trg_Cinematic_BOSS1 = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Cinematic_BOSS1, gg_rct_REG_Boss1_Intro )
    call TriggerAddCondition( gg_trg_Cinematic_BOSS1, Condition( function Trig_Cinematic_BOSS1_Conditions ) )
    call TriggerAddAction( gg_trg_Cinematic_BOSS1, function Trig_Cinematic_BOSS1_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic BOSS1 Ending
//===========================================================================
function Trig_Cinematic_BOSS1_Ending_Func009A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Boss1_09, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_BOSS1_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.30 )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_BOSS1_Ending_Func009A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call CinematicModeExBJ( false, GetPlayersAll(), 0.60 )
endfunction

//===========================================================================
function InitTrig_Cinematic_BOSS1_Ending takes nothing returns nothing
    set gg_trg_Cinematic_BOSS1_Ending = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_BOSS1_Ending )
    call TriggerAddAction( gg_trg_Cinematic_BOSS1_Ending, function Trig_Cinematic_BOSS1_Ending_Actions )
endfunction

