//===========================================================================
// Trigger: Death of all Bosses
//===========================================================================
function Trig_Death_of_all_Bosses_Func001Func004Func001A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
endfunction

function Trig_Death_of_all_Bosses_Func001C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Death_of_Orc) == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_Death_of_Goblin) == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_Death_of_Troll) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_of_all_Bosses_Actions takes nothing returns nothing
    if ( Trig_Death_of_all_Bosses_Func001C() ) then
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = udg_Boss3_NumMonsters
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call ForGroupBJ( udg_Boss3_MonsterGroups[GetForLoopIndexA()], function Trig_Death_of_all_Bosses_Func001Func004Func001A )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        call TriggerExecute( gg_trg_Cinematic_Victory_alternate )
    else
    endif
endfunction

