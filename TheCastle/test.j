//===========================================================================
// Trigger: Teleportation
//===========================================================================
function Trig_Teleportation_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I029' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Teleportation_Actions takes nothing returns nothing
    local unit hero_unit = GetBuyingUnit()
    local real hero_x = GetUnitX (hero_unit)
    local real hero_y = GetUnitY (hero_unit)
    call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", hero_x, hero_y ))
    call AddItemToStockBJ( 'I029', gg_unit_n022_0203, 0, 1 )
    call TriggerSleepAction( 0.20 )
    call SetUnitPosition(hero_unit, 8060, -12670 )
    call SetUnitFacing(hero_unit, 90)
    call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", GetUnitX (hero_unit), GetUnitY (hero_unit) ))
    call PanCameraToTimedLocForPlayer( GetOwningPlayer(GetBuyingUnit()), GetUnitLoc(GetBuyingUnit()), 0 )
    // Обнуление переменных
    set hero_unit = null
endfunction

//===========================================================================
function InitTrig_Teleportation takes nothing returns nothing
    set gg_trg_Teleportation = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Teleportation, Player(PLAYER_NEUTRAL_PASSIVE), EVENT_PLAYER_UNIT_SELL_ITEM )
    call TriggerAddCondition( gg_trg_Teleportation, Condition( function Trig_Teleportation_Conditions ) )
    call TriggerAddAction( gg_trg_Teleportation, function Trig_Teleportation_Actions )
endfunction

