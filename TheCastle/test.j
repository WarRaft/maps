// Trigger: Robots respawn
//===========================================================================
function Trig_Robots_respawn_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_UNIT_Boss2) == true ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Robots_Group) < 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Robots_respawn_Actions takes nothing returns nothing
    local unit robot_unit
    local location point = GetUnitLoc(udg_UNIT_Boss2)
    set robot_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'n01J', GetLocationX(point),GetLocationY(point), 0.00 )
    call GroupAddUnitSimple( robot_unit, udg_Robots_Group )
    // Создание эффекта появления
    call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl", GetUnitX(robot_unit), GetUnitY(robot_unit) ) )
    // Обнуление переменных
    call RemoveLocation(point)
    set point = null
    set robot_unit = null
endfunction

