    local location point_target = GetOrderPointLoc()
    local location new_point_target
    local real angle = AngleBetweenPoints(point_hero, point_target)
    local real distance = DistanceBetweenPoints(point_hero, point_target)
    call DisableTrigger( GetTriggeringTrigger() )
    set angle = 180 + angle
    set new_point_target = PolarProjectionBJ(point_hero, distance, angle)
    call IssuePointOrderLoc( hero, "move", new_point_target )
    call EnableTrigger( GetTriggeringTrigger() )
    // Обнуление переменных
    call RemoveLocation(point_hero)
    call RemoveLocation(point_target)
    call RemoveLocation(new_point_target)
    set point_hero = null
    set point_target = null
    set new_point_target = null
    set hero = null
endfunction

