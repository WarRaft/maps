//===========================================================================
// Trigger: Fire Execution
//
// Включается триггером Switch в папке "Переключатели"
//===========================================================================
function Trig_Fire_Execution_Func008C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_UNIT_Devastator) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fire_Execution_Func015C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fire_Execution_Actions takes nothing returns nothing
    local unit dummy_unit
    local unit dummy_unit2
    local real x = 9730
    local real y = 3830
    set dummy_unit = TeoCreateDummyUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'n00X', x, y, 'A016' )
    call IssuePointOrder( dummy_unit, "flamestrike", x, y )
    call SetDoodadAnimationBJ( "stand", 'D04K', 1000.00, Location(9850.00, 3870.00) )
    if ( Trig_Fire_Execution_Func008C() ) then
        call FogModifierStart( udg_Eye[2] )
    else
    endif
    // Обнуление переменных
    set dummy_unit = null
    call TriggerSleepAction( 2.00 )
    call FogModifierStop( udg_Eye[2] )
    call TriggerSleepAction( 1.00 )
    call SetDoodadAnimationBJ( "death", 'D04K', 1000.00, Location(9850.00, 3870.00) )
    if ( Trig_Fire_Execution_Func015C() ) then
        call TriggerExecute( GetTriggeringTrigger() )
    else
    endif
endfunction

