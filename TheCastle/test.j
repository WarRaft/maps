function Trig_Boss1_AI_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Boss1_stage == 2 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_UNIT_Boss1, 'B000') == false ) ) then
        return false
