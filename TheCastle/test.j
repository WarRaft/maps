    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
        return
    endif
    call ClearTextMessagesBJ( GetPlayersAll() )
    call TriggerSleepAction( 0.20 )
    // Титры 2
    if ( Trig_Cinematic_Victory_Func064C() ) then
        call DisplayTimedTextToForce( GetPlayersAll(), 6.00, "TRIGSTR_4417" )
