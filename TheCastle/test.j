//===========================================================================
// Trigger: Runes Buttons Checking
//===========================================================================
function Trig_Runes_Buttons_Checking_Func001Func016Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B01M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runes_Buttons_Checking_Func001Func016A takes nothing returns nothing
    if ( Trig_Runes_Buttons_Checking_Func001Func016Func001C() ) then
        call RemoveDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_Runes_Buttons_Checking_Func001Func019C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(udg_Button[1]) == false ) ) then
        return false
    endif
    if ( not ( IsDestructableAliveBJ(udg_Button[2]) == false ) ) then
        return false
    endif
    if ( not ( IsDestructableAliveBJ(udg_Button[3]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runes_Buttons_Checking_Func001C takes nothing returns boolean
    if ( not Trig_Runes_Buttons_Checking_Func001Func019C() ) then
        return false
    endif
    return true
endfunction

function Trig_Runes_Buttons_Checking_Actions takes nothing returns nothing
    if ( Trig_Runes_Buttons_Checking_Func001C() ) then
        call DisableTrigger( gg_trg_Runes_Button1_Entrance )
        call DisableTrigger( gg_trg_Runes_Button1_Exit )
        call DisableTrigger( gg_trg_Runes_Button2_Entrance )
        call DisableTrigger( gg_trg_Runes_Button2_Exit )
        call DisableTrigger( gg_trg_Runes_Button3_Entrance )
        call DisableTrigger( gg_trg_Runes_Button3_Exit )
        call TriggerSleepAction( 0.50 )
        call PlaySoundBJ( gg_snd_BattleNetDoorsStereo2 )
        call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_B004_0364 )
        call TriggerSleepAction( 1.00 )
        // Открываем порталы для возврата № 1 и № 2
        set udg_Portal_num = 1
        call TriggerExecute( gg_trg_PORTAL_OPENING )
        set udg_Portal_num = 2
        call TriggerExecute( gg_trg_PORTAL_OPENING )
        call EnumDestructablesInRectAll( gg_rct_REG_Runes, function Trig_Runes_Buttons_Checking_Func001Func016A )
        call RemoveUnit( udg_UNIT_Traveler )
        call RemoveUnit( udg_UNIT_Lizard )
    else
    endif
endfunction

