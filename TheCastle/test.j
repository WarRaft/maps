    set gg_trg_Button4_Checking_Code = CreateTrigger(  )
    call DisableTrigger( gg_trg_Button4_Checking_Code )
    call TriggerAddAction( gg_trg_Button4_Checking_Code, function Trig_Button4_Checking_Code_Actions )
endfunction

//===========================================================================
// Trigger: NumCode1
//===========================================================================
function Trig_NumCode1_Func001C takes nothing returns boolean
    if ( not ( udg_Runes_conditions[1] < udg_Runes_num ) ) then
        return false
    endif
    return true
endfunction

function Trig_NumCode1_Actions takes nothing returns nothing
    if ( Trig_NumCode1_Func001C() ) then
        call RemoveDestructable( udg_Runes1[udg_Runes_conditions[1]] )
        call CreateDestructableLoc( udg_RunesTypes[( udg_Runes_conditions[1] + 1 )], GetRectCenter(gg_rct_REG_Rune_Password1), 90.00, 1, 0 )
        set udg_Runes1[( udg_Runes_conditions[1] + 1 )] = GetLastCreatedDestructable()
        set udg_Runes_conditions[1] = ( udg_Runes_conditions[1] + 1 )
    else
        call RemoveDestructable( udg_Runes1[udg_Runes_num] )
        call CreateDestructableLoc( udg_RunesTypes[1], GetRectCenter(gg_rct_REG_Rune_Password1), 90.00, 1, 0 )
        set udg_Runes1[1] = GetLastCreatedDestructable()
        set udg_Runes_conditions[1] = 1
    endif
    set udg_Lighting = false
    call TriggerExecute( gg_trg_Button4_Checking_Code )
    call TriggerSleepAction( 1.00 )
    call DestructableRestoreLife( gg_dest_B00E_0755, 5.00, true )
endfunction

