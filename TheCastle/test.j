function Trig_Found_Note_Func002Func001C takes nothing returns boolean
    if ( not ( GetManipulatedItem() == udg_Note[GetForLoopIndexB()] ) ) then
        return false
    endif
    if ( not ( GetManipulatedItem() != null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Found_Note_Actions takes nothing returns nothing
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = udg_Note_num
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        if ( Trig_Found_Note_Func002Func001C() ) then
            set udg_Note_count = ( udg_Note_count + 1 )
            set udg_Note[GetForLoopIndexB()] = null
            call TriggerExecute( gg_trg_Note_Msg )
        else
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
endfunction

