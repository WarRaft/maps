//===========================================================================
// Trigger: Traps Timer
//===========================================================================
function Trig_Traps_Timer_Func001Func002Func001Func005A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
endfunction

function Trig_Traps_Timer_Func001Func002Func001C takes nothing returns boolean
    if ( not ( udg_Trap_Bool[udg_Traps_count] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Traps_Timer_Func001Func002C takes nothing returns boolean
    if ( not ( udg_TrapFrequence[udg_Traps_count] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Traps_Timer_Actions takes nothing returns nothing
    set udg_Traps_count = 1
    loop
        exitwhen udg_Traps_count > udg_NumTraps
        set udg_TrapFrequence[udg_Traps_count] = ( udg_TrapFrequence[udg_Traps_count] - 1 )
        if ( Trig_Traps_Timer_Func001Func002C() ) then
            if ( Trig_Traps_Timer_Func001Func002Func001C() ) then
                call GroupEnumUnitsInRect ( udg_Trap_Units, udg_TrapRegion[udg_Traps_count], null )
                call ForGroupBJ( udg_Trap_Units, function Trig_Traps_Timer_Func001Func002Func001Func005A )
                call DestructableRestoreLife( udg_Traps[udg_Traps_count], 500.00, true )
                call DestructableRestoreLife( udg_TrapBlock[udg_Traps_count], 500.00, false )
                set udg_Trap_Bool[udg_Traps_count] = false
                call GroupClear( udg_Trap_Units )
            else
                call KillDestructable( udg_Traps[udg_Traps_count] )
                call KillDestructable( udg_TrapBlock[udg_Traps_count] )
                set udg_Trap_Bool[udg_Traps_count] = true
            endif
            set udg_TrapFrequence[udg_Traps_count] = udg_InitialTrapsFrequence[udg_Traps_count]
        else
        endif
        set udg_Traps_count = udg_Traps_count + 1
    endloop
endfunction

