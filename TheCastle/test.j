    call TriggerAddAction( gg_trg_Cinematic_Marauder_Ending, function Trig_Cinematic_Marauder_Ending_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Prisoner1
//
// Поверить не могу своим глазам! Я думал, что меня никто и никогда здесь не найдёт.
// Меня посадили сюда на несколько месяцев за небольшие эксперименты с тёмной магией! Спустя какое то время ко мне перестали заходить охранники. Мне было очень страшно . . . Я был уверен, что в Замке никого не осталось . . . Но через некоторое время пришли они . . . чудовища . . .
// Я смог выжить благодаря своим магическим навыкам. Но я не в состоянии был открыть решетку. И теперь Вы открыли её. Я ждал этого два года! Спасибо Вам! Но могу я просить Вас о помощи? Я слишком слаб, чтобы самостоятельно выбраться из Замка.
// В соседней комнате должна находиться моя Сфера Теней. С её помощью я смогу выбраться отсюда! Умоляю Вас, принесите её мне!  
//===========================================================================
function Trig_Cinematic_Prisoner1_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

