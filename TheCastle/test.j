    if ( Trig_Lever14_Activation_Func001C() ) then
        call PlaySoundBJ( gg_snd_QuestNew )
        call DestructableRestoreLife( gg_dest_DTs2_0673, 2500.00, true )
        call DestructableRestoreLife( gg_dest_DTs2_0672, 2500.00, true )
