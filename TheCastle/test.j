    if ( Trig_Cinematic_Traveler_Func038C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Traveler, GetUnitName(udg_UNIT_Traveler), gg_snd_Traveler03, ( udg_TEXT_Traveler[3] + ( " " + udg_TEXT_Traveler[4] ) ), bj_TIMETYPE_SET, 13.00, false )
    else
