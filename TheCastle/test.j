//===========================================================================
// Trigger: Note Msg
//===========================================================================
function Trig_Note_Msg_Func001Func001Func010A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( true, 'A05U', GetEnumPlayer() )
endfunction

function Trig_Note_Msg_Func001Func001C takes nothing returns boolean
    if ( not ( udg_Note_count == udg_Note_num ) ) then
        return false
    endif
    return true
endfunction

function Trig_Note_Msg_Func001C takes nothing returns boolean
    if ( not ( udg_Note_count == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Note_Msg_Actions takes nothing returns nothing
    if ( Trig_Note_Msg_Func001C() ) then
        call QuestSetDiscoveredBJ( udg_Task_Notes, true )
        call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2222" )
        call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_ALWAYSHINT, ( "|cff999797Найдено " + ( I2S(udg_Note_count) + ( " из " + ( I2S(udg_Note_num) + " записей.|r" ) ) ) ) )
        call QuestSetDescriptionBJ( udg_Task_Notes, ( "Зaмoк xpaнит в сeбe мнoгo тaйн. Ho иccлeдoвaв бoлee дeтaльнo eгo уголки, можно обнаружить записи, которые могут помочь в прохождении испытаний.|n|n" + ( "|cff999797Найдено " + ( I2S(udg_Note_count) + ( " из " + ( I2S(udg_Note_num) + " записей.|r" ) ) ) ) ) )
    else
        if ( Trig_Note_Msg_Func001Func001C() ) then
            call DisableTrigger( GetTriggeringTrigger() )
            call QuestSetCompleted(udg_Task_Notes, true)
            call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2534" )
            call QuestSetDescriptionBJ( udg_Task_Notes, ( "Зaмoк xpaнит в сeбe мнoгo тaйн. Ho иccлeдoвaв бoлee дeтaльнo eгo уголки, можно обнаружить записи, которые могут помочь в прохождении испытаний.|n|n" + ( "|cff999797Найдено " + ( I2S(udg_Note_count) + ( " из " + ( I2S(udg_Note_num) + " записей.|r" ) ) ) ) ) )
            call SetHeroLevelBJ( udg_Hero_mechanic, ( GetHeroLevel(udg_Hero_mechanic) + 1 ), true )
            call SetHeroLevelBJ( udg_Hero_shaman, ( GetHeroLevel(udg_Hero_shaman) + 1 ), true )
            call SetHeroLevelBJ( udg_Hero_warrior, ( GetHeroLevel(udg_Hero_warrior) + 1 ), true )
            call ForForce( udg_Players, function Trig_Note_Msg_Func001Func001Func010A )
            call TriggerExecute( gg_trg_Help9 )
        else
            call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_ALWAYSHINT, ( "|cff999797Найдено " + ( I2S(udg_Note_count) + ( " из " + ( I2S(udg_Note_num) + " записей.|r" ) ) ) ) )
            call QuestSetDescriptionBJ( udg_Task_Notes, ( "Зaмoк xpaнит в сeбe мнoгo тaйн. Ho иccлeдoвaв бoлee дeтaльнo eгo уголки, можно обнаружить записи, которые могут помочь в прохождении испытаний.|n|n" + ( "|cff999797Найдено " + ( I2S(udg_Note_count) + ( " из " + ( I2S(udg_Note_num) + " записей.|r" ) ) ) ) ) )
        endif
    endif
endfunction

