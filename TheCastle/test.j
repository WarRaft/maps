//===========================================================================
// Trigger: Death of Orc
//===========================================================================
function Trig_Death_of_Orc_Func004C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_UNIT_Boss3_Goblin) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_of_Orc_Func005C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_UNIT_Boss3_Troll) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_of_Orc_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call AddSpecialEffectLocBJ( GetUnitLoc(GetDyingUnit()), "EFFECTS\\AncientExplode.mdx" )
    set udg_Boss3_MaxMonsters[2] = 0
    if ( Trig_Death_of_Orc_Func004C() ) then
        call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_3932" )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_UNIT_Boss3_Goblin, "Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdl" )
        call ModifyHeroStat( bj_HEROSTAT_STR, udg_UNIT_Boss3_Goblin, bj_MODIFYMETHOD_ADD, 20 )
        call ModifyHeroStat( bj_HEROSTAT_INT, udg_UNIT_Boss3_Goblin, bj_MODIFYMETHOD_ADD, 20 )
    else
    endif
    if ( Trig_Death_of_Orc_Func005C() ) then
        call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_4757" )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_UNIT_Boss3_Troll, "Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdl" )
        call ModifyHeroStat( bj_HEROSTAT_STR, udg_UNIT_Boss3_Troll, bj_MODIFYMETHOD_ADD, 20 )
        call ModifyHeroStat( bj_HEROSTAT_AGI, udg_UNIT_Boss3_Troll, bj_MODIFYMETHOD_ADD, 20 )
        call UnitAddAbilityBJ( 'A067', udg_UNIT_Boss3_Troll )
        call EnableTrigger( gg_trg_Voodoo )
    else
    endif
    call KillDestructable( LoadDestructableHandleBJ(21, 1, GetLastCreatedHashtableBJ()) )
    call TriggerExecute( gg_trg_Death_of_all_Bosses )
endfunction

