//===========================================================================
// Trigger: Spawn Timer
//===========================================================================
function Trig_Spawn_Timer_Func001Func001C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_MonsterGroups[GetForLoopIndexA()]) < udg_MaxMonsters[GetForLoopIndexA()] ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MonsterSpawners[GetForLoopIndexA()]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spawn_Timer_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_NumMonsters
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Spawn_Timer_Func001Func001C() ) then
            call TriggerExecute( gg_trg_Spawn_1_Monster )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Spawn_Timer takes nothing returns nothing
    set gg_trg_Spawn_Timer = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Spawn_Timer, 1.00 )
    call TriggerAddAction( gg_trg_Spawn_Timer, function Trig_Spawn_Timer_Actions )
endfunction

//===========================================================================
// Trigger: Spawn 1 Monster
//===========================================================================
function Trig_Spawn_1_Monster_Func007001 takes nothing returns boolean
    return ( udg_SpawnFrequence[GetForLoopIndexA()] != 0 )
endfunction

function Trig_Spawn_1_Monster_Actions takes nothing returns nothing
    local unit new_unit
    local location point = GetUnitLoc(udg_MonsterSpawners[GetForLoopIndexA()])
    local real x = GetLocationX(point) + 100 * Cos(udg_SpawnAngle[GetForLoopIndexA()] * 0.0174) 
    local real y = GetLocationY(point) + 100 * Sin(udg_SpawnAngle[GetForLoopIndexA()] * 0.0174) 
    local real angle = udg_SpawnAngle[GetForLoopIndexA()]
    set udg_SpawnFrequence[GetForLoopIndexA()] = ( udg_SpawnFrequence[GetForLoopIndexA()] - 1 )
    if ( Trig_Spawn_1_Monster_Func007001() ) then
        return
    else
        call DoNothing(  )
    endif
    // Восстанавливаем частоту
    set udg_SpawnFrequence[GetForLoopIndexA()] = udg_InitialSpawnFrequence[GetForLoopIndexA()]
    set new_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_MonsterTypes[GetForLoopIndexA()], x,y, angle )
    call GroupAddUnitSimple( new_unit, udg_MonsterGroups[GetForLoopIndexA()] )
    // Создание эффекта появления
    call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl", GetUnitX(new_unit), GetUnitY(new_unit) ) )
    // Обнуление переменных
    call RemoveLocation(point)
    set point = null
    set new_unit = null
endfunction

//===========================================================================
function InitTrig_Spawn_1_Monster takes nothing returns nothing
    set gg_trg_Spawn_1_Monster = CreateTrigger(  )
    call DisableTrigger( gg_trg_Spawn_1_Monster )
    call TriggerAddAction( gg_trg_Spawn_1_Monster, function Trig_Spawn_1_Monster_Actions )
endfunction

//===========================================================================
// Trigger: Death of Monster
//===========================================================================
function Trig_Death_of_Monster_Func002003001 takes nothing returns boolean
    return ( IsUnitInGroup(GetDyingUnit(), udg_MonsterGroups[GetForLoopIndexA()]) == true )
endfunction

function Trig_Death_of_Monster_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = udg_NumMonsters
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Death_of_Monster_Func002003001() ) then
            call GroupRemoveUnitSimple( GetDyingUnit(), udg_MonsterGroups[GetForLoopIndexA()] )
        else
            call DoNothing(  )
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

