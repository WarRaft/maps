    call DisableTrigger( GetTriggeringTrigger() )
    call CreateItemLoc( 'I00T', GetUnitLoc(udg_UNIT_Merchant) )
    call CreateItemLoc( 'I00T', GetUnitLoc(udg_UNIT_Merchant) )
