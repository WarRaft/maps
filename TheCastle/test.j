function Trig_Cinematic_Victory_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call StopMusicBJ( false )
    call PlayThematicMusicBJ( "Sound\\Music\\mp3Music\\HeroicVictory.mp3" )
    call ForForce( udg_Players, function Trig_Cinematic_Victory_Func005A )
    call TriggerSleepAction( 6.00 )
    set udg_Cinematic_skipped = false
    // НАЧАЛО СЪЁМОК
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( true )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.00 )
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Victory_Func016A )
    // Ввод изображения
    call CinematicModeExBJ( true, GetPlayersAll(), 0.60 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0.00, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_Victory_Func022C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
        return
    endif
    if ( Trig_Cinematic_Victory_Func023C() ) then
        loop
            exitwhen ( Trig_Cinematic_Victory_Func023Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
        return
    endif
    // Сообщение 1
    if ( Trig_Cinematic_Victory_Func025C() ) then
        call DisplayTimedTextToForce( GetPlayersAll(), 13.00, "TRIGSTR_4411" )
    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
        return
    endif
    // Таймер ожидания 10 с.
    if ( Trig_Cinematic_Victory_Func027C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 10.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
        return
    endif
    if ( Trig_Cinematic_Victory_Func028C() ) then
        loop
            exitwhen ( Trig_Cinematic_Victory_Func028Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
        return
    endif
    call ClearTextMessagesBJ( GetPlayersAll() )
    call TriggerSleepAction( 0.30 )
    // Сообщение 2
    if ( Trig_Cinematic_Victory_Func032C() ) then
        call DisplayTimedTextToForce( GetPlayersAll(), 9.00, "TRIGSTR_4412" )
    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
        return
    endif
    // Таймер ожидания 6 с.
    if ( Trig_Cinematic_Victory_Func034C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 6.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
        return
    endif
    if ( Trig_Cinematic_Victory_Func035C() ) then
        loop
            exitwhen ( Trig_Cinematic_Victory_Func035Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
        return
    endif
    // Смена камеры
    if ( Trig_Cinematic_Victory_Func037C() ) then
        call ForForce( udg_Players, function Trig_Cinematic_Victory_Func037Func001A )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    call ClearTextMessagesBJ( GetPlayersAll() )
    call TriggerSleepAction( 0.30 )
    // Сообщение 3
    if ( Trig_Cinematic_Victory_Func041C() ) then
        call DisplayTimedTextToForce( GetPlayersAll(), 14.50, "TRIGSTR_4413" )
    else
        call TriggerExecute( gg_trg_Cinematic_Victory_Ending )
