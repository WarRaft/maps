//===========================================================================
// Trigger: Disconnect
//===========================================================================
function Trig_Disconnect_Func005A takes nothing returns nothing
    call SetUnitOwner( GetEnumUnit(), ForcePickRandomPlayer(udg_Players), true )
endfunction

function Trig_Disconnect_Actions takes nothing returns nothing
    call ForceRemovePlayerSimple( GetTriggerPlayer(), udg_Players )
    call SetPlayerStateBJ( Player(0), PLAYER_STATE_RESOURCE_FOOD_USED, CountPlayersInForceBJ(udg_Players) )
    call SetPlayerStateBJ( Player(1), PLAYER_STATE_RESOURCE_FOOD_USED, CountPlayersInForceBJ(udg_Players) )
    call SetPlayerStateBJ( Player(2), PLAYER_STATE_RESOURCE_FOOD_USED, CountPlayersInForceBJ(udg_Players) )
    call ForGroupBJ( GetUnitsOfPlayerAll(GetTriggerPlayer()), function Trig_Disconnect_Func005A )
endfunction

//===========================================================================
function InitTrig_Disconnect takes nothing returns nothing
    set gg_trg_Disconnect = CreateTrigger(  )
    call TriggerRegisterPlayerEventLeave( gg_trg_Disconnect, Player(0) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Disconnect, Player(1) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Disconnect, Player(2) )
    call TriggerAddAction( gg_trg_Disconnect, function Trig_Disconnect_Actions )
endfunction

