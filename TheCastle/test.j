//===========================================================================
// Trigger: Init Pedestals
//===========================================================================
function Trig_Init_Pedestals_Actions takes nothing returns nothing
    set udg_Pedestal[1] = gg_unit_n00B_0076
    set udg_Pedestal[2] = gg_unit_n00B_0069
    set udg_Pedestal[3] = gg_unit_n00B_0082
    // Пьедестал с Некрономиконом
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitAnimation( udg_Pedestal[GetForLoopIndexA()], "stand second" )
        call AddItemToStockBJ( 'I00J', udg_Pedestal[GetForLoopIndexA()], 1, 1 )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call KillDestructable( gg_dest_DTs2_0943 )
    call KillDestructable( gg_dest_DTs2_0931 )
    call KillDestructable( gg_dest_DTs2_1041 )
    call KillDestructable( gg_dest_DTs2_1073 )
endfunction

