endfunction

function Trig_Cinematic_Traveler_Func046C takes nothing returns boolean
    if ( not ( udg_Cinematic_skipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Traveler_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Cinematic_skipped = false
    set udg_Hero_any = GetTriggerUnit()
    // НАЧАЛО СЪЁМОК
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.40 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( true )
    call IssueImmediateOrderBJ( udg_Hero_mechanic, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_shaman, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_warrior, "stop" )
    call SetUnitFacingToFaceUnitTimed( udg_UNIT_Traveler, udg_Hero_any, 0.50 )
    call SetUnitFacingToFaceUnitTimed( udg_Hero_any, udg_UNIT_Traveler, 0.50 )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.00 )
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Traveler_Func019A )
    // Ввод изображения
    call CinematicModeExBJ( true, GetPlayersAll(), 0.60 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_Traveler_Func025C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Traveler_Ending )
        return
    endif
    if ( Trig_Cinematic_Traveler_Func026C() ) then
        loop
            exitwhen ( Trig_Cinematic_Traveler_Func026Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Traveler_Ending )
        return
    endif
    // Сообщение Странника 1
    if ( Trig_Cinematic_Traveler_Func028C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Traveler, GetUnitName(udg_UNIT_Traveler), gg_snd_Traveler01, udg_TEXT_Traveler[1], bj_TIMETYPE_SET, 5.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Traveler_Ending )
        return
    endif
    // Таймер ожидания 5.5 с.
    if ( Trig_Cinematic_Traveler_Func030C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 5.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_Traveler_Ending )
        return
    endif
    if ( Trig_Cinematic_Traveler_Func031C() ) then
        loop
            exitwhen ( Trig_Cinematic_Traveler_Func031Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Traveler_Ending )
        return
    endif
    // Сообщение Странника 2
    if ( Trig_Cinematic_Traveler_Func033C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Traveler, GetUnitName(udg_UNIT_Traveler), gg_snd_Traveler02, udg_TEXT_Traveler[2], bj_TIMETYPE_SET, 9.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Traveler_Ending )
        return
    endif
    // Таймер ожидания 9.5 с.
    if ( Trig_Cinematic_Traveler_Func035C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 9.50 )
