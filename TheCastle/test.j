    set gg_trg_Trick = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Trick, Player(0), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Trick, Player(1), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Trick, Player(2), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Trick, Condition( function Trig_Trick_Conditions ) )
    call TriggerAddAction( gg_trg_Trick, function Trig_Trick_Actions )
endfunction

//===========================================================================
// Trigger: Activation robot
//
// Включается триггером First Activating robot  в папке "Сюжет"
//===========================================================================
function Trig_Activation_robot_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A009' ) ) then
        return false
    endif
    if ( not ( GetSpellTargetUnit() == udg_UNIT_Robot ) ) then
        return false
    endif
    return true
endfunction

function Trig_Activation_robot_Func001C takes nothing returns boolean
    if ( not ( udg_Robot_Repair_Bool == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Activation_robot_Actions takes nothing returns nothing
    if ( Trig_Activation_robot_Func001C() ) then
        set udg_Robot_Activation_Bool = true
        call RescueUnitBJ( udg_UNIT_Robot, GetOwningPlayer(GetTriggerUnit()), false )
        call IssueTargetOrderBJ( udg_Hero_mechanic, "board", udg_UNIT_Robot )
        call UnitRemoveAbilityBJ( 'Avul', udg_UNIT_Robot )
        call UnitAddAbilityBJ( 'A050', udg_UNIT_Robot )
        call SetUnitTimeScalePercent( udg_UNIT_Robot, 100.00 )
        set udg_Hero_mechanic = udg_UNIT_Robot
        call SelectUnitForPlayerSingle( udg_Hero_mechanic, GetOwningPlayer(udg_Hero_mechanic) )
        call EnableTrigger( gg_trg_Deactivation_robot )
    else
        call PlaySoundOnUnitBJ( gg_snd_Error, 100, GetTriggerUnit() )
        call DisplayTextToForce( GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_1437" )
    endif
endfunction

//===========================================================================
function InitTrig_Activation_robot takes nothing returns nothing
    set gg_trg_Activation_robot = CreateTrigger(  )
    call DisableTrigger( gg_trg_Activation_robot )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Activation_robot, Player(0), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Activation_robot, Player(1), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Activation_robot, Player(2), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Activation_robot, Condition( function Trig_Activation_robot_Conditions ) )
    call TriggerAddAction( gg_trg_Activation_robot, function Trig_Activation_robot_Actions )
