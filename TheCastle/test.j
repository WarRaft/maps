//===========================================================================
// Trigger: Skeleton spawn
//===========================================================================
function Trig_Skeleton_spawn_Func004C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Skeleton_Group) < 30 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Skeleton_spawn_Actions takes nothing returns nothing
    local unit temp_unit
    local location point = GetRandomLocInRect(gg_rct_REG_Skeleton_spawn)
    local location point_target = GetRandomLocInRect(gg_rct_REG_Skeletons_atack_point)
    if ( Trig_Skeleton_spawn_Func004C() ) then
        set temp_unit = TeoCreateUnit( Player(11), 'u001', GetLocationX(point),GetLocationY(point), 270.00 )
        call GroupAddUnitSimple( temp_unit, udg_Skeleton_Group )
        call UnitApplyTimedLife(  temp_unit, 'BTLF', GetRandomReal(14.00, 17.00) )
        call IssuePointOrder( temp_unit, "attack", GetLocationX(point_target), GetLocationY(point_target))
        call RemoveLocation(point)
        call RemoveLocation(point_target)
        set temp_unit = null
        set point = null
        set point_target = null
    else
    endif
endfunction

