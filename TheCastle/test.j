//===========================================================================
// Trigger: Z coordinate check
//
// 0.70 сек для плавного изменения камеры при движении.
//===========================================================================
function Trig_Z_coordinate_check_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = CountPlayersInForceBJ(udg_Players)
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Z_time[GetForLoopIndexA()] = 0.70
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerExecute( gg_trg_Z_calculation )
endfunction

//===========================================================================
function InitTrig_Z_coordinate_check takes nothing returns nothing
    set gg_trg_Z_coordinate_check = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Z_coordinate_check, 0.30 )
    call TriggerAddAction( gg_trg_Z_coordinate_check, function Trig_Z_coordinate_check_Actions )
endfunction

//===========================================================================
// Trigger: Z calculation
//===========================================================================
function Trig_Z_calculation_Actions takes nothing returns nothing
    local real coordinate_X
    local real coordinate_Y
    local player current_player
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = CountPlayersInForceBJ(udg_Players)
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set coordinate_X = GetUnitX(udg_Z_Unit[bj_forLoopAIndex])
        set coordinate_Y = GetUnitY(udg_Z_Unit[bj_forLoopAIndex])
        set current_player = Player(bj_forLoopAIndex-1)
        // Если земля является городской почвой, то не двигать камеру по Z
        if (GetTerrainType(coordinate_X, coordinate_Y) == 'Ydrt' ) then
        else
            call SetCameraFieldForPlayer(current_player, CAMERA_FIELD_ZOFFSET, (80.00 * (I2R(GetTerrainCliffLevel(coordinate_X, coordinate_Y)) - 5.00 )), udg_Z_time[bj_forLoopAIndex])
        endif
        if (udg_FREECAM[bj_forLoopAIndex] == false) then
            call SetCameraTargetControllerNoZForPlayer( current_player, udg_Z_Unit[bj_forLoopAIndex], 0.00, 0, false )
        endif
        set current_player = null
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Z_calculation takes nothing returns nothing
    set gg_trg_Z_calculation = CreateTrigger(  )
    call DisableTrigger( gg_trg_Z_calculation )
    call TriggerAddAction( gg_trg_Z_calculation, function Trig_Z_calculation_Actions )
endfunction

//===========================================================================
// Trigger: Help1 Training
//===========================================================================
function Trig_Help1_Training_Func004C takes nothing returns boolean
    if ( not ( udg_CONSTANT_LANGUAGE == "RU" ) ) then
        return false
    endif
    return true
endfunction

function Trig_Help1_Training_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, udg_TEXT_Quest[1], udg_TEXT_Req[1], "ReplaceableTextures\\CommandButtons\\BTNOrcBattleStandard.blp" )
    set udg_Task_First = GetLastCreatedQuestBJ()
    if ( Trig_Help1_Training_Func004C() ) then
        call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_4739" )
    else
        call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_4743" )
    endif
    call CreateQuestBJ( bj_QUESTTYPE_REQ_UNDISCOVERED, udg_TEXT_Quest[2], udg_TEXT_Req[2], "ReplaceableTextures\\CommandButtons\\BTNSoulGem.blp" )
    set udg_Task_Main = GetLastCreatedQuestBJ()
    call CreateQuestBJ( bj_QUESTTYPE_REQ_UNDISCOVERED, udg_TEXT_Quest[3], "TRIGSTR_4740", "ReplaceableTextures\\CommandButtons\\BTNTome.blp" )
    set udg_Task_Notes = GetLastCreatedQuestBJ()
    call TriggerSleepAction( 2.50 )
    call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_ALWAYSHINT, udg_TEXT_Hint[1] )
    call PingMinimapLocForForceEx( udg_Players, GetUnitLoc(gg_unit_nbrg_0018), 10.00, bj_MINIMAPPINGSTYLE_SIMPLE, 50.00, 100, 50.00 )
endfunction

