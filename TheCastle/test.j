    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette01) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette02) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette03) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette04) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette05) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette06) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette09) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette11) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette12) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette13) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette14) == false ) ) then
        return false
    endif
    if ( not ( RectContainsItem(udg_All_Items[udg_N], gg_rct_REG_Statuette16) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lever14_Actions takes nothing returns nothing
    set udg_N = 1
    loop
        exitwhen udg_N > udg_All_Items_num
        if ( Trig_Lever14_Func001Func001C() ) then
            set udg_Wrong_Place_for_Item = false
        else
            set udg_Wrong_Place_for_Item = true
            call TriggerExecute( gg_trg_Lever14_Activation )
            return
        endif
        set udg_N = udg_N + 1
    endloop
    call TriggerExecute( gg_trg_Lever14_Activation )
endfunction

