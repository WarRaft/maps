//===========================================================================
// Trigger: Explosive timer
//===========================================================================
function Trig_Explosive_timer_Actions takes nothing returns nothing
    local unit temp_unit = GetSummonedUnit()
    local texttag msg
    local string text
    if ( udg_CONSTANT_LANGUAGE == "RU" ) then
        set text = "До взрыва 5 секунд . . ."
    else
        set text = "5 seconds before the explosion . . ."
    endif
    set msg = CreateTextTagUnitBJ( text, temp_unit, 0, 10, 100, 0.00, 0.00, 0 )
    call PlaySoundBJ( gg_snd_BattleNetTick )
    call TriggerSleepAction( 1.00 )
    if ( udg_CONSTANT_LANGUAGE == "RU" ) then
        set text = "До взрыва 4 секунды . . ."
    else
        set text = "4 seconds before the explosion . . ."
    endif
    call SetTextTagTextBJ(msg, text, 10 )
    call PlaySoundBJ( gg_snd_BattleNetTick )
    call TriggerSleepAction( 1.00 )
    if ( udg_CONSTANT_LANGUAGE == "RU" ) then
        set text = "До взрыва 3 секунды . . ."
    else
        set text = "3 seconds before the explosion . . ."
    endif
    call SetTextTagTextBJ(msg, text, 10 )
    call PlaySoundBJ( gg_snd_BattleNetTick )
    call TriggerSleepAction( 1.00 )
    if ( udg_CONSTANT_LANGUAGE == "RU" ) then
        set text = "До взрыва 2 секунды . . ."
    else
        set text = "2 seconds before the explosion . . ."
    endif
    call SetTextTagTextBJ(msg, text, 10 )
    call PlaySoundBJ( gg_snd_BattleNetTick )
    call TriggerSleepAction( 1.00 )
    if ( udg_CONSTANT_LANGUAGE == "RU" ) then
        set text = "До взрыва 1 секунда . . ."
    else
        set text = "1 second before the explosion . . ."
    endif
    call SetTextTagTextBJ(msg, text, 10 )
    call PlaySoundBJ( gg_snd_BattleNetTick )
    call TriggerSleepAction( 1.00 )
    call DestroyTextTag(msg)
    call DestroyEffect( AddSpecialEffect("Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl", GetUnitX(temp_unit), GetUnitY(temp_unit)) )
    call TriggerSleepAction( 0.20 )
    call DestroyEffect( AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl", GetUnitX(temp_unit), GetUnitY(temp_unit)) )
    set temp_unit = null
    set msg = null
    set text = null
endfunction

