//===========================================================================
// Trigger: Portal passage
//
// Проход через портал
//===========================================================================
function Trig_Portal_passage_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( udg_Teleport_Bool == true ) ) then
        return false
    endif
    if ( not ( LoadUnitHandleBJ(0, 2, GetLastCreatedHashtableBJ()) != null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_passage_Actions takes nothing returns nothing
    local unit temp_unit = GetTriggerUnit()
    local unit portal = LoadUnitHandleBJ(0, 2, GetLastCreatedHashtableBJ())
    local real portal_x = GetUnitX (portal)
    local real portal_y = GetUnitY (portal)
    local real portal_angle = GetUnitFacing(portal)
    local location point = Location( portal_x,  portal_y)
    // Перемещаем входящего в портал юнита
    call SetUnitPosition( temp_unit, portal_x, portal_y )
    call IssuePointOrder( temp_unit, "move", portal_x + 150.00 * CosBJ(portal_angle), portal_y + 150.00 * SinBJ(portal_angle))
    // Перемещаем камеру
    call PanCameraToTimedLocForPlayer( GetOwningPlayer(temp_unit), point, 0 )
    // Обнуление переменных
    call RemoveLocation(point)
    set point = null
    set temp_unit = null
    set portal = null
endfunction

//===========================================================================
function InitTrig_Portal_passage takes nothing returns nothing
    set gg_trg_Portal_passage = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Portal_passage, Condition( function Trig_Portal_passage_Conditions ) )
    call TriggerAddAction( gg_trg_Portal_passage, function Trig_Portal_passage_Actions )
endfunction

