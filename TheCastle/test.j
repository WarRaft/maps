    call AddItemToStockBJ( 'I025', GetTriggerUnit(), 0, 1 )
    call AddItemToStockBJ( 'I026', GetTriggerUnit(), 0, 1 )
    call AddItemToStockBJ( 'I024', GetTriggerUnit(), 0, 1 )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 3
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        if ( Trig_Rune_Deativation_Func008Func001C() ) then
            set udg_Spatial_Cubes_Checking[GetForLoopIndexB()] = 0
        else
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
endfunction

