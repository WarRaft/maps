function Trig_Init_Players_Func002A takes nothing returns nothing
    call SetPlayerHandicapXPBJ( GetEnumPlayer(), 50.00 )
    call SetPlayerStateBJ( GetEnumPlayer(), PLAYER_STATE_RESOURCE_LUMBER, ( udg_Count_Life - 1 ) )
    call SetPlayerAbilityAvailableBJ( false, 'A05M', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A05U', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A05Y', GetEnumPlayer() )
endfunction

function Trig_Init_Players_Actions takes nothing returns nothing
    if ( Trig_Init_Players_Func001C() ) then
        call ForceAddPlayerSimple( Player(0), udg_Players )
        call ForceAddPlayerSimple( Player(1), udg_Players )
        call ForceAddPlayerSimple( Player(2), udg_Players )
        call CreateNUnitsAtLoc( 1, 'N000', Player(2), GetRectCenter(gg_rct_REG_Mechanic), 90.00 )
        set udg_Hero_mechanic = GetLastCreatedUnit()
        set udg_UNIT_Robot_Mechanic = udg_Hero_mechanic
        set udg_Name_Mechanic = GetHeroProperName(udg_Hero_mechanic)
        call CreateNUnitsAtLoc( 1, 'N001', Player(1), GetRectCenter(gg_rct_REG_Shaman), 90.00 )
        set udg_Hero_shaman = GetLastCreatedUnit()
        call CreateNUnitsAtLoc( 1, 'O001', Player(0), GetRectCenter(gg_rct_REG_Warrior), 90.00 )
        set udg_Hero_warrior = GetLastCreatedUnit()
    else
        if ( Trig_Init_Players_Func001Func004C() ) then
            call ForceAddPlayerSimple( Player(0), udg_Players )
            call ForceAddPlayerSimple( Player(1), udg_Players )
            call DisableTrigger( gg_trg_Selecting_Player3 )
            call CreateNUnitsAtLoc( 1, 'N000', Player(1), GetRectCenter(gg_rct_REG_Mechanic), 90.00 )
            set udg_Hero_mechanic = GetLastCreatedUnit()
            set udg_UNIT_Robot_Mechanic = udg_Hero_mechanic
            set udg_Name_Mechanic = GetHeroProperName(udg_Hero_mechanic)
            call CreateNUnitsAtLoc( 1, 'N001', Player(1), GetRectCenter(gg_rct_REG_Shaman), 90.00 )
            set udg_Hero_shaman = GetLastCreatedUnit()
            call CreateNUnitsAtLoc( 1, 'O001', Player(0), GetRectCenter(gg_rct_REG_Warrior), 90.00 )
            set udg_Hero_warrior = GetLastCreatedUnit()
        else
            if ( Trig_Init_Players_Func001Func004Func004C() ) then
                call ForceAddPlayerSimple( Player(0), udg_Players )
                call ForceAddPlayerSimple( Player(2), udg_Players )
                call DisableTrigger( gg_trg_Selecting_Player2 )
                call CreateNUnitsAtLoc( 1, 'N000', Player(2), GetRectCenter(gg_rct_REG_Mechanic), 90.00 )
                set udg_Hero_mechanic = GetLastCreatedUnit()
                set udg_UNIT_Robot_Mechanic = udg_Hero_mechanic
                set udg_Name_Mechanic = GetHeroProperName(udg_Hero_mechanic)
                call CreateNUnitsAtLoc( 1, 'N001', Player(2), GetRectCenter(gg_rct_REG_Shaman), 90.00 )
                set udg_Hero_shaman = GetLastCreatedUnit()
                call CreateNUnitsAtLoc( 1, 'O001', Player(0), GetRectCenter(gg_rct_REG_Warrior), 90.00 )
                set udg_Hero_warrior = GetLastCreatedUnit()
            else
                if ( Trig_Init_Players_Func001Func004Func004Func004C() ) then
                    call ForceAddPlayerSimple( Player(0), udg_Players )
                    call DisableTrigger( gg_trg_Selecting_Player2 )
                    call DisableTrigger( gg_trg_Selecting_Player3 )
                    call CreateNUnitsAtLoc( 1, 'N000', Player(0), GetRectCenter(gg_rct_REG_Mechanic), 90.00 )
                    set udg_Hero_mechanic = GetLastCreatedUnit()
                    set udg_UNIT_Robot_Mechanic = udg_Hero_mechanic
                    set udg_Name_Mechanic = GetHeroProperName(udg_Hero_mechanic)
                    call CreateNUnitsAtLoc( 1, 'N001', Player(0), GetRectCenter(gg_rct_REG_Shaman), 90.00 )
                    set udg_Hero_shaman = GetLastCreatedUnit()
                    call CreateNUnitsAtLoc( 1, 'O001', Player(0), GetRectCenter(gg_rct_REG_Warrior), 90.00 )
                    set udg_Hero_warrior = GetLastCreatedUnit()
                else
                endif
            endif
        endif
    endif
    call ForForce( udg_Players, function Trig_Init_Players_Func002A )
    call SetPlayerName( Player(7), "TRIGSTR_4688" )
    call SetPlayerStateBJ( Player(0), PLAYER_STATE_RESOURCE_FOOD_USED, CountPlayersInForceBJ(udg_Players) )
    call SetPlayerStateBJ( Player(1), PLAYER_STATE_RESOURCE_FOOD_USED, CountPlayersInForceBJ(udg_Players) )
    call SetPlayerStateBJ( Player(2), PLAYER_STATE_RESOURCE_FOOD_USED, CountPlayersInForceBJ(udg_Players) )
    call SetPlayerStateBJ( Player(0), PLAYER_STATE_RESOURCE_FOOD_CAP, 3 )
    call SetPlayerStateBJ( Player(1), PLAYER_STATE_RESOURCE_FOOD_CAP, 3 )
    call SetPlayerStateBJ( Player(2), PLAYER_STATE_RESOURCE_FOOD_CAP, 3 )
endfunction

