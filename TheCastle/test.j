function Trig_Cinematic_Lattice1_Ending_Func009Func002Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B00Y' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Lattice1_Ending_Func009Func002A takes nothing returns nothing
    if ( Trig_Cinematic_Lattice1_Ending_Func009Func002Func001C() ) then
        call RemoveDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_Cinematic_Lattice1_Ending_Func009C takes nothing returns boolean
    if ( not ( IsDestructableDeadBJ(gg_dest_B00S_0759) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Lattice1_Ending_Func012A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Lattice3, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_Lattice1_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.30 )
    call KillDestructable( gg_dest_B00S_0760 )
    if ( Trig_Cinematic_Lattice1_Ending_Func009C() ) then
        call EnumDestructablesInRectAll( gg_rct_REG_Portal_Blocking1, function Trig_Cinematic_Lattice1_Ending_Func009Func002A )
        call DisableTrigger( gg_trg_Portal_Blocking1 )
        call DisableTrigger( gg_trg_Portal_Blocking2 )
    else
    endif
    call FogModifierStop( udg_Eye[4] )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Lattice1_Ending_Func012A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call ShowInterfaceForceOn( GetPlayersAll(), 0.60 )
endfunction

