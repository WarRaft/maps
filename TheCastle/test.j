//===========================================================================
function Trig_Destroying_Barrel_Conditions takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'LTex' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Destroying_Barrel_Actions takes nothing returns nothing
    local unit dummy_unit
    local destructable barrel = GetDyingDestructable()
    local real x = GetDestructableX(barrel)
    local real y = GetDestructableY(barrel)
    call TriggerSleepAction( 0.20 )
    // Проверка на уничтожение ключевой бочки
    if ( barrel == gg_dest_LTex_1000  ) then
        call DisableTrigger( gg_trg_Fire2 )
    endif
    // Взрыв бочки
    set dummy_unit = TeoCreateDummyUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'n00X', x, y, 'A02D' )
    call IssuePointOrder( dummy_unit, "flamestrike", x, y )
    set dummy_unit = null
    set barrel = null
endfunction

