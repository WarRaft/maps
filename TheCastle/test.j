//===========================================================================
// Trigger: Cinematic Marauder Ending
//===========================================================================
function Trig_Cinematic_Marauder_Ending_Func017A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Marauder3, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_Marauder_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.30 )
    call UnitAddAbilityBJ( 'A043', udg_UNIT_Marauder )
    call UnitAddAbilityBJ( 'Asid', udg_UNIT_Marauder )
    call AddItemToStockBJ( 'I01P', udg_UNIT_Marauder, 1, 1 )
    call AddItemToStockBJ( 'I01R', udg_UNIT_Marauder, 1, 1 )
    call AddItemToStockBJ( 'I01Q', udg_UNIT_Marauder, 1, 1 )
    call AddItemToStockBJ( 'I01S', udg_UNIT_Marauder, 1, 1 )
    call AddItemToStockBJ( 'I01T', udg_UNIT_Marauder, 1, 1 )
    call AddItemToStockBJ( 'I01U', udg_UNIT_Marauder, 1, 1 )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Marauder_Ending_Func017A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call CinematicModeExBJ( false, GetPlayersAll(), 0.60 )
endfunction

