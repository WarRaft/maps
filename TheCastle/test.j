function Trig_Reload_robot_Actions takes nothing returns nothing
    local texttag msg
    local string text
    call DisableTrigger( GetTriggeringTrigger() )
    // Останавливаем боевую машину
    call SetUnitMoveSpeed( udg_UNIT_Robot, 0.00 )
    call SetUnitTurnSpeedBJ( udg_UNIT_Robot, 0.00 )
    set udg_Robot_Repair_Bool = true
    // Создаём предупреждение
    call TriggerSleepAction( 0.10 )
    if ( Trig_Reload_robot_Func010C() ) then
        set text = "Т Р Е Б У Е Т С Я   Р Е М О Н Т"
        set msg = CreateTextTagUnitBJ( text, udg_UNIT_Robot, 0, 10, 100, 0.00, 0.00, 0 )
    else
    endif
    call TriggerSleepAction( 0.05 )
    set text = " "
    call SetTextTagTextBJ(msg, text, 10 )
    call TriggerSleepAction( 0.05 )
    if ( Trig_Reload_robot_Func015C() ) then
        set text = "Т Р Е Б У Е Т С Я   Р Е М О Н Т"
        call SetTextTagTextBJ(msg, text, 10 )
    else
    endif
    call TriggerSleepAction( 0.05 )
    set text = " "
    call SetTextTagTextBJ(msg, text, 10 )
    call TriggerSleepAction( 0.05 )
    if ( Trig_Reload_robot_Func020C() ) then
