function InitTrig_Attacking_Devouer takes nothing returns nothing
    set gg_trg_Attacking_Devouer = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Attacking_Devouer, function Trig_Attacking_Devouer_Actions )
endfunction

