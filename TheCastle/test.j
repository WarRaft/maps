//===========================================================================
function InitTrig_Cinematic_Prisoner1 takes nothing returns nothing
    set gg_trg_Cinematic_Prisoner1 = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Cinematic_Prisoner1, Condition( function Trig_Cinematic_Prisoner1_Conditions ) )
    call TriggerAddAction( gg_trg_Cinematic_Prisoner1, function Trig_Cinematic_Prisoner1_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Prisoner1 Ending
//===========================================================================
function Trig_Cinematic_Prisoner1_Ending_Func012A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Prisoner5, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_Prisoner1_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.30 )
    set udg_Quest_Prisoner = true
    call TriggerRegisterUnitInRangeSimple( gg_trg_Cinematic_Prisoner2, 300.00, udg_UNIT_Prisoner )
    call EnableTrigger( gg_trg_Cinematic_Prisoner2 )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Prisoner1_Ending_Func012A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call CinematicModeExBJ( false, GetPlayersAll(), 0.60 )
endfunction

//===========================================================================
function InitTrig_Cinematic_Prisoner1_Ending takes nothing returns nothing
    set gg_trg_Cinematic_Prisoner1_Ending = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_Prisoner1_Ending )
    call TriggerAddAction( gg_trg_Cinematic_Prisoner1_Ending, function Trig_Cinematic_Prisoner1_Ending_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Prisoner2
//
// Да, это она!  Моя Сфера! Благодарю Вас от всего сердца! Теперь я смогу вернуться домой!
// Так, надо вспомнить, как это делается . . .
// Отлично! У меня получилось. Спасибо Вам еще раз за помощь! Возьмите мою сферу в качестве благодарности. Прощайте!
//===========================================================================
function Trig_Cinematic_Prisoner2_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I02D') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Prisoner2_Func021A takes nothing returns nothing
    call ClearSelectionForPlayer( GetEnumPlayer() )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Prisoner2, GetEnumPlayer(), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Prisoner1, GetEnumPlayer(), 40.00 )
