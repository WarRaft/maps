function Trig_Rat_death_Actions takes nothing returns nothing
    call GroupRemoveUnitSimple( GetDyingUnit(), udg_Rats_Group )
    if ( Trig_Rat_death_Func002C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call TeoTextTag ("Репутация изменена", udg_Hero_warrior, 0,80,0)
        call TeoTextTag ("Репутация изменена", udg_Hero_shaman, 0,80,0)
        call TeoTextTag ("Репутация изменена", udg_Hero_mechanic, 0,80,0)
        set udg_Reputation = ( udg_Reputation + 5.00 )
        if ( Trig_Rat_death_Func002Func006C() ) then
            if ( Trig_Rat_death_Func002Func006Func001C() ) then
                set udg_Hero_any = udg_Hero_warrior
            else
                if ( Trig_Rat_death_Func002Func006Func001Func001C() ) then
                    set udg_Hero_any = udg_Hero_mechanic
                else
                    if ( Trig_Rat_death_Func002Func006Func001Func001Func001C() ) then
                        set udg_Hero_any = udg_Hero_shaman
                    else
                    endif
                endif
            endif
            call DisableTrigger( gg_trg_Cinematic_Marauder )
            call SetPlayerAllianceStateBJ( Player(PLAYER_NEUTRAL_PASSIVE), Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL )
            call TriggerSleepAction( 1.00 )
            call TriggerExecute( gg_trg_Cinematic_Marauder )
        else
        endif
    else
    endif
endfunction

