        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Traveler, GetUnitName(udg_UNIT_Traveler), gg_snd_Traveler04, udg_TEXT_Traveler[5], bj_TIMETYPE_SET, 8.00, false )
    else
