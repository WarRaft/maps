function Trig_Direction_Selection_Func009C takes nothing returns boolean
    if ( not ( udg_FS_Angle < 115.00 ) ) then
        return false
    endif
    if ( not ( udg_FS_Angle > 65.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Direction_Selection_Actions takes nothing returns nothing
    set udg_Movements_num = 4
    // ВПРАВО
    if ( Trig_Direction_Selection_Func003C() ) then
        set udg_FS_Direction = 0.00
        if (GetUnitX(udg_FS_Target_Unit) >=0) then
            set udg_FS_Step = 70
        else
            set udg_FS_Step = 10
        endif
        call TriggerExecute( gg_trg_Lock_Check )
        return
    else
    endif
    // ВЛЕВО
    if ( Trig_Direction_Selection_Func005C() ) then
        set udg_FS_Direction = 180.00
        if (GetUnitX(udg_FS_Target_Unit) >=0) then
            set udg_FS_Step = 10
        else
            set udg_FS_Step = 70
        endif
        call TriggerExecute( gg_trg_Lock_Check )
        return
    else
    endif
    // ВНИЗ
    if ( Trig_Direction_Selection_Func007C() ) then
        set udg_FS_Direction = 270.00
        if (GetUnitY(udg_FS_Target_Unit) >=0) then
            set udg_FS_Step = 10
        else
            set udg_FS_Step = 70
        endif
        call TriggerExecute( gg_trg_Lock_Check )
        return
    else
    endif
    // ВВЕРХ
    if ( Trig_Direction_Selection_Func009C() ) then
        set udg_FS_Direction = 90.00
        if (GetUnitY(udg_FS_Target_Unit) >=0) then
            set udg_FS_Step = 70
        else
            set udg_FS_Step = 10
        endif
        call TriggerExecute( gg_trg_Lock_Check )
        return
    else
    endif
endfunction

