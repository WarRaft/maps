    call TriggerAddCondition( gg_trg_Fatal_Strike_Actions, Condition( function Trig_Fatal_Strike_Actions_Conditions ) )
    call TriggerAddAction( gg_trg_Fatal_Strike_Actions, function Trig_Fatal_Strike_Actions_Actions )
endfunction

//===========================================================================
// Trigger: Provocation
//===========================================================================
function Trig_Provocation_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A002' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Provocation_Func004Func003C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnumUnit()) != Player(0) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnumUnit()) != Player(1) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnumUnit()) != Player(2) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnumUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'n00W' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'n02S' ) ) then
        return false
    endif
    if ( not ( GetUnitLevel(GetEnumUnit()) < 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Provocation_Func004A takes nothing returns nothing
    local player dummy_player = Player(4)
    local unit dummy_unit
    if ( Trig_Provocation_Func004Func003C() ) then
        // Даём ослабление и добавляем в группу
        set dummy_unit = TeoCreateDummyUnit( dummy_player, 'n00X', GetUnitX (udg_Hero_warrior), GetUnitY (udg_Hero_warrior), 'A054' )
        call IssueTargetOrder( dummy_unit, "cripple", GetEnumUnit() )
        call GroupAddUnitSimple( GetEnumUnit(), udg_Provocation_Group )
        set dummy_unit = null
        set dummy_player = null
    else
    endif
endfunction

function Trig_Provocation_Actions takes nothing returns nothing
    call QueueUnitAnimationBJ( udg_Hero_warrior, "stand" )
    // Выбираем группу юнитов
    call GroupEnumUnitsInRange (udg_TempGroup, GetUnitX (udg_Hero_warrior), GetUnitY (udg_Hero_warrior), 500, null) 
    call ForGroupBJ( udg_TempGroup, function Trig_Provocation_Func004A )
    call StartTimerBJ( udg_Provocation_Timer, false, 5.00 )
    call EnableTrigger( gg_trg_Provocation_timer )
    // Обнуление переменных
    call GroupClear( udg_TempGroup )
endfunction

//===========================================================================
function InitTrig_Provocation takes nothing returns nothing
    set gg_trg_Provocation = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Provocation, Player(0), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Provocation, Player(1), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Provocation, Player(2), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Provocation, Condition( function Trig_Provocation_Conditions ) )
    call TriggerAddAction( gg_trg_Provocation, function Trig_Provocation_Actions )
endfunction

