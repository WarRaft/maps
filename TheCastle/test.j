// Trigger: Attack of Marauder
//===========================================================================
function Trig_Attack_of_Marauder_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'n01O' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Attack_of_Marauder_Func004Func012A takes nothing returns nothing
    call IssueTargetOrderBJ( GetEnumUnit(), "attack", udg_UNIT_Marauder )
endfunction

function Trig_Attack_of_Marauder_Func004C takes nothing returns boolean
    if ( not ( IsUnitType(GetEventDamageSource(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetEventDamage() >= 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Attack_of_Marauder_Actions takes nothing returns nothing
    // Если урон наносят крысы
    if ( Trig_Attack_of_Marauder_Func002C() ) then
        call SetUnitUserData( udg_UNIT_Marauder, 0 )
        call StartTimerBJ( udg_Marauder_Timer, false, 2.00 )
    else
    endif
    // Если урон наносит Герой
    if ( Trig_Attack_of_Marauder_Func004C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call DisableTrigger( gg_trg_Cinematic_Marauder )
        call DisableTrigger( gg_trg_Death_of_Marauder )
        call DisableTrigger( gg_trg_Rat_death )
        call FogModifierStop( udg_Eye[1] )
        call SetUnitOwner( udg_UNIT_Marauder, Player(PLAYER_NEUTRAL_AGGRESSIVE), false )
        call SetUnitMoveSpeed( udg_UNIT_Marauder, 190.00 )
        call UnitRemoveAbilityBJ( 'A043', udg_UNIT_Marauder )
        call UnitRemoveAbilityBJ( 'Asid', udg_UNIT_Marauder )
        call ForGroupBJ( udg_Rats_Group, function Trig_Attack_of_Marauder_Func004Func012A )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Marauder, "TRIGSTR_2832", gg_snd_Marauder03, "TRIGSTR_2833", bj_TIMETYPE_ADD, 0.00, false )
        call TeoTextTag ("Репутация изменена", udg_Hero_warrior, 80,0,0)
        call TeoTextTag ("Репутация изменена", udg_Hero_shaman, 80,0,0)
        call TeoTextTag ("Репутация изменена", udg_Hero_mechanic, 80,0,0)
        set udg_Reputation = ( udg_Reputation - 10.00 )
    else
    endif
endfunction

