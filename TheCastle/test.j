        return false
    endif
    return true
endfunction

function Trig_BUTTON_EXIT_Actions takes nothing returns nothing
    call GroupRemoveUnitSimple( udg_TempUnit, udg_Button_Units[udg_TempNumButton] )
    if ( Trig_BUTTON_EXIT_Func002C() ) then
        call DestructableRestoreLife( udg_Button[udg_TempNumButton], 50.00, true )
        call SetDestructableAnimationBJ( udg_Button[udg_TempNumButton], "stand alternate" )
    else
    endif
endfunction

