    call DisableTrigger( gg_trg_Direction_Selection )
    call TriggerAddAction( gg_trg_Direction_Selection, function Trig_Direction_Selection_Actions )
endfunction

//===========================================================================
// Trigger: Lock Check
//===========================================================================
function Trig_Lock_Check_Actions takes nothing returns nothing
    local real x = GetUnitX(udg_FS_Target_Unit)
    local real y = GetUnitY(udg_FS_Target_Unit)
    local location pos = Location(x, y)
    local location point = Location(GetLocationX(pos) + 250.00 * Cos(udg_FS_Direction * bj_DEGTORAD), GetLocationY(pos) + 250.00 * Sin(udg_FS_Direction * bj_DEGTORAD))
    local rect blocking_area = Rect(GetLocationX(point) - 150, GetLocationY(point) - 150, GetLocationX(point) + 150, GetLocationY(point) + 150 )
    local real dx
    local real dy
    local item dummy_item
    local group blocking_units
    set udg_HaveBlock = false
    //     Если помехой является юнит    
    set blocking_units = GetUnitsInRectAll(blocking_area)
    if (CountUnitsInGroup(blocking_units) !=0 ) then
        set udg_HaveBlock = true
        // ----------- Обнуление переменных ----------- 
        call RemoveLocation(pos)
        call RemoveLocation(point)
        call RemoveRect(blocking_area)
        call DestroyGroup(blocking_units)
        set pos = null
        set point = null
        set blocking_area = null
        set blocking_units = null
    return
    endif
    call GroupClear( blocking_units )
    //     Если помехой является непроходимая точка    
    set dummy_item = CreateItem( 'ratf', GetLocationX(point), GetLocationY(point) )
    set dx = IAbsBJ( R2I( GetItemX(dummy_item) - GetLocationX(point) ) ) 
    set dy = IAbsBJ( R2I( GetItemY(dummy_item) - GetLocationY(point) ) ) 
    call SetItemVisible( dummy_item, false)
    if ( dx > 0 or dy > 0 ) then
        set udg_HaveBlock = true
        // ----------- Обнуление переменных ----------- 
        call RemoveItem( dummy_item )
        call RemoveLocation(pos)
        call RemoveLocation(point)
        call RemoveRect(blocking_area)
        call DestroyGroup(blocking_units)
        set pos = null
        set point = null
        set blocking_area = null
        set blocking_units = null
    return
    endif
    call RemoveItem( dummy_item )
    //     Если помехой является точка-блокиратор    
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if (RectContainsLoc(blocking_area, udg_Blocking_Point[GetForLoopIndexA()]) == true ) then
            set udg_HaveBlock = true
            // ----------- Обнуление переменных ----------- 
            call RemoveLocation(pos)
            call RemoveLocation(point)
            call RemoveRect(blocking_area)
            call DestroyGroup(blocking_units)
            set pos = null
            set point = null
            set blocking_area = null
            set blocking_units = null
        return
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call StartTimerBJ( udg_Movement_Timer, false, 0.03 )
    // ----------- Обнуление переменных ----------- 
    call RemoveLocation(pos)
    call RemoveLocation(point)
    call RemoveRect(blocking_area)
    call DestroyGroup(blocking_units)
    set pos = null
    set point = null
    set blocking_area = null
    set blocking_units = null
endfunction

//===========================================================================
function InitTrig_Lock_Check takes nothing returns nothing
    set gg_trg_Lock_Check = CreateTrigger(  )
    call DisableTrigger( gg_trg_Lock_Check )
    call TriggerAddAction( gg_trg_Lock_Check, function Trig_Lock_Check_Actions )
endfunction

