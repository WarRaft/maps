        return false
    endif
    return true
endfunction

function Trig_Cage3_Actions takes nothing returns nothing
    call TriggerSleepAction( 0.50 )
    call CreateNUnitsAtLoc( 1, 'n004', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct_REG_Cage3_Start), 145.00 )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", GetRectCenter(gg_rct_REG_Cage3_Point) )
    set udg_UNIT_Zombie = GetLastCreatedUnit()
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 0.00 )
    call TriggerSleepAction( 1.00 )
    if ( Trig_Cage3_Func007C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Zombie, GetUnitName(udg_UNIT_Zombie), gg_snd_Zombie02, udg_TEXT_Zombie[2], bj_TIMETYPE_SET, 0.50, false )
        call TriggerSleepAction( 4.00 )
    else
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Zombie, GetUnitName(udg_UNIT_Zombie), gg_snd_Zombie01, udg_TEXT_Zombie[1], bj_TIMETYPE_SET, 1.00, false )
        call TriggerSleepAction( 4.00 )
    endif
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 100.00 )
endfunction

