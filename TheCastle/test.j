//===========================================================================
// Trigger: Boss Obelisk Attack
//===========================================================================
function Trig_Boss_Obelisk_Attack_Func007C takes nothing returns boolean
    if ( not ( udg_Boss1_stage == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Obelisk_Attack_Func009Func001001 takes nothing returns boolean
    return ( udg_Boss_Obelisk_condition[1] == true )
endfunction

function Trig_Boss_Obelisk_Attack_Func009Func001002001 takes nothing returns boolean
    return ( udg_Boss_Obelisk_condition[2] == true )
endfunction

function Trig_Boss_Obelisk_Attack_Func009Func001002002001 takes nothing returns boolean
    return ( udg_Boss_Obelisk_condition[3] == true )
endfunction

function Trig_Boss_Obelisk_Attack_Func009Func001002002002 takes nothing returns boolean
    return ( udg_Boss_Obelisk_condition[4] == true )
endfunction

function Trig_Boss_Obelisk_Attack_Func009Func001002002 takes nothing returns boolean
    return GetBooleanAnd( Trig_Boss_Obelisk_Attack_Func009Func001002002001(), Trig_Boss_Obelisk_Attack_Func009Func001002002002() )
endfunction

function Trig_Boss_Obelisk_Attack_Func009Func001002 takes nothing returns boolean
    return GetBooleanAnd( Trig_Boss_Obelisk_Attack_Func009Func001002001(), Trig_Boss_Obelisk_Attack_Func009Func001002002() )
endfunction

function Trig_Boss_Obelisk_Attack_Func009Func008C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_UNIT_Boss1, 'B000') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Obelisk_Attack_Func009C takes nothing returns boolean
    if ( not GetBooleanAnd( Trig_Boss_Obelisk_Attack_Func009Func001001(), Trig_Boss_Obelisk_Attack_Func009Func001002() ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Obelisk_Attack_Actions takes nothing returns nothing
    call PlaySoundBJ( gg_snd_AutoCastButtonClick1 )
    set udg_Boss_Obelisk_condition[udg_Boss_Obelisk_num] = true
    call SetUnitColor( udg_Boss_Obelisk[udg_Boss_Obelisk_num], GetPlayerColor(ConvertedPlayer(udg_Boss1_stage)) )
    call SetUnitAnimation( udg_Boss_Obelisk[udg_Boss_Obelisk_num], "stand alternate" )
    call StartTimerBJ( udg_Boss_Obelisk_Timer[udg_Boss_Obelisk_num], false, udg_Timer_Duration )
    // Меняем цвет молнии для Обелисков в зависимости от стадии
    if ( Trig_Boss_Obelisk_Attack_Func007C() ) then
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 4
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call UnitRemoveAbilityBJ( 'A012', udg_Boss_Obelisk[GetForLoopIndexA()] )
            call UnitAddAbilityBJ( 'A013', udg_Boss_Obelisk[GetForLoopIndexA()] )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    else
    endif
    // Если все обелиски активированы, то атакуем Повелителя Огня
    if ( Trig_Boss_Obelisk_Attack_Func009C() ) then
        call DisableTrigger( gg_trg_Boss_Obelisk1 )
        call DisableTrigger( gg_trg_Boss_Obelisk2 )
        call DisableTrigger( gg_trg_Boss_Obelisk3 )
        call DisableTrigger( gg_trg_Boss_Obelisk4 )
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 4
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call PauseTimerBJ( true, udg_Boss_Obelisk_Timer[GetForLoopIndexA()] )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        // Если на Повелителе Огня есть огненный щит
        if ( Trig_Boss_Obelisk_Attack_Func009Func008C() ) then
            call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_2574" )
            call PlaySoundBJ( gg_snd_Error )
            set bj_forLoopAIndex = 1
            set bj_forLoopAIndexEnd = 4
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                set udg_Boss_Obelisk_condition[GetForLoopIndexA()] = false
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        else
            set bj_forLoopAIndex = 1
            set bj_forLoopAIndexEnd = 4
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call IssueTargetOrderBJ( udg_Boss_Obelisk[GetForLoopIndexA()], "fingerofdeath", udg_UNIT_Boss1 )
                set udg_Boss_Obelisk_condition[GetForLoopIndexA()] = false
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
            set udg_Boss1_stage = ( udg_Boss1_stage + 1 )
        endif
        call TriggerSleepAction( 1.00 )
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 4
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetUnitAnimation( udg_Boss_Obelisk[GetForLoopIndexA()], "stand" )
            call SetUnitColor( udg_Boss_Obelisk[GetForLoopIndexA()], GetPlayerColor(Player(PLAYER_NEUTRAL_PASSIVE)) )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        call EnableTrigger( gg_trg_Boss_Obelisk1 )
        call EnableTrigger( gg_trg_Boss_Obelisk2 )
        call EnableTrigger( gg_trg_Boss_Obelisk3 )
        call EnableTrigger( gg_trg_Boss_Obelisk4 )
    else
    endif
endfunction

