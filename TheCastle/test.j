        set point = Location(GetRectCenterX(gg_rct_REG_Fire4_Top), GetRectCenterY(gg_rct_REG_Fire4_Top))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire4_Mid), GetRectCenterY(gg_rct_REG_Fire4_Mid))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire4_Bot), GetRectCenterY(gg_rct_REG_Fire4_Bot))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        call TriggerSleepAction( 0.01 )
        set point = Location(GetRectCenterX(gg_rct_REG_Fire5_Top), GetRectCenterY(gg_rct_REG_Fire5_Top))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire5_Mid), GetRectCenterY(gg_rct_REG_Fire5_Mid))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire5_Bot), GetRectCenterY(gg_rct_REG_Fire5_Bot))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        call TriggerSleepAction( 0.01 )
        set point = Location(GetRectCenterX(gg_rct_REG_Fire6_Top), GetRectCenterY(gg_rct_REG_Fire6_Top))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire6_Bot), GetRectCenterY(gg_rct_REG_Fire6_Bot))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        call TriggerSleepAction( 0.01 )
        set point = Location(GetRectCenterX(gg_rct_REG_Fire6_Mid), GetRectCenterY(gg_rct_REG_Fire6_Mid))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        call TriggerSleepAction( 0.10 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman03, udg_TEXT_Shaman[3], bj_TIMETYPE_SET, 2.00, false )
        call ShowDestructableBJ( false, gg_dest_B002_3154 )
        call ShowDestructableBJ( true, gg_dest_B003_3157 )
        call TriggerSleepAction( 0.05 )
        call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", GetUnitX(gg_unit_n00U_0184), GetUnitY(gg_unit_n00U_0184)))
        call TriggerSleepAction( 0.30 )
        call SetUnitAnimation( gg_unit_n00U_0184, "stand" )
        set point = null
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Таймер ожидания 3 с.
    if ( Trig_Cinematic_Book_Func026C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 3.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    if ( Trig_Cinematic_Book_Func027C() ) then
        loop
            exitwhen ( Trig_Cinematic_Book_Func027Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Демонстрация книги
    if ( Trig_Cinematic_Book_Func029C() ) then
        call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.80, "war3mapImported\\Book.tga", 100.00, 100.00, 100.00, 0 )
        call TriggerSleepAction( 0.80 )
        set udg_Book_open_Bool = true
        call SetDayNightModels( "Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdl ","Environment\\DNC\\DNCLordaeron\\DNCLordaeronUnit\\DNCLordaeronUnit.mdl")
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Таймер ожидания 2 с.
    if ( Trig_Cinematic_Book_Func031C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 2.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    if ( Trig_Cinematic_Book_Func032C() ) then
        loop
            exitwhen ( Trig_Cinematic_Book_Func032Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Сообщение Нитнарака
    if ( Trig_Cinematic_Book_Func034C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_warrior, GetHeroProperName(udg_Hero_warrior), gg_snd_Warrior05, udg_TEXT_Warrior[5], bj_TIMETYPE_SET, 3.50, false )
        call ShowDestructableBJ( true, gg_dest_B002_3154 )
        call ShowDestructableBJ( false, gg_dest_B003_3157 )
        call SetUnitAnimation( gg_unit_n00U_0184, "stand second" )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Таймер ожидания 5 с.
    if ( Trig_Cinematic_Book_Func036C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 5.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    if ( Trig_Cinematic_Book_Func037C() ) then
        loop
            exitwhen ( Trig_Cinematic_Book_Func037Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Смена камеры
    if ( Trig_Cinematic_Book_Func039C() ) then
        call ForForce( udg_Players, function Trig_Cinematic_Book_Func039Func001A )
    else
        call TriggerExecute( gg_trg_Starting_Game )
        return
    endif
    // Закрытие книги и сообщение Нитнарака
    if ( Trig_Cinematic_Book_Func041C() ) then
        call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", GetUnitX(gg_unit_n00U_0184), GetUnitY(gg_unit_n00U_0184)))
        call SetDayNightModels( "","")
        call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.80, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0 )
        set udg_Book_open_Bool = false
        call TriggerSleepAction( 0.50 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_warrior, GetHeroProperName(udg_Hero_warrior), gg_snd_Warrior06, udg_TEXT_Warrior[6], bj_TIMETYPE_SET, 3.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Таймер ожидания 3.5 с.
    if ( Trig_Cinematic_Book_Func043C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 3.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    if ( Trig_Cinematic_Book_Func044C() ) then
        loop
            exitwhen ( Trig_Cinematic_Book_Func044Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Сообщение Тетинумми 1
    if ( Trig_Cinematic_Book_Func046C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic18, udg_TEXT_Mechanic[18], bj_TIMETYPE_SET, 8.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Таймер ожидания 7.5 с.
    if ( Trig_Cinematic_Book_Func048C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 7.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    if ( Trig_Cinematic_Book_Func049C() ) then
        loop
            exitwhen ( Trig_Cinematic_Book_Func049Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Сообщение Тетинумми 2
    if ( Trig_Cinematic_Book_Func051C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, GetHeroProperName(udg_Hero_mechanic), gg_snd_Mechanic19, udg_TEXT_Mechanic[19], bj_TIMETYPE_SET, 4.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Таймер ожидания 4 с.
    if ( Trig_Cinematic_Book_Func053C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 4.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    if ( Trig_Cinematic_Book_Func054C() ) then
        loop
            exitwhen ( Trig_Cinematic_Book_Func054Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    set point = null
    // ЗАВЕРШЕНИЕ СЪЁМОК
    call TriggerExecute( gg_trg_Cinematic_Book_Ending )
endfunction

