    call TriggerAddAction( gg_trg_Cinematic_Traveler_Ending, function Trig_Cinematic_Traveler_Ending_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Marauder
//
// Я уже думал, что мне конец! Всю мою команду перебили скелеты, а меня чуть не сожрали эти чертовы крысы. Но мне повезло.
// Этот Замок - очень страшное и опасное место! А стены его прячут несметные богатства. Мы думали, что сможем быстро разбогатеть, если проберемся сюда. 
// Но раз уж я остался в живых, могу вам кое-что предложить за скромненькую сумму. Мы нашли здесь драгоценные камни и древние книги. Мне они ни к чему, а вот золотишко лишним не будет.
//===========================================================================
function Trig_Cinematic_Marauder_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetUnitUserData(udg_UNIT_Marauder) == 1 ) ) then
        return false
    endif
    return true
endfunction

