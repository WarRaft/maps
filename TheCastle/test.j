function InitTrig_Cinematic_BOSS2 takes nothing returns nothing
    set gg_trg_Cinematic_BOSS2 = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Cinematic_BOSS2, gg_rct_REG_Boss2_Intro )
    call TriggerAddCondition( gg_trg_Cinematic_BOSS2, Condition( function Trig_Cinematic_BOSS2_Conditions ) )
    call TriggerAddAction( gg_trg_Cinematic_BOSS2, function Trig_Cinematic_BOSS2_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic BOSS2 Ending
//===========================================================================
function Trig_Cinematic_BOSS2_Ending_Func011A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Boss2_09, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_BOSS2_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call SetDayNightModels( "","")
    call SetTerrainFogExBJ( 0, 0.00, 6000.00, 100.00, 0.00, 0.00, 0.00 )
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.30 )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_BOSS2_Ending_Func011A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call CinematicModeExBJ( false, GetPlayersAll(), 0.60 )
endfunction

//===========================================================================
function InitTrig_Cinematic_BOSS2_Ending takes nothing returns nothing
    set gg_trg_Cinematic_BOSS2_Ending = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_BOSS2_Ending )
    call TriggerAddAction( gg_trg_Cinematic_BOSS2_Ending, function Trig_Cinematic_BOSS2_Ending_Actions )
endfunction

//===========================================================================
// Trigger: First Activating robot
//
// Оказывается, синие генераторы связаны не только с подъемником, но и с этой машиной. Они не дают ей разрушиться. А заводы каким-то образом дают энергию для этих генераторов. Поэтому нужно уничтожить как можно больше танков, прежде чем последний завод будет разрушен.
// А зaвoды кaким-тo oбpaзoм дaют энepгию для этиx гeнepaтopoв. Пoэтoмy нyжнo yничтoжить кaк мoжнo бoльшe тaнкoв, пpeждe чeм пocлeдний зaвoд бyдeт рaзpyшeн.
//===========================================================================
function Trig_First_Activating_robot_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A009' ) ) then
        return false
    endif
    if ( not ( GetSpellTargetUnit() == udg_UNIT_Robot ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Activating_robot_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Robot_Activation_Bool = true
    call RescueUnitBJ( udg_UNIT_Robot, GetOwningPlayer(GetTriggerUnit()), false )
    call IssueTargetOrderBJ( udg_Hero_mechanic, "board", udg_UNIT_Robot )
    call UnitRemoveAbilityBJ( 'Avul', udg_UNIT_Robot )
    call UnitAddAbilityBJ( 'A050', udg_UNIT_Robot )
    call SetUnitTimeScalePercent( udg_UNIT_Robot, 100.00 )
    set udg_Hero_mechanic = udg_UNIT_Robot
    call SelectUnitForPlayerSingle( udg_Hero_mechanic, GetOwningPlayer(udg_Hero_mechanic) )
    // См. папку "_Босс2 (Адская колесница)"
    call EnableTrigger( gg_trg_Activation_robot )
    call EnableTrigger( gg_trg_Deactivation_robot )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 0.00 )
    call TriggerSleepAction( 1.00 )
    call UnitAddIndicatorBJ( udg_UNIT_Robot, 100, 100, 100, 0 )
    call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, udg_Name_Mechanic, gg_snd_Mechanic12, udg_TEXT_Mechanic[12], bj_TIMETYPE_SET, 7.00, false )
    call TriggerSleepAction( 10.00 )
    call UnitAddIndicatorBJ( udg_UNIT_Robot, 100, 100, 100, 0 )
    call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_mechanic, udg_Name_Mechanic, gg_snd_Mechanic13, udg_TEXT_Mechanic[13], bj_TIMETYPE_SET, 10.00, false )
    call TriggerSleepAction( 13.00 )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 100.00 )
endfunction

//===========================================================================
function InitTrig_First_Activating_robot takes nothing returns nothing
    set gg_trg_First_Activating_robot = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_First_Activating_robot, Player(0), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_First_Activating_robot, Player(1), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_First_Activating_robot, Player(2), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_First_Activating_robot, Condition( function Trig_First_Activating_robot_Conditions ) )
    call TriggerAddAction( gg_trg_First_Activating_robot, function Trig_First_Activating_robot_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Tesseract
//
// - Это же легендарный Тессеракт! Древний магический артефакт, способный уменьшать предметы внутри себя до мельчайших частиц. 
// - При этом сам Тессеракт и предметы внутри него не имеют массы.
// - Тессеракт может вместить в себя до шести предметов. Маги часто использовали его в своих опытах.
// - Это сумка чтоли?
// - Ну... Можно и так сказать.
//===========================================================================
function Trig_Cinematic_Tesseract_Func016A takes nothing returns nothing
    call ClearSelectionForPlayer( GetEnumPlayer() )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Tesseract_01, Player(0), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Tesseract_02, Player(0), 60.00 )
endfunction

function Trig_Cinematic_Tesseract_Func021A takes nothing returns nothing
    // Для Тессеракта
    call SetPlayerAllianceStateBJ( GetEnumPlayer(), Player(7), bj_ALLIANCE_ALLIED )
    call SetPlayerAllianceStateBJ( Player(7), GetEnumPlayer(), bj_ALLIANCE_ALLIED )
    call SetPlayerAllianceBJ( Player(7), ALLIANCE_SHARED_CONTROL, true, GetEnumPlayer() )
endfunction

