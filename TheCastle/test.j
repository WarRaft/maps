//===========================================================================
// Trigger: Use mechanism
//===========================================================================
function Trig_Use_mechanism_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A009' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Use_mechanism_Func005Func001Func001Func001C takes nothing returns boolean
    if ( not ( udg_Switch_condition[GetForLoopIndexA()] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Use_mechanism_Func005Func001Func001C takes nothing returns boolean
    if ( not ( GetSpellTargetDestructable() == udg_Switch[GetForLoopIndexA()] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Use_mechanism_Func005C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetSpellTargetDestructable()) == 'B00D' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Use_mechanism_Func007C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetSpellTargetDestructable()) == 'B00E' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Use_mechanism_Func009Func003C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Fire2) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Use_mechanism_Func009C takes nothing returns boolean
    if ( not ( GetSpellTargetUnit() == gg_unit_n00D_0072 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Use_mechanism_Actions takes nothing returns nothing
    // Цель: Переключатели
    if ( Trig_Use_mechanism_Func005C() ) then
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = udg_Switch_num
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            if ( Trig_Use_mechanism_Func005Func001Func001C() ) then
                if ( Trig_Use_mechanism_Func005Func001Func001Func001C() ) then
                    call SetDestructableAnimationBJ( udg_Switch[GetForLoopIndexA()], "Death" )
                else
                    call SetDestructableAnimationBJ( udg_Switch[GetForLoopIndexA()], "Stand" )
                    call PlaySoundAtPointBJ( gg_snd_Lever, 100, GetDestructableLoc(udg_Switch[GetForLoopIndexA()]), 0 )
                endif
                call TriggerExecute( gg_trg_Switch )
            else
            endif
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    else
    endif
    // Цель: Одноразовые рычаги
    if ( Trig_Use_mechanism_Func007C() ) then
        call KillDestructable( GetSpellTargetDestructable() )
    else
    endif
    // Цель: Неисправный гоблин
    if ( Trig_Use_mechanism_Func009C() ) then
        call PlaySoundAtPointBJ( gg_snd_MetalHeavySliceMetal1, 100, GetUnitLoc(gg_unit_n00D_0072), 0 )
        // Активируем гоблина
        if ( Trig_Use_mechanism_Func009Func003C() ) then
            call SetUnitTimeScalePercent( GetSpellTargetUnit(), 100.00 )
            call IssueTargetDestructableOrder( GetSpellTargetUnit(), "attack", gg_dest_LTex_1000 )
        else
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Use_mechanism takes nothing returns nothing
    set gg_trg_Use_mechanism = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Use_mechanism, Player(0), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Use_mechanism, Player(1), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Use_mechanism, Player(2), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Use_mechanism, Condition( function Trig_Use_mechanism_Conditions ) )
    call TriggerAddAction( gg_trg_Use_mechanism, function Trig_Use_mechanism_Actions )
endfunction

//===========================================================================
// Trigger: Lighting Charge
//===========================================================================
function Trig_Lighting_Charge_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A018' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lighting_Charge_Actions takes nothing returns nothing
    local player dummy_player = Player(4)
    local location point = GetSpellTargetLoc()
    local unit dummy_unit
    // Создаем дамми-юнита, уничтожающего тени
    set dummy_unit = CreateUnit(dummy_player, 'n01L', GetLocationX(point), GetLocationY(point), 0)
    call UnitApplyTimedLife( dummy_unit, 'BTLF', 4.6 )
    call UnitAddAbility( dummy_unit, 'A000' )
    call SetUnitFlyHeight( dummy_unit, 0, 238.00 )
    call IssuePointOrder( dummy_unit, "flare", GetLocationX(point), GetLocationY(point) )
    // Обнуление переменных
    call RemoveLocation(point)
    set point = null
    set dummy_unit = null
endfunction

//===========================================================================
function InitTrig_Lighting_Charge takes nothing returns nothing
    set gg_trg_Lighting_Charge = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Lighting_Charge, Player(0), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Lighting_Charge, Player(1), EVENT_PLAYER_UNIT_SPELL_EFFECT )
