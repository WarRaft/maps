function Trig_Summon_Skeleton_healers_Actions takes nothing returns nothing
    local unit healer_unit1
    local real x1 = 130
    local real y1 = -7930
    local unit healer_unit2
    local real x2 = 580
    local real y2 = -8190
    local unit healer_unit3
    local real x3 = 1020
    local real y3 = -7930
    set healer_unit1 = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'u00F', x1, y1, 45 )
    set healer_unit2 = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'u00F', x2, y2, 90 )
    set healer_unit3 = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'u00F', x3, y3, 135 )
    call GroupAddUnitSimple( healer_unit1, udg_Archmage_Heal_Group )
    call GroupAddUnitSimple( healer_unit2, udg_Archmage_Heal_Group )
    call GroupAddUnitSimple( healer_unit3, udg_Archmage_Heal_Group )
    call UnitApplyTimedLife( healer_unit1, 'BTLF', 60 )
    call UnitApplyTimedLife( healer_unit2, 'BTLF', 60 )
    call UnitApplyTimedLife( healer_unit3, 'BTLF', 60 )
    // Создание эффекта появления
    call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl", x1, y1 ) )
    call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl", x2, y2 ) )
    call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl", x3, y3 ) )
    // Обнуление переменных
    set healer_unit1 = null
    set healer_unit2 = null
    set healer_unit3 = null
endfunction

