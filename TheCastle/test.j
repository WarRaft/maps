    set gg_trg_Extra_Skills = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Extra_Skills, EVENT_PLAYER_HERO_SKILL )
    call TriggerAddAction( gg_trg_Extra_Skills, function Trig_Extra_Skills_Actions )
endfunction

