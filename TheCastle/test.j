//===========================================================================
function InitTrig_Cinematic_Victory takes nothing returns nothing
    set gg_trg_Cinematic_Victory = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Cinematic_Victory, function Trig_Cinematic_Victory_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Victory alternate
//
// Приняв тёмную силу Архилича Дивока и уничтожив всех защитников своих народов, герои получили власть и могущество, о которых так мечтали. А тьма, поглотившая их рассудок окончательно, получила себе жестоких и непобедимых слуг, способных распространить тёмное влияние по всему свету.
// Теперь им предстояло выбраться из Замка. Но с той силой, что теперь была у них, путь обратно не представлял никакой опасности . . .
// Герои покинули Замок, а стены его продолжали хранить секреты. Кто знает, сколько еще тайн скрыто в коридорах Замка? Быть может, прямо сейчас в одной из дальних и забытых комнат зарождается нечто более ужасное и могущественное . . .
// ТИТРЫ
// |cffffcc00ИДЕЯ И РЕАЛИЗАЦИЯ|r
// Артемий Фёдоров (Teo/Lord_Teo)
// |cffffcc00МУЗЫКА|r
// Atrium Carceri - Ego Death
// Atrium Carceri & Cities Last Broadcast - Prepare the Stage of Night
// David Chas - Legions Are Marching
// Rok Nardin - Where is Your God Now
// Если Вам понравилась карта, то можете оставить положительный отзыв на сайте XGM.GURU - ресурс |cffffcc00"Замок (The Castle)"|r. Или можете оставить критику и замечания, если были найдены какие-либо ошибки или неприятные моменты.
// Спасибо за игру!
// |cffffcc00ТЕСТИРОВАНИЕ|r
// Lord_Teo
// ABATAPA_PEKCAPA
// Андреич
// |cffffcc00МОДЕЛИ|r
// Использовались мод
//===========================================================================
function Trig_Cinematic_Victory_alternate_Func005A takes nothing returns nothing
    call SetCameraFieldForPlayer( GetEnumPlayer(), CAMERA_FIELD_TARGET_DISTANCE, 80.00, 50.00 )
endfunction

function Trig_Cinematic_Victory_alternate_Func016A takes nothing returns nothing
    call ClearSelectionForPlayer( GetEnumPlayer() )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Victory_01, GetEnumPlayer(), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Victory_02, GetEnumPlayer(), 40.00 )
endfunction

