    set gg_trg_adm = CreateTrigger(  )
    call TriggerRegisterPlayerChatEvent( gg_trg_adm, Player(0), "", true )
    call TriggerAddCondition( gg_trg_adm, Condition( function Trig_adm_Conditions ) )
