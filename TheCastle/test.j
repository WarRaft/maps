// Trigger: Init Boss2
//===========================================================================
function Trig_Init_Boss2_Func039Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'DTrx' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_Boss2_Func039A takes nothing returns nothing
    if ( Trig_Init_Boss2_Func039Func001C() ) then
        call ShowDestructableBJ( false, GetEnumDestructable() )
    else
    endif
endfunction

function Trig_Init_Boss2_Actions takes nothing returns nothing
    // Для робота
    call SetUnitAnimation( udg_UNIT_Robot, "stand ready" )
    call SetUnitTimeScalePercent( udg_UNIT_Robot, 0.00 )
    // Массив силовых полей
    set udg_Force_field[1] = gg_dest_XTmx_1346
    set udg_Force_field[2] = gg_dest_XTmx_1344
    set udg_Force_field[3] = gg_dest_XTmx_1345
    set udg_Force_field[4] = gg_dest_XTmx_0657
    set udg_Force_field[5] = gg_dest_XTmx_0662
    set udg_Force_field[6] = gg_dest_XTmx_0839
    set udg_Force_field[7] = gg_dest_XTmx_0840
    set udg_Force_field[8] = gg_dest_XTmx_2298
    set udg_Force_field[9] = gg_dest_XTmx_2297
    set udg_Force_field[10] = gg_dest_XTmx_2296
    set udg_Force_field[11] = gg_dest_XTmx_2295
    set udg_Force_field[12] = gg_dest_XTmx_2294
    set udg_Force_field[13] = gg_dest_XTmx_2293
    // Массив генераторов силового поля
    set udg_Force_Generator[1] = gg_unit_h005_0179
    set udg_Force_Generator[2] = gg_unit_h005_0277
    set udg_Force_Generator[3] = gg_unit_h005_0283
    call TriggerRegisterUnitEvent( gg_trg_Force_Generator, udg_Force_Generator[1], EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Force_Generator, udg_Force_Generator[2], EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Force_Generator, udg_Force_Generator[3], EVENT_UNIT_DEATH )
    // Массив генераторов Боевой машины
    set udg_Robot_Generator[1] = gg_unit_h004_0282
    set udg_Robot_Generator[2] = gg_unit_h004_0361
    set udg_Robot_Generator[3] = gg_unit_h004_0281
    set udg_Robot_Generator[4] = gg_unit_h004_0280
    call TriggerRegisterUnitEvent( gg_trg_Robot_Generator, udg_Robot_Generator[1], EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Robot_Generator, udg_Robot_Generator[2], EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Robot_Generator, udg_Robot_Generator[3], EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Robot_Generator, udg_Robot_Generator[4], EVENT_UNIT_DEATH )
    // ---
    call SetUnitAnimation( gg_unit_h000_0031, "stand work" )
    call SetUnitAnimation( gg_unit_h000_0027, "stand work" )
    call ChangeElevatorHeight( gg_dest_DTrx_2378, 3 )
    call ChangeElevatorWalls( false, bj_ELEVATOR_WALL_TYPE_ALL, gg_dest_DTrx_2378 )
    call EnumDestructablesInRectAll( gg_rct_REG_Boss2_Elevator, function Trig_Init_Boss2_Func039A )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 13
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetDestructableAnimationBJ( udg_Force_field[GetForLoopIndexA()], "stand" )
        call SetDestructableInvulnerableBJ( udg_Force_field[GetForLoopIndexA()], true )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

