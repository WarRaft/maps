//===========================================================================
// Trigger: Lightning Storm
//
// Структура хэш-таблицы для умения:
// x.1 - координата X точки применения умения
// x.2 - координата Y точки применения умения
// x.3 - значение boolean для определения процесса применения умения 
//===========================================================================
function Trig_Lightning_Storm_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05H' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Storm_Actions takes nothing returns nothing
    local player dummy_player = Player(PLAYER_NEUTRAL_PASSIVE)
    local unit dummy_unit1
    local unit dummy_unit2
    local unit dummy_unit3
    local real x1 = GetUnitX (udg_Hero_warrior)
    local real y1 = GetUnitY (udg_Hero_warrior)
    local real x2 = GetUnitX (udg_Hero_shaman)
    local real y2 = GetUnitY (udg_Hero_shaman)
    local real x3 = GetUnitX (udg_Hero_mechanic)
    local real y3 = GetUnitY (udg_Hero_mechanic)
    // Сохраняем координаты точек применения умения в хэш-таблицу
    call SaveRealBJ( x1, 31, 1, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( y1, 31, 2, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( x2, 32, 1, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( y2, 32, 2, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( x3, 33, 1, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( y3, 33, 2, GetLastCreatedHashtableBJ() )
    // Сохраняем значение "Да" для нашего умения в хэш-таблицу для фиксации процесса начала применения
    call SaveBooleanBJ( true, 30, 3, GetLastCreatedHashtableBJ() )
    // Создаем юниты-пустышки в виде маркеров в точках применения умения
    set dummy_unit1 = TeoCreateUnit (dummy_player, 'n02L', x1, y1, 0)
    call UnitApplyTimedLife( dummy_unit1, 'BTLF', 2 )
    set dummy_unit2 = TeoCreateUnit (dummy_player, 'n02L', x2, y2, 0)
    call UnitApplyTimedLife( dummy_unit2, 'BTLF', 2 )
    set dummy_unit3 = TeoCreateUnit (dummy_player, 'n02L', x3, y3, 0)
    call UnitApplyTimedLife( dummy_unit3, 'BTLF', 2 )
    call SetUnitAnimation( dummy_unit1, "birth" )
    call SetUnitAnimation( dummy_unit2, "birth" )
    call SetUnitAnimation( dummy_unit3, "birth" )
    call QueueUnitAnimationBJ( dummy_unit1, "stand" )
    call QueueUnitAnimationBJ( dummy_unit2, "stand" )
    call QueueUnitAnimationBJ( dummy_unit3, "stand" )
    call StartTimerBJ( udg_Lighting_Storm_Timer, false, 2.20 )
    // Обнуление переменных
    set dummy_player = null
    set dummy_unit1 = null
    set dummy_unit2 = null
    set dummy_unit3 = null
endfunction

//===========================================================================
function InitTrig_Lightning_Storm takes nothing returns nothing
    set gg_trg_Lightning_Storm = CreateTrigger(  )
    call DisableTrigger( gg_trg_Lightning_Storm )
    call TriggerAddCondition( gg_trg_Lightning_Storm, Condition( function Trig_Lightning_Storm_Conditions ) )
    call TriggerAddAction( gg_trg_Lightning_Storm, function Trig_Lightning_Storm_Actions )
endfunction

//===========================================================================
// Trigger: Lightning Storm timer
//===========================================================================
function Trig_Lightning_Storm_timer_Func010C takes nothing returns boolean
    if ( not ( LoadBooleanBJ(30, 3, GetLastCreatedHashtableBJ()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Storm_timer_Actions takes nothing returns nothing
    local player dummy_player = Player(PLAYER_NEUTRAL_PASSIVE)
    local unit dummy_unit
    local real x1 = LoadRealBJ(31, 1, GetLastCreatedHashtableBJ())
    local real y1 = LoadRealBJ(31, 2, GetLastCreatedHashtableBJ())
    local real x2 = LoadRealBJ(32, 1, GetLastCreatedHashtableBJ())
    local real y2 = LoadRealBJ(32, 2, GetLastCreatedHashtableBJ())
    local real x3 = LoadRealBJ(33, 1, GetLastCreatedHashtableBJ())
    local real y3 = LoadRealBJ(33, 2, GetLastCreatedHashtableBJ())
    // Если применение умения не прерывалось
    if ( Trig_Lightning_Storm_timer_Func010C() ) then
        set dummy_unit = TeoCreateDummyUnit( dummy_player, 'n00X', x1, y1, null )
        call UnitDamagePoint(dummy_unit, 0, 190.00, x1, y1,1000.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call UnitDamagePoint(dummy_unit, 0, 190.00, x2, y2,1000.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call UnitDamagePoint(dummy_unit, 0, 190.00, x3, y3,1000.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call DestroyEffect( AddSpecialEffect( "EFFECTS\\Stormfall.mdx", x1, y1) )
        call DestroyEffect( AddSpecialEffect( "EFFECTS\\Stormfall.mdx", x2, y2) )
        call DestroyEffect( AddSpecialEffect( "EFFECTS\\Stormfall.mdx", x3, y3) )
        call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", x1, y1) )
        call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", x2, y2) )
        call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", x3, y3) )
    else
    endif
    // Обнуление переменных
    set dummy_player = null
    set dummy_unit = null
endfunction

