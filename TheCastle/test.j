//===========================================================================
// Trigger: Marauder
//===========================================================================
function Trig_Marauder_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Marauder_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_Cinematic_Marauder )
    call CreateFogModifierRadiusLocBJ( true, Player(0), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_REG_Point_of_View1), 450.00 )
    set udg_Eye[1] = GetLastCreatedFogModifier()
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc( 1, 'n01O', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct_REG_Rats_Spawn), bj_UNIT_FACING )
        call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Rats_Group )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "attack", udg_UNIT_Marauder )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call SetPlayerAllianceStateBJ( Player(PLAYER_NEUTRAL_PASSIVE), Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_UNALLIED )
    call TriggerSleepAction( 0.50 )
    call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Marauder, "TRIGSTR_2781", gg_snd_Marauder01, "TRIGSTR_2782", bj_TIMETYPE_SET, 2.00, false )
    call TriggerSleepAction( 2.50 )
    call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Marauder, "TRIGSTR_2789", gg_snd_Marauder02, "TRIGSTR_2790", bj_TIMETYPE_ADD, 0.00, false )
endfunction

