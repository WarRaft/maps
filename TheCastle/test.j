//===========================================================================
function Trig_Music_note_Timer_Func001C takes nothing returns boolean
    if ( not ( udg_Music == 11 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Music_note_Timer_Actions takes nothing returns nothing
    if ( Trig_Music_note_Timer_Func001C() ) then
        call TriggerExecute( gg_trg_Music_notes_Activation )
    else
        set udg_Music = 0
        call ShowDestructableBJ( false, gg_dest_B009_10778 )
        call ShowDestructableBJ( false, gg_dest_B007_10689 )
        call ShowDestructableBJ( false, gg_dest_B006_10784 )
        call ShowDestructableBJ( false, gg_dest_B009_10787 )
        call ShowDestructableBJ( false, gg_dest_B007_10782 )
        call ShowDestructableBJ( false, gg_dest_B00A_10780 )
        call ShowDestructableBJ( false, gg_dest_B006_10785 )
        call ShowDestructableBJ( false, gg_dest_B009_10777 )
        call ShowDestructableBJ( false, gg_dest_B007_10781 )
        call ShowDestructableBJ( false, gg_dest_B006_10786 )
        call ShowDestructableBJ( false, gg_dest_B007_10783 )
        call ShowDestructableBJ( false, gg_dest_B009_10779 )
    endif
endfunction

