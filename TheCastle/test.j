        return false
    endif
    return true
endfunction

function Trig_Moving_HellishCreature_Func003C takes nothing returns boolean
    if ( not ( udg_HellishCreature_random == GetUnitUserData(udg_UNIT_HellishCreature) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moving_HellishCreature_Actions takes nothing returns nothing
    set udg_HellishCreature_random = GetRandomInt(1, 3)
    if ( Trig_Moving_HellishCreature_Func003C() ) then
        call TriggerExecute( GetTriggeringTrigger() )
    else
        call SetUnitPositionLoc( udg_UNIT_HellishCreature, GetRectCenter(udg_HellishCreature_zone[udg_HellishCreature_random]) )
        call SetUnitAnimation( udg_UNIT_HellishCreature, "birth" )
        call QueueUnitAnimationBJ( udg_UNIT_HellishCreature, "stand" )
        call SetUnitUserData( udg_UNIT_HellishCreature, udg_HellishCreature_random )
    endif
endfunction

