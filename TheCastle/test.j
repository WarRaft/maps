//===========================================================================
// Trigger: Starting Cinematic
//
// TEXT_Warrior[1] = Вот, мы и добрались.
// TEXT_Mechanic[1] = В этом Замке нас ждут трудные испытания. Нам нужно держаться вместе, чтобы преодолеть их все.
// TEXT_Shaman[1] = Мы - надежда наших народов. Наши навыки и умения помогут нам справиться с любой опасностью. Вперёд, друзья!
//===========================================================================
function Trig_Starting_Cinematic_Func014A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Intro_001, GetEnumPlayer(), 0 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Intro_002, GetEnumPlayer(), 15.00 )
endfunction

function Trig_Starting_Cinematic_Func019C takes nothing returns boolean
    if ( not ( udg_Cinematic_skipped == false ) ) then
        return false
    endif
    return true
endfunction

