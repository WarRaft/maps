    set gg_trg_Init_Puzzles = CreateTrigger(  )
    call DisableTrigger( gg_trg_Init_Puzzles )
    call TriggerAddAction( gg_trg_Init_Puzzles, function Trig_Init_Puzzles_Actions )
endfunction

//===========================================================================
// Trigger: Destoying Easy Puzzle
//===========================================================================
function Trig_Destoying_Easy_Puzzle_Func007A takes nothing returns nothing
    local unit enum_unit = GetEnumUnit()
    local real x = GetUnitX(enum_unit)
    local real y = GetUnitY(enum_unit)
    if ( GetUnitTypeId(enum_unit) != 'nmgv') then
        call KillUnit( enum_unit )
        call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", x, y ))
        set enum_unit = null
    else
        if (RectContainsCoords(udg_EasyPuzzle_Region[1], x, y) == false) then
            if (RectContainsCoords(udg_EasyPuzzle_Region[2], x, y) == false) then
                if (RectContainsCoords(udg_EasyPuzzle_Region[3], x, y) == false) then
                    if (RectContainsCoords(udg_EasyPuzzle_Region[4], x, y) == false) then
                        if (RectContainsCoords(udg_EasyPuzzle_Region[5], x, y) == false) then
                            if (RectContainsCoords(udg_EasyPuzzle_Region[6], x, y) == false) then
                                if (RectContainsCoords(udg_EasyPuzzle_Region[7], x, y) == false) then
                                    if (RectContainsCoords(udg_EasyPuzzle_Region[8], x, y) == false) then
                                        call KillUnit( enum_unit )
                                        call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", x, y ))
                                        set enum_unit = null
                                    endif
                               endif
                            endif
                        endif
                    endif
                endif
            endif
        endif
    endif
endfunction

function Trig_Destoying_Easy_Puzzle_Func011A takes nothing returns nothing
    local unit enum_unit = GetEnumUnit()
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( (RectContainsCoords(udg_EasyPuzzle_Region[GetForLoopIndexA()], GetUnitX(enum_unit), GetUnitY(enum_unit)) == true) and (udg_EasyPuzzle_Available_Box[GetForLoopIndexA()] == false) ) then
            set udg_EasyPuzzle_Available_Box[GetForLoopIndexA()] = true
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set enum_unit = null
endfunction

function Trig_Destoying_Easy_Puzzle_Func013Func001C takes nothing returns boolean
    if ( not ( udg_EasyPuzzle_Available_Box[GetForLoopIndexA()] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Destoying_Easy_Puzzle_Func015C takes nothing returns boolean
    if ( not ( IsUnitGroupEmptyBJ(udg_EasyPuzzle_Group_New) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Destoying_Easy_Puzzle_Actions takes nothing returns nothing
    local location point
    local unit temp_unit
    set udg_BoxSize = 0.00
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_EasyPuzzle_Available_Box[GetForLoopIndexA()] = false
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call GroupClear( udg_EasyPuzzle_Group_New )
    // Убиваем всех юнитов в области (кроме ящиков), а также уничтожаем ящики, которые находятся не на нужных местах
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_REG_Easy_Puzzle), function Trig_Destoying_Easy_Puzzle_Func007A )
    call TriggerSleepAction( 0.70 )
    call EnableTrigger( gg_trg_Death_of_EasyPuzzleBox )
    // Проверяем места на необходимость создания ящика
    call ForGroupBJ( udg_EasyPuzzle_Group, function Trig_Destoying_Easy_Puzzle_Func011A )
    // Создаем ящики, в нужных местах, если там нет ящика
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Destoying_Easy_Puzzle_Func013Func001C() ) then
            set point = GetRectCenter(udg_EasyPuzzle_Region[GetForLoopIndexA()])
            set temp_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'nmgv', GetLocationX(point),GetLocationY(point), 45.00 )
            call GroupAddUnitSimple( temp_unit, udg_EasyPuzzle_Group )
            call GroupAddUnitSimple( temp_unit, udg_EasyPuzzle_Group_New )
            call SetUnitScalePercent( temp_unit, 0.00, 0.00, 0.00 )
            call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", GetLocationX(point), GetLocationY(point) ))
            call RemoveLocation(point)
            set point = null
            set temp_unit = null
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction( 0.20 )
    if ( Trig_Destoying_Easy_Puzzle_Func015C() ) then
        call StartTimerBJ( udg_EasyPuzzle_Size_Timer, false, 0.04 )
    else
    endif
endfunction

//===========================================================================
