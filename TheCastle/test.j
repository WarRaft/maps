function Trig_Cinematic_BOSS3_Actions takes nothing returns nothing
    set udg_Cinematic_skipped = false
    // НАЧАЛО СЪЁМОК
    call StopMusicBJ( false )
    call PlayMusicBJ( gg_snd_Boss3 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.40 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( true )
    call IssueImmediateOrderBJ( udg_Hero_mechanic, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_shaman, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_warrior, "stop" )
    call SetUnitPositionLocFacingBJ( udg_Hero_warrior, GetRectCenter(gg_rct_REG_Warrior_Ending1), 90.00 )
    call SetUnitPositionLocFacingBJ( udg_Hero_shaman, GetRectCenter(gg_rct_REG_Shaman_Ending1), 90.00 )
    call SetUnitPositionLocFacingBJ( udg_Hero_mechanic, GetRectCenter(gg_rct_REG_Mechanic_Ending1), 90.00 )
    call TriggerSleepAction( 0.10 )
    call PauseUnitBJ( false, udg_Hero_warrior )
    call PauseUnitBJ( false, udg_Hero_shaman )
    call PauseUnitBJ( false, udg_Hero_mechanic )
    call IssuePointOrderLocBJ( udg_Hero_warrior, "move", GetRectCenter(gg_rct_REG_Warrior_Ending2) )
    call IssuePointOrderLocBJ( udg_Hero_shaman, "move", GetRectCenter(gg_rct_REG_Shaman_Ending2) )
    call IssuePointOrderLocBJ( udg_Hero_mechanic, "move", GetRectCenter(gg_rct_REG_Mechanic_Ending2) )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.00 )
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_BOSS3_Func026A )
    // Ввод изображения
    call CinematicModeExBJ( true, GetPlayersAll(), 0.60 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    // Таймер ожидания 1.5 с.
    if ( Trig_Cinematic_BOSS3_Func032C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS3_Func033C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS3_Func033Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Сообщение Дивока 1
    if ( Trig_Cinematic_BOSS3_Func035C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Boss3_Archmage, "TRIGSTR_4256", gg_snd_Archmage1, "TRIGSTR_4257", bj_TIMETYPE_SET, 20.20, false )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Таймер ожидания 21.5 с.
    if ( Trig_Cinematic_BOSS3_Func037C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 21.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS3_Func038C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS3_Func038Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Сообщение Дивока 2
    if ( Trig_Cinematic_BOSS3_Func040C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Boss3_Archmage, "TRIGSTR_4264", gg_snd_Archmage2, "TRIGSTR_4265", bj_TIMETYPE_SET, 19.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Таймер ожидания 19.5 с.
    if ( Trig_Cinematic_BOSS3_Func042C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 19.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS3_Func043C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS3_Func043Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Сообщение Дивока 3
    if ( Trig_Cinematic_BOSS3_Func045C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Boss3_Archmage, "TRIGSTR_4266", gg_snd_Archmage3, "TRIGSTR_4267", bj_TIMETYPE_SET, 7.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_BOSS3_Func047C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS3_Func048C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS3_Func048Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Смена камеры
    if ( Trig_Cinematic_BOSS3_Func050C() ) then
        call ForForce( udg_Players, function Trig_Cinematic_BOSS3_Func050Func001A )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_BOSS3_Func052C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS3_Func053C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS3_Func053Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Восстанавливаем решетку
    if ( Trig_Cinematic_BOSS3_Func055C() ) then
        call DestructableRestoreLife( gg_dest_B00S_9043, 500.00, true )
        call DestructableRestoreLife( gg_dest_B00S_9044, 500.00, true )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // Таймер ожидания 6 с.
    if ( Trig_Cinematic_BOSS3_Func057C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 6.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS3_Func058C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS3_Func058Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
        return
    endif
    // ЗАВЕРШЕНИЕ СЪЁМОК
    call TriggerExecute( gg_trg_Cinematic_BOSS3_Ending )
endfunction

//===========================================================================
function InitTrig_Cinematic_BOSS3 takes nothing returns nothing
    set gg_trg_Cinematic_BOSS3 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_BOSS3 )
    call TriggerAddAction( gg_trg_Cinematic_BOSS3, function Trig_Cinematic_BOSS3_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic BOSS3 Ending
//===========================================================================
function Trig_Cinematic_BOSS3_Ending_Func012A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Boss3_05, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_BOSS3_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call TriggerExecute( gg_trg_Init_Boss3 )
    call CameraSetSmoothingFactorBJ( 0.30 )
    call DestructableRestoreLife( gg_dest_B00S_9043, 500.00, true )
    call DestructableRestoreLife( gg_dest_B00S_9044, 500.00, true )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_BOSS3_Ending_Func012A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call CinematicModeExBJ( false, GetPlayersAll(), 0.60 )
    call TriggerSleepAction( 0.90 )
    call TriggerExecute( gg_trg_Help10 )
endfunction

//===========================================================================
function InitTrig_Cinematic_BOSS3_Ending takes nothing returns nothing
    set gg_trg_Cinematic_BOSS3_Ending = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_BOSS3_Ending )
    call TriggerAddAction( gg_trg_Cinematic_BOSS3_Ending, function Trig_Cinematic_BOSS3_Ending_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic BOSS3 alternate
//
// Запускается триггером Choice of ending в папке "_Босс3 (Финальный)" при выполнении условия репутации
// --------------------------------------------------------
// (1)Наконец-то! Я ждал вас. Всё время, пока вы находились в моём Замке, я наблюдал за вами. 
// (2)Пройдя все испытания, вы не проявили ни милосердия, ни жалости. Ваши души темны как ночь.
// (3)Вас отправили сюда, чтобы избавиться от тьмы, пожирающей ваши племена. Но вы пришли сюда не уничтожать тьму, а получить силу, которая позволит вам овладеть всем миром, ведь так? 
// (4)Можете мне доверять! Если бы я хотел убить вас, то уже сделал бы это. Я хочу преумножить ваше могущество!
// (5)Встаньте в магический круг в соседнем зале.
// (6)Вас ждёт последнее испытание. Эти порталы ведут к вашим поселениям. Я показал вашим вождям ваши истинные намерения. И скоро они явятся сюда со своими армиями, чтобы уничтожить вас. 
// (7)Я не могу покинуть этот Замок, но вы можете. Я передам вам свою тёмную силу. И вы одолеете их всех! А после этого уже никто не сможет остановить тьму внутри вас! И она поглотит весь этот жалкий мир!
//===========================================================================
function Trig_Cinematic_BOSS3_alternate_Func027A takes nothing returns nothing
    call ClearSelectionForPlayer( GetEnumPlayer() )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Boss3_01, GetEnumPlayer(), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Boss3_02, GetEnumPlayer(), 50.00 )
endfunction

function Trig_Cinematic_BOSS3_alternate_Func033C takes nothing returns boolean
    if ( not ( udg_Cinematic_skipped == false ) ) then
        return false
    endif
    return true
endfunction

