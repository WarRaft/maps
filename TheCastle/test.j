    call ClearSelectionForPlayer( GetEnumPlayer() )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Prisoner1, GetEnumPlayer(), 0.00 )
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Prisoner2, GetEnumPlayer(), 50.00 )
