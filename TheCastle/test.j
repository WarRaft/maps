//===========================================================================
function Trig_Portal01_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( udg_Portal_Activity_Bool[1] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal01_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call TeoPortalMoving(GetEnteringUnit(), 1, 180)
    call TriggerSleepAction( 0.50 )
    call KillDestructable( LoadDestructableHandleBJ(1, 1, GetLastCreatedHashtableBJ()) )
    call KillDestructable( LoadDestructableHandleBJ(1, 2, GetLastCreatedHashtableBJ()) )
endfunction

