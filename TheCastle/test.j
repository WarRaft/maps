    call TriggerAddAction( gg_trg_Init_Boss3_alternate, function Trig_Init_Boss3_alternate_Actions )
endfunction

//===========================================================================
// Trigger: Boss3 Spawn security Timer
//===========================================================================
function Trig_Boss3_Spawn_security_Timer_Func001Func001C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Boss3_MonsterGroups[GetForLoopIndexA()]) < udg_Boss3_MaxMonsters[GetForLoopIndexA()] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss3_Spawn_security_Timer_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_Boss3_NumMonsters
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Boss3_Spawn_security_Timer_Func001Func001C() ) then
            call TriggerExecute( gg_trg_Boss3_Spawn_1_Monster )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Boss3_Spawn_security_Timer takes nothing returns nothing
    set gg_trg_Boss3_Spawn_security_Timer = CreateTrigger(  )
    call DisableTrigger( gg_trg_Boss3_Spawn_security_Timer )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Boss3_Spawn_security_Timer, 1.00 )
    call TriggerAddAction( gg_trg_Boss3_Spawn_security_Timer, function Trig_Boss3_Spawn_security_Timer_Actions )
endfunction

//===========================================================================
// Trigger: Boss3 Spawn 1 Monster
//===========================================================================
function Trig_Boss3_Spawn_1_Monster_Func006C takes nothing returns boolean
    if ( not ( udg_Boss3_SpawnFrequence[GetForLoopIndexA()] != 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss3_Spawn_1_Monster_Actions takes nothing returns nothing
    local unit new_unit
    local real x = -6400
    local real y = -11900
    local location point = GetRectCenter(udg_Boss3_SpawnRegions[GetForLoopIndexA()])
    set udg_Boss3_SpawnFrequence[GetForLoopIndexA()] = ( udg_Boss3_SpawnFrequence[GetForLoopIndexA()] - 1 )
    if ( Trig_Boss3_Spawn_1_Monster_Func006C() ) then
        // Обнуление переменных
        call RemoveLocation(point)
        set point = null
        set new_unit = null
        return
    else
    endif
    // Восстанавливаем частоту
    set udg_Boss3_SpawnFrequence[GetForLoopIndexA()] = udg_Boss3_InitialSpawnFrequence[GetForLoopIndexA()]
    set new_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Boss3_MonsterTypes[GetForLoopIndexA()], GetLocationX(point),GetLocationY(point), GetRandomDirectionDeg() )
    call GroupAddUnitSimple( new_unit, udg_Boss3_MonsterGroups[GetForLoopIndexA()] )
    call IssuePointOrder(new_unit, "attack", x, y)
    // Обнуление переменных
    call RemoveLocation(point)
    set point = null
    set new_unit = null
endfunction

//===========================================================================
function InitTrig_Boss3_Spawn_1_Monster takes nothing returns nothing
    set gg_trg_Boss3_Spawn_1_Monster = CreateTrigger(  )
    call DisableTrigger( gg_trg_Boss3_Spawn_1_Monster )
    call TriggerAddAction( gg_trg_Boss3_Spawn_1_Monster, function Trig_Boss3_Spawn_1_Monster_Actions )
endfunction

//===========================================================================
// Trigger: Boss3 Death of Monster
//===========================================================================
function Trig_Boss3_Death_of_Monster_Func002003001 takes nothing returns boolean
    return ( IsUnitInGroup(GetDyingUnit(), udg_Boss3_MonsterGroups[GetForLoopIndexA()]) == true )
endfunction

function Trig_Boss3_Death_of_Monster_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = udg_Boss3_NumMonsters
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Boss3_Death_of_Monster_Func002003001() ) then
            call GroupRemoveUnitSimple( GetDyingUnit(), udg_Boss3_MonsterGroups[GetForLoopIndexA()] )
        else
            call DoNothing(  )
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Boss3_Death_of_Monster takes nothing returns nothing
    set gg_trg_Boss3_Death_of_Monster = CreateTrigger(  )
    call DisableTrigger( gg_trg_Boss3_Death_of_Monster )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Boss3_Death_of_Monster, Player(PLAYER_NEUTRAL_AGGRESSIVE), EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Boss3_Death_of_Monster, function Trig_Boss3_Death_of_Monster_Actions )
endfunction

//===========================================================================
// Trigger: Heroes Transformation
//===========================================================================
function Trig_Heroes_Transformation_Func014A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A02Z', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( true, 'A05B', GetEnumPlayer() )
endfunction

function Trig_Heroes_Transformation_Func015C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A05B', udg_Hero_shaman) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Heroes_Transformation_Func016C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A05B', udg_Hero_shaman) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Heroes_Transformation_Func017C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A05B', udg_Hero_shaman) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Heroes_Transformation_Func018C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A05B', udg_Hero_shaman) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Heroes_Transformation_Actions takes nothing returns nothing
    // Трансформация Орка-воина
    call SetUnitColor( udg_Hero_warrior, PLAYER_COLOR_CYAN )
    call SetUnitVertexColorBJ( udg_Hero_warrior, 93.00, 93.00, 93.00, 0 )
    // Умения
    call UnitRemoveAbilityBJ( 'A002', udg_Hero_warrior )
    call UnitAddAbilityBJ( 'A04Z', udg_Hero_warrior )
    call UnitRemoveAbilityBJ( 'A03U', udg_Hero_warrior )
    call UnitAddAbilityBJ( 'A061', udg_Hero_warrior )
    // Трансформация Тролля-шамана
    call SetUnitColor( udg_Hero_shaman, PLAYER_COLOR_CYAN )
    call SetUnitVertexColorBJ( udg_Hero_shaman, 93.00, 93.00, 93.00, 0 )
    // Умения
    call UnitRemoveAbilityBJ( 'A05A', udg_Hero_shaman )
    call ForForce( udg_Players, function Trig_Heroes_Transformation_Func014A )
    if ( Trig_Heroes_Transformation_Func015C() ) then
        call UnitAddAbilityBJ( 'A05C', udg_Hero_shaman )
    else
    endif
    if ( Trig_Heroes_Transformation_Func016C() ) then
        call UnitAddAbilityBJ( 'A05C', udg_Hero_shaman )
        call SetUnitAbilityLevelSwapped( 'A05C', udg_Hero_shaman, 2 )
    else
    endif
    if ( Trig_Heroes_Transformation_Func017C() ) then
        call UnitAddAbilityBJ( 'A05C', udg_Hero_shaman )
        call SetUnitAbilityLevelSwapped( 'A05C', udg_Hero_shaman, 3 )
    else
    endif
    if ( Trig_Heroes_Transformation_Func018C() ) then
        call UnitAddAbilityBJ( 'A05C', udg_Hero_shaman )
        call SetUnitAbilityLevelSwapped( 'A05C', udg_Hero_shaman, 4 )
    else
    endif
    call UnitRemoveAbilityBJ( 'A003', udg_Hero_shaman )
    call UnitRemoveAbilityBJ( 'A041', udg_Hero_shaman )
    call UnitRemoveAbilityBJ( 'A00O', udg_Hero_shaman )
    call UnitAddAbilityBJ( 'A04U', udg_Hero_shaman )
    call UnitAddAbilityBJ( 'A04V', udg_Hero_shaman )
    call UnitAddAbilityBJ( 'A04T', udg_Hero_shaman )
    // Трансформация Гоблина-механика
    call SetUnitColor( udg_Hero_mechanic, PLAYER_COLOR_CYAN )
    call SetUnitVertexColorBJ( udg_Hero_mechanic, 93.00, 93.00, 93.00, 0 )
    // Умения
    call UnitRemoveAbilityBJ( 'A001', udg_Hero_mechanic )
    call UnitAddAbilityBJ( 'A04R', udg_Hero_mechanic )
    call UnitAddAbilityBJ( 'A04W', udg_Hero_mechanic )
endfunction

//===========================================================================
function InitTrig_Heroes_Transformation takes nothing returns nothing
    set gg_trg_Heroes_Transformation = CreateTrigger(  )
    call DisableTrigger( gg_trg_Heroes_Transformation )
    call TriggerAddAction( gg_trg_Heroes_Transformation, function Trig_Heroes_Transformation_Actions )
endfunction

//===========================================================================
// Trigger: Boss3 Waves settings
//
// При добавлении юнитов также необходимо увеличить размерность массива Boss3_MonsterGroups в настройках переменных.
// Начальные параметры волны.
// Максимальное количество монстров (итоговое):
// Охотник за головами - 6
// Орк-воин - 6
// Тролль-охотник - 2
// Шаман лесных троллей - 2
// Гоблинский Резак - 2
// Тролль-берсерк - 1
//===========================================================================
function Trig_Boss3_Waves_settings_Actions takes nothing returns nothing
    set udg_Boss3_NumMonsters = 6
    // Заполнение массива данных по монстрам
    set udg_Boss3_MonsterTypes[1] = 'o006'
    set udg_Boss3_SpawnRegions[1] = gg_rct_REG_Portal22
    set udg_Boss3_MaxMonsters[1] = 6
    set udg_Boss3_SpawnFrequence[1] = 4
    // -
    set udg_Boss3_MonsterTypes[2] = 'o007'
    set udg_Boss3_SpawnRegions[2] = gg_rct_REG_Portal21
    set udg_Boss3_MaxMonsters[2] = 6
    set udg_Boss3_SpawnFrequence[2] = 5
    // -
    set udg_Boss3_MonsterTypes[3] = 'n02I'
    set udg_Boss3_SpawnRegions[3] = gg_rct_REG_Portal22
    set udg_Boss3_MaxMonsters[3] = 1
    set udg_Boss3_SpawnFrequence[3] = 9
    // -
    set udg_Boss3_MonsterTypes[4] = 'n02J'
    set udg_Boss3_SpawnRegions[4] = gg_rct_REG_Portal22
    set udg_Boss3_MaxMonsters[4] = 0
    set udg_Boss3_SpawnFrequence[4] = 11
    // -
    set udg_Boss3_MonsterTypes[5] = 'n02G'
    set udg_Boss3_SpawnRegions[5] = gg_rct_REG_Portal20
    set udg_Boss3_MaxMonsters[5] = 1
    set udg_Boss3_SpawnFrequence[5] = 17
    // -
    set udg_Boss3_MonsterTypes[6] = 'o005'
    set udg_Boss3_SpawnRegions[6] = gg_rct_REG_Portal22
    set udg_Boss3_MaxMonsters[6] = 0
    set udg_Boss3_SpawnFrequence[6] = 13
    // -
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_Boss3_NumMonsters
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Boss3_InitialSpawnFrequence[GetForLoopIndexA()] = udg_Boss3_SpawnFrequence[GetForLoopIndexA()]
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Boss3_Waves_settings takes nothing returns nothing
    set gg_trg_Boss3_Waves_settings = CreateTrigger(  )
    call DisableTrigger( gg_trg_Boss3_Waves_settings )
    call TriggerAddAction( gg_trg_Boss3_Waves_settings, function Trig_Boss3_Waves_settings_Actions )
endfunction

//===========================================================================
// Trigger: Boss3 Monsters wave Timer
//
// Увеличиваем количество монстров
//===========================================================================
function Trig_Boss3_Monsters_wave_Timer_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Boss3_MaxMonsters[3] = 2
    set udg_Boss3_MaxMonsters[4] = 2
    set udg_Boss3_MaxMonsters[5] = 2
    set udg_Boss3_MaxMonsters[6] = 1
    // Запускаем таймер до начала волны с героями
    call StartTimerBJ( udg_Boss3_Wave_Timer, false, 90.00 )
    call EnableTrigger( gg_trg_Boss3_Heroes_Wave_Timer )
endfunction

//===========================================================================
function InitTrig_Boss3_Monsters_wave_Timer takes nothing returns nothing
    set gg_trg_Boss3_Monsters_wave_Timer = CreateTrigger(  )
    call DisableTrigger( gg_trg_Boss3_Monsters_wave_Timer )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Boss3_Monsters_wave_Timer, udg_Boss3_Wave_Timer )
    call TriggerAddAction( gg_trg_Boss3_Monsters_wave_Timer, function Trig_Boss3_Monsters_wave_Timer_Actions )
endfunction

//===========================================================================
// Trigger: Boss3 Heroes Wave Timer
//===========================================================================
function Trig_Boss3_Heroes_Wave_Timer_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    // Создание героев
    call CreateNUnitsAtLoc( 1, 'O004', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct_REG_Portal22), 90.00 )
    set udg_UNIT_Boss3_Troll = GetLastCreatedUnit()
    call CreateNUnitsAtLoc( 1, 'N02H', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct_REG_Portal20), 270.00 )
    set udg_UNIT_Boss3_Goblin = GetLastCreatedUnit()
    call CreateNUnitsAtLoc( 1, 'O003', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct_REG_Portal21), 0.00 )
    set udg_UNIT_Boss3_Orc = GetLastCreatedUnit()
    // ------------------------------------------------------------------------
    // ДЕЙСТВИЯ ПОСЛЕ СОЗДАНИЯ ГЕРОЕВ
    // ------------------------------------------------------------------------
    // Изменение цвета
    call SetUnitColor( udg_UNIT_Boss3_Troll, PLAYER_COLOR_RED )
    call SetUnitColor( udg_UNIT_Boss3_Goblin, PLAYER_COLOR_RED )
    call SetUnitColor( udg_UNIT_Boss3_Orc, PLAYER_COLOR_RED )
    // Уровень героев
    call SetHeroLevelBJ( udg_UNIT_Boss3_Troll, 13, false )
    call SetHeroLevelBJ( udg_UNIT_Boss3_Goblin, 13, false )
    call SetHeroLevelBJ( udg_UNIT_Boss3_Orc, 13, false )
    // Умения
    call SelectHeroSkill( udg_UNIT_Boss3_Troll, 'A051' )
    call SelectHeroSkill( udg_UNIT_Boss3_Orc, 'A056' )
    // Артефакты героев
    call UnitAddItemByIdSwapped( 'I013', udg_UNIT_Boss3_Troll )
    call UnitAddItemByIdSwapped( 'I02G', udg_UNIT_Boss3_Troll )
    set udg_Boss3_Troll_Item = GetLastCreatedItem()
    call UnitAddItemByIdSwapped( 'I005', udg_UNIT_Boss3_Goblin )
    call UnitAddItemByIdSwapped( 'I02H', udg_UNIT_Boss3_Goblin )
    set udg_Boss3_Goblin_Item = GetLastCreatedItem()
    call UnitAddItemByIdSwapped( 'I009', udg_UNIT_Boss3_Orc )
    call UnitAddItemByIdSwapped( 'I02I', udg_UNIT_Boss3_Orc )
    set udg_Boss3_Orc_Item = GetLastCreatedItem()
    // События триггеров
    call TriggerRegisterUnitEvent( gg_trg_Troll_Invulnerability, udg_UNIT_Boss3_Troll, EVENT_UNIT_DAMAGED )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Troll, udg_UNIT_Boss3_Troll, EVENT_UNIT_DEATH )
    call EnableTrigger( gg_trg_Trolls_Count )
    call TriggerRegisterUnitEvent( gg_trg_Goblin_Invulnerability, udg_UNIT_Boss3_Goblin, EVENT_UNIT_DAMAGED )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Goblin, udg_UNIT_Boss3_Goblin, EVENT_UNIT_DEATH )
    call EnableTrigger( gg_trg_Goblin_Count )
    call TriggerRegisterUnitEvent( gg_trg_Orc_Invulnerability, udg_UNIT_Boss3_Orc, EVENT_UNIT_DAMAGED )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Orc, udg_UNIT_Boss3_Orc, EVENT_UNIT_DEATH )
    call EnableTrigger( gg_trg_Orc_Count )
    call TriggerExecute( gg_trg_Lightning_Discharge_Events )
    call TriggerExecute( gg_trg_Poisonous_puddle_Events )
    call EnableTrigger( gg_trg_Poisonous_puddle )
    set udg_Talking_Hero = GetEnteringUnit()
    // Сообщение Тралла
    call SetCineModeVolumeGroupsBJ(  )
    call TriggerSleepAction( 1.00 )
    call UnitAddIndicatorBJ( udg_UNIT_Boss3_Orc, 100, 100, 100, 0 )
    call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Boss3_Orc, GetHeroProperName(udg_UNIT_Boss3_Orc), gg_snd_Thrall01, udg_TEXT_Thrall[1], bj_TIMETYPE_SET, 1.00, false )
    call TriggerSleepAction( 4.00 )
    call VolumeGroupResetBJ(  )
endfunction

