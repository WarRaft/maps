    set gg_trg_Lever05 = CreateTrigger(  )
    call TriggerRegisterDeathEvent( gg_trg_Lever05, gg_dest_B00E_0267 )
    call TriggerAddAction( gg_trg_Lever05, function Trig_Lever05_Actions )
endfunction

