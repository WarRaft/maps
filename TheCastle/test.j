        call ChangeElevatorWalls( false, bj_ELEVATOR_WALL_TYPE_ALL, gg_dest_DTrx_0972 )
        call ChangeElevatorHeight( gg_dest_DTrx_0972, 3 )
        call TriggerSleepAction( 1.00 )
