    if ( not ( udg_Wrong_Place_for_Item == false ) ) then
        return false
    endif
    if ( not Trig_Lever14_Activation_Func001Func008C() ) then
        return false
    endif
    if ( not Trig_Lever14_Activation_Func001Func009C() ) then
        return false
    endif
    if ( not ( RectContainsItem(gg_item_I010_0194, gg_rct_REG_Statuette08_Azara) == true ) ) then
        return false
