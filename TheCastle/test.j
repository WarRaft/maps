    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I035' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Plan01_Func001Func007A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( true, 'A05M', GetEnumPlayer() )
endfunction

function Trig_Plan01_Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Hero_mechanic ) ) then
        return false
    endif
    return true
endfunction

function Trig_Plan01_Actions takes nothing returns nothing
    if ( Trig_Plan01_Func001C() ) then
        call RemoveItem( GetManipulatedItem() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call ForForce( udg_Players, function Trig_Plan01_Func001Func007A )
        call TriggerExecute( gg_trg_Help9 )
    else
        call SetItemCharges( GetManipulatedItem(), 1 )
        call PlaySoundOnUnitBJ( gg_snd_Error, 100, GetTriggerUnit() )
        call DisplayTextToForce( GetForceOfPlayer(GetTriggerPlayer()), udg_TEXT_Msg[3] )
    endif
endfunction

