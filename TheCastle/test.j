    if ( Trig_Cinematic_Prisoner1_Func026C() ) then
        loop
            exitwhen ( Trig_Cinematic_Prisoner1_Func026Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
