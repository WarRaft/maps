    if ( not ( CountUnitsInGroup(udg_Rats_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Marauder_Actions takes nothing returns nothing
    if ( Trig_Cinematic_Marauder_Func001C() ) then
        if ( Trig_Cinematic_Marauder_Func001Func001C() ) then
            set udg_Hero_any = GetTriggerUnit()
        else
        endif
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_Cinematic_skipped = false
        call FogModifierStop( udg_Eye[1] )
        // НАЧАЛО СЪЁМОК
        call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
        call TriggerSleepAction( 0.40 )
        // Необходимые действия за кадром (звук, перемещение юнитов)
        call PauseAllUnitsBJ( true )
        call IssueImmediateOrderBJ( udg_Hero_mechanic, "stop" )
        call IssueImmediateOrderBJ( udg_Hero_shaman, "stop" )
        call IssueImmediateOrderBJ( udg_Hero_warrior, "stop" )
        call SetUnitFacingToFaceUnitTimed( udg_UNIT_Marauder, udg_Hero_any, 0.50 )
        call SetUnitFacingToFaceUnitTimed( udg_Hero_any, udg_UNIT_Marauder, 0.50 )
        call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
        call DisableTrigger( gg_trg_Z_coordinate_check )
        call CameraSetSmoothingFactorBJ( 0.00 )
        // Выбор начального положения камеры
        call ForForce( udg_Players, function Trig_Cinematic_Marauder_Func001Func019A )
        // Ввод изображения
        call CinematicModeExBJ( true, GetPlayersAll(), 0.60 )
        call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
        // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
        // Таймер ожидания 1 с.
        if ( Trig_Cinematic_Marauder_Func001Func025C() ) then
            call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        if ( Trig_Cinematic_Marauder_Func001Func026C() ) then
            loop
                exitwhen ( Trig_Cinematic_Marauder_Func001Func026Func001001() )
                call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
            endloop
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        // Сообщение Мародера 1
        if ( Trig_Cinematic_Marauder_Func001Func028C() ) then
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Marauder, "TRIGSTR_2878", gg_snd_Marauder04, "TRIGSTR_2879", bj_TIMETYPE_SET, 8.80, false )
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        // Таймер ожидания 9.3 с.
        if ( Trig_Cinematic_Marauder_Func001Func030C() ) then
            call StartTimerBJ( udg_Cinematic_Timer, false, 9.30 )
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        if ( Trig_Cinematic_Marauder_Func001Func031C() ) then
            loop
                exitwhen ( Trig_Cinematic_Marauder_Func001Func031Func001001() )
                call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
            endloop
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        // Сообщение Мародера 2
        if ( Trig_Cinematic_Marauder_Func001Func033C() ) then
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Marauder, "TRIGSTR_2942", gg_snd_Marauder05, "TRIGSTR_2943", bj_TIMETYPE_SET, 11.60, false )
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        // Таймер ожидания 12.1 с.
        if ( Trig_Cinematic_Marauder_Func001Func035C() ) then
            call StartTimerBJ( udg_Cinematic_Timer, false, 12.10 )
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        if ( Trig_Cinematic_Marauder_Func001Func036C() ) then
            loop
                exitwhen ( Trig_Cinematic_Marauder_Func001Func036Func001001() )
                call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
            endloop
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        // Сообщение Мародера 3
        if ( Trig_Cinematic_Marauder_Func001Func038C() ) then
            call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Marauder, "TRIGSTR_2944", gg_snd_Marauder06, "TRIGSTR_2945", bj_TIMETYPE_SET, 13.00, false )
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        // Таймер ожидания 13.5 с.
        if ( Trig_Cinematic_Marauder_Func001Func040C() ) then
            call StartTimerBJ( udg_Cinematic_Timer, false, 13.50 )
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        if ( Trig_Cinematic_Marauder_Func001Func041C() ) then
            loop
                exitwhen ( Trig_Cinematic_Marauder_Func001Func041Func001001() )
                call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
            endloop
        else
            call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
            return
        endif
        // ЗАВЕРШЕНИЕ СЪЁМОК
        call TriggerExecute( gg_trg_Cinematic_Marauder_Ending )
    else
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), gg_unit_n01P_0376, "TRIGSTR_2880", gg_snd_Marauder07, "TRIGSTR_2881", bj_TIMETYPE_ADD, 0.00, false )
    endif
endfunction

