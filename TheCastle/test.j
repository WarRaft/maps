        return false
    endif
    return true
endfunction

function Trig_Death_of_Skeleton_merchant_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call SetUnitUserData( udg_UNIT_Skeleton_merchant, GetRandomInt(1, 3) )
    if ( Trig_Death_of_Skeleton_merchant_Func003C() ) then
        call CreateItemLoc( 'I00C', GetUnitLoc(udg_UNIT_Skeleton_merchant) )
    else
        if ( Trig_Death_of_Skeleton_merchant_Func003Func002C() ) then
            call CreateItemLoc( 'I00D', GetUnitLoc(udg_UNIT_Skeleton_merchant) )
        else
            call CreateItemLoc( 'I00D', GetUnitLoc(udg_UNIT_Skeleton_merchant) )
        endif
    endif
endfunction

