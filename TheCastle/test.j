endfunction

function Trig_Extra_Skills_Actions takes nothing returns nothing
    // Восстановление маны
    if ( Trig_Extra_Skills_Func002C() ) then
        if ( Trig_Extra_Skills_Func002Func001C() ) then
            call UnitAddAbilityBJ( 'A01H', GetTriggerUnit() )
        else
        endif
        if ( Trig_Extra_Skills_Func002Func002C() ) then
            call UnitRemoveBuffBJ( 'B005', GetTriggerUnit() )
            call UnitRemoveAbilityBJ( 'A01H', GetTriggerUnit() )
            call UnitAddAbilityBJ( 'A01J', GetTriggerUnit() )
        else
        endif
        if ( Trig_Extra_Skills_Func002Func003C() ) then
            call UnitRemoveBuffBJ( 'B006', GetTriggerUnit() )
            call UnitRemoveAbilityBJ( 'A01J', GetTriggerUnit() )
            call UnitAddAbilityBJ( 'A01K', GetTriggerUnit() )
        else
        endif
    else
    endif
    // Лёгкая поступь
    if ( Trig_Extra_Skills_Func004C() ) then
        if ( Trig_Extra_Skills_Func004Func001C() ) then
            call UnitRemoveBuffBJ( 'B004', GetTriggerUnit() )
        else
        endif
        if ( Trig_Extra_Skills_Func004Func002C() ) then
            call UnitRemoveBuffBJ( 'B008', GetTriggerUnit() )
        else
        endif
    else
    endif
    // Восстановление здоровья
    if ( Trig_Extra_Skills_Func006C() ) then
        if ( Trig_Extra_Skills_Func006Func001C() ) then
            call UnitAddAbilityBJ( 'A01N', GetTriggerUnit() )
        else
        endif
        if ( Trig_Extra_Skills_Func006Func002C() ) then
            call UnitRemoveBuffBJ( 'B00B', GetTriggerUnit() )
            call UnitRemoveAbilityBJ( 'A01N', GetTriggerUnit() )
            call UnitAddAbilityBJ( 'A01M', GetTriggerUnit() )
        else
        endif
        if ( Trig_Extra_Skills_Func006Func003C() ) then
            call UnitRemoveBuffBJ( 'B00A', GetTriggerUnit() )
            call UnitRemoveAbilityBJ( 'A01M', GetTriggerUnit() )
            call UnitAddAbilityBJ( 'A01O', GetTriggerUnit() )
        else
        endif
    else
    endif
    // Жизненная сила
    if ( Trig_Extra_Skills_Func008C() ) then
        if ( Trig_Extra_Skills_Func008Func001C() ) then
            call UnitAddAbilityBJ( 'A01Q', GetTriggerUnit() )
        else
        endif
        if ( Trig_Extra_Skills_Func008Func002C() ) then
            call UnitRemoveBuffBJ( 'B00F', GetTriggerUnit() )
            call UnitRemoveAbilityBJ( 'A01Q', GetTriggerUnit() )
            call UnitAddAbilityBJ( 'A01R', GetTriggerUnit() )
        else
        endif
        if ( Trig_Extra_Skills_Func008Func003C() ) then
            call UnitRemoveBuffBJ( 'B00E', GetTriggerUnit() )
            call UnitRemoveAbilityBJ( 'A01R', GetTriggerUnit() )
            call UnitAddAbilityBJ( 'A01P', GetTriggerUnit() )
        else
        endif
    else
    endif
    // Змеиная ловкость
    if ( Trig_Extra_Skills_Func010C() ) then
        if ( Trig_Extra_Skills_Func010Func001C() ) then
            call ForForce( udg_Players, function Trig_Extra_Skills_Func010Func001Func001A )
        else
        endif
        if ( Trig_Extra_Skills_Func010Func002C() ) then
            call UnitRemoveBuffBJ( 'B00H', GetTriggerUnit() )
            call ForForce( udg_Players, function Trig_Extra_Skills_Func010Func002Func002A )
        else
        endif
        if ( Trig_Extra_Skills_Func010Func003C() ) then
            call UnitRemoveBuffBJ( 'B00G', GetTriggerUnit() )
            call ForForce( udg_Players, function Trig_Extra_Skills_Func010Func003Func002A )
        else
        endif
    else
    endif
    // Электрическое поле
    if ( Trig_Extra_Skills_Func012C() ) then
        if ( Trig_Extra_Skills_Func012Func001C() ) then
            call ForForce( udg_Players, function Trig_Extra_Skills_Func012Func001Func001A )
        else
        endif
        if ( Trig_Extra_Skills_Func012Func002C() ) then
            call UnitRemoveBuffBJ( 'B00J', GetTriggerUnit() )
            call ForForce( udg_Players, function Trig_Extra_Skills_Func012Func002Func002A )
        else
        endif
        if ( Trig_Extra_Skills_Func012Func003C() ) then
            call UnitRemoveBuffBJ( 'B00K', GetTriggerUnit() )
            call ForForce( udg_Players, function Trig_Extra_Skills_Func012Func003Func002A )
        else
        endif
    else
    endif
    // Смертельный удар
    if ( Trig_Extra_Skills_Func014C() ) then
        if ( Trig_Extra_Skills_Func014Func001C() ) then
            call ForForce( udg_Players, function Trig_Extra_Skills_Func014Func001Func001A )
            // Для дамми-юнита (Фатальный удар)
            call SetPlayerAbilityAvailableBJ( true, 'A02L', Player(4) )
        else
        endif
        if ( Trig_Extra_Skills_Func014Func002C() ) then
            call UnitRemoveBuffBJ( 'B00R', GetTriggerUnit() )
            call ForForce( udg_Players, function Trig_Extra_Skills_Func014Func002Func002A )
            // Для дамми-юнита (Фатальный удар)
            call SetPlayerAbilityAvailableBJ( false, 'A02L', Player(4) )
            call SetPlayerAbilityAvailableBJ( true, 'A02N', Player(4) )
        else
        endif
        if ( Trig_Extra_Skills_Func014Func003C() ) then
            call UnitRemoveBuffBJ( 'B00S', GetTriggerUnit() )
            call ForForce( udg_Players, function Trig_Extra_Skills_Func014Func003Func002A )
            // Для дамми-юнита (Фатальный удар)
            call SetPlayerAbilityAvailableBJ( false, 'A02N', Player(4) )
            call SetPlayerAbilityAvailableBJ( true, 'A02M', Player(4) )
        else
        endif
    else
    endif
    // Лекарь
    if ( Trig_Extra_Skills_Func016C() ) then
        if ( Trig_Extra_Skills_Func016Func001C() ) then
            call IncUnitAbilityLevelSwapped( 'A05A', GetTriggerUnit() )
            call ModifyHeroSkillPoints( GetTriggerUnit(), bj_MODIFYMETHOD_ADD, 1 )
            call SetPlayerAbilityAvailableBJ( true, 'A05B', GetOwningPlayer(GetTriggerUnit()) )
            call SelectHeroSkill( GetTriggerUnit(), 'A05B' )
            call UnitRemoveBuffBJ( 'B01H', GetTriggerUnit() )
            call SetPlayerAbilityAvailableBJ( false, 'A05B', GetOwningPlayer(GetTriggerUnit()) )
        else
        endif
        if ( Trig_Extra_Skills_Func016Func002C() ) then
            call UnitRemoveBuffBJ( 'B00V', GetTriggerUnit() )
            call IncUnitAbilityLevelSwapped( 'A05A', GetTriggerUnit() )
            call ModifyHeroSkillPoints( GetTriggerUnit(), bj_MODIFYMETHOD_ADD, 1 )
            call SetPlayerAbilityAvailableBJ( true, 'A05B', GetOwningPlayer(GetTriggerUnit()) )
            call SelectHeroSkill( GetTriggerUnit(), 'A05B' )
            call UnitRemoveBuffBJ( 'B01I', GetTriggerUnit() )
            call SetPlayerAbilityAvailableBJ( false, 'A05B', GetOwningPlayer(GetTriggerUnit()) )
        else
        endif
        if ( Trig_Extra_Skills_Func016Func003C() ) then
            call UnitRemoveBuffBJ( 'B00W', GetTriggerUnit() )
            call IncUnitAbilityLevelSwapped( 'A05A', GetTriggerUnit() )
            call ModifyHeroSkillPoints( GetTriggerUnit(), bj_MODIFYMETHOD_ADD, 1 )
            call SetPlayerAbilityAvailableBJ( true, 'A05B', GetOwningPlayer(GetTriggerUnit()) )
            call SelectHeroSkill( GetTriggerUnit(), 'A05B' )
            call UnitRemoveBuffBJ( 'B01J', GetTriggerUnit() )
            call SetPlayerAbilityAvailableBJ( false, 'A05B', GetOwningPlayer(GetTriggerUnit()) )
        else
        endif
    else
    endif
    // Лекарь (alternate)
    if ( Trig_Extra_Skills_Func018C() ) then
        if ( Trig_Extra_Skills_Func018Func001C() ) then
            call IncUnitAbilityLevelSwapped( 'A05C', GetTriggerUnit() )
        else
        endif
        if ( Trig_Extra_Skills_Func018Func002C() ) then
            call UnitRemoveBuffBJ( 'B01H', GetTriggerUnit() )
            call IncUnitAbilityLevelSwapped( 'A05C', GetTriggerUnit() )
        else
        endif
        if ( Trig_Extra_Skills_Func018Func003C() ) then
            call UnitRemoveBuffBJ( 'B01I', GetTriggerUnit() )
            call IncUnitAbilityLevelSwapped( 'A05C', GetTriggerUnit() )
        else
        endif
    else
    endif
endfunction

