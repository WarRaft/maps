// Trigger: Cyber Goblin
//===========================================================================
function Trig_Cyber_Goblin_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cyber_Goblin_Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01S', udg_Hero_mechanic) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cyber_Goblin_Func004Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01S', udg_Hero_mechanic) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cyber_Goblin_Func004C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01S', udg_Hero_mechanic) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cyber_Goblin_Func005Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01I', udg_Hero_mechanic) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cyber_Goblin_Func005Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01I', udg_Hero_mechanic) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cyber_Goblin_Func005C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01I', udg_Hero_mechanic) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cyber_Goblin_Actions takes nothing returns nothing
    if ( Trig_Cyber_Goblin_Func004C() ) then
        call UnitAddAbilityBJ( 'A01Q', udg_Hero_mechanic )
    else
        if ( Trig_Cyber_Goblin_Func004Func001C() ) then
            call UnitAddAbilityBJ( 'A01R', udg_Hero_mechanic )
        else
            if ( Trig_Cyber_Goblin_Func004Func001Func001C() ) then
                call UnitAddAbilityBJ( 'A01P', udg_Hero_mechanic )
            else
            endif
        endif
    endif
    if ( Trig_Cyber_Goblin_Func005C() ) then
        call UnitAddAbilityBJ( 'A01N', udg_Hero_mechanic )
    else
        if ( Trig_Cyber_Goblin_Func005Func001C() ) then
            call UnitAddAbilityBJ( 'A01M', udg_Hero_mechanic )
        else
            if ( Trig_Cyber_Goblin_Func005Func001Func001C() ) then
                call UnitAddAbilityBJ( 'A01O', udg_Hero_mechanic )
            else
            endif
        endif
    endif
    call UnitAddAbilityBJ( 'A01Z', udg_Hero_mechanic )
endfunction

//===========================================================================
function InitTrig_Cyber_Goblin takes nothing returns nothing
    set gg_trg_Cyber_Goblin = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Cyber_Goblin, Player(0), EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Cyber_Goblin, Player(1), EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Cyber_Goblin, Player(2), EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Cyber_Goblin, Condition( function Trig_Cyber_Goblin_Conditions ) )
    call TriggerAddAction( gg_trg_Cyber_Goblin, function Trig_Cyber_Goblin_Actions )
endfunction

