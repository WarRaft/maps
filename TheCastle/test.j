    set gg_trg_Traps_Timer = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Traps_Timer, 1.00 )
    call TriggerAddAction( gg_trg_Traps_Timer, function Trig_Traps_Timer_Actions )
endfunction

