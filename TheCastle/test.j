//===========================================================================
// Trigger: Tesseract Picking Up
//===========================================================================
function Trig_Tesseract_Picking_Up_Conditions takes nothing returns boolean
    if ( not ( GetOrderTargetUnit() == udg_UNIT_Backpack ) ) then
        return false
    endif
    if ( not ( GetUnitCurrentOrder(GetTriggerUnit()) != String2OrderIdBJ("attack") ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_UNIT_Backpack) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tesseract_Picking_Up_Actions takes nothing returns nothing
    local unit Hero_unit = GetTriggerUnit()
    local location Hero_point = GetUnitLoc(Hero_unit)
    local location Item_point = GetUnitLoc(udg_UNIT_Backpack)
    // Проверяем расстояние
    if (DistanceBetweenPoints(Hero_point, Item_point) <= 150.00) then
    // Проверяем слоты инвентаря
        if (UnitInventoryCount(Hero_unit) < 6) then
            call PauseUnitBJ( true,Hero_unit )
            call IssueImmediateOrder( Hero_unit,"stop" )
            call SetUnitFacingToFaceLocTimed(Hero_unit, Item_point, 0)
            call PauseUnitBJ( false,Hero_unit )
            call ShowUnitHide( udg_UNIT_Backpack )
             call UnitAddItemByIdSwapped( 'I038', Hero_unit )
        endif
    endif
    // Обнуление переменных
    call RemoveLocation(Hero_point)
    call RemoveLocation(Item_point)
    set Hero_point = null
    set Item_point = null
    set Hero_unit = null
endfunction

//===========================================================================
function InitTrig_Tesseract_Picking_Up takes nothing returns nothing
    set gg_trg_Tesseract_Picking_Up = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Tesseract_Picking_Up, Player(0), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Tesseract_Picking_Up, Player(1), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Tesseract_Picking_Up, Player(2), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER )
    call TriggerAddCondition( gg_trg_Tesseract_Picking_Up, Condition( function Trig_Tesseract_Picking_Up_Conditions ) )
    call TriggerAddAction( gg_trg_Tesseract_Picking_Up, function Trig_Tesseract_Picking_Up_Actions )
endfunction

//===========================================================================
// Trigger: Tesseract Losing
//===========================================================================
function Trig_Tesseract_Losing_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I038' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tesseract_Losing_Actions takes nothing returns nothing
    set udg_Tesseract_Item = GetManipulatedItem()
    set udg_Tesseract_unit = GetTriggerUnit()
    // Позволяет дождаться момента, когда предмет упадет на землю
    call TriggerSleepAction( 0.00 )
    call TriggerExecute( gg_trg_Tesseract_Actions_in_losing )
endfunction

//===========================================================================
function InitTrig_Tesseract_Losing takes nothing returns nothing
    set gg_trg_Tesseract_Losing = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Tesseract_Losing, Player(0), EVENT_PLAYER_UNIT_DROP_ITEM )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Tesseract_Losing, Player(1), EVENT_PLAYER_UNIT_DROP_ITEM )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Tesseract_Losing, Player(2), EVENT_PLAYER_UNIT_DROP_ITEM )
    call TriggerAddCondition( gg_trg_Tesseract_Losing, Condition( function Trig_Tesseract_Losing_Conditions ) )
    call TriggerAddAction( gg_trg_Tesseract_Losing, function Trig_Tesseract_Losing_Actions )
endfunction

//===========================================================================
// Trigger: Tesseract Actions in losing
//===========================================================================
function Trig_Tesseract_Actions_in_losing_Actions takes nothing returns nothing
    local location Hero_point = GetUnitLoc(udg_Tesseract_unit)
    local location Item_point = GetItemLoc(udg_Tesseract_Item)
    // Если предмет на земле, то создаем руну с нужным количеством зарядов
    // Если предмет передали другому герою, то ничего не создаем
    if ( RectContainsItem( udg_Tesseract_Item, RectFromCenterSizeBJ(Hero_point, 200.00, 200.00) )== true) then
        call ShowUnitShow( udg_UNIT_Backpack )
        call SetUnitPositionLoc( udg_UNIT_Backpack, Item_point )
        call RemoveItem( udg_Tesseract_Item )
    endif
    // Обнуление переменных
    call RemoveLocation(Hero_point)
    call RemoveLocation(Item_point)
    set Hero_point = null
    set Item_point = null
endfunction

