    set udg_ResurrectionStone[2] = gg_unit_nbsw_0002
    set udg_ResurrectionStone[3] = gg_unit_nbsw_0059
    set udg_ResurrectionStone[4] = gg_unit_nbsw_0003
    set udg_ResurrectionStone[5] = gg_unit_nbse_0135
    set udg_ResurrectionStone[6] = gg_unit_nbsw_0123
    set udg_ResurrectionStone[7] = gg_unit_nbsw_0010
    set udg_ResurrectionStone[8] = gg_unit_nbsw_0549
    // Области для воскрешения
    set udg_ResurrectionCircle[1] = gg_unit_ncop_0093
    set udg_ResurrectionCircle[2] = gg_unit_ncop_0026
    set udg_ResurrectionCircle[3] = gg_unit_ncop_0060
    set udg_ResurrectionCircle[4] = gg_unit_ncop_0117
    set udg_ResurrectionCircle[5] = gg_unit_ncop_0107
    set udg_ResurrectionCircle[6] = gg_unit_ncop_0136
    set udg_ResurrectionCircle[7] = gg_unit_ncop_0372
    set udg_ResurrectionCircle[8] = gg_unit_ncop_0550
endfunction

