//===========================================================================
// Trigger: Portal04
//===========================================================================
function Trig_Portal04_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( udg_Portal_Activity_Bool[4] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal04_Func005C takes nothing returns boolean
    if ( not ( udg_Heroes_count >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal04_Actions takes nothing returns nothing
    call TeoPortalMoving(GetEnteringUnit(), 4, 270)
    set udg_Heroes_count = ( udg_Heroes_count + 1 )
    if ( Trig_Portal04_Func005C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_Heroes_count = 0
        call TriggerSleepAction( 0.50 )
        call KillDestructable( LoadDestructableHandleBJ(4, 1, GetLastCreatedHashtableBJ()) )
        call KillDestructable( LoadDestructableHandleBJ(4, 2, GetLastCreatedHashtableBJ()) )
        call TriggerSleepAction( 1.50 )
        call StopMusicBJ( false )
        call PlayMusicBJ( gg_snd_Background3 )
    else
    endif
endfunction

