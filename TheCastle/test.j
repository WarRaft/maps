//===========================================================================
// Trigger: Lightning Discharge
//
// Структура хэш-таблицы для умения:
// x.1 - координата X точки применения умения
// x.2 - координата Y точки применения умения
// x.3 - значение boolean для определения процесса применения умения 
//===========================================================================
function Trig_Lightning_Discharge_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A056' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Discharge_Func020Func003Func003C takes nothing returns boolean
    if ( not ( udg_Boss3_Random == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Discharge_Func020Func003C takes nothing returns boolean
    if ( not ( udg_Boss3_Random == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Discharge_Func020C takes nothing returns boolean
    if ( not ( udg_Boss3_Random == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Discharge_Actions takes nothing returns nothing
    local player dummy_player = Player(PLAYER_NEUTRAL_PASSIVE)
    local unit dummy_unit
    local real x1 = GetUnitX (udg_Hero_warrior)
    local real y1 = GetUnitY (udg_Hero_warrior)
    local real x2 = GetUnitX (udg_Hero_shaman)
    local real y2 = GetUnitY (udg_Hero_shaman)
    local real x3 = GetUnitX (udg_Hero_mechanic)
    local real y3 = GetUnitY (udg_Hero_mechanic)
    // Сохраняем координаты точек применения умения в хэш-таблицу
    call SaveRealBJ( x1, 31, 1, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( y1, 31, 2, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( x2, 32, 1, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( y2, 32, 2, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( x3, 33, 1, GetLastCreatedHashtableBJ() )
    call SaveRealBJ( y3, 33, 2, GetLastCreatedHashtableBJ() )
    // Сохраняем значение "Да" для нашего умения в хэш-таблицу для фиксации процесса начала применения
    call SaveBooleanBJ( true, 30, 3, GetLastCreatedHashtableBJ() )
    set udg_Boss3_Random = GetRandomInt(1, 3)
    // Создаем юниты-пустышку в виде маркера в точке применения умения
    if ( Trig_Lightning_Discharge_Func020C() ) then
        set dummy_unit = TeoCreateUnit (dummy_player, 'n02L', x1, y1, 0)
        call UnitApplyTimedLife( dummy_unit, 'BTLF', 2 )
    else
        if ( Trig_Lightning_Discharge_Func020Func003C() ) then
            set dummy_unit = TeoCreateUnit (dummy_player, 'n02L', x2, y2, 0)
            call UnitApplyTimedLife( dummy_unit, 'BTLF', 2 )
        else
            if ( Trig_Lightning_Discharge_Func020Func003Func003C() ) then
                set dummy_unit = TeoCreateUnit (dummy_player, 'n02L', x3, y3, 0)
                call UnitApplyTimedLife( dummy_unit, 'BTLF', 2 )
            else
            endif
        endif
    endif
    call SetUnitAnimation( dummy_unit, "birth" )
    call QueueUnitAnimationBJ( dummy_unit, "stand" )
    call StartTimerBJ( udg_Lighting_Discharge_Timer, false, 2.20 )
    // Обнуление переменных
    set dummy_player = null
    set dummy_unit = null
endfunction

