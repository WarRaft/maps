//===========================================================================
// Trigger: Init Puzzles
//
// AnimationStep - шаг анимации
//===========================================================================
function Trig_Init_Puzzles_Actions takes nothing returns nothing
    local location point
    local unit temp_unit
    set udg_AnimationStep = 20.00
    // -------------------------------------------------------------------
    // ЛЁГКАЯ ГОЛОВОЛОМКА (Easy Puzzle) 
    // -------------------------------------------------------------------
    // Области расположения ящиков в лёгкой головоломке
    set udg_EasyPuzzle_Region[1] = gg_rct_REG_EP01
    set udg_EasyPuzzle_Region[2] = gg_rct_REG_EP02
    set udg_EasyPuzzle_Region[3] = gg_rct_REG_EP03
    set udg_EasyPuzzle_Region[4] = gg_rct_REG_EP04
    set udg_EasyPuzzle_Region[5] = gg_rct_REG_EP05
    set udg_EasyPuzzle_Region[6] = gg_rct_REG_EP06
    set udg_EasyPuzzle_Region[7] = gg_rct_REG_EP07
    set udg_EasyPuzzle_Region[8] = gg_rct_REG_EP08
    // Создаем и разворачиваем ящики лёгкой головоломки
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set point = GetRectCenter(udg_EasyPuzzle_Region[GetForLoopIndexA()])
        set temp_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'nmgv', GetLocationX(point),GetLocationY(point), 45.00 )
        call GroupAddUnitSimple( temp_unit, udg_EasyPuzzle_Group )
        call RemoveLocation(point)
        set point = null
        set temp_unit = null
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // -----------------------------------------------------------------------
    // СЛОЖНАЯ ГОЛОВОЛОМКА (Hard Puzzle) 
    // -----------------------------------------------------------------------
    // Области расположения ящиков в сложной головоломке
    set udg_HardPuzzle_Region[1] = gg_rct_REG_HP01
    set udg_HardPuzzle_Region[2] = gg_rct_REG_HP02
    set udg_HardPuzzle_Region[3] = gg_rct_REG_HP03
    set udg_HardPuzzle_Region[4] = gg_rct_REG_HP04
    set udg_HardPuzzle_Region[5] = gg_rct_REG_HP05
    set udg_HardPuzzle_Region[6] = gg_rct_REG_HP06
    set udg_HardPuzzle_Region[7] = gg_rct_REG_HP07
    set udg_HardPuzzle_Region[8] = gg_rct_REG_HP08
    set udg_HardPuzzle_Region[9] = gg_rct_REG_HP09
    set udg_HardPuzzle_Region[10] = gg_rct_REG_HP10
    set udg_HardPuzzle_Region[11] = gg_rct_REG_HP11
    set udg_HardPuzzle_Region[12] = gg_rct_REG_HP12
    set udg_HardPuzzle_Region[13] = gg_rct_REG_HP13
    set udg_HardPuzzle_Region[14] = gg_rct_REG_HP14
    set udg_HardPuzzle_Region[15] = gg_rct_REG_HP15
    set udg_HardPuzzle_Region[16] = gg_rct_REG_HP16
    set udg_HardPuzzle_Region[17] = gg_rct_REG_HP17
    set udg_HardPuzzle_Region[18] = gg_rct_REG_HP18
    // Создаем и разворачиваем ящики сложной головоломки
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set point = GetRectCenter(udg_HardPuzzle_Region[GetForLoopIndexA()])
        set temp_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'nmgv', GetLocationX(point),GetLocationY(point), 45.00 )
        call GroupAddUnitSimple( temp_unit, udg_HardPuzzle_Group )
        call RemoveLocation(point)
        set point = null
        set temp_unit = null
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

