    call KillUnit( LoadUnitHandleBJ(0, 2, GetLastCreatedHashtableBJ()) )
    call SaveUnitHandleBJ( GetSummonedUnit(), 0, 2, GetLastCreatedHashtableBJ() )
    call SetUnitTimeScalePercent( LoadUnitHandleBJ(0, 2, GetLastCreatedHashtableBJ()), 320.00 )
    call TriggerSleepAction( 1.00 )
    call SetUnitFacingTimed( LoadUnitHandleBJ(0, 2, GetLastCreatedHashtableBJ()), ( 0.00 + GetUnitFacing(GetSummoningUnit()) ), 1.00 )
    call SetUnitTimeScalePercent( LoadUnitHandleBJ(0, 2, GetLastCreatedHashtableBJ()), 100.00 )
    call TriggerSleepAction( 2.00 )
    set udg_Teleport_Bool = true
endfunction

