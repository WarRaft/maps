        return false
    endif
    return true
endfunction

function Trig_Lizard_Feeding_Actions takes nothing returns nothing
    call SetUnitOwner( udg_UNIT_Lizard, Player(PLAYER_NEUTRAL_PASSIVE), false )
    if ( Trig_Lizard_Feeding_Func002C() ) then
        call UnitRemoveAbilityBJ( 'Awan', udg_UNIT_Lizard )
        call IssuePointOrderLocBJ( udg_UNIT_Lizard, "move", GetUnitLoc(udg_UNIT_Traveler) )
        call TeoTextTag ("Репутация изменена", udg_Hero_warrior, 0,80,0)
        call TeoTextTag ("Репутация изменена", udg_Hero_shaman, 0,80,0)
        call TeoTextTag ("Репутация изменена", udg_Hero_mechanic, 0,80,0)
        set udg_Reputation = ( udg_Reputation + 5.00 )
    else
    endif
endfunction

