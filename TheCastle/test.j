function Trig_Cinematic_BOSS2_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Cinematic_skipped = false
    // НАЧАЛО СЪЁМОК
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.40 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call SetDayNightModels( "Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdl ","Environment\\DNC\\DNCLordaeron\\DNCLordaeronUnit\\DNCLordaeronUnit.mdl")
    call SetTerrainFogExBJ( 0, 6000.00, 6000.00, 100.00, 0.00, 0.00, 0.00 )
    call PauseAllUnitsBJ( true )
    call IssueImmediateOrderBJ( udg_Hero_mechanic, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_shaman, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_warrior, "stop" )
    call ForGroupBJ( GetUnitsOfPlayerAll(Player(11)), function Trig_Cinematic_BOSS2_Func015A )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call StopMusicBJ( false )
    call PlayMusicBJ( gg_snd_Boss2 )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call TriggerExecute( gg_trg_Init_Boss2 )
    call EnableTrigger( gg_trg_Tanks_respawn )
    call CameraSetSmoothingFactorBJ( 0.00 )
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_BOSS2_Func024A )
    // Ввод изображения
    call CinematicModeExBJ( true, GetPlayersAll(), 0.60 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0.00, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_BOSS2_Func030C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS2_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS2_Func031C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS2_Func031Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS2_Ending )
        return
    endif
    // Сообщение Нитнарак
    if ( Trig_Cinematic_BOSS2_Func033C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_warrior, GetHeroProperName(udg_Hero_warrior), gg_snd_Warrior03, udg_TEXT_Warrior[3], bj_TIMETYPE_SET, 1.50, false )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS2_Ending )
        return
    endif
    // Таймер ожидания 3 с.
    if ( Trig_Cinematic_BOSS2_Func035C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 3.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS2_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS2_Func036C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS2_Func036Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS2_Ending )
        return
    endif
    // Сообщение Акнеладу
    if ( Trig_Cinematic_BOSS2_Func038C() ) then
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman13, udg_TEXT_Shaman[13], bj_TIMETYPE_SET, 6.00, false )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS2_Ending )
        return
    endif
    // Таймер ожидания 7.5 с.
    if ( Trig_Cinematic_BOSS2_Func040C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 7.50 )
    else
        call TriggerExecute( gg_trg_Cinematic_BOSS2_Ending )
        return
    endif
    if ( Trig_Cinematic_BOSS2_Func041C() ) then
        loop
            exitwhen ( Trig_Cinematic_BOSS2_Func041Func001001() )
