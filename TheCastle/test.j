function Trig_Cinematic_Book_Actions takes nothing returns nothing
    local location point
    set udg_Cinematic_skipped = false
    // НАЧАЛО СЪЁМОК
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.40 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( true )
    call IssueImmediateOrderBJ( udg_Hero_mechanic, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_shaman, "stop" )
    call IssueImmediateOrderBJ( udg_Hero_warrior, "stop" )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 0.00 )
    call DisableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.00 )
    // Выбор начального положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Book_Func015A )
    // Ввод изображения
    call CinematicModeExBJ( true, GetPlayersAll(), 0.60 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    // ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК
    // Таймер ожидания 1 с.
    if ( Trig_Cinematic_Book_Func021C() ) then
        call StartTimerBJ( udg_Cinematic_Timer, false, 1.00 )
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    if ( Trig_Cinematic_Book_Func022C() ) then
        loop
            exitwhen ( Trig_Cinematic_Book_Func022Func001001() )
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
        endloop
    else
        call TriggerExecute( gg_trg_Cinematic_Book_Ending )
        return
    endif
    // Сообщение Акнеладу и эффект появления книги
    if ( Trig_Cinematic_Book_Func024C() ) then
        set point = Location(GetRectCenterX(gg_rct_REG_Fire1_Top), GetRectCenterY(gg_rct_REG_Fire1_Top))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire1_Mid), GetRectCenterY(gg_rct_REG_Fire1_Mid))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire1_Bot), GetRectCenterY(gg_rct_REG_Fire1_Bot))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        call TriggerSleepAction( 0.01 )
        set point = Location(GetRectCenterX(gg_rct_REG_Fire2_Top), GetRectCenterY(gg_rct_REG_Fire2_Top))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire2_Mid), GetRectCenterY(gg_rct_REG_Fire2_Mid))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire2_Bot), GetRectCenterY(gg_rct_REG_Fire2_Bot))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        call TriggerSleepAction( 0.01 )
        set point = Location(GetRectCenterX(gg_rct_REG_Fire3_Top), GetRectCenterY(gg_rct_REG_Fire3_Top))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire3_Mid), GetRectCenterY(gg_rct_REG_Fire3_Mid))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
        set point = Location(GetRectCenterX(gg_rct_REG_Fire3_Bot), GetRectCenterY(gg_rct_REG_Fire3_Bot))
        call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
        call RemoveLocation(point)
