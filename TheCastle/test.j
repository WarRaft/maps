function Trig_Labyrinth_Buttons_Checking_Func001Func013C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(udg_Button[7]) == false ) ) then
        return false
    endif
    if ( not ( IsDestructableAliveBJ(udg_Button[8]) == false ) ) then
        return false
    endif
    if ( not ( IsDestructableAliveBJ(udg_Button[9]) == false ) ) then
        return false
    endif
    if ( not ( IsDestructableAliveBJ(udg_Button[10]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Labyrinth_Buttons_Checking_Func001C takes nothing returns boolean
    if ( not Trig_Labyrinth_Buttons_Checking_Func001Func013C() ) then
        return false
    endif
    return true
endfunction

function Trig_Labyrinth_Buttons_Checking_Actions takes nothing returns nothing
    if ( Trig_Labyrinth_Buttons_Checking_Func001C() ) then
        call DisableTrigger( gg_trg_Labyrinth_Button7_Entrance )
        call DisableTrigger( gg_trg_Labyrinth_Button7_Exit )
        call DisableTrigger( gg_trg_Labyrinth_Button8_Entrance )
        call DisableTrigger( gg_trg_Labyrinth_Button8_Exit )
        call DisableTrigger( gg_trg_Labyrinth_Button9_Entrance )
        call DisableTrigger( gg_trg_Labyrinth_Button9_Exit )
        call DisableTrigger( gg_trg_Labyrinth_Button10_Entrance )
        call DisableTrigger( gg_trg_Labyrinth_Button10_Exit )
        call DisableTrigger( gg_trg_Labyrinth_Button_with_Item )
        call DisableTrigger( gg_trg_Labyrinth_Button_without_Item )
        // Открываем портал № 4
        call TeoPortalRevival(4)
    else
    endif
endfunction

