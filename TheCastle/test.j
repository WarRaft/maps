//===========================================================================
// Trigger: Music notes Activation
//===========================================================================
function Trig_Music_notes_Activation_Func049Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'n02M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Music_notes_Activation_Func049A takes nothing returns nothing
    if ( Trig_Music_notes_Activation_Func049Func001C() ) then
        call SetUnitOwner( GetEnumUnit(), Player(PLAYER_NEUTRAL_AGGRESSIVE), true )
        call UnitRemoveAbilityBJ( 'Awan', GetEnumUnit() )
    else
    endif
endfunction

function Trig_Music_notes_Activation_Actions takes nothing returns nothing
    set udg_Music = 0
    call DisableTrigger( gg_trg_Button20_Action )
    call DisableTrigger( gg_trg_Button21_Action )
    call DisableTrigger( gg_trg_Button22_Action )
    call DisableTrigger( gg_trg_Button23_Action )
    // Анимация исчезновения рун
    call ShowDestructableBJ( false, gg_dest_B009_10778 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B009_10778), "EFFECTS\\Holy Light Royal.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B007_10689 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B007_10689), "EFFECTS\\Holy Light.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B006_10784 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B006_10784), "EFFECTS\\Holy Light Nature.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B009_10787 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B009_10787), "EFFECTS\\Holy Light Royal.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B007_10782 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B007_10782), "EFFECTS\\Holy Light.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B00A_10780 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B00A_10780), "EFFECTS\\Holy Light Void.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B006_10785 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B006_10785), "EFFECTS\\Holy Light Nature.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B009_10777 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B009_10777), "EFFECTS\\Holy Light Royal.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B007_10781 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B007_10781), "EFFECTS\\Holy Light.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B006_10786 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B006_10786), "EFFECTS\\Holy Light Nature.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B007_10783 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B007_10783), "EFFECTS\\Holy Light.mdx" )
    call TriggerSleepAction( 0.05 )
    call ShowDestructableBJ( false, gg_dest_B009_10779 )
    call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B009_10779), "EFFECTS\\Holy Light Royal.mdx" )
    call TriggerSleepAction( 0.05 )
    // Окончание анимации исчезновения рун
    call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_B00S_10986 )
    call RemoveDestructable( gg_dest_YTlb_0467 )
    call RemoveDestructable( gg_dest_YTlb_0468 )
    call RemoveDestructable( gg_dest_YTlb_0469 )
    call RemoveDestructable( gg_dest_YTlb_0470 )
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_REG_Neutral_Units3), function Trig_Music_notes_Activation_Func049A )
endfunction

