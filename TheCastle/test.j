//===========================================================================
// Trigger: Verify stone conditions
//===========================================================================
function Trig_Verify_stone_conditions_Func001Func001C takes nothing returns boolean
    if ( not ( udg_ResurrectionsStones_condition[GetForLoopIndexA()] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Verify_stone_conditions_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_ResurrectionStones_num
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Verify_stone_conditions_Func001Func001C() ) then
            call SetUnitAnimation( udg_ResurrectionStone[GetForLoopIndexA()], "stand alternate" )
            call PlaySoundBJ( gg_snd_AutoCastButtonClick1 )
        else
            call SetUnitAnimation( udg_ResurrectionStone[GetForLoopIndexA()], "stand" )
            call SetUnitColor( udg_ResurrectionCircle[GetForLoopIndexA()], GetPlayerColor(Player(PLAYER_NEUTRAL_PASSIVE)) )
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Verify_stone_conditions takes nothing returns nothing
    set gg_trg_Verify_stone_conditions = CreateTrigger(  )
    call DisableTrigger( gg_trg_Verify_stone_conditions )
    call TriggerAddAction( gg_trg_Verify_stone_conditions, function Trig_Verify_stone_conditions_Actions )
endfunction

//===========================================================================
// Trigger: Death of Hero
//
// Перевыбор нужен для того, чтобы камера прикреплялась за другим героем после смерти основного
// HeroTimer[1] - Таймер для Механика
// HeroTimer[2] - Таймер для Шамана
// HeroTimer[3] - Таймер для Воина
//===========================================================================
function Trig_Death_of_Hero_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_of_Hero_Func004A takes nothing returns nothing
    call SetPlayerStateBJ( GetEnumPlayer(), PLAYER_STATE_RESOURCE_LUMBER, ( udg_Count_Life - 1 ) )
endfunction

function Trig_Death_of_Hero_Func006Func005001 takes nothing returns boolean
    return ( GetDyingUnit() == udg_Hero_mechanic )
endfunction

function Trig_Death_of_Hero_Func006Func006001 takes nothing returns boolean
    return ( GetDyingUnit() == udg_Hero_shaman )
endfunction

function Trig_Death_of_Hero_Func006Func007001 takes nothing returns boolean
    return ( GetDyingUnit() == udg_Hero_warrior )
endfunction

function Trig_Death_of_Hero_Func006C takes nothing returns boolean
    if ( not ( udg_Count_Life <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_of_Hero_Actions takes nothing returns nothing
    // Уменьшаем количество воскрешений у всех Игроков
    set udg_Count_Life = ( udg_Count_Life - 1 )
    call ForForce( udg_Players, function Trig_Death_of_Hero_Func004A )
    // Проверяем на условие Поражения
    if ( Trig_Death_of_Hero_Func006C() ) then
        call DisableTrigger( gg_trg_Timer_Mechanic )
        call DisableTrigger( gg_trg_Timer_Shaman )
        call DisableTrigger( gg_trg_Timer_Warrior )
        call DisableTrigger( GetTriggeringTrigger() )
        call TriggerExecute( gg_trg_The_Defeat )
    else
        if ( Trig_Death_of_Hero_Func006Func005001() ) then
            call StartTimerBJ( udg_Hero_Timer[1], false, 5.00 )
        else
            call DoNothing(  )
        endif
        if ( Trig_Death_of_Hero_Func006Func006001() ) then
            call StartTimerBJ( udg_Hero_Timer[2], false, 5.00 )
        else
            call DoNothing(  )
        endif
        if ( Trig_Death_of_Hero_Func006Func007001() ) then
            call StartTimerBJ( udg_Hero_Timer[3], false, 5.00 )
        else
            call DoNothing(  )
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Death_of_Hero takes nothing returns nothing
    set gg_trg_Death_of_Hero = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Death_of_Hero, Player(0), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Death_of_Hero, Player(1), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Death_of_Hero, Player(2), EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Death_of_Hero, Condition( function Trig_Death_of_Hero_Conditions ) )
    call TriggerAddAction( gg_trg_Death_of_Hero, function Trig_Death_of_Hero_Actions )
endfunction

//===========================================================================
// Trigger: Timer Mechanic
//
// Game_Stage - отвечает за область воскрешения героев, если воскрешение происходит не около Камня воскрешения
// 0 - воскрешение в стартовой области
// 1- воскрешение в конечной области
// 2- воскрешение в альтернативной области
//===========================================================================
function Trig_Timer_Mechanic_Func002Func001Func002Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01S', udg_Hero_mechanic) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func002Func001Func002Func004Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01S', udg_Hero_mechanic) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func002Func001Func002Func004C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01S', udg_Hero_mechanic) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func002Func001Func002Func005Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01I', udg_Hero_mechanic) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func002Func001Func002Func005Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01I', udg_Hero_mechanic) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func002Func001Func002Func005C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A01I', udg_Hero_mechanic) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func002Func001Func002C takes nothing returns boolean
    if ( not ( udg_Game_Stage == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Game_Stage == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func002Func002Func001C takes nothing returns boolean
    if ( not ( udg_ResurrectionsStones_condition[GetForLoopIndexA()] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func002C takes nothing returns boolean
    if ( not ( udg_ResurrectionsStones_condition[0] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func004Func002C takes nothing returns boolean
    if ( not ( udg_FREECAM[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_mechanic))] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Func004C takes nothing returns boolean
    if ( not ( IsUnitGroupEmptyBJ(GetUnitsSelectedAll(GetOwningPlayer(udg_Hero_mechanic))) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Mechanic_Actions takes nothing returns nothing
    // Если ни один из камней Воскрешения не активирован
    if ( Trig_Timer_Mechanic_Func002C() ) then
        if ( Trig_Timer_Mechanic_Func002Func001C() ) then
            call ReviveHeroLoc( udg_Hero_mechanic, GetRectCenter(gg_rct_REG_Resurrection_1), true )
        else
            if ( Trig_Timer_Mechanic_Func002Func001Func002C() ) then
                call ReviveHeroLoc( udg_Hero_mechanic, GetRectCenter(gg_rct_REG_Resurrection_2), true )
            else
                // Альтернативный Босс
                call ReviveHeroLoc( udg_Hero_mechanic, GetRectCenter(gg_rct_REG_Resurrection_3), true )
                // Добавляем навыки для трансформы
                if ( Trig_Timer_Mechanic_Func002Func001Func002Func004C() ) then
                    call UnitAddAbilityBJ( 'A01Q', udg_Hero_mechanic )
                else
                    if ( Trig_Timer_Mechanic_Func002Func001Func002Func004Func001C() ) then
                        call UnitAddAbilityBJ( 'A01R', udg_Hero_mechanic )
                    else
                        if ( Trig_Timer_Mechanic_Func002Func001Func002Func004Func001Func001C() ) then
                            call UnitAddAbilityBJ( 'A01P', udg_Hero_mechanic )
                        else
                        endif
                    endif
                endif
                if ( Trig_Timer_Mechanic_Func002Func001Func002Func005C() ) then
                    call UnitAddAbilityBJ( 'A01N', udg_Hero_mechanic )
                else
                    if ( Trig_Timer_Mechanic_Func002Func001Func002Func005Func001C() ) then
                        call UnitAddAbilityBJ( 'A01M', udg_Hero_mechanic )
                    else
                        if ( Trig_Timer_Mechanic_Func002Func001Func002Func005Func001Func001C() ) then
                            call UnitAddAbilityBJ( 'A01O', udg_Hero_mechanic )
                        else
                        endif
                    endif
                endif
                call UnitAddAbilityBJ( 'A01Z', udg_Hero_mechanic )
            endif
        endif
    else
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = udg_ResurrectionStones_num
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            if ( Trig_Timer_Mechanic_Func002Func002Func001C() ) then
                call ReviveHeroLoc( udg_Hero_mechanic, GetUnitLoc(udg_ResurrectionCircle[GetForLoopIndexA()]), true )
            else
            endif
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    endif
    // Если никто из героев не выделен, то выбираем воскресшего героя
    if ( Trig_Timer_Mechanic_Func004C() ) then
        call SelectUnitForPlayerSingle( udg_Hero_mechanic, GetOwningPlayer(udg_Hero_mechanic) )
        if ( Trig_Timer_Mechanic_Func004Func002C() ) then
            call PanCameraToTimedLocForPlayer( GetOwningPlayer(udg_Hero_mechanic), GetUnitLoc(udg_Hero_mechanic), 0 )
        else
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Timer_Mechanic takes nothing returns nothing
    set gg_trg_Timer_Mechanic = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Timer_Mechanic, udg_Hero_Timer[1] )
    call TriggerAddAction( gg_trg_Timer_Mechanic, function Trig_Timer_Mechanic_Actions )
endfunction

