//===========================================================================
// Trigger: Found Item
//
// Массив предметов для крафта:
// 1 - Кольцо защиты
// 2 - Сапоги скорости                      (нет повтора в крафте)
// 3 - Перчатки скорости                  (нет повтора в крафте)
// 4 - Боевой топор
// 5 - Талисман Маны                       (нет повтора в крафте)
// 6 - Талисман Здоровья                (нет повтора в крафте)
// 7 - Кольцо Регенерации               (нет повтора в крафте)
// 8 - Кольцо регенерации Маны     (нет повтора в крафте)
// 9 - Деревянные заготовки
// 10 - Стальные перчатки
// 11 - Стальной Топор
// 12 - Накидка
//===========================================================================
function Trig_Found_Item_Func001C takes nothing returns boolean
    if ( ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_ARTIFACT ) ) then
        return true
    endif
    if ( ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_PERMANENT ) ) then
        return true
    endif
    return false
endfunction

function Trig_Found_Item_Conditions takes nothing returns boolean
    if ( not Trig_Found_Item_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Found_Item_Func003001 takes nothing returns boolean
    return ( GetItemTypeId(GetManipulatedItem()) == 'rde1' )
endfunction

function Trig_Found_Item_Func005001 takes nothing returns boolean
    return ( GetItemTypeId(GetManipulatedItem()) == 'stwa' )
endfunction

function Trig_Found_Item_Func007001 takes nothing returns boolean
    return ( GetItemTypeId(GetManipulatedItem()) == 'I001' )
endfunction

function Trig_Found_Item_Func009001 takes nothing returns boolean
    return ( GetItemTypeId(GetManipulatedItem()) == 'I005' )
endfunction

function Trig_Found_Item_Func011001 takes nothing returns boolean
    return ( GetItemTypeId(GetManipulatedItem()) == 'I00F' )
endfunction

function Trig_Found_Item_Func013001 takes nothing returns boolean
    return ( GetItemTypeId(GetManipulatedItem()) == 'I01B' )
endfunction

function Trig_Found_Item_Actions takes nothing returns nothing
    // [ 1 ] Кольцо защиты 
    if ( Trig_Found_Item_Func003001() ) then
        set udg_Items[1] = ( udg_Items[1] + 1 )
    else
        call DoNothing(  )
    endif
    // [ 4 ] Боевой топор
    if ( Trig_Found_Item_Func005001() ) then
        set udg_Items[4] = ( udg_Items[4] + 1 )
    else
        call DoNothing(  )
    endif
    // [ 9 ] Деревянные заготовки
    if ( Trig_Found_Item_Func007001() ) then
        set udg_Items[9] = ( udg_Items[9] + 1 )
    else
        call DoNothing(  )
    endif
    // [ 10 ] Стальные перчатки
    if ( Trig_Found_Item_Func009001() ) then
        set udg_Items[10] = ( udg_Items[10] + 1 )
    else
        call DoNothing(  )
    endif
    // [ 11 ] Стальной топор
    if ( Trig_Found_Item_Func011001() ) then
        set udg_Items[11] = ( udg_Items[11] + 1 )
    else
        call DoNothing(  )
    endif
    // [ 12 ] Накидка
    if ( Trig_Found_Item_Func013001() ) then
        set udg_Items[12] = ( udg_Items[12] + 1 )
    else
        call DoNothing(  )
    endif
endfunction

//===========================================================================
function InitTrig_Found_Item takes nothing returns nothing
    set gg_trg_Found_Item = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Found_Item, Condition( function Trig_Found_Item_Conditions ) )
    call TriggerAddAction( gg_trg_Found_Item, function Trig_Found_Item_Actions )
endfunction

