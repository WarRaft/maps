//===========================================================================
// Trigger: Init Switches
//
// Switch_condition: "Нет" - stand анимация, "Да" - death анимация.
//===========================================================================
function Trig_Init_Switches_Actions takes nothing returns nothing
    set udg_Switch_num = 8
    set udg_Switch[1] = gg_dest_B00D_1188
    set udg_Switch[2] = gg_dest_B00D_1189
    set udg_Switch[3] = gg_dest_B00D_1190
    set udg_Switch[4] = gg_dest_B00D_1191
    set udg_Switch_condition[1] = false
    set udg_Switch_condition[2] = false
    set udg_Switch_condition[3] = false
    set udg_Switch_condition[4] = false
    // Включение лифта
    set udg_Switch[5] = gg_dest_B00D_1208
    set udg_Switch_condition[5] = true
    call SetDestructableAnimationBJ( udg_Switch[5], "death" )
    // Подъем и спуск лифта
    set udg_Switch[6] = gg_dest_B00D_1206
    set udg_Switch_condition[6] = true
    call SetDestructableAnimationBJ( udg_Switch[6], "death" )
    set udg_Switch[7] = gg_dest_B00D_1207
    set udg_Switch_condition[7] = true
    call SetDestructableAnimationBJ( udg_Switch[7], "death" )
    // Огонь в камере
    set udg_Switch[8] = gg_dest_B00D_5910
    set udg_Switch_condition[8] = true
    call SetDestructableAnimationBJ( udg_Switch[8], "death" )
endfunction

