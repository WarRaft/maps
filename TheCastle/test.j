//===========================================================================
// Trigger: Cinematic Book Ending
//===========================================================================
function Trig_Cinematic_Book_Ending_Func001C takes nothing returns boolean
    if ( not ( udg_Book_open_Bool == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Book_Ending_Func013A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Book5, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_Book_Ending_Func015C takes nothing returns boolean
    if ( not ( udg_Book_open_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_Book_Ending_Actions takes nothing returns nothing
    if ( Trig_Cinematic_Book_Ending_Func001C() ) then
        call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
        call TriggerSleepAction( 0.90 )
    else
    endif
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.30 )
    // См. папку "Головоломка со статуэтками"
    call EnableTrigger( gg_trg_Activation_Book )
    call ShowDestructableBJ( true, gg_dest_B002_3154 )
    call ShowDestructableBJ( false, gg_dest_B003_3157 )
    call SetUnitAnimation( gg_unit_n00U_0184, "stand second" )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Book_Ending_Func013A )
    // Ввод изображения
    if ( Trig_Cinematic_Book_Ending_Func015C() ) then
        call SetDayNightModels( "","")
        call ShowInterfaceForceOn( GetPlayersAll(), 1.00 )
        call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.80, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0 )
    else
        call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
        call CinematicModeExBJ( false, GetPlayersAll(), 0.60 )
    endif
endfunction

//===========================================================================
function InitTrig_Cinematic_Book_Ending takes nothing returns nothing
    set gg_trg_Cinematic_Book_Ending = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_Book_Ending )
    call TriggerAddAction( gg_trg_Cinematic_Book_Ending, function Trig_Cinematic_Book_Ending_Actions )
endfunction

