function InitTrig_Cinematic_Book takes nothing returns nothing
    set gg_trg_Cinematic_Book = CreateTrigger(  )
    call DisableTrigger( gg_trg_Cinematic_Book )
    call TriggerAddAction( gg_trg_Cinematic_Book, function Trig_Cinematic_Book_Actions )
