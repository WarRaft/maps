    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'n004' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Prison_Func006A takes nothing returns nothing
    if ( Trig_Prison_Func006Func001C() ) then
        call SetUnitOwner( GetEnumUnit(), Player(10), false )
        call IssueTargetOrderBJ( GetEnumUnit(), "attack", udg_UNIT_Overseer )
    else
    endif
endfunction

function Trig_Prison_Actions takes nothing returns nothing
    if ( Trig_Prison_Func002001() ) then
        set udg_TempREG = gg_rct_REG_Cell1
    else
        call DoNothing(  )
    endif
    if ( Trig_Prison_Func003001() ) then
        set udg_TempREG = gg_rct_REG_Cell2
    else
        call DoNothing(  )
    endif
    if ( Trig_Prison_Func004001() ) then
        set udg_TempREG = gg_rct_REG_Cell3
    else
        call DoNothing(  )
    endif
    if ( Trig_Prison_Func005001() ) then
        set udg_TempREG = gg_rct_REG_Cell4
    else
        call DoNothing(  )
    endif
    call ForGroupBJ( GetUnitsInRectAll(udg_TempREG), function Trig_Prison_Func006A )
    set udg_Debuff_status = ( udg_Debuff_status + 1 )
    call ConditionalTriggerExecute( gg_trg_Debuff_Overseer )
endfunction

