//===========================================================================
function Trig_BUTTON_ENTRANCE_Func002C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(udg_Button[udg_TempNumButton]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BUTTON_ENTRANCE_Actions takes nothing returns nothing
    call GroupAddUnitSimple( udg_TempUnit, udg_Button_Units[udg_TempNumButton] )
    if ( Trig_BUTTON_ENTRANCE_Func002C() ) then
        call KillDestructable( udg_Button[udg_TempNumButton] )
    else
    endif
endfunction

