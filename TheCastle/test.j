//===========================================================================
function Trig_Foggy_Mind_Events_Actions takes nothing returns nothing
    call TriggerRegisterUnitEvent( gg_trg_Foggy_Mind, udg_UNIT_Boss3_Archmage, EVENT_UNIT_SPELL_EFFECT )
    call TriggerRegisterUnitEvent( gg_trg_Foggy_Mind_Object_Mechanic, udg_Hero_mechanic, EVENT_UNIT_ISSUED_TARGET_ORDER )
    call TriggerRegisterUnitEvent( gg_trg_Foggy_Mind_Object_Shaman, udg_Hero_shaman, EVENT_UNIT_ISSUED_TARGET_ORDER )
    call TriggerRegisterUnitEvent( gg_trg_Foggy_Mind_Object_Warrior, udg_Hero_warrior, EVENT_UNIT_ISSUED_TARGET_ORDER )
    call TriggerRegisterUnitEvent( gg_trg_Foggy_Mind_Point_Mechanic, udg_Hero_mechanic, EVENT_UNIT_ISSUED_POINT_ORDER )
    call TriggerRegisterUnitEvent( gg_trg_Foggy_Mind_Point_Shaman, udg_Hero_shaman, EVENT_UNIT_ISSUED_POINT_ORDER )
    call TriggerRegisterUnitEvent( gg_trg_Foggy_Mind_Point_Warrior, udg_Hero_warrior, EVENT_UNIT_ISSUED_POINT_ORDER )
    call EnableTrigger( gg_trg_Foggy_Mind )
    call EnableTrigger( gg_trg_Foggy_Mind_timer )
endfunction

