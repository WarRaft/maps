    set gg_trg_Moving_HellishCreature = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Moving_HellishCreature, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Moving_HellishCreature, Condition( function Trig_Moving_HellishCreature_Conditions ) )
