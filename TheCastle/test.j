function InitTrig_Soul_Stone_death takes nothing returns nothing
    set gg_trg_Soul_Stone_death = CreateTrigger(  )
    call TriggerRegisterDeathEvent( gg_trg_Soul_Stone_death, gg_dest_B00G_4765 )
    call TriggerRegisterDeathEvent( gg_trg_Soul_Stone_death, gg_dest_B00G_7436 )
    call TriggerAddAction( gg_trg_Soul_Stone_death, function Trig_Soul_Stone_death_Actions )
endfunction

