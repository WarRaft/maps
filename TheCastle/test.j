//===========================================================================
// Trigger: Runes Button1 Entrance
//===========================================================================
function Trig_Runes_Button1_Entrance_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runes_Button1_Entrance_Func005Func005Func002A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
endfunction

function Trig_Runes_Button1_Entrance_Func005Func005C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(LoadDestructableHandleBJ(3, 1, GetLastCreatedHashtableBJ())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runes_Button1_Entrance_Func005Func006C takes nothing returns boolean
    if ( not ( IsDestructableDeadBJ(udg_Button[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runes_Button1_Entrance_Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Button_Units[1]) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runes_Button1_Entrance_Actions takes nothing returns nothing
    set udg_TempUnit = GetEnteringUnit()
    set udg_TempNumButton = 1
    call TriggerExecute( gg_trg_BUTTON_ENTRANCE )
    if ( Trig_Runes_Button1_Entrance_Func005C() ) then
        call AddSpecialEffectLocBJ( GetDestructableLoc(gg_dest_B003_0443), "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call TriggerSleepAction( 0.50 )
        if ( Trig_Runes_Button1_Entrance_Func005Func005C() ) then
            call DisableTrigger( gg_trg_Skeleton_spawn )
            call ForGroupBJ( udg_Skeleton_Group, function Trig_Runes_Button1_Entrance_Func005Func005Func002A )
            call KillDestructable( LoadDestructableHandleBJ(3, 1, GetLastCreatedHashtableBJ()) )
            // Убираем ограничение опыта (защита от фарма)
            call SuspendHeroXPBJ( true, udg_Hero_warrior )
            call SuspendHeroXPBJ( true, udg_Hero_shaman )
            call SuspendHeroXPBJ( true, udg_Hero_mechanic )
            // См. папку "Сцены"
            call DisableTrigger( gg_trg_Comment01 )
            // См. папку "Ограничение опыта"
            call DisableTrigger( gg_trg_ExpBlock1 )
            call EnableTrigger( gg_trg_ExpBlock2 )
        else
        endif
        if ( Trig_Runes_Button1_Entrance_Func005Func006C() ) then
            call ShowDestructableBJ( false, gg_dest_B003_0443 )
            call ShowDestructableBJ( true, gg_dest_B002_0365 )
            call TriggerExecute( gg_trg_Runes_Buttons_Checking )
        else
            call DoNothing(  )
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Runes_Button1_Entrance takes nothing returns nothing
    set gg_trg_Runes_Button1_Entrance = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Runes_Button1_Entrance, gg_rct_REG_Button01 )
    call TriggerAddCondition( gg_trg_Runes_Button1_Entrance, Condition( function Trig_Runes_Button1_Entrance_Conditions ) )
    call TriggerAddAction( gg_trg_Runes_Button1_Entrance, function Trig_Runes_Button1_Entrance_Actions )
endfunction

