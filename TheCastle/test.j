//===========================================================================
function InitTrig_Cinematic_Victory_alternate takes nothing returns nothing
    set gg_trg_Cinematic_Victory_alternate = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Cinematic_Victory_alternate, function Trig_Cinematic_Victory_alternate_Actions )
endfunction

//===========================================================================
// Trigger: Cinematic Victory Ending
//===========================================================================
function Trig_Cinematic_Victory_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    call ClearTextMessagesBJ( GetPlayersAll() )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call CustomVictoryBJ( Player(0), true, true )
    call CustomVictoryBJ( Player(1), true, true )
    call CustomVictoryBJ( Player(2), true, true )
endfunction

//===========================================================================
function InitTrig_Cinematic_Victory_Ending takes nothing returns nothing
    set gg_trg_Cinematic_Victory_Ending = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Cinematic_Victory_Ending, function Trig_Cinematic_Victory_Ending_Actions )
endfunction

//===========================================================================
// Trigger: Comment01
//
// Включается триггером Sceletons  в папке "_Скелеты из портала"
//===========================================================================
function Trig_Comment01_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Comment01_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 0.00 )
    call TriggerSleepAction( 1.00 )
    // Сообщение Акнеладу
    call UnitAddIndicatorBJ( udg_Hero_shaman, 100, 100, 100, 0 )
    call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman04, udg_TEXT_Shaman[4], bj_TIMETYPE_SET, 1.00, false )
    call TriggerSleepAction( 4.00 )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 100.00 )
endfunction

//===========================================================================
function InitTrig_Comment01 takes nothing returns nothing
    set gg_trg_Comment01 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Comment01 )
    call TriggerRegisterEnterRectSimple( gg_trg_Comment01, gg_rct_REG_Hint )
    call TriggerAddCondition( gg_trg_Comment01, Condition( function Trig_Comment01_Conditions ) )
    call TriggerAddAction( gg_trg_Comment01, function Trig_Comment01_Actions )
endfunction

//===========================================================================
// Trigger: Enchanted crystals msg
//===========================================================================
function Trig_Enchanted_crystals_msg_Func006C takes nothing returns boolean
    if ( not ( udg_Talking_Hero == udg_Hero_shaman ) ) then
        return false
    endif
    return true
endfunction

function Trig_Enchanted_crystals_msg_Func008C takes nothing returns boolean
    if ( not ( udg_Talking_Hero == udg_Hero_warrior ) ) then
        return false
    endif
    return true
endfunction

function Trig_Enchanted_crystals_msg_Func010C takes nothing returns boolean
    if ( not ( udg_Talking_Hero == udg_Hero_mechanic ) ) then
        return false
    endif
    return true
endfunction

function Trig_Enchanted_crystals_msg_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Talking_Hero = GetEnteringUnit()
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 0.00 )
    call TriggerSleepAction( 1.00 )
    // Сообщение Акнеладу
    if ( Trig_Enchanted_crystals_msg_Func006C() ) then
        call UnitAddIndicatorBJ( udg_Hero_shaman, 100, 100, 100, 0 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman05, udg_TEXT_Shaman[5], bj_TIMETYPE_SET, 7.00, false )
        call TriggerSleepAction( 10.00 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_shaman, GetHeroProperName(udg_Hero_shaman), gg_snd_Shaman07, udg_TEXT_Shaman[7], bj_TIMETYPE_SET, 4.00, false )
        call TriggerSleepAction( 7.00 )
    else
    endif
    // Сообщение Нитнарак
    if ( Trig_Enchanted_crystals_msg_Func008C() ) then
        call UnitAddIndicatorBJ( udg_Hero_warrior, 100, 100, 100, 0 )
        call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_Hero_warrior, GetHeroProperName(udg_Hero_warrior), gg_snd_Warrior02, udg_TEXT_Warrior[2], bj_TIMETYPE_SET, 1.00, false )
