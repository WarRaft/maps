//===========================================================================
// Trigger: Renegade Merchant
//===========================================================================
function Trig_Renegade_Merchant_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 0.50 )
    call QuestMessageBJ( udg_Players, bj_QUESTMESSAGE_ALWAYSHINT, udg_TEXT_Hint[16] )
    call CreateNUnitsAtLoc( 1, 'u004', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_REG_Renegade_Merchant_Start), 240.00 )
    set udg_UNIT_Merchant = GetLastCreatedUnit()
    call IssuePointOrderLocBJ( udg_UNIT_Merchant, "move", GetRectCenter(gg_rct_REG_Renegade_Merchant_Point) )
    call TriggerRegisterUnitEvent( gg_trg_Death_of_Merchant, udg_UNIT_Merchant, EVENT_UNIT_DEATH )
    call TriggerRegisterUnitEvent( gg_trg_Attack_of_Merchant, udg_UNIT_Merchant, EVENT_UNIT_DAMAGED )
    call TriggerSleepAction( 1.00 )
    call SetUnitFacingTimed( udg_UNIT_Merchant, 270.00, 0.30 )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 0.00 )
    call TriggerSleepAction( 0.30 )
    call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Merchant, GetUnitName(udg_UNIT_Merchant), gg_snd_Acolyte01, "TRIGSTR_1707", bj_TIMETYPE_SET, 22.00, false )
    call TriggerSleepAction( 25.00 )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 100.00 )
endfunction

//===========================================================================
function InitTrig_Renegade_Merchant takes nothing returns nothing
    set gg_trg_Renegade_Merchant = CreateTrigger(  )
    call TriggerRegisterDeathEvent( gg_trg_Renegade_Merchant, gg_dest_LOcg_1738 )
    call TriggerAddAction( gg_trg_Renegade_Merchant, function Trig_Renegade_Merchant_Actions )
endfunction

//===========================================================================
// Trigger: Attack of Merchant
//===========================================================================
function Trig_Attack_of_Merchant_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEventDamageSource(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetEventDamage() >= 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Attack_of_Merchant_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call SetUnitOwner( udg_UNIT_Merchant, Player(PLAYER_NEUTRAL_AGGRESSIVE), false )
    call UnitRemoveAbilityBJ( 'Apit', udg_UNIT_Merchant )
    call UnitRemoveAbilityBJ( 'Aneu', udg_UNIT_Merchant )
    call StopSoundBJ( gg_snd_Acolyte01, false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 0.00 )
    call TransmissionFromUnitWithNameBJ( GetPlayersAll(), udg_UNIT_Merchant, GetUnitName(udg_UNIT_Merchant), gg_snd_Acolyte02, "TRIGSTR_2289", bj_TIMETYPE_SET, 0.00, false )
    call TeoTextTag ("Репутация изменена", udg_Hero_warrior, 80,0,0)
    call TeoTextTag ("Репутация изменена", udg_Hero_shaman, 80,0,0)
    call TeoTextTag ("Репутация изменена", udg_Hero_mechanic, 80,0,0)
    set udg_Reputation = ( udg_Reputation - 5.00 )
    call TriggerSleepAction( 2.00 )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_UNITSOUNDS, 100.00 )
endfunction

//===========================================================================
function InitTrig_Attack_of_Merchant takes nothing returns nothing
    set gg_trg_Attack_of_Merchant = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Attack_of_Merchant, Condition( function Trig_Attack_of_Merchant_Conditions ) )
    call TriggerAddAction( gg_trg_Attack_of_Merchant, function Trig_Attack_of_Merchant_Actions )
endfunction

