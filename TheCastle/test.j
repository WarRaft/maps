function InitTrig_Disintegration takes nothing returns nothing
    set gg_trg_Disintegration = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Disintegration, Player(0), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Disintegration, Player(1), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Disintegration, Player(2), EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Disintegration, Condition( function Trig_Disintegration_Conditions ) )
    call TriggerAddAction( gg_trg_Disintegration, function Trig_Disintegration_Actions )
endfunction

