    call RemoveLocation(point)
    set point = Location(GetRectCenterX(gg_rct_REG_Fire3_Mid), GetRectCenterY(gg_rct_REG_Fire3_Mid))
    call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
    call RemoveLocation(point)
    set point = Location(GetRectCenterX(gg_rct_REG_Fire3_Bot), GetRectCenterY(gg_rct_REG_Fire3_Bot))
    call DestroyEffect(AddSpecialEffectLoc( "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl", point ))
    call RemoveLocation(point)
