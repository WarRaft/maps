        return false
    endif
    return true
endfunction

function Trig_Lightning_Discharge_timer_Actions takes nothing returns nothing
    local real x
    local real y
    if ( Trig_Lightning_Discharge_timer_Func003C() ) then
        set x = LoadRealBJ(31, 1, GetLastCreatedHashtableBJ())
        set y = LoadRealBJ(31, 2, GetLastCreatedHashtableBJ())
    else
        if ( Trig_Lightning_Discharge_timer_Func003Func003C() ) then
            set x = LoadRealBJ(32, 1, GetLastCreatedHashtableBJ())
            set y = LoadRealBJ(32, 2, GetLastCreatedHashtableBJ())
        else
            if ( Trig_Lightning_Discharge_timer_Func003Func003Func003C() ) then
                set x = LoadRealBJ(33, 1, GetLastCreatedHashtableBJ())
                set y = LoadRealBJ(33, 2, GetLastCreatedHashtableBJ())
            else
            endif
        endif
    endif
    // Если применение умения не прерывалось
    if ( Trig_Lightning_Discharge_timer_Func005C() ) then
        call UnitDamagePoint(udg_UNIT_Boss3_Orc, 0, 190.00, x, y,1000.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call DestroyEffect( AddSpecialEffect( "EFFECTS\\Stormfall.mdx", x, y) )
        call DestroyEffect( AddSpecialEffect( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", x, y) )
    else
    endif
endfunction

