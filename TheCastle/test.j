//===========================================================================
// Trigger: Cinematic Teleporter Ending
//===========================================================================
function Trig_Cinematic_Teleporter_Ending_Func012A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_CAM_Teleporter3, GetEnumPlayer(), 0 )
endfunction

function Trig_Cinematic_Teleporter_Ending_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 0.90 )
    // Необходимые действия за кадром (звук, перемещение юнитов)
    call SetUnitAnimation( gg_unit_n022_0203, "stand" )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 3
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call SetUnitAnimation( udg_Spatial_Cube[GetForLoopIndexB()], "stand" )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    call PauseAllUnitsBJ( false )
    call VolumeGroupSetVolumeBJ( SOUND_VOLUMEGROUP_SPELLS, 100.00 )
    call EnableTrigger( gg_trg_Z_coordinate_check )
    call CameraSetSmoothingFactorBJ( 0.30 )
    call TriggerSleepAction( 0.10 )
    // Выбор положения камеры
    call ForForce( udg_Players, function Trig_Cinematic_Teleporter_Ending_Func012A )
    // Ввод изображения
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 0.60, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0 )
    call CinematicModeExBJ( false, GetPlayersAll(), 0.60 )
endfunction

