    set gg_trg_Runes_Buttons_Checking = CreateTrigger(  )
    call DisableTrigger( gg_trg_Runes_Buttons_Checking )
    call TriggerAddAction( gg_trg_Runes_Buttons_Checking, function Trig_Runes_Buttons_Checking_Actions )
