//===========================================================================
// Trigger: Button4 Checking Code
//
// Ворота к Boss1
//===========================================================================
function Trig_Button4_Checking_Code_Func005Func001Func007C takes nothing returns boolean
    if ( not ( IsDestructableDeadBJ(gg_dest_B00B_0146) == false ) ) then
        return false
    endif
    if ( not ( IsDestructableDeadBJ(udg_Button[4]) == true ) ) then
        return false
    endif
    if ( not ( udg_Lighting == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Button4_Checking_Code_Func005Func001C takes nothing returns boolean
    if ( not Trig_Button4_Checking_Code_Func005Func001Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_Button4_Checking_Code_Func005Func007Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B01M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Button4_Checking_Code_Func005Func007A takes nothing returns nothing
    if ( Trig_Button4_Checking_Code_Func005Func007Func001C() ) then
        call RemoveDestructable( GetEnumDestructable() )
    else
    endif
endfunction

function Trig_Button4_Checking_Code_Func005Func008C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(udg_Runes1[4]) == true ) ) then
        return false
    endif
    if ( not ( IsDestructableAliveBJ(udg_Runes2[1]) == true ) ) then
        return false
    endif
    if ( not ( IsDestructableAliveBJ(udg_Runes3[2]) == true ) ) then
        return false
    endif
    if ( not ( IsDestructableDeadBJ(udg_Button[4]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Button4_Checking_Code_Func005C takes nothing returns boolean
    if ( not Trig_Button4_Checking_Code_Func005Func008C() ) then
        return false
    endif
    return true
endfunction

function Trig_Button4_Checking_Code_Actions takes nothing returns nothing
    local unit dummy_unit1
    local real x = -9400
    local real y = -4200
    call TriggerSleepAction( 0.50 )
    if ( Trig_Button4_Checking_Code_Func005C() ) then
        call DisableTrigger( gg_trg_Button4_Entrance )
        call DisableTrigger( gg_trg_Button4_Exit )
        call EnableTrigger( gg_trg_Boss1_AI )
        call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_B00B_0146 )
        call PlaySoundBJ( gg_snd_BattleNetDoorsStereo2 )
        call EnumDestructablesInRectAll( gg_rct_REG_Destructable01, function Trig_Button4_Checking_Code_Func005Func007A )
    else
        if ( Trig_Button4_Checking_Code_Func005Func001C() ) then
            set udg_Lighting = true
            set dummy_unit1 = TeoCreateDummyUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'n00X', x, y, 'A025' )
            call IssuePointOrder( dummy_unit1, "flamestrike", x, y )
            call SetDoodadAnimationBJ( "stand", 'D04K', 1000.00, Location(-9400.00, -4000.00) )
            call TriggerSleepAction( 1.50 )
            call SetDoodadAnimationBJ( "death", 'D04K', 1000.00, Location(-9400.00, -4000.00) )
            set dummy_unit1 = null
        else
        endif
    endif
endfunction

