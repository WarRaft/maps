function Trig_Security1_Actions takes nothing returns nothing
    call TeoPortalRevival(18)
    call CreateNUnitsAtLoc( 1, 'n016', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct_REG_Portal18), 0.00 )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "attack", GetRectCenter(gg_rct_REG_Security_Attack_Point1) )
    call TriggerSleepAction( 0.30 )
    call CreateNUnitsAtLoc( 1, 'n014', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct_REG_Portal18), 0.00 )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "attack", GetRectCenter(gg_rct_REG_Security_Attack_Point1) )
    call TriggerSleepAction( 0.30 )
    call CreateNUnitsAtLoc( 1, 'n01A', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct_REG_Portal18), 0.00 )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "attack", GetRectCenter(gg_rct_REG_Security_Attack_Point1) )
    call SetUnitColor( GetLastCreatedUnit(), PLAYER_COLOR_BROWN )
    call TriggerSleepAction( 1.00 )
    call CreateNUnitsAtLoc( 1, 'u002', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(gg_rct_REG_Portal18), 0.00 )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", GetRectCenter(gg_rct_REG_Security_Attack_Point2) )
    call SetUnitManaPercentBJ( GetLastCreatedUnit(), 100 )
    call SetUnitColor( GetLastCreatedUnit(), PLAYER_COLOR_GREEN )
    call KillDestructable( LoadDestructableHandleBJ(18, 1, GetLastCreatedHashtableBJ()) )
