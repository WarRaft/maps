//===========================================================================
// Trigger: Destoying Hard Puzzle
//===========================================================================
function Trig_Destoying_Hard_Puzzle_Func007A takes nothing returns nothing
    local unit enum_unit = GetEnumUnit()
    if ( GetUnitTypeId(enum_unit) != 'nmgv') then
        call KillUnit( enum_unit )
        call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", GetUnitX(enum_unit), GetUnitY(enum_unit) ))
        set enum_unit = null
    else
        if (RectContainsCoords(udg_HardPuzzle_Region[1], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
            if (RectContainsCoords(udg_HardPuzzle_Region[2], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
                if (RectContainsCoords(udg_HardPuzzle_Region[3], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
                    if (RectContainsCoords(udg_HardPuzzle_Region[4], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[5], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[6], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[7], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[8], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[9], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[10], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[11], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[12], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[13], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[14], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[15], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[16], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[17], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    if (RectContainsCoords(udg_HardPuzzle_Region[18], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then
    call KillUnit( enum_unit )
    call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", GetUnitX(enum_unit), GetUnitY(enum_unit) ))
    set enum_unit = null
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
    endif
                endif
            endif
        endif
    endif
endfunction

function Trig_Destoying_Hard_Puzzle_Func011A takes nothing returns nothing
    local unit enum_unit = GetEnumUnit()
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( (RectContainsCoords(udg_HardPuzzle_Region[GetForLoopIndexA()], GetUnitX(enum_unit), GetUnitY(enum_unit)) == true) and (udg_HardPuzzle_Available_Box[GetForLoopIndexA()] == false) ) then
        set udg_HardPuzzle_Available_Box[GetForLoopIndexA()] = true
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set enum_unit = null
endfunction

function Trig_Destoying_Hard_Puzzle_Func013Func001C takes nothing returns boolean
    if ( not ( udg_HardPuzzle_Available_Box[GetForLoopIndexA()] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Destoying_Hard_Puzzle_Func015C takes nothing returns boolean
    if ( not ( IsUnitGroupEmptyBJ(udg_HardPuzzle_Group_New) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Destoying_Hard_Puzzle_Actions takes nothing returns nothing
    local location point
    local unit temp_unit
    set udg_BoxSize = 0.00
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_HardPuzzle_Available_Box[GetForLoopIndexA()] = false
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call GroupClear( udg_HardPuzzle_Group_New )
    // Убиваем всех юнитов в области (кроме ящиков), а также уничтожаем ящики, которые находятся не на нужных местах
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_REG_Hard_Puzzle), function Trig_Destoying_Hard_Puzzle_Func007A )
    call TriggerSleepAction( 0.70 )
    call EnableTrigger( gg_trg_Death_of_HardPuzzleBox )
    // Проверяем места на необходимость создания ящика
    call ForGroupBJ( udg_HardPuzzle_Group, function Trig_Destoying_Hard_Puzzle_Func011A )
    // Создаем ящики, в нужных местах, если там нет ящика
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Destoying_Hard_Puzzle_Func013Func001C() ) then
            set point = GetRectCenter(udg_HardPuzzle_Region[GetForLoopIndexA()])
            set temp_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'nmgv', GetLocationX(point),GetLocationY(point), 45.00 )
            call GroupAddUnitSimple( temp_unit, udg_HardPuzzle_Group )
            call GroupAddUnitSimple( temp_unit, udg_HardPuzzle_Group_New )
            call SetUnitScalePercent( temp_unit, 0.00, 0.00, 0.00 )
            call DestroyEffect(AddSpecialEffect( "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", GetLocationX(point), GetLocationY(point) ))
            call RemoveLocation(point)
            set point = null
            set temp_unit = null
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction( 0.20 )
    if ( Trig_Destoying_Hard_Puzzle_Func015C() ) then
        call StartTimerBJ( udg_HardPuzzle_Size_Timer, false, ( 1.00 / 30.00 ) )
    else
    endif
endfunction

