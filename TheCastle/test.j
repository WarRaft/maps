function InitTrig_Corpses_death takes nothing returns nothing
    set gg_trg_Corpses_death = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Corpses_death, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Corpses_death, Condition( function Trig_Corpses_death_Conditions ) )
    call TriggerAddAction( gg_trg_Corpses_death, function Trig_Corpses_death_Actions )
endfunction

//===========================================================================
// Trigger: Attacking Devouer
//===========================================================================
function Trig_Attacking_Devouer_Func003Func002C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_UNIT_Devouer) <= 2.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Attacking_Devouer_Func003C takes nothing returns boolean
    if ( not ( IsUnitType(GetEventDamageSource(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Attacking_Devouer_Actions takes nothing returns nothing
    local effect temp_effect
    set udg_HP_Devouer = GetUnitStateSwap(UNIT_STATE_LIFE, udg_UNIT_Devouer)
    if ( Trig_Attacking_Devouer_Func003C() ) then
        call TriggerSleepAction( 0.01 )
        call SetUnitLifeBJ( udg_UNIT_Devouer, ( udg_HP_Devouer + ( 2.00 * GetEventDamage() ) ) )
        set temp_effect = AddSpecialEffectTarget( "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", udg_UNIT_Devouer, "origin" )
        call TriggerSleepAction( 2.00 )
        call DestroyEffect( temp_effect )
        set temp_effect = null
    else
        call TriggerSleepAction( 0.01 )
        if ( Trig_Attacking_Devouer_Func003Func002C() ) then
            call KillUnit( udg_UNIT_Devouer )
        else
        endif
    endif
endfunction

