//===========================================================================
// Trigger: Hunting
//===========================================================================
function Trig_Hunting_Func002Func006Func001C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_UNIT_Devastator), GetUnitLoc(GetEnumUnit())) < udg_Distance_to_victim ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hunting_Func002Func006A takes nothing returns nothing
    if ( Trig_Hunting_Func002Func006Func001C() ) then
        set udg_Distance_to_victim = DistanceBetweenPoints(GetUnitLoc(udg_UNIT_Devastator), GetUnitLoc(GetEnumUnit()))
        set udg_VictimUnit = GetEnumUnit()
    else
    endif
endfunction

function Trig_Hunting_Func002C takes nothing returns boolean
    if ( not ( IsUnitGroupEmptyBJ(udg_Victims_Group) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hunting_Actions takes nothing returns nothing
    if ( Trig_Hunting_Func002C() ) then
        call EnableTrigger( GetTriggeringTrigger() )
        // Выбираем ближайшего юнита к Опустошителю
        set udg_Distance_to_victim = 10000.00
        call ForGroupBJ( udg_Victims_Group, function Trig_Hunting_Func002Func006A )
        call IssueTargetOrderBJ( udg_UNIT_Devastator, "attack", udg_VictimUnit )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call IssuePointOrderLocBJ( udg_UNIT_Devastator, "move", GetRectCenter(gg_rct_REG_Start_of_Hunting) )
    endif
endfunction

