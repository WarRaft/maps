//===========================================================================
// Trigger: Entry portal
//===========================================================================
function Trig_Entry_portal_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSummonedUnit()) == 'h002' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Entry_portal_Actions takes nothing returns nothing
    local location hero_point = GetUnitLoc(GetSummoningUnit())
    local location target_point = GetUnitLoc(GetSummonedUnit())
    local real angle = AngleBetweenPoints(hero_point, target_point)
    set udg_Teleport_Bool = false
    // Убиваем предыдущий призванный портал
    call KillUnit( LoadUnitHandleBJ(0, 1, GetLastCreatedHashtableBJ()) )
    // Сохраняем призванный портал в хэш-таблицу
    call SaveUnitHandleBJ( GetSummonedUnit(), 0, 1, GetLastCreatedHashtableBJ() )
    call SetUnitFacing( LoadUnitHandleBJ(0, 1, GetLastCreatedHashtableBJ()), ( 180.00 + angle ) )
    call SetUnitTimeScalePercent( LoadUnitHandleBJ(0, 1, GetLastCreatedHashtableBJ()), 320.00 )
    // Обнуление переменных
    call RemoveLocation(hero_point)
    call RemoveLocation(target_point)
    set hero_point = null
    set target_point = null
    call TriggerSleepAction( 1.00 )
    call SetUnitTimeScalePercent( LoadUnitHandleBJ(0, 1, GetLastCreatedHashtableBJ()), 100.00 )
    call TriggerSleepAction( 2.00 )
    call TriggerRegisterUnitInRangeSimple( gg_trg_Portal_passage, 30.00, LoadUnitHandleBJ(0, 1, GetLastCreatedHashtableBJ()) )
    set udg_Teleport_Bool = true
endfunction

//===========================================================================
function InitTrig_Entry_portal takes nothing returns nothing
    set gg_trg_Entry_portal = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Entry_portal, Player(0), EVENT_PLAYER_UNIT_SUMMON )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Entry_portal, Player(1), EVENT_PLAYER_UNIT_SUMMON )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Entry_portal, Player(2), EVENT_PLAYER_UNIT_SUMMON )
    call TriggerAddCondition( gg_trg_Entry_portal, Condition( function Trig_Entry_portal_Conditions ) )
    call TriggerAddAction( gg_trg_Entry_portal, function Trig_Entry_portal_Actions )
endfunction

