[trigger]
name="Selecting Player1"
description=""
condition=OperatorComparePlayer(GetOwningPlayer(GetTriggerUnit()), OperatorEqualENE, Player00)
action=IfThenElseMultiple()
>action:2=DoNothing()
>action:1=SetVariable($Z_time["1"], "0.00")
>action:1=SetVariable($Z_Unit["1"], $Hero_warrior)
>action:1=TriggerExecute($gg_trg_Z_calculation)
>action:1=ReturnAction()
>condition:0=OperatorCompareUnit(GetTriggerUnit(), OperatorEqualENE, $Hero_warrior)
action=IfThenElseMultiple()
>action:1=SetVariable($Z_time["1"], "0.00")
>action:1=SetVariable($Z_Unit["1"], $Hero_shaman)
>action:1=TriggerExecute($gg_trg_Z_calculation)
>action:1=ReturnAction()
>action:2=DoNothing()
>condition:0=OperatorCompareUnit(GetTriggerUnit(), OperatorEqualENE, $Hero_shaman)
action=IfThenElseMultiple()
>action:1=SetVariable($Z_time["1"], "0.00")
>action:1=SetVariable($Z_Unit["1"], $Hero_mechanic)
>action:1=TriggerExecute($gg_trg_Z_calculation)
>action:1=ReturnAction()
>action:2=DoNothing()
>condition:0=OperatorCompareUnit(GetTriggerUnit(), OperatorEqualENE, $Hero_mechanic)
event=TriggerRegisterPlayerSelectionEventBJ(Player00, SelDeselOptionSel)
