[trigger]
name="Exchange"
description="Триггер заменяет купленные в лавках предметы (Подлежащие продаже) на предметы с более низкой ценой продажи (Артефакты)."
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>action:1=UnitAddItemByIdSwapped("rlif", GetBuyingUnit())
>action:1=ReturnAction()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I00M")
action=IfThenElseMultiple()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I00L")
>action:1=RemoveItem(GetSoldItem())
>action:1=UnitAddItemByIdSwapped("rde1", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I00N")
>action:1=UnitAddItemByIdSwapped("gcel", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I00O")
>action:1=UnitAddItemByIdSwapped("bspd", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I00P")
>action:1=UnitAddItemByIdSwapped("I008", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I00Q")
>action:1=UnitAddItemByIdSwapped("I002", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I00R")
>action:1=UnitAddItemByIdSwapped("prvt", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I00S")
>action:1=UnitAddItemByIdSwapped("stwa", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I01E")
>action:1=UnitAddItemByIdSwapped("I01B", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>action:1=RemoveItemFromStockBJ("I01P", $UNIT_Marauder)
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I01P")
>action:1=UnitAddItemByIdSwapped("I00C", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>action:1=RemoveItemFromStockBJ("I01Q", $UNIT_Marauder)
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I01Q")
>action:1=UnitAddItemByIdSwapped("I00B", GetBuyingUnit())
>action:1=ReturnAction()
action=IfThenElseMultiple()
>action:1=RemoveItem(GetSoldItem())
>action:1=RemoveItemFromStockBJ("I01R", $UNIT_Marauder)
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I01R")
>action:1=UnitAddItemByIdSwapped("I00D", GetBuyingUnit())
>action:1=ReturnAction()
action=CommentString("Предметы 2 уровня")
