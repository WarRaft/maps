[trigger]
name="Boss1 AI"
description=""
initially_off=1
action=CustomScriptCode("local location point = GetUnitLoc(GroupPickRandomUnit(udg_Units_in_the_boss1_area))")
action=IfThenElseMultiple()
>action:2=IfThenElseMultiple()
>>action:1=CommentString("Активируем Огненный щит для Повелителя Огня")
>>action:2=DoNothing()
>>action:1=IssueTargetOrder($UNIT_Boss1, UnitOrderAntiMagicShell, $UNIT_Boss1)
>>action:1=StartTimerBJ($Cooldown_Boss1, PeriodicOptionOneTime, "15.00")
>>condition:0=OperatorCompareInteger($Boss1_stage, OperatorEqual, "2")
>>condition:0=OperatorCompareBoolean(UnitHasBuffBJ($UNIT_Boss1, "B000"), OperatorEqualENE, "false")
>>condition:0=OperatorCompareReal(TimerGetRemaining($Cooldown_Boss1), OperatorLessEq, "0.00")
>action:1=SetVariable($Trigger_for_Boss1, OperatorInt($Trigger_for_Boss1, OperatorAdd, "1"))
>action:1=IfThenElseMultiple()
>>action:2=IfThenElseMultiple()
>>>action:2=CustomScriptCode("call IssuePointOrder( udg_UNIT_Boss1, \"flamestrike\", GetLocationX(point), GetLocationY(point) )")
>>>action:1=CommentString("Активируем Огненный щит для Повелителя Огня")
>>>action:1=IssueTargetOrder($UNIT_Boss1, UnitOrderAntiMagicShell, $UNIT_Boss1)
>>>action:1=StartTimerBJ($Cooldown_Boss1, PeriodicOptionOneTime, "15.00")
>>>condition:0=OperatorCompareInteger($Boss1_stage, OperatorEqual, "2")
>>>condition:0=OperatorCompareBoolean(UnitHasBuffBJ($UNIT_Boss1, "B000"), OperatorEqualENE, "false")
>>>condition:0=OperatorCompareReal(TimerGetRemaining($Cooldown_Boss1), OperatorLessEq, "0.00")
>>action:1=SetVariable($Trigger_for_Boss1, "0")
>>action:1=IssueImmediateOrder($UNIT_Boss1, UnitOrderLavaMonster)
>>condition:0=OperatorCompareInteger($Trigger_for_Boss1, OperatorEqual, "15")
>condition:0=OperatorCompareBoolean(IsUnitGroupEmptyBJ($Units_in_the_boss1_area), OperatorEqualENE, "false")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Boss1), OperatorEqualENE, "true")
action=CommentString("Обнуление переменных")
action=CustomScriptCode("call RemoveLocation(point)")
action=CustomScriptCode("set point = null")
event=TriggerRegisterTimerEventPeriodic("2.30")
