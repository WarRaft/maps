[trigger]
name="Boss Obelisk Attack"
description=""
initially_off=1
action=PlaySoundBJ($gg_snd_AutoCastButtonClick1)
action=SetVariable($Boss_Obelisk_condition[$Boss_Obelisk_num], "true")
action=SetUnitColor($Boss_Obelisk[$Boss_Obelisk_num], GetPlayerColor(ConvertedPlayer($Boss1_stage)))
action=SetUnitAnimation($Boss_Obelisk[$Boss_Obelisk_num], "stand alternate")
action=StartTimerBJ($Boss_Obelisk_Timer[$Boss_Obelisk_num], PeriodicOptionOneTime, $Timer_Duration)
action=CommentString("Меняем цвет молнии для Обелисков в зависимости от стадии")
action=IfThenElseMultiple()
>action:1=ForLoopAMultiple("1", "4")
>>action:0=UnitRemoveAbilityBJ("A012", $Boss_Obelisk[GetForLoopIndexA()])
>>action:0=UnitAddAbilityBJ("A013", $Boss_Obelisk[GetForLoopIndexA()])
>condition:0=OperatorCompareInteger($Boss1_stage, OperatorEqual, "2")
action=CommentString("Если все обелиски активированы, то атакуем Повелителя Огня")
action=IfThenElseMultiple()
>condition:0=GetBooleanAnd(condition:OperatorCompareBoolean($Boss_Obelisk_condition["1"], OperatorEqualENE, "true") ~"", condition:GetBooleanAnd(condition:OperatorCompareBoolean($Boss_Obelisk_condition["2"], OperatorEqualENE, "true") ~"", condition:GetBooleanAnd(condition:OperatorCompareBoolean($Boss_Obelisk_condition["3"], OperatorEqualENE, "true") ~"", condition:OperatorCompareBoolean($Boss_Obelisk_condition["4"], OperatorEqualENE, "true") ~"") ~"") ~"")
>action:1=DisableTrigger($gg_trg_Boss_Obelisk1)
>action:1=DisableTrigger($gg_trg_Boss_Obelisk2)
>action:1=DisableTrigger($gg_trg_Boss_Obelisk3)
>action:1=DisableTrigger($gg_trg_Boss_Obelisk4)
>action:1=ForLoopA("1", "4", action:PauseTimerBJ(PauseResumePause, $Boss_Obelisk_Timer[GetForLoopIndexA()]) ~"DoNothing")
>action:1=CommentString("Если на Повелителе Огня есть огненный щит")
>action:1=IfThenElseMultiple()
>>action:1=DisplayTextToForce(GetPlayersAll(), "TRIGSTR_2574")
>>action:1=PlaySoundBJ($gg_snd_Error)
>>action:1=ForLoopAMultiple("1", "4")
>>>action:0=SetVariable($Boss_Obelisk_condition[GetForLoopIndexA()], "false")
>>action:2=ForLoopAMultiple("1", "4")
>>>action:0=IssueTargetOrder($Boss_Obelisk[GetForLoopIndexA()], UnitOrderFingerOfDeath, $UNIT_Boss1)
>>>action:0=SetVariable($Boss_Obelisk_condition[GetForLoopIndexA()], "false")
>>action:2=SetVariable($Boss1_stage, OperatorInt($Boss1_stage, OperatorAdd, "1"))
>>condition:0=OperatorCompareBoolean(UnitHasBuffBJ($UNIT_Boss1, "B000"), OperatorEqualENE, "true")
>action:1=TriggerSleepAction("1.00")
>action:1=ForLoopAMultiple("1", "4")
>>action:0=SetUnitAnimation($Boss_Obelisk[GetForLoopIndexA()], "stand")
>>action:0=SetUnitColor($Boss_Obelisk[GetForLoopIndexA()], GetPlayerColor(PlayerNP))
>action:1=EnableTrigger($gg_trg_Boss_Obelisk1)
>action:1=EnableTrigger($gg_trg_Boss_Obelisk2)
>action:1=EnableTrigger($gg_trg_Boss_Obelisk3)
>action:1=EnableTrigger($gg_trg_Boss_Obelisk4)
