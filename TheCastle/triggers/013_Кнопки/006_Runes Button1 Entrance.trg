[trigger]
name="Runes Button1 Entrance"
description=""
action=SetVariable($TempUnit, GetEnteringUnit())
condition=OperatorCompareBoolean(IsUnitType(GetEnteringUnit(), UnitTypeHero), OperatorEqualENE, "true")
action=SetVariable($TempNumButton, "1")
action=TriggerExecute($gg_trg_BUTTON_ENTRANCE)
action=IfThenElseMultiple()
>condition:0=OperatorCompareInteger(CountUnitsInGroup($Button_Units["1"]), OperatorEqual, "1")
>action:1=AddSpecialEffectLocBJ(GetDestructableLoc($gg_dest_B003_0443), "Environment\\NightElfBuildingFire\\ElfSmallBuildingFire2.mdl")
>action:1=DestroyEffectBJ(GetLastCreatedEffectBJ())
>action:1=TriggerSleepAction("0.50")
>action:1=IfThenElseMultiple()
>>action:1=DisableTrigger($gg_trg_Skeleton_spawn)
>>action:1=ForGroupMultiple($Skeleton_Group)
>>>action:0=KillUnit(GetEnumUnit())
>>action:1=KillDestructable(LoadDestructableHandleBJ("3", "1", GetLastCreatedHashtableBJ()))
>>action:1=CommentString("Убираем ограничение опыта (защита от фарма)")
>>action:1=SuspendHeroXPBJ(EnableDisableEnable, $Hero_warrior)
>>action:1=SuspendHeroXPBJ(EnableDisableEnable, $Hero_shaman)
>>action:1=SuspendHeroXPBJ(EnableDisableEnable, $Hero_mechanic)
>>action:1=CommentString("См. папку \"Сцены\"")
>>action:1=DisableTrigger($gg_trg_Comment01)
>>action:1=CommentString("См. папку \"Ограничение опыта\"")
>>action:1=DisableTrigger($gg_trg_ExpBlock1)
>>action:1=EnableTrigger($gg_trg_ExpBlock2)
>>condition:0=OperatorCompareBoolean(IsDestructableAliveBJ(LoadDestructableHandleBJ("3", "1", GetLastCreatedHashtableBJ())), OperatorEqualENE, "true")
>action:1=IfThenElseMultiple()
>>condition:0=OperatorCompareBoolean(IsDestructableDeadBJ($Button["1"]), OperatorEqualENE, "true")
>>action:1=ShowDestructableBJ(ShowHideHide, $gg_dest_B003_0443)
>>action:1=ShowDestructableBJ(ShowHideShow, $gg_dest_B002_0365)
>>action:1=TriggerExecute($gg_trg_Runes_Buttons_Checking)
>>action:2=DoNothing()
event=TriggerRegisterEnterRectSimple($gg_rct_REG_Button01)
