[trigger]
name="Button20 Action"
description=""
action=CommentString("Проигрывание звука и проверка на правильность")
action=IfThenElseMultiple()
>action:2=IfThenElseMultiple()
>>action:2=IfThenElseMultiple()
>>>action:2=IfThenElseMultiple()
>>>>action:2=PauseTimerBJ(PauseResumePause, $Music_Timer)
>>>>action:2=TriggerExecute($gg_trg_Music_note_Timer)
>>>>action:1=ShowDestructableBJ(ShowHideShow, $gg_dest_B009_10779)
>>>>action:1=StartTimerBJ($Music_Timer, PeriodicOptionOneTime, $Music_Timer_count)
>>>>condition:0=OperatorCompareInteger($Music, OperatorEqual, "11")
>>>action:1=SetVariable($Music, OperatorInt($Music, OperatorAdd, "1"))
>>>action:1=ShowDestructableBJ(ShowHideShow, $gg_dest_B009_10777)
>>>action:1=StartTimerBJ($Music_Timer, PeriodicOptionOneTime, $Music_Timer_count)
>>>condition:0=OperatorCompareInteger($Music, OperatorEqual, "7")
>>action:1=SetVariable($Music, OperatorInt($Music, OperatorAdd, "1"))
>>action:1=ShowDestructableBJ(ShowHideShow, $gg_dest_B009_10787)
>>action:1=StartTimerBJ($Music_Timer, PeriodicOptionOneTime, $Music_Timer_count)
>>condition:0=OperatorCompareInteger($Music, OperatorEqual, "3")
>action:1=SetVariable($Music, OperatorInt($Music, OperatorAdd, "1"))
>action:1=ShowDestructableBJ(ShowHideShow, $gg_dest_B009_10778)
>action:1=StartTimerBJ($Music_Timer, PeriodicOptionOneTime, $Music_Timer_count)
>condition:0=OperatorCompareInteger($Music, OperatorEqual, "0")
event=TriggerRegisterDeathEvent($gg_dest_B01H_10390)
