[trigger]
name="Runes Buttons Checking"
description=""
initially_off=1
action=IfThenElseMultiple()
>action:1=DisableTrigger($gg_trg_Runes_Button1_Entrance)
>action:1=DisableTrigger($gg_trg_Runes_Button1_Exit)
>action:1=DisableTrigger($gg_trg_Runes_Button2_Entrance)
>action:1=DisableTrigger($gg_trg_Runes_Button2_Exit)
>action:1=DisableTrigger($gg_trg_Runes_Button3_Entrance)
>action:1=DisableTrigger($gg_trg_Runes_Button3_Exit)
>action:1=TriggerSleepAction("0.50")
>action:1=PlaySoundBJ($gg_snd_BattleNetDoorsStereo2)
>action:1=ModifyGateBJ(GateOperationOpen, $gg_dest_B004_0364)
>action:1=TriggerSleepAction("1.00")
>action:1=CommentString("Открываем порталы для возврата № 1 и № 2")
>action:1=SetVariable($Portal_num, "1")
>action:1=TriggerExecute($gg_trg_PORTAL_OPENING)
>action:1=SetVariable($Portal_num, "2")
>action:1=TriggerExecute($gg_trg_PORTAL_OPENING)
>action:1=EnumDestructablesInRectAllMultiple($gg_rct_REG_Runes)
>>action:0=IfThenElseMultiple()
>>>action:1=RemoveDestructable(GetEnumDestructable())
>>>condition:0=OperatorCompareDestructableCode(GetDestructableTypeId(GetEnumDestructable()), OperatorEqualENE, "B01M")
>action:1=RemoveUnit($UNIT_Traveler)
>action:1=RemoveUnit($UNIT_Lizard)
>condition:0=AndMultiple()
>>condition:0=OperatorCompareBoolean(IsDestructableAliveBJ($Button["1"]), OperatorEqualENE, "false")
>>condition:0=OperatorCompareBoolean(IsDestructableAliveBJ($Button["2"]), OperatorEqualENE, "false")
>>condition:0=OperatorCompareBoolean(IsDestructableAliveBJ($Button["3"]), OperatorEqualENE, "false")
