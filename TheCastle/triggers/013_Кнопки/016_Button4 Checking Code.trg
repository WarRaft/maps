[trigger]
name="Button4 Checking Code"
description="Ворота к Boss1"
initially_off=1
action=CustomScriptCode("local unit dummy_unit1")
action=CustomScriptCode("local real x = -9400")
action=CustomScriptCode("local real y = -4200")
action=TriggerSleepAction("0.50")
action=IfThenElseMultiple()
>action:2=IfThenElseMultiple()
>>action:1=SetVariable($Lighting, "true")
>>action:1=CustomScriptCode("set dummy_unit1 = TeoCreateDummyUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'n00X', x, y, 'A025' )")
>>action:1=CustomScriptCode("call IssuePointOrder( dummy_unit1, \"flamestrike\", x, y )")
>>action:1=SetDoodadAnimationBJ("stand", "D04K", "1000.00", Location("-9400.00", "-4000.00"))
>>action:1=TriggerSleepAction("1.50")
>>action:1=SetDoodadAnimationBJ("death", "D04K", "1000.00", Location("-9400.00", "-4000.00"))
>>condition:0=AndMultiple()
>>>condition:0=OperatorCompareBoolean(IsDestructableDeadBJ($gg_dest_B00B_0146), OperatorEqualENE, "false")
>>>condition:0=OperatorCompareBoolean(IsDestructableDeadBJ($Button["4"]), OperatorEqualENE, "true")
>>>condition:0=OperatorCompareBoolean($Lighting, OperatorEqualENE, "false")
>>action:1=CustomScriptCode("set dummy_unit1 = null")
>action:1=DisableTrigger($gg_trg_Button4_Entrance)
>action:1=DisableTrigger($gg_trg_Button4_Exit)
>action:1=EnableTrigger($gg_trg_Boss1_AI)
>action:1=ModifyGateBJ(GateOperationOpen, $gg_dest_B00B_0146)
>action:1=PlaySoundBJ($gg_snd_BattleNetDoorsStereo2)
>action:1=EnumDestructablesInRectAllMultiple($gg_rct_REG_Destructable01)
>>action:0=IfThenElseMultiple()
>>>action:1=RemoveDestructable(GetEnumDestructable())
>>>condition:0=OperatorCompareDestructableCode(GetDestructableTypeId(GetEnumDestructable()), OperatorEqualENE, "B01M")
>condition:0=AndMultiple()
>>condition:0=OperatorCompareBoolean(IsDestructableAliveBJ($Runes1["4"]), OperatorEqualENE, "true")
>>condition:0=OperatorCompareBoolean(IsDestructableAliveBJ($Runes2["1"]), OperatorEqualENE, "true")
>>condition:0=OperatorCompareBoolean(IsDestructableAliveBJ($Runes3["2"]), OperatorEqualENE, "true")
>>condition:0=OperatorCompareBoolean(IsDestructableDeadBJ($Button["4"]), OperatorEqualENE, "true")
