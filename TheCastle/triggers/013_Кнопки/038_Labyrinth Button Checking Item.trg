[trigger]
name="Labyrinth Button Checking Item"
description=""
initially_off=1
action=IfThenElseMultiple()
>action:1=SetVariable($TempUnit, $gg_unit_n00F_0134)
>action:1=SetVariable($TempNumButton, "7")
>action:1=SetVariable($TempNumButtonItem, "7")
>action:1=TriggerExecute($gg_trg_BUTTON_ENTRANCE)
>condition:0=OperatorCompareBoolean(RectContainsItem($TempItem, $gg_rct_REG_Button07), OperatorEqualENE, "true")
action=IfThenElseMultiple()
>action:1=SetVariable($TempUnit, $gg_unit_n00F_0134)
>action:1=SetVariable($TempNumButton, "8")
>action:1=SetVariable($TempNumButtonItem, "8")
>action:1=TriggerExecute($gg_trg_BUTTON_ENTRANCE)
>condition:0=OperatorCompareBoolean(RectContainsItem($TempItem, $gg_rct_REG_Button08), OperatorEqualENE, "true")
action=IfThenElseMultiple()
>action:1=SetVariable($TempUnit, $gg_unit_n00F_0134)
>action:1=SetVariable($TempNumButton, "9")
>action:1=SetVariable($TempNumButtonItem, "9")
>action:1=TriggerExecute($gg_trg_BUTTON_ENTRANCE)
>condition:0=OperatorCompareBoolean(RectContainsItem($TempItem, $gg_rct_REG_Button09), OperatorEqualENE, "true")
action=IfThenElseMultiple()
>action:1=SetVariable($TempUnit, $gg_unit_n00F_0134)
>action:1=SetVariable($TempNumButton, "10")
>action:1=SetVariable($TempNumButtonItem, "10")
>action:1=TriggerExecute($gg_trg_BUTTON_ENTRANCE)
>condition:0=OperatorCompareBoolean(RectContainsItem($TempItem, $gg_rct_REG_Button10), OperatorEqualENE, "true")
