[trigger]
name="Init Switches"
description="Switch_condition: \"Нет\" - stand анимация, \"Да\" - death анимация."
initially_off=1
action=SetVariable($Switch_num, "8")
action=SetVariable($Switch["1"], $gg_dest_B00D_1188)
action=SetVariable($Switch["2"], $gg_dest_B00D_1189)
action=SetVariable($Switch["3"], $gg_dest_B00D_1190)
action=SetVariable($Switch["4"], $gg_dest_B00D_1191)
action=SetVariable($Switch_condition["1"], "false")
action=SetVariable($Switch_condition["2"], "false")
action=SetVariable($Switch_condition["3"], "false")
action=SetVariable($Switch_condition["4"], "false")
action=CommentString("Включение лифта")
action=SetVariable($Switch["5"], $gg_dest_B00D_1208)
action=SetVariable($Switch_condition["5"], "true")
action=SetDestructableAnimationBJ($Switch["5"], "death")
action=CommentString("Подъем и спуск лифта")
action=SetVariable($Switch["6"], $gg_dest_B00D_1206)
action=SetVariable($Switch_condition["6"], "true")
action=SetDestructableAnimationBJ($Switch["6"], "death")
action=SetVariable($Switch["7"], $gg_dest_B00D_1207)
action=SetVariable($Switch_condition["7"], "true")
action=SetDestructableAnimationBJ($Switch["7"], "death")
action=CommentString("Огонь в камере")
action=SetVariable($Switch["8"], $gg_dest_B00D_5910)
action=SetVariable($Switch_condition["8"], "true")
action=SetDestructableAnimationBJ($Switch["8"], "death")
