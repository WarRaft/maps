>>action:1=TriggerSleepAction("0.30")
>>action:1=IfThenElseMultiple()
>>>action:2=ChangeElevatorWalls(ElevatorWallOpOpen, ElevatorWallTypeNorth, $gg_dest_DTrx_1204)
>>>action:1=ChangeElevatorWalls(ElevatorWallOpOpen, ElevatorWallTypeSouth, $gg_dest_DTrx_1204)
>>>condition:0=OperatorCompareInteger(GetElevatorHeight($gg_dest_DTrx_1204), OperatorEqual, "1")
>>condition:0=OperatorCompareBoolean($Switch_condition["7"], OperatorEqualENE, "true")
>action:1=ReturnAction()
>condition:0=OperatorCompareDestructible(GetSpellTargetDestructable(), OperatorEqualENE, $Switch["7"])
action=CommentString("8 переключатель (огненная казнь)")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:2=SetVariable($Switch_condition["8"], "false")
>>action:2=TriggerExecute($gg_trg_Fire_Execution)
>>action:2=EnableTrigger($gg_trg_Fire_Execution)
>>action:1=SetVariable($Switch_condition["8"], "true")
>>action:1=DisableTrigger($gg_trg_Fire_Execution)
>>condition:0=OperatorCompareBoolean($Switch_condition["8"], OperatorEqualENE, "false")
>condition:0=OperatorCompareDestructible(GetSpellTargetDestructable(), OperatorEqualENE, $Switch["8"])
