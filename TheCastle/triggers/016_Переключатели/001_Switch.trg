[trigger]
name="Switch"
description=""
initially_off=1
action=CommentString("1 переключатель (двери западни)")
action=IfThenElseMultiple()
>action:1=TriggerExecute($gg_trg_Hunting)
>action:1=IfThenElseMultiple()
>>action:2=DestructableRestoreLife($gg_dest_B00S_4127, "500.00", ShowHideShow)
>>action:2=DestructableRestoreLife($gg_dest_B00S_4129, "500.00", ShowHideShow)
>>action:2=KillDestructable($gg_dest_B00S_4128)
>>action:2=SetVariable($Switch_condition["1"], "false")
>>action:1=KillDestructable($gg_dest_B00S_4127)
>>action:1=KillDestructable($gg_dest_B00S_4129)
>>action:1=DestructableRestoreLife($gg_dest_B00S_4128, "500.00", ShowHideShow)
>>action:1=SetVariable($Switch_condition["1"], "true")
>>condition:0=OperatorCompareBoolean($Switch_condition["1"], OperatorEqualENE, "false")
>action:1=ReturnAction()
>condition:0=OperatorCompareDestructible(GetSpellTargetDestructable(), OperatorEqualENE, $Switch["1"])
action=CommentString("2 переключатель (двери западни)")
action=IfThenElseMultiple()
>action:1=TriggerExecute($gg_trg_Hunting)
>action:1=IfThenElseMultiple()
>>action:2=KillDestructable($gg_dest_B00S_1183)
>>action:2=DestructableRestoreLife($gg_dest_B00S_1184, "500.00", ShowHideShow)
>>action:1=KillDestructable($gg_dest_B00S_1184)
>>action:1=DestructableRestoreLife($gg_dest_B00S_1183, "500.00", ShowHideShow)
>>action:1=SetVariable($Switch_condition["2"], "true")
>>action:2=SetVariable($Switch_condition["2"], "false")
>>condition:0=OperatorCompareBoolean($Switch_condition["2"], OperatorEqualENE, "false")
>action:1=ReturnAction()
>condition:0=OperatorCompareDestructible(GetSpellTargetDestructable(), OperatorEqualENE, $Switch["2"])
action=CommentString("3 переключатель (двери западни)")
action=IfThenElseMultiple()
>action:1=TriggerExecute($gg_trg_Hunting)
>action:1=IfThenElseMultiple()
>>action:2=DestructableRestoreLife($gg_dest_B00S_1180, "500.00", ShowHideShow)
>>action:2=DestructableRestoreLife($gg_dest_B00S_1182, "500.00", ShowHideShow)
>>action:2=KillDestructable($gg_dest_B00S_1185)
>>action:1=KillDestructable($gg_dest_B00S_1180)
>>action:1=KillDestructable($gg_dest_B00S_1182)
>>action:1=DestructableRestoreLife($gg_dest_B00S_1185, "500.00", ShowHideShow)
>>action:2=SetVariable($Switch_condition["3"], "false")
>>action:1=SetVariable($Switch_condition["3"], "true")
>>condition:0=OperatorCompareBoolean($Switch_condition["3"], OperatorEqualENE, "false")
>action:1=ReturnAction()
>condition:0=OperatorCompareDestructible(GetSpellTargetDestructable(), OperatorEqualENE, $Switch["3"])
action=CommentString("4 переключатель (двери западни)")
action=IfThenElseMultiple()
>action:1=TriggerExecute($gg_trg_Hunting)
>action:1=IfThenElseMultiple()
>>action:2=DestructableRestoreLife($gg_dest_B00S_0971, "500.00", ShowHideShow)
>>action:1=KillDestructable($gg_dest_B00S_0971)
>>action:2=SetVariable($Switch_condition["4"], "false")
>>action:1=SetVariable($Switch_condition["4"], "true")
>>condition:0=OperatorCompareBoolean($Switch_condition["4"], OperatorEqualENE, "false")
>action:1=ReturnAction()
>condition:0=OperatorCompareDestructible(GetSpellTargetDestructable(), OperatorEqualENE, $Switch["4"])
action=CommentString("5 переключатель (включение лифта)")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:2=SetVariable($Switch_condition["5"], "false")
>>action:2=ChangeElevatorWalls(ElevatorWallOpClose, ElevatorWallTypeAll, $gg_dest_DTrx_0972)
>>action:2=ChangeElevatorHeight($gg_dest_DTrx_0972, "1")
>>action:2=StartTimerBJ($Elevator_Timer["1"], PeriodicOptionOneTime, "4.00")
>>action:2=EnableTrigger($gg_trg_ElevatorTimer1)
>>action:2=TriggerSleepAction("1.00")
>>action:2=ChangeElevatorWalls(ElevatorWallOpOpen, ElevatorWallTypeNorth, $gg_dest_DTrx_0972)
>>action:1=SetVariable($Switch_condition["5"], "true")
>>action:1=ChangeElevatorWalls(ElevatorWallOpClose, ElevatorWallTypeAll, $gg_dest_DTrx_0972)
>>action:1=ChangeElevatorHeight($gg_dest_DTrx_0972, "3")
>>action:1=PauseTimerBJ(PauseResumePause, $Elevator_Timer["1"])
>>action:1=DisableTrigger($gg_trg_ElevatorTimer1)
>>action:1=TriggerSleepAction("1.00")
>>action:1=ChangeElevatorWalls(ElevatorWallOpOpen, ElevatorWallTypeSouth, $gg_dest_DTrx_0972)
>>condition:0=OperatorCompareBoolean($Switch_condition["5"], OperatorEqualENE, "false")
>action:1=ReturnAction()
>condition:0=OperatorCompareDestructible(GetSpellTargetDestructable(), OperatorEqualENE, $Switch["5"])
action=CommentString("6 переключатель (подъемник лифта № 1)")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=ChangeElevatorWalls(ElevatorWallOpClose, ElevatorWallTypeAll, $gg_dest_DTrx_1204)
>>action:1=IfThenElseMultiple()
>>>action:2=ChangeElevatorHeight($gg_dest_DTrx_1204, "1")
>>>action:1=ChangeElevatorHeight($gg_dest_DTrx_1204, "3")
>>>condition:0=OperatorCompareInteger(GetElevatorHeight($gg_dest_DTrx_1204), OperatorEqual, "1")
>>action:1=TriggerSleepAction("0.70")
>>action:1=SetDestructableAnimationBJ($Switch["6"], "death")
>>action:1=TriggerSleepAction("0.30")
>>action:1=IfThenElseMultiple()
>>>action:2=ChangeElevatorWalls(ElevatorWallOpOpen, ElevatorWallTypeNorth, $gg_dest_DTrx_1204)
>>>action:1=ChangeElevatorWalls(ElevatorWallOpOpen, ElevatorWallTypeSouth, $gg_dest_DTrx_1204)
>>>condition:0=OperatorCompareInteger(GetElevatorHeight($gg_dest_DTrx_1204), OperatorEqual, "1")
>>condition:0=OperatorCompareBoolean($Switch_condition["6"], OperatorEqualENE, "true")
>action:1=ReturnAction()
>condition:0=OperatorCompareDestructible(GetSpellTargetDestructable(), OperatorEqualENE, $Switch["6"])
action=CommentString("7 переключатель (подъемник лифта № 2)")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=ChangeElevatorWalls(ElevatorWallOpClose, ElevatorWallTypeAll, $gg_dest_DTrx_1204)
>>action:1=IfThenElseMultiple()
