[trigger]
name="Init Notes"
description=""
initially_off=1
action=SetVariable($Note_num, "8")
action=CommentString("1")
action=CreateItemLoc("I01F", GetRectCenter($gg_rct_REG_Note1))
action=SetVariable($Note["1"], GetLastCreatedItem())
action=SetVariable($Note_Type["1"], GetItemTypeId($Note["1"]))
action=CommentString("2")
action=CreateItemLoc("I01G", GetRectCenter($gg_rct_REG_Note2))
action=SetVariable($Note["2"], GetLastCreatedItem())
