[trigger]
name="Rat death"
description=""
action=GroupRemoveUnitSimple(GetDyingUnit(), $Rats_Group)
action=IfThenElseMultiple()
>action:1=DisableTrigger(GetTriggeringTrigger())
>action:1=CustomScriptCode("call TeoTextTag (\"Репутация изменена\", udg_Hero_warrior, 0,80,0)")
>action:1=CustomScriptCode("call TeoTextTag (\"Репутация изменена\", udg_Hero_shaman, 0,80,0)")
>action:1=CustomScriptCode("call TeoTextTag (\"Репутация изменена\", udg_Hero_mechanic, 0,80,0)")
>action:1=SetVariable($Reputation, OperatorReal($Reputation, OperatorAdd, "5.00"))
>action:1=IfThenElseMultiple()
>>action:1=IfThenElseMultiple()
>>>action:2=IfThenElseMultiple()
>>>>action:2=IfThenElseMultiple()
>>>>>action:1=SetVariable($Hero_any, $Hero_shaman)
>>>>>condition:0=OperatorCompareBoolean(RectContainsUnit($gg_rct_REG_Marauder_Area, $Hero_shaman), OperatorEqualENE, "true")
>>>>action:1=SetVariable($Hero_any, $Hero_mechanic)
>>>>condition:0=OperatorCompareBoolean(RectContainsUnit($gg_rct_REG_Marauder_Area, $Hero_mechanic), OperatorEqualENE, "true")
>>>action:1=SetVariable($Hero_any, $Hero_warrior)
>>>condition:0=OperatorCompareBoolean(RectContainsUnit($gg_rct_REG_Marauder_Area, $Hero_warrior), OperatorEqualENE, "true")
>>action:1=DisableTrigger($gg_trg_Cinematic_Marauder)
>>action:1=SetPlayerAllianceStateBJ(PlayerNP, PlayerNA, AllianceSettingNeutral)
>>action:1=TriggerSleepAction("1.00")
>>action:1=TriggerExecute($gg_trg_Cinematic_Marauder)
>>condition:0=OrMultiple()
>>>condition:0=OperatorCompareBoolean(RectContainsUnit($gg_rct_REG_Marauder_Area, $Hero_warrior), OperatorEqualENE, "true")
>>>condition:0=OperatorCompareBoolean(RectContainsUnit($gg_rct_REG_Marauder_Area, $Hero_mechanic), OperatorEqualENE, "true")
>>>condition:0=OperatorCompareBoolean(RectContainsUnit($gg_rct_REG_Marauder_Area, $Hero_shaman), OperatorEqualENE, "true")
>condition:0=OperatorCompareBoolean(IsUnitGroupEmptyBJ($Rats_Group), OperatorEqualENE, "true")
condition=OperatorCompareUnitCode(GetUnitTypeId(GetDyingUnit()), OperatorEqualENE, "n01O")
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventDeath)
