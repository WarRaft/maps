[trigger]
name="Attack of Marauder"
description=""
action=CommentString("Если урон наносят крысы")
action=IfThenElseMultiple()
>action:1=SetUnitUserData($UNIT_Marauder, "0")
>action:1=StartTimerBJ($Marauder_Timer, PeriodicOptionOneTime, "2.00")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetEventDamageSource()), OperatorEqualENE, "n01O")
action=CommentString("Если урон наносит Герой")
action=IfThenElseMultiple()
>condition:0=OperatorCompareBoolean(IsUnitType(GetEventDamageSource(), UnitTypeHero), OperatorEqualENE, "true")
>condition:0=OperatorCompareReal(GetEventDamage(), OperatorGreaterEq, "1.00")
>action:1=DisableTrigger(GetTriggeringTrigger())
>action:1=DisableTrigger($gg_trg_Cinematic_Marauder)
>action:1=DisableTrigger($gg_trg_Death_of_Marauder)
>action:1=DisableTrigger($gg_trg_Rat_death)
>action:1=FogModifierStop($Eye["1"])
>action:1=SetUnitOwner($UNIT_Marauder, PlayerNA, ChangeColorFalse)
>action:1=SetUnitMoveSpeed($UNIT_Marauder, "190.00")
>action:1=UnitRemoveAbilityBJ("A043", $UNIT_Marauder)
>action:1=UnitRemoveAbilityBJ("Asid", $UNIT_Marauder)
>action:1=ForGroupMultiple($Rats_Group)
>>action:0=IssueTargetOrder(GetEnumUnit(), UnitOrderAttackUnit, $UNIT_Marauder)
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Marauder, "TRIGSTR_2832", $gg_snd_Marauder03, "TRIGSTR_2833", AddSetToAdd, "0.00", WaitDontDont)
>action:1=CustomScriptCode("call TeoTextTag (\"Репутация изменена\", udg_Hero_warrior, 80,0,0)")
>action:1=CustomScriptCode("call TeoTextTag (\"Репутация изменена\", udg_Hero_shaman, 80,0,0)")
>action:1=CustomScriptCode("call TeoTextTag (\"Репутация изменена\", udg_Hero_mechanic, 80,0,0)")
>action:1=SetVariable($Reputation, OperatorReal($Reputation, OperatorSubtract, "10.00"))
