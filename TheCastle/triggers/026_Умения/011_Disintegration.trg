[trigger]
name="Disintegration"
description=""
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventSpellEffect)
action=CustomScriptCode("local player dummy_player = Player(4)")
action=CustomScriptCode("local unit dummy_unit")
action=CustomScriptCode("local unit target_unit = GetSpellTargetUnit()")
action=CustomScriptCode("local real target_x = GetUnitX (target_unit)")
action=CustomScriptCode("local real target_y = GetUnitY (target_unit)")
action=CommentString("Проверка на уничтожение трупов Пожирателя")
action=CustomScriptCode("if (GetUnitTypeId(target_unit) == 'n00W') then")
action=CustomScriptCode("    call DestroyEffect(AddSpecialEffect( \"Abilities\\\\Spells\\\\Other\\\\Monsoon\\\\MonsoonBoltTarget.mdl\", target_x, target_y ))")
action=CustomScriptCode("endif")
action=TriggerSleepAction("0.05")
action=CustomScriptCode("if (IsUnitAliveBJ(target_unit) == false) then")
action=CustomScriptCode("    call DestroyEffect(AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\", target_x, target_y ))")
action=CustomScriptCode("    set dummy_unit = TeoCreateDummyUnit( dummy_player, 'n00X', target_x, target_y, 'A02A' )")
action=CustomScriptCode("    call IssuePointOrder( dummy_unit, \"dreadlordinferno\", target_x, target_y )")
action=CustomScriptCode("endif")
action=CommentString("Обнуление переменных")
action=CustomScriptCode("set target_unit = null")
action=CustomScriptCode("set dummy_unit = null")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A00O")
