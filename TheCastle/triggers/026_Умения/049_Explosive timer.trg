[trigger]
name="Explosive timer"
description=""
initially_off=1
action=CustomScriptCode("local unit temp_unit = GetSummonedUnit()")
action=CustomScriptCode("local texttag msg")
action=CustomScriptCode("local string text")
action=CustomScriptCode("if ( udg_CONSTANT_LANGUAGE == \"RU\" ) then")
action=CustomScriptCode("    set text = \"До взрыва 5 секунд . . .\"")
action=CustomScriptCode("else")
action=CustomScriptCode("    set text = \"5 seconds before the explosion . . .\"")
action=CustomScriptCode("endif")
action=CustomScriptCode("set msg = CreateTextTagUnitBJ( text, temp_unit, 0, 10, 100, 0.00, 0.00, 0 )")
action=CustomScriptCode("call PlaySoundBJ( gg_snd_BattleNetTick )")
action=TriggerSleepAction("1.00")
action=CustomScriptCode("if ( udg_CONSTANT_LANGUAGE == \"RU\" ) then")
action=CustomScriptCode("    set text = \"До взрыва 4 секунды . . .\"")
action=CustomScriptCode("else")
action=CustomScriptCode("    set text = \"4 seconds before the explosion . . .\"")
action=CustomScriptCode("endif")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=CustomScriptCode("call PlaySoundBJ( gg_snd_BattleNetTick )")
action=TriggerSleepAction("1.00")
action=CustomScriptCode("if ( udg_CONSTANT_LANGUAGE == \"RU\" ) then")
action=CustomScriptCode("    set text = \"До взрыва 3 секунды . . .\"")
action=CustomScriptCode("else")
action=CustomScriptCode("    set text = \"3 seconds before the explosion . . .\"")
action=CustomScriptCode("endif")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=CustomScriptCode("call PlaySoundBJ( gg_snd_BattleNetTick )")
action=TriggerSleepAction("1.00")
action=CustomScriptCode("if ( udg_CONSTANT_LANGUAGE == \"RU\" ) then")
action=CustomScriptCode("    set text = \"До взрыва 2 секунды . . .\"")
action=CustomScriptCode("else")
action=CustomScriptCode("    set text = \"2 seconds before the explosion . . .\"")
action=CustomScriptCode("endif")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=CustomScriptCode("call PlaySoundBJ( gg_snd_BattleNetTick )")
action=TriggerSleepAction("1.00")
action=CustomScriptCode("if ( udg_CONSTANT_LANGUAGE == \"RU\" ) then")
action=CustomScriptCode("    set text = \"До взрыва 1 секунда . . .\"")
action=CustomScriptCode("else")
action=CustomScriptCode("    set text = \"1 second before the explosion . . .\"")
action=CustomScriptCode("endif")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=CustomScriptCode("call PlaySoundBJ( gg_snd_BattleNetTick )")
action=TriggerSleepAction("1.00")
action=CustomScriptCode("call DestroyTextTag(msg)")
action=CustomScriptCode("call DestroyEffect( AddSpecialEffect(\"Objects\\\\Spawnmodels\\\\Human\\\\HCancelDeath\\\\HCancelDeath.mdl\", GetUnitX(temp_unit), GetUnitY(temp_unit)) )")
action=TriggerSleepAction("0.20")
action=CustomScriptCode("call DestroyEffect( AddSpecialEffect(\"Objects\\\\Spawnmodels\\\\Other\\\\NeutralBuildingExplosion\\\\NeutralBuildingExplosion.mdl\", GetUnitX(temp_unit), GetUnitY(temp_unit)) )")
action=CustomScriptCode("set temp_unit = null")
action=CustomScriptCode("set msg = null")
action=CustomScriptCode("set text = null")
