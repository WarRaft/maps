[trigger]
name="Fatal Strike"
description=""
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A00J")
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventSpellEffect)
action=CustomScriptCode("local location Hero_point")
action=CustomScriptCode("local location Target_point")
action=CustomScriptCode("local unit dummy_unit")
action=CustomScriptCode("local unit copy_unit")
action=CustomScriptCode("set udg_FS_Target_Unit = GetSpellTargetUnit()")
action=CustomScriptCode("set Hero_point = GetUnitLoc(udg_Hero_warrior)")
action=CustomScriptCode("set Target_point = GetUnitLoc(udg_FS_Target_Unit)")
action=CustomScriptCode("set udg_FS_Angle = AngleBetweenPoints(Hero_point, Target_point)")
action=CommentString("Параметры Героя")
action=SetVariable($FS_Level, GetHeroLevel($Hero_warrior))
action=ForLoopAMultiple("1", "6")
>action:0=SetVariable($FS_Items[GetForLoopIndexA()], UnitItemInSlotBJ($Hero_warrior, GetForLoopIndexA()))
action=SetUnitTimeScalePercent($Hero_warrior, "150.00")
action=CommentString("Создаем копию Героя")
action=CustomScriptCode("set copy_unit = TeoCreateDummyUnit( Player(5), 'O001', 6600, 12940, 0 )")
action=CustomScriptCode("call SetHeroLevelBJ( copy_unit, udg_FS_Level, false )")
action=ForLoopBMultiple("1", "6")
>action:0=CustomScriptCode(" call UnitAddItemByIdSwapped( GetItemTypeId(udg_FS_Items[GetForLoopIndexB()]), copy_unit )")
action=CommentString("Проверяем на наличие Безумия и кидаем бафф, если нужно")
action=IfThenElseMultiple()
>condition:0=OrMultiple()
>>condition:0=OperatorCompareBoolean(UnitHasBuffBJ($Hero_warrior, "B001"), OperatorEqualENE, "true")
>>condition:0=OperatorCompareBoolean(UnitHasBuffBJ($Hero_warrior, "B01L"), OperatorEqualENE, "true")
>action:1=CustomScriptCode("call IssueImmediateOrder( udg_UNIT_FS_Dummy, \"roar\" )")
action=CommentString("Наносим урон по Дамми-юниту")
action=CustomScriptCode("call IssueTargetOrder( copy_unit, \"attackonce\", udg_UNIT_FS_Dummy )")
action=CommentString("Обнуление переменных")
action=CustomScriptCode("call RemoveLocation(Hero_point)")
action=CustomScriptCode("call RemoveLocation(Target_point)")
action=CustomScriptCode("set Hero_point = null")
action=CustomScriptCode("set Target_point = null")
action=CustomScriptCode("set dummy_unit = null")
action=CustomScriptCode("set copy_unit = null")
