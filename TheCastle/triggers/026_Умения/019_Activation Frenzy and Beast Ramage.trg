[trigger]
name="Activation Frenzy and Beast Ramage"
description=""
action=CustomScriptCode("local player dummy_player = GetOwningPlayer(udg_Hero_warrior)")
action=CommentString("Проверяем Безумие")
action=IfThenElseMultiple()
>action:1=SetVariable($Frenzy_Bool, "true")
>action:1=CustomScriptCode("set udg_Frenzy_Unit = CreateUnit(dummy_player, 'n01I', 6280.00, 13000.00, 0)")
>condition:0=OperatorCompareReal(GetUnitLifePercent($Hero_warrior), OperatorLess, "30.00")
>condition:0=OperatorCompareBoolean($Frenzy_Bool, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=SetVariable($Frenzy_Bool, "false")
>action:1=CustomScriptCode("call RemoveUnit( udg_Frenzy_Unit )")
>condition:0=OperatorCompareReal(GetUnitLifePercent($Hero_warrior), OperatorGreaterEq, "30.00")
>condition:0=OperatorCompareBoolean($Frenzy_Bool, OperatorEqualENE, "true")
action=CommentString("Проверяем Буйство зверя")
action=IfThenElseMultiple()
>action:1=SetVariable($Beast_Rampage_bool, "true")
>action:1=CustomScriptCode("set udg_Beast_Rampage_Unit = CreateUnit(dummy_player, 'n01H', 6280.00, 13000.00, 0)")
>condition:0=OperatorCompareReal(GetUnitLifePercent($Hero_warrior), OperatorGreater, "30.00")
>condition:0=OperatorCompareBoolean($Beast_Rampage_bool, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=SetVariable($Beast_Rampage_bool, "false")
>action:1=CustomScriptCode("call RemoveUnit( udg_Beast_Rampage_Unit )")
>condition:0=OperatorCompareReal(GetUnitLifePercent($Hero_warrior), OperatorLessEq, "30.00")
>condition:0=OperatorCompareBoolean($Beast_Rampage_bool, OperatorEqualENE, "true")
action=CustomScriptCode("set dummy_player = null")
event=TriggerRegisterTimerEventPeriodic("0.30")
