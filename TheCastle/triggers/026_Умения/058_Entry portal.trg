[trigger]
name="Entry portal"
description=""
action=CustomScriptCode("local location hero_point = GetUnitLoc(GetSummoningUnit())")
action=CustomScriptCode("local location target_point = GetUnitLoc(GetSummonedUnit())")
action=CustomScriptCode("local real angle = AngleBetweenPoints(hero_point, target_point)")
action=SetVariable($Teleport_Bool, "false")
action=CommentString("Убиваем предыдущий призванный портал")
action=KillUnit(LoadUnitHandleBJ("0", "1", GetLastCreatedHashtableBJ()))
action=CommentString("Сохраняем призванный портал в хэш-таблицу")
action=SaveUnitHandleBJ(GetSummonedUnit(), "0", "1", GetLastCreatedHashtableBJ())
action=CustomScriptCode("call SetUnitFacing( LoadUnitHandleBJ(0, 1, GetLastCreatedHashtableBJ()), ( 180.00 + angle ) )")
action=SetUnitTimeScalePercent(LoadUnitHandleBJ("0", "1", GetLastCreatedHashtableBJ()), "320.00")
action=CommentString("Обнуление переменных")
action=CustomScriptCode("call RemoveLocation(hero_point)")
action=CustomScriptCode("call RemoveLocation(target_point)")
action=CustomScriptCode("set hero_point = null")
action=CustomScriptCode("set target_point = null")
action=TriggerSleepAction("1.00")
action=SetUnitTimeScalePercent(LoadUnitHandleBJ("0", "1", GetLastCreatedHashtableBJ()), "100.00")
action=TriggerSleepAction("2.00")
action=AddTriggerEvent($gg_trg_Portal_passage, event:TriggerRegisterUnitInRangeSimple("30.00", LoadUnitHandleBJ("0", "1", GetLastCreatedHashtableBJ())) ~"")
action=SetVariable($Teleport_Bool, "true")
condition=OperatorCompareUnitCode(GetUnitTypeId(GetSummonedUnit()), OperatorEqualENE, "h002")
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventSummoned)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventSummoned)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventSummoned)
