[trigger]
name="Provocation"
description=""
action=QueueUnitAnimationBJ($Hero_warrior, "stand")
action=CommentString("Выбираем группу юнитов")
action=CustomScriptCode("call GroupEnumUnitsInRange (udg_TempGroup, GetUnitX (udg_Hero_warrior), GetUnitY (udg_Hero_warrior), 500, null) ")
action=ForGroupMultiple($TempGroup)
>action:0=CustomScriptCode("local player dummy_player = Player(4)")
>action:0=CustomScriptCode("local unit dummy_unit")
>action:0=IfThenElseMultiple()
>>action:1=CommentString("Даём ослабление и добавляем в группу")
>>action:1=CustomScriptCode("set dummy_unit = TeoCreateDummyUnit( dummy_player, 'n00X', GetUnitX (udg_Hero_warrior), GetUnitY (udg_Hero_warrior), 'A054' )")
>>action:1=CustomScriptCode("call IssueTargetOrder( dummy_unit, \"cripple\", GetEnumUnit() )")
>>action:1=CustomScriptCode("call GroupAddUnitSimple( GetEnumUnit(), udg_Provocation_Group )")
>>action:1=CustomScriptCode("set dummy_unit = null")
>>action:1=CustomScriptCode("set dummy_player = null")
>>condition:0=OperatorComparePlayer(GetOwningPlayer(GetEnumUnit()), OperatorNotEqualENE, Player00)
>>condition:0=OperatorComparePlayer(GetOwningPlayer(GetEnumUnit()), OperatorNotEqualENE, Player01)
>>condition:0=OperatorComparePlayer(GetOwningPlayer(GetEnumUnit()), OperatorNotEqualENE, Player02)
>>condition:0=OperatorComparePlayer(GetOwningPlayer(GetEnumUnit()), OperatorNotEqualENE, PlayerNP)
>>condition:0=OperatorCompareBoolean(IsUnitAliveBJ(GetEnumUnit()), OperatorEqualENE, "true")
>>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetEnumUnit()), OperatorNotEqualENE, "n00W")
>>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetEnumUnit()), OperatorNotEqualENE, "n02S")
>>condition:0=OperatorCompareInteger(GetUnitLevel(GetEnumUnit()), OperatorLess, "10")
action=StartTimerBJ($Provocation_Timer, PeriodicOptionOneTime, "5.00")
action=EnableTrigger($gg_trg_Provocation_timer)
action=CommentString("Обнуление переменных")
action=CustomScriptCode("call GroupClear( udg_TempGroup )")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A002")
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventSpellEffect)
