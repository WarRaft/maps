[trigger]
name="Use mechanism"
description=""
action=CommentString("Цель: Переключатели")
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventSpellEffect)
action=IfThenElseMultiple()
>action:1=ForLoopAMultiple("1", $Switch_num)
>>action:0=IfThenElseMultiple()
>>>action:1=IfThenElseMultiple()
>>>>action:2=SetDestructableAnimationBJ($Switch[GetForLoopIndexA()], "Stand")
>>>>action:2=PlaySoundAtPointBJ($gg_snd_Lever, "100", GetDestructableLoc($Switch[GetForLoopIndexA()]), "0")
>>>>action:1=SetDestructableAnimationBJ($Switch[GetForLoopIndexA()], "Death")
>>>>condition:0=OperatorCompareBoolean($Switch_condition[GetForLoopIndexA()], OperatorEqualENE, "false")
>>>action:1=TriggerExecute($gg_trg_Switch)
>>>condition:0=OperatorCompareDestructible(GetSpellTargetDestructable(), OperatorEqualENE, $Switch[GetForLoopIndexA()])
>condition:0=OperatorCompareDestructableCode(GetDestructableTypeId(GetSpellTargetDestructable()), OperatorEqualENE, "B00D")
action=CommentString("Цель: Одноразовые рычаги")
action=IfThenElseMultiple()
>action:1=KillDestructable(GetSpellTargetDestructable())
>condition:0=OperatorCompareDestructableCode(GetDestructableTypeId(GetSpellTargetDestructable()), OperatorEqualENE, "B00E")
action=CommentString("Цель: Неисправный гоблин")
action=IfThenElseMultiple()
>action:1=PlaySoundAtPointBJ($gg_snd_MetalHeavySliceMetal1, "100", GetUnitLoc($gg_unit_n00D_0072), "0")
>action:1=CommentString("Активируем гоблина")
>action:1=IfThenElseMultiple()
>>action:1=SetUnitTimeScalePercent(GetSpellTargetUnit(), "100.00")
>>action:1=IssueTargetDestructableOrder(GetSpellTargetUnit(), UnitOrderAttackDestructible, $gg_dest_LTex_1000)
>>condition:0=OperatorCompareBoolean(IsTriggerEnabled($gg_trg_Fire2), OperatorEqualENE, "true")
>condition:0=OperatorCompareUnit(GetSpellTargetUnit(), OperatorEqualENE, $gg_unit_n00D_0072)
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A009")
