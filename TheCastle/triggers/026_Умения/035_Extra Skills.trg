[trigger]
name="Extra Skills"
description="Инициализация умений происходит в Init Skills"
action=CommentString("Восстановление маны")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=UnitAddAbilityBJ("A01H", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "1")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B005", GetTriggerUnit())
>>action:1=UnitRemoveAbilityBJ("A01H", GetTriggerUnit())
>>action:1=UnitAddAbilityBJ("A01J", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B006", GetTriggerUnit())
>>action:1=UnitRemoveAbilityBJ("A01J", GetTriggerUnit())
>>action:1=UnitAddAbilityBJ("A01K", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "3")
>condition:0=OperatorCompareHeroSkill(GetLearnedSkillBJ(), OperatorEqualENE, "A01E")
action=CommentString("Лёгкая поступь")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B004", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B008", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "3")
>condition:0=OperatorCompareHeroSkill(GetLearnedSkillBJ(), OperatorEqualENE, "A01L")
action=CommentString("Восстановление здоровья")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=UnitAddAbilityBJ("A01N", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "1")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00B", GetTriggerUnit())
>>action:1=UnitRemoveAbilityBJ("A01N", GetTriggerUnit())
>>action:1=UnitAddAbilityBJ("A01M", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00A", GetTriggerUnit())
>>action:1=UnitRemoveAbilityBJ("A01M", GetTriggerUnit())
>>action:1=UnitAddAbilityBJ("A01O", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "3")
>condition:0=OperatorCompareHeroSkill(GetLearnedSkillBJ(), OperatorEqualENE, "A01I")
action=CommentString("Жизненная сила")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=UnitAddAbilityBJ("A01Q", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "1")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00F", GetTriggerUnit())
>>action:1=UnitRemoveAbilityBJ("A01Q", GetTriggerUnit())
>>action:1=UnitAddAbilityBJ("A01R", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00E", GetTriggerUnit())
>>action:1=UnitRemoveAbilityBJ("A01R", GetTriggerUnit())
>>action:1=UnitAddAbilityBJ("A01P", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "3")
>condition:0=OperatorCompareHeroSkill(GetLearnedSkillBJ(), OperatorEqualENE, "A01S")
action=CommentString("Змеиная ловкость")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=ForForceMultiple($Players)
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A01U", GetEnumPlayer())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "1")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00H", GetTriggerUnit())
>>action:1=ForForceMultiple($Players)
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A01U", GetEnumPlayer())
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A01T", GetEnumPlayer())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00G", GetTriggerUnit())
>>action:1=ForForceMultiple($Players)
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A01T", GetEnumPlayer())
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A01V", GetEnumPlayer())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "3")
>condition:0=OperatorCompareHeroSkill(GetLearnedSkillBJ(), OperatorEqualENE, "A01W")
action=CommentString("Электрическое поле")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=ForForceMultiple($Players)
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A01X", GetEnumPlayer())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "1")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00J", GetTriggerUnit())
>>action:1=ForForceMultiple($Players)
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A01X", GetEnumPlayer())
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A020", GetEnumPlayer())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00K", GetTriggerUnit())
>>action:1=ForForceMultiple($Players)
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A020", GetEnumPlayer())
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A021", GetEnumPlayer())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "3")
>condition:0=OperatorCompareHeroSkill(GetLearnedSkillBJ(), OperatorEqualENE, "A023")
action=CommentString("Смертельный удар")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=ForForceMultiple($Players)
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A02L", GetEnumPlayer())
>>action:1=CommentString("Для дамми-юнита (Фатальный удар)")
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A02L", Player04)
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "1")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00R", GetTriggerUnit())
>>action:1=ForForceMultiple($Players)
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A02L", GetEnumPlayer())
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A02N", GetEnumPlayer())
>>action:1=CommentString("Для дамми-юнита (Фатальный удар)")
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A02L", Player04)
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A02N", Player04)
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00S", GetTriggerUnit())
>>action:1=ForForceMultiple($Players)
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A02N", GetEnumPlayer())
>>>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A02M", GetEnumPlayer())
>>action:1=CommentString("Для дамми-юнита (Фатальный удар)")
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A02N", Player04)
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A02M", Player04)
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "3")
>condition:0=OperatorCompareHeroSkill(GetLearnedSkillBJ(), OperatorEqualENE, "A02O")
action=CommentString("Лекарь")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=IncUnitAbilityLevelSwapped("A05A", GetTriggerUnit())
>>action:1=ModifyHeroSkillPoints(GetTriggerUnit(), ModifyMethodAdd, "1")
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A05B", GetOwningPlayer(GetTriggerUnit()))
>>action:1=SelectHeroSkill(GetTriggerUnit(), "A05B")
>>action:1=UnitRemoveBuffBJ("B01H", GetTriggerUnit())
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A05B", GetOwningPlayer(GetTriggerUnit()))
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "1")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00V", GetTriggerUnit())
>>action:1=IncUnitAbilityLevelSwapped("A05A", GetTriggerUnit())
>>action:1=ModifyHeroSkillPoints(GetTriggerUnit(), ModifyMethodAdd, "1")
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A05B", GetOwningPlayer(GetTriggerUnit()))
>>action:1=SelectHeroSkill(GetTriggerUnit(), "A05B")
>>action:1=UnitRemoveBuffBJ("B01I", GetTriggerUnit())
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A05B", GetOwningPlayer(GetTriggerUnit()))
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B00W", GetTriggerUnit())
>>action:1=IncUnitAbilityLevelSwapped("A05A", GetTriggerUnit())
>>action:1=ModifyHeroSkillPoints(GetTriggerUnit(), ModifyMethodAdd, "1")
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A05B", GetOwningPlayer(GetTriggerUnit()))
>>action:1=SelectHeroSkill(GetTriggerUnit(), "A05B")
>>action:1=UnitRemoveBuffBJ("B01J", GetTriggerUnit())
>>action:1=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A05B", GetOwningPlayer(GetTriggerUnit()))
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "3")
>condition:0=OperatorCompareHeroSkill(GetLearnedSkillBJ(), OperatorEqualENE, "A02Z")
action=CommentString("Лекарь (alternate)")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=IncUnitAbilityLevelSwapped("A05C", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "1")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B01H", GetTriggerUnit())
>>action:1=IncUnitAbilityLevelSwapped("A05C", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=UnitRemoveBuffBJ("B01I", GetTriggerUnit())
>>action:1=IncUnitAbilityLevelSwapped("A05C", GetTriggerUnit())
>>condition:0=OperatorCompareInteger(GetLearnedSkillLevel(), OperatorEqual, "3")
>condition:0=OperatorCompareHeroSkill(GetLearnedSkillBJ(), OperatorEqualENE, "A05B")
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventHero_Skill)
