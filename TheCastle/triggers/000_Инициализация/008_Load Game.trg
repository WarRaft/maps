[trigger]
name="Load Game"
description=""
action=SetAllyColorFilterState("1")
action=EnableMinimapFilterButtons(EnableDisableDisable, EnableDisableDisable)
action=UseTimeOfDayBJ(OnOffOff)
action=SetGameSpeed(GameSpeedFastest)
action=LockGameSpeedBJ()
action=ForceCinematicSubtitlesBJ(OnOffOn)
action=TriggerExecute($gg_trg_Init_Environment)
action=IfThenElseMultiple()
>action:1=ReplaceUnitBJ($UNIT_Robot, "n006", UnitStateMethodRelative)
>action:1=SetVariable($UNIT_Robot, GetLastReplacedUnitBJ())
>action:1=AddTriggerEvent($gg_trg_Reload_robot, event:TriggerRegisterUnitEvent($UNIT_Robot, UnitEventDamaged) ~"")
>action:1=AddTriggerEvent($gg_trg_Deactivation_robot, event:TriggerRegisterUnitInRangeSimple("200.00", $UNIT_Robot) ~"")
>action:1=AddTriggerEvent($gg_trg_Death_of_Robot, event:TriggerRegisterUnitEvent($UNIT_Robot, UnitEventDeath) ~"")
>action:1=IfThenElseMultiple()
>>action:1=UnitAddAbilityBJ("A02H", $UNIT_Robot)
>>condition:0=OperatorCompareBoolean($Robot_Repair_Bool, OperatorEqualENE, "true")
>action:1=TriggerSleepAction("0.10")
>action:1=SetUnitTimeScalePercent($UNIT_Robot, "0.00")
>condition:0=OperatorCompareBoolean($Robot_Activation_Bool, OperatorEqualENE, "false")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Robot), OperatorEqualENE, "true")
event=TriggerRegisterGameLoadedEventBJ()
