[trigger]
name="Init Players"
description=""
initially_off=1
action=IfThenElseMultiple()
>action:1=ForceAddPlayerSimple(Player00, $Players)
>action:1=ForceAddPlayerSimple(Player01, $Players)
>action:1=ForceAddPlayerSimple(Player02, $Players)
>action:2=IfThenElseMultiple()
>>action:1=ForceAddPlayerSimple(Player00, $Players)
>>action:1=ForceAddPlayerSimple(Player01, $Players)
>>action:1=DisableTrigger($gg_trg_Selecting_Player3)
>>action:2=IfThenElseMultiple()
>>>action:1=ForceAddPlayerSimple(Player00, $Players)
>>>action:1=ForceAddPlayerSimple(Player02, $Players)
>>>action:1=DisableTrigger($gg_trg_Selecting_Player2)
>>>action:2=IfThenElseMultiple()
>>>>action:1=ForceAddPlayerSimple(Player00, $Players)
>>>>action:1=DisableTrigger($gg_trg_Selecting_Player2)
>>>>action:1=DisableTrigger($gg_trg_Selecting_Player3)
>>>>action:1=CreateNUnitsAtLoc("1", "N000", Player00, GetRectCenter($gg_rct_REG_Mechanic), "90.00")
>>>>action:1=SetVariable($Hero_mechanic, GetLastCreatedUnit())
>>>>action:1=SetVariable($UNIT_Robot_Mechanic, $Hero_mechanic)
>>>>action:1=SetVariable($Name_Mechanic, GetHeroProperName($Hero_mechanic))
>>>>action:1=CreateNUnitsAtLoc("1", "N001", Player00, GetRectCenter($gg_rct_REG_Shaman), "90.00")
>>>>action:1=SetVariable($Hero_shaman, GetLastCreatedUnit())
>>>>action:1=CreateNUnitsAtLoc("1", "O001", Player00, GetRectCenter($gg_rct_REG_Warrior), "90.00")
>>>>action:1=SetVariable($Hero_warrior, GetLastCreatedUnit())
>>>>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player00), OperatorEqualENE, PlayerSlotStatePlaying)
>>>>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player01), OperatorEqualENE, PlayerSlotStateEmpty)
>>>>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player02), OperatorEqualENE, PlayerSlotStateEmpty)
>>>action:1=CreateNUnitsAtLoc("1", "N000", Player02, GetRectCenter($gg_rct_REG_Mechanic), "90.00")
>>>action:1=SetVariable($Hero_mechanic, GetLastCreatedUnit())
>>>action:1=SetVariable($UNIT_Robot_Mechanic, $Hero_mechanic)
>>>action:1=SetVariable($Name_Mechanic, GetHeroProperName($Hero_mechanic))
>>>action:1=CreateNUnitsAtLoc("1", "N001", Player02, GetRectCenter($gg_rct_REG_Shaman), "90.00")
>>>action:1=SetVariable($Hero_shaman, GetLastCreatedUnit())
>>>action:1=CreateNUnitsAtLoc("1", "O001", Player00, GetRectCenter($gg_rct_REG_Warrior), "90.00")
>>>action:1=SetVariable($Hero_warrior, GetLastCreatedUnit())
>>>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player00), OperatorEqualENE, PlayerSlotStatePlaying)
>>>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player01), OperatorEqualENE, PlayerSlotStateEmpty)
>>>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player02), OperatorEqualENE, PlayerSlotStatePlaying)
>>action:1=CreateNUnitsAtLoc("1", "N000", Player01, GetRectCenter($gg_rct_REG_Mechanic), "90.00")
>>action:1=SetVariable($Hero_mechanic, GetLastCreatedUnit())
>>action:1=SetVariable($UNIT_Robot_Mechanic, $Hero_mechanic)
>>action:1=SetVariable($Name_Mechanic, GetHeroProperName($Hero_mechanic))
>>action:1=CreateNUnitsAtLoc("1", "N001", Player01, GetRectCenter($gg_rct_REG_Shaman), "90.00")
>>action:1=SetVariable($Hero_shaman, GetLastCreatedUnit())
>>action:1=CreateNUnitsAtLoc("1", "O001", Player00, GetRectCenter($gg_rct_REG_Warrior), "90.00")
>>action:1=SetVariable($Hero_warrior, GetLastCreatedUnit())
>>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player00), OperatorEqualENE, PlayerSlotStatePlaying)
>>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player01), OperatorEqualENE, PlayerSlotStatePlaying)
>>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player02), OperatorEqualENE, PlayerSlotStateEmpty)
>action:1=CreateNUnitsAtLoc("1", "N000", Player02, GetRectCenter($gg_rct_REG_Mechanic), "90.00")
>action:1=SetVariable($Hero_mechanic, GetLastCreatedUnit())
>action:1=SetVariable($UNIT_Robot_Mechanic, $Hero_mechanic)
>action:1=SetVariable($Name_Mechanic, GetHeroProperName($Hero_mechanic))
>action:1=CreateNUnitsAtLoc("1", "N001", Player01, GetRectCenter($gg_rct_REG_Shaman), "90.00")
>action:1=SetVariable($Hero_shaman, GetLastCreatedUnit())
>action:1=CreateNUnitsAtLoc("1", "O001", Player00, GetRectCenter($gg_rct_REG_Warrior), "90.00")
>action:1=SetVariable($Hero_warrior, GetLastCreatedUnit())
>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player00), OperatorEqualENE, PlayerSlotStatePlaying)
>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player01), OperatorEqualENE, PlayerSlotStatePlaying)
>condition:0=OperatorComparePlayerSlotStatus(GetPlayerSlotState(Player02), OperatorEqualENE, PlayerSlotStatePlaying)
action=ForForceMultiple($Players)
>action:0=SetPlayerHandicapXPBJ(GetEnumPlayer(), "50.00")
>action:0=SetPlayerState(GetEnumPlayer(), PlayerStateLumber, OperatorInt($Count_Life, OperatorSubtract, "1"))
>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A05M", GetEnumPlayer())
>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A05U", GetEnumPlayer())
>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A05Y", GetEnumPlayer())
action=SetPlayerName(Player07, "TRIGSTR_4688")
action=SetPlayerState(Player00, PlayerStateFoodUsed, CountPlayersInForceBJ($Players))
action=SetPlayerState(Player01, PlayerStateFoodUsed, CountPlayersInForceBJ($Players))
action=SetPlayerState(Player02, PlayerStateFoodUsed, CountPlayersInForceBJ($Players))
action=SetPlayerState(Player00, PlayerStateFoodCap, "3")
action=SetPlayerState(Player01, PlayerStateFoodCap, "3")
action=SetPlayerState(Player02, PlayerStateFoodCap, "3")
