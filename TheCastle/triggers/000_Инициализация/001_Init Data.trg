[trigger]
name="Init Data"
description=""
initially_off=1
action=CommentString("Язык текста")
action=SetVariable($CONSTANT_LANGUAGE, "RU")
action=CommentString("Начальная репутация")
action=SetVariable($Reputation, "40.00")
action=CommentString("Найстройки камеры по умолчанию")
action=ForLoopAMultiple("1", "3")
>action:0=SetVariable($FREECAM[GetForLoopIndexA()], "true")
action=SetVariable($Count_Life, "6")
action=CommentString("Тессеракт")
action=SetVariable($UNIT_Backpack, $gg_unit_n031_0606)
action=CommentString("Начальные настройки типов рун")
action=SetVariable($RunesTypes["1"], "B007")
action=SetVariable($RunesTypes["2"], "B006")
action=SetVariable($RunesTypes["3"], "B009")
action=SetVariable($RunesTypes["4"], "B00A")
action=SetVariable($Runes_num, "4")
action=CommentString("Руны-пароль")
action=CreateDestructableLoc($RunesTypes["1"], GetRectCenter($gg_rct_REG_Rune_Password1), "90.00", "1", "0")
action=SetVariable($Runes1["1"], GetLastCreatedDestructable())
action=SetVariable($Runes_conditions["1"], "1")
action=CreateDestructableLoc($RunesTypes["3"], GetRectCenter($gg_rct_REG_Rune_Password2), "90.00", "1", "0")
action=SetVariable($Runes2["3"], GetLastCreatedDestructable())
action=SetVariable($Runes_conditions["2"], "3")
action=CreateDestructableLoc($RunesTypes["3"], GetRectCenter($gg_rct_REG_Rune_Password3), "90.00", "1", "0")
action=SetVariable($Runes3["3"], GetLastCreatedDestructable())
action=SetVariable($Runes_conditions["3"], "3")
action=CommentString("Обелиски Босса")
action=SetVariable($Boss_Obelisk["1"], $gg_unit_nico_0058)
action=SetVariable($Boss_Obelisk["2"], $gg_unit_nico_0155)
action=SetVariable($Boss_Obelisk["3"], $gg_unit_nico_0061)
action=SetVariable($Boss_Obelisk["4"], $gg_unit_nico_0062)
action=CommentString("Обелиски")
action=SetVariable($Obelisk["1"], $gg_unit_n017_0324)
action=SetVariable($Obelisk["2"], $gg_unit_n017_0333)
action=SetVariable($Obelisk["3"], $gg_unit_n017_0319)
action=SetVariable($Obelisk["4"], $gg_unit_n017_0180)
action=CommentString("Длительность таймера")
action=SetVariable($Timer_Duration, "9.00")
action=CommentString("Точки-блокираторы для кубов")
action=SetVariable($Blocking_Point["1"], Location("10950.00", "8320.00"))
action=SetVariable($Blocking_Point["2"], Location("9530.00", "8050.00"))
action=SetVariable($Blocking_Point["3"], Location("7750.00", "7560.00"))
action=SetVariable($Blocking_Point["4"], Location("5560.00", "7030.00"))
action=CommentString("Оранжерея")
action=SetVariable($HellishCreature_zone["1"], $gg_rct_REG_HellishCreature_1)
action=SetVariable($HellishCreature_zone["2"], $gg_rct_REG_HellishCreature_2)
action=SetVariable($HellishCreature_zone["3"], $gg_rct_REG_HellishCreature_3)
