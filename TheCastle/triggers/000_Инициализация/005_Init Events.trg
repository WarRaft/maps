[trigger]
name="Init Events"
description=""
initially_off=1
action=AddTriggerEvent($gg_trg_Found_Item, event:TriggerRegisterUnitEvent($Hero_mechanic, UnitEventHeroPickUpItem) ~"")
action=AddTriggerEvent($gg_trg_Lost_Item, event:TriggerRegisterUnitEvent($Hero_mechanic, UnitEventHeroDropItem) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Devouer, event:TriggerRegisterUnitEvent($UNIT_Devouer, UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Attacking_Devouer, event:TriggerRegisterUnitEvent($UNIT_Devouer, UnitEventDamaged) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Overseer, event:TriggerRegisterUnitEvent($UNIT_Overseer, UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Boss1, event:TriggerRegisterUnitEvent($UNIT_Boss1, UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Devastator, event:TriggerRegisterUnitEvent($UNIT_Devastator, UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Fatal_Strike_Actions, event:TriggerRegisterUnitEvent($UNIT_FS_Dummy, UnitEventDamaged) ~"")
action=CommentString("БОСС 2")
action=AddTriggerEvent($gg_trg_Death_of_Boss2, event:TriggerRegisterUnitEvent($UNIT_Boss2, UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Reload_robot, event:TriggerRegisterUnitEvent($UNIT_Robot, UnitEventDamaged) ~"")
action=AddTriggerEvent($gg_trg_Deactivation_robot, event:TriggerRegisterUnitInRangeSimple("200.00", $UNIT_Robot) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Robot, event:TriggerRegisterUnitEvent($UNIT_Robot, UnitEventDeath) ~"")
action=CommentString("Королева Змей")
action=AddTriggerEvent($gg_trg_Death_of_Naga, event:TriggerRegisterUnitEvent($UNIT_Naga, UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Naga_Shield, event:TriggerRegisterUnitEvent($UNIT_Naga, UnitEventTargetInRange) ~"")
action=AddTriggerEvent($gg_trg_Naga_Shield, event:TriggerRegisterUnitEvent($UNIT_Naga, UnitEventAttacked) ~"")
action=AddTriggerEvent($gg_trg_Naga_Help, event:TriggerRegisterUnitEvent($UNIT_Naga, UnitEventSpellEffect) ~"")
action=CommentString("Странник с ящерицей")
action=AddTriggerEvent($gg_trg_Cinematic_Traveler, event:TriggerRegisterUnitInRangeSimple("320.00", $UNIT_Traveler) ~"")
action=AddTriggerEvent($gg_trg_Attack_of_Traveler, event:TriggerRegisterUnitEvent($UNIT_Traveler, UnitEventDamaged) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Lizard, event:TriggerRegisterUnitEvent($UNIT_Lizard, UnitEventDeath) ~"")
action=CommentString("Встреча с мародером")
action=AddTriggerEvent($gg_trg_Cinematic_Marauder, event:TriggerRegisterUnitInRangeSimple("200.00", $UNIT_Marauder) ~"")
action=AddTriggerEvent($gg_trg_Attack_of_Marauder, event:TriggerRegisterUnitEvent($UNIT_Marauder, UnitEventDamaged) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Marauder, event:TriggerRegisterUnitEvent($UNIT_Marauder, UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Marauder2, event:TriggerRegisterUnitEvent($UNIT_Marauder, UnitEventDeath) ~"")
action=CommentString("Встреча с пленником")
action=AddTriggerEvent($gg_trg_Cinematic_Prisoner1, event:TriggerRegisterUnitInRangeSimple("300.00", $UNIT_Prisoner) ~"")
action=AddTriggerEvent($gg_trg_Attack_of_Prisoner, event:TriggerRegisterUnitEvent($UNIT_Prisoner, UnitEventDamaged) ~"")
action=CommentString("Адское создание")
action=AddTriggerEvent($gg_trg_Death_of_Hellish_Creature, event:TriggerRegisterUnitEvent($UNIT_HellishCreature, UnitEventDeath) ~"")
action=CommentString("Стражи")
action=AddTriggerEvent($gg_trg_Death_of_EarthGuard, event:TriggerRegisterUnitEvent($UNIT_EarthGuard, UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Attacking_EarthGuard, event:TriggerRegisterUnitEvent($UNIT_EarthGuard, UnitEventDamaged) ~"")
action=AddTriggerEvent($gg_trg_Death_of_WaterGuard, event:TriggerRegisterUnitEvent($UNIT_WaterGuard, UnitEventDeath) ~"")
action=CommentString("БОСС 3")
action=AddTriggerEvent($gg_trg_Death_of_Archmage, event:TriggerRegisterUnitEvent($UNIT_Boss3_Archmage, UnitEventDeath) ~"")
