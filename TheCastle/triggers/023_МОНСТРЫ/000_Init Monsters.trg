[trigger]
name="Init Monsters"
description="При добавлении юнитов также необходимо увеличить размерность массива MonsterGroups в настройках переменных."
initially_off=1
action=SetVariable($NumMonsters, "8")
action=CommentString("Заполнение массива данных по монстрам")
action=SetVariable($MonsterTypes["1"], "n00Y")
action=SetVariable($MonsterSpawners["1"], $gg_unit_n008_0159)
action=SetVariable($MaxMonsters["1"], "5")
action=SetVariable($SpawnFrequence["1"], "3")
action=SetVariable($SpawnAngle["1"], "155.00")
action=CommentString("-")
action=SetVariable($MonsterTypes["2"], "n00Y")
action=SetVariable($MonsterSpawners["2"], $gg_unit_n008_0056)
action=SetVariable($MaxMonsters["2"], "5")
action=SetVariable($SpawnFrequence["2"], "3")
action=SetVariable($SpawnAngle["2"], "90.00")
action=CommentString("-")
action=SetVariable($MonsterTypes["3"], "n01K")
action=SetVariable($MonsterSpawners["3"], $gg_unit_harm_0073)
action=SetVariable($MaxMonsters["3"], "5")
action=SetVariable($SpawnFrequence["3"], "3")
action=SetVariable($SpawnAngle["3"], "225.00")
action=CommentString("Склеп")
action=SetVariable($MonsterTypes["4"], "n00Y")
action=SetVariable($MonsterSpawners["4"], $gg_unit_n008_0466)
action=SetVariable($MaxMonsters["4"], "5")
action=SetVariable($SpawnFrequence["4"], "3")
action=SetVariable($SpawnAngle["4"], "225.00")
action=CommentString("-")
action=SetVariable($MonsterTypes["5"], "n00Y")
action=SetVariable($MonsterSpawners["5"], $gg_unit_n008_0524)
action=SetVariable($MaxMonsters["5"], "5")
action=SetVariable($SpawnFrequence["5"], "3")
action=SetVariable($SpawnAngle["5"], "335.00")
action=CommentString("-")
action=SetVariable($MonsterTypes["6"], "n00Y")
action=SetVariable($MonsterSpawners["6"], $gg_unit_n008_0525)
action=SetVariable($MaxMonsters["6"], "5")
action=SetVariable($SpawnFrequence["6"], "3")
action=SetVariable($SpawnAngle["6"], "225.00")
action=CommentString("-")
action=SetVariable($MonsterTypes["7"], "n00Y")
action=SetVariable($MonsterSpawners["7"], $gg_unit_n008_0526)
action=SetVariable($MaxMonsters["7"], "5")
action=SetVariable($SpawnFrequence["7"], "3")
action=SetVariable($SpawnAngle["7"], "60.00")
action=CommentString("-")
action=SetVariable($MonsterTypes["8"], "n00Y")
action=SetVariable($MonsterSpawners["8"], $gg_unit_n008_0528)
action=SetVariable($MaxMonsters["8"], "5")
action=SetVariable($SpawnFrequence["8"], "3")
action=SetVariable($SpawnAngle["8"], "155.00")
action=CommentString("-")
action=ForLoopA("1", $NumMonsters, action:SetVariable($InitialSpawnFrequence[GetForLoopIndexA()], $SpawnFrequence[GetForLoopIndexA()]) ~"")
