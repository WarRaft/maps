>action:2=TriggerExecute($gg_trg_Cinematic_BOSS1_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=TriggerSleepAction("0.30")
action=CommentString("Сообщение Тетинумми 2")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic05, $TEXT_Mechanic["5"], AddSetToSet, "9.50", WaitDontDont)
