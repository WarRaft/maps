[trigger]
name="Cinematic Tesseract"
description="- Это же легендарный Тессеракт! Древний магический артефакт, способный уменьшать предметы внутри себя до мельчайших частиц. \r\n- При этом сам Тессеракт и предметы внутри него не имеют массы.\r\n\r\n- Тессеракт может вместить в себя до шести предметов. Маги часто использовали его в своих опытах.\r\n\r\n- Это сумка чтоли?\r\n- Ну... Можно и так сказать."
action=DisableTrigger(GetTriggeringTrigger())
event=TriggerRegisterEnterRectSimple($gg_rct_REG_Tesseract_Entrance)
action=SetVariable($Cinematic_skipped, "false")
action=CommentString("НАЧАЛО СЪЁМОК")
action=CinematicFadeBJ(FadeTypeOptionFadeOut, "0.50", CineFilterTextureBlack, "0", "0", "0", "0")
action=TriggerSleepAction("0.40")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=PauseAllUnitsBJ(PauseUnpauseOptionPause)
action=IssueImmediateOrder($Hero_mechanic, UnitOrderStop)
action=IssueImmediateOrder($Hero_shaman, UnitOrderStop)
action=IssueImmediateOrder($Hero_warrior, UnitOrderStop)
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "0.00")
action=DisableTrigger($gg_trg_Z_coordinate_check)
action=CameraSetSmoothingFactorBJ("0.00")
action=CommentString("Выбор начального положения камеры")
action=ForForceMultiple($Players)
>action:0=ClearSelectionForPlayer(GetEnumPlayer())
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Tesseract_01, Player00, "0.00")
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Tesseract_02, Player00, "60.00")
action=CommentString("Ввод изображения")
action=CinematicModeExBJ(OnOffOn, GetPlayersAll(), "0.60")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0", "0", "0", "0")
action=CommentString("ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК")
action=ForForceMultiple($Players)
>action:0=CommentString("Для Тессеракта")
>action:0=SetPlayerAllianceStateBJ(GetEnumPlayer(), Player07, AllianceSettingAllied)
>action:0=SetPlayerAllianceStateBJ(Player07, GetEnumPlayer(), AllianceSettingAllied)
>action:0=SetPlayerAllianceBJ(Player07, AllianceTypeSharedControl, OnOffOn, GetEnumPlayer())
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Тетинумми 1")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic14, $TEXT_Mechanic["14"], AddSetToSet, "11.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 11 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "11.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Тетинумми 2")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic15, $TEXT_Mechanic["15"], AddSetToSet, "6.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 6 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "6.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Тетинумми 3")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic16, $TEXT_Mechanic["16"], AddSetToSet, "8.10", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 9.2 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "9.20")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Смена камеры")
action=IfThenElseMultiple()
>action:1=ForForceMultiple($Players)
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Tesseract_03, GetEnumPlayer(), "0.00")
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Tesseract_04, GetEnumPlayer(), "20.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=TriggerSleepAction("0.30")
action=CommentString("Сообщение Нитнарак")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_warrior, GetHeroProperName($Hero_warrior), $gg_snd_Warrior10, $TEXT_Warrior["10"], AddSetToSet, "2.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 2.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "2.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Тетинумми 4")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic17, $TEXT_Mechanic["17"], AddSetToSet, "1.50", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 3 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "3.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("ЗАВЕРШЕНИЕ СЪЁМОК")
action=TriggerExecute($gg_trg_Cinematic_Tesseract_Ending)
