[trigger]
name="Comment03"
description="Собщение о Пожирателе мертвых."
action=DisableTrigger(GetTriggeringTrigger())
action=SetVariable($Talking_Hero, GetLeavingUnit())
action=VolumeGroupSetVolumeBJ(VolumeGroupUnitSounds, "0.00")
action=TriggerSleepAction("1.00")
action=CommentString("Сообщение Акнеладу")
action=IfThenElseMultiple()
>action:1=UnitAddIndicatorBJ($Hero_shaman, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman09, $TEXT_Shaman["9"], AddSetToSet, "6.00", WaitDontDont)
>action:1=TriggerSleepAction("9.00")
>condition:0=OperatorCompareUnit($Talking_Hero, OperatorEqualENE, $Hero_shaman)
action=CommentString("Сообщение Нитнарак")
action=IfThenElseMultiple()
>action:1=UnitAddIndicatorBJ($Hero_warrior, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_warrior, GetHeroProperName($Hero_warrior), $gg_snd_Warrior08, $TEXT_Warrior["8"], AddSetToSet, "8.00", WaitDontDont)
>action:1=TriggerSleepAction("11.00")
>condition:0=OperatorCompareUnit($Talking_Hero, OperatorEqualENE, $Hero_warrior)
action=CommentString("Сообщение Тетинумми")
action=IfThenElseMultiple()
>action:1=UnitAddIndicatorBJ($Hero_mechanic, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic06, $TEXT_Mechanic["6"], AddSetToSet, "8.00", WaitDontDont)
>action:1=TriggerSleepAction("11.00")
>condition:0=OperatorCompareUnit($Talking_Hero, OperatorEqualENE, $Hero_mechanic)
action=VolumeGroupSetVolumeBJ(VolumeGroupUnitSounds, "100.00")
condition=OperatorCompareBoolean(IsUnitType(GetLeavingUnit(), UnitTypeHero), OperatorEqualENE, "true")
event=TriggerRegisterLeaveRectSimple($gg_rct_REG_Corpses_spawn)
