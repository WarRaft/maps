[trigger]
name="Cinematic Prisoner2"
description="Да, это она!  Моя Сфера! Благодарю Вас от всего сердца! Теперь я смогу вернуться домой!\r\n\r\nТак, надо вспомнить, как это делается . . .\r\n\r\nОтлично! У меня получилось. Спасибо Вам еще раз за помощь! Возьмите мою сферу в качестве благодарности. Прощайте!\r\n"
initially_off=1
condition=OperatorCompareBoolean(IsUnitType(GetTriggerUnit(), UnitTypeHero), OperatorEqualENE, "true")
condition=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I02D"), OperatorEqualENE, "true")
action=DisableTrigger(GetTriggeringTrigger())
action=SetVariable($Cinematic_skipped, "false")
action=SetVariable($Hero_any, GetTriggerUnit())
action=CommentString("НАЧАЛО СЪЁМОК")
action=CinematicFadeBJ(FadeTypeOptionFadeOut, "0.50", CineFilterTextureBlack, "0", "0", "0", "0")
action=TriggerSleepAction("0.40")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=PauseAllUnitsBJ(PauseUnpauseOptionPause)
action=IssueImmediateOrder($Hero_mechanic, UnitOrderStop)
action=IssueImmediateOrder($Hero_shaman, UnitOrderStop)
action=IssueImmediateOrder($Hero_warrior, UnitOrderStop)
action=SetUnitFacingToFaceUnitTimed($UNIT_Prisoner, $Hero_any, "0.50")
action=SetUnitFacingToFaceUnitTimed($Hero_any, $UNIT_Prisoner, "0.50")
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "0.00")
action=DisableTrigger($gg_trg_Z_coordinate_check)
action=CameraSetSmoothingFactorBJ("0.00")
action=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I02D"))
action=CommentString("Выбор начального положения камеры")
action=ForForceMultiple($Players)
>action:0=ClearSelectionForPlayer(GetEnumPlayer())
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Prisoner2, GetEnumPlayer(), "0.00")
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Prisoner1, GetEnumPlayer(), "40.00")
action=CommentString("Ввод изображения")
action=CinematicModeExBJ(OnOffOn, GetPlayersAll(), "0.60")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0", "0", "0", "0")
action=CommentString("ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК")
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Заключённого 1")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Prisoner, "TRIGSTR_4134", $gg_snd_Prisoner5, "TRIGSTR_4135", AddSetToSet, "7.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 7.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "7.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Поворот и сообщение Заключённого 2")
action=IfThenElseMultiple()
>action:1=SetUnitFacingTimed($UNIT_Prisoner, "360.00", "0.80")
>action:1=TriggerSleepAction("0.30")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Prisoner, "TRIGSTR_4202", $gg_snd_Prisoner6, "TRIGSTR_4203", AddSetToSet, "3.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 4 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "4.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Открытие портала")
action=IfThenElseMultiple()
>action:1=SetVariable($Portal_num, "23")
>action:1=TriggerExecute($gg_trg_PORTAL_OPENING)
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 2 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "2.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Заключённого 3")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Prisoner, "TRIGSTR_4245", $gg_snd_Prisoner7, "TRIGSTR_4246", AddSetToSet, "9.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 7.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "7.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Создание Сферы")
action=IfThenElseMultiple()
>action:1=CreateItemLoc("I02W", Location("8560.00", "-2075.00"))
>action:1=SetVariable($Cinematic_Prisoner, "true")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 2 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "2.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Исчезновение Заключённого")
action=IfThenElseMultiple()
>action:1=PauseUnitBJ(PauseUnpauseOptionUnpause, $UNIT_Prisoner)
>action:1=IssuePointOrderLoc($UNIT_Prisoner, UnitOrderMove, Location("8620.00", "-2020.00"))
>action:1=TriggerSleepAction("0.40")
>action:1=RemoveUnit($UNIT_Prisoner)
>action:1=KillDestructable(LoadDestructableHandleBJ("23", "1", GetLastCreatedHashtableBJ()))
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 2 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "2.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("ЗАВЕРШЕНИЕ СЪЁМОК")
action=TriggerExecute($gg_trg_Cinematic_Prisoner2_Ending)
