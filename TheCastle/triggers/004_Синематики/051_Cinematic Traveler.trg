[trigger]
name="Cinematic Traveler"
description="Как хорошо, что я встретил вас, а не бандитов. Не откажите в помощи бедному страннику.\r\n\r\nМоя бедная ящерка! Моя Дори! Её что-то спугнуло и она убежала. Я видел, как она пролезла под стену Замка.\r\n\r\nЕсли вы вдруг встретите её, угостите листьями этого растения. Она должна сразу вспомнить меня и вернуться. Только, пожалуйста, аккуратнее! Дори сильно напугана и может быть агрессивной!\r\n\r\nК сожалению, мне нечего вам предложить. Но если вы поможете мне, то я буду молиться за вас всю свою жизнь!\r\n"
condition=OperatorCompareBoolean(IsUnitType(GetTriggerUnit(), UnitTypeHero), OperatorEqualENE, "true")
action=DisableTrigger(GetTriggeringTrigger())
action=SetVariable($Cinematic_skipped, "false")
action=SetVariable($Hero_any, GetTriggerUnit())
action=CommentString("НАЧАЛО СЪЁМОК")
action=CinematicFadeBJ(FadeTypeOptionFadeOut, "0.50", CineFilterTextureBlack, "0", "0", "0", "0")
action=TriggerSleepAction("0.40")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=PauseAllUnitsBJ(PauseUnpauseOptionPause)
action=IssueImmediateOrder($Hero_mechanic, UnitOrderStop)
action=IssueImmediateOrder($Hero_shaman, UnitOrderStop)
action=IssueImmediateOrder($Hero_warrior, UnitOrderStop)
action=SetUnitFacingToFaceUnitTimed($UNIT_Traveler, $Hero_any, "0.50")
action=SetUnitFacingToFaceUnitTimed($Hero_any, $UNIT_Traveler, "0.50")
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "0.00")
action=DisableTrigger($gg_trg_Z_coordinate_check)
action=CameraSetSmoothingFactorBJ("0.00")
action=CommentString("Выбор начального положения камеры")
action=ForForceMultiple($Players)
>action:0=ClearSelectionForPlayer(GetEnumPlayer())
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Traveler1, GetEnumPlayer(), "0.00")
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Traveler2, GetEnumPlayer(), "60.00")
action=CommentString("Ввод изображения")
action=CinematicModeExBJ(OnOffOn, GetPlayersAll(), "0.60")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0", "0", "0", "0")
action=CommentString("ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК")
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Странника 1")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Traveler, GetUnitName($UNIT_Traveler), $gg_snd_Traveler01, $TEXT_Traveler["1"], AddSetToSet, "5.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 5.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "5.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Странника 2")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Traveler, GetUnitName($UNIT_Traveler), $gg_snd_Traveler02, $TEXT_Traveler["2"], AddSetToSet, "9.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 9.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "9.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Странника 3")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Traveler, GetUnitName($UNIT_Traveler), $gg_snd_Traveler03, OperatorString($TEXT_Traveler["3"], OperatorString(" ", $TEXT_Traveler["4"])), AddSetToSet, "13.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 14 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "14.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Странника 4")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Traveler, GetUnitName($UNIT_Traveler), $gg_snd_Traveler04, $TEXT_Traveler["5"], AddSetToSet, "8.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 8.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "8.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("ЗАВЕРШЕНИЕ СЪЁМОК")
action=TriggerExecute($gg_trg_Cinematic_Traveler_Ending)
