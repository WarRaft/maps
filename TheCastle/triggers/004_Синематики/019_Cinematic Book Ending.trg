[trigger]
name="Cinematic Book Ending"
description=""
initially_off=1
action=IfThenElseMultiple()
>action:1=CinematicFadeBJ(FadeTypeOptionFadeOut, "1.00", CineFilterTextureBlack, "0", "0", "0", "0")
>action:1=TriggerSleepAction("0.90")
>condition:0=OperatorCompareBoolean($Book_open_Bool, OperatorEqualENE, "false")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=PauseAllUnitsBJ(PauseUnpauseOptionUnpause)
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "100.00")
action=EnableTrigger($gg_trg_Z_coordinate_check)
action=CameraSetSmoothingFactorBJ("0.30")
action=CommentString("См. папку \"Головоломка со статуэтками\"")
action=EnableTrigger($gg_trg_Activation_Book)
action=ShowDestructableBJ(ShowHideShow, $gg_dest_B002_3154)
action=ShowDestructableBJ(ShowHideHide, $gg_dest_B003_3157)
action=SetUnitAnimation($gg_unit_n00U_0184, "stand second")
action=CommentString("Выбор положения камеры")
action=ForForceMultiple($Players)
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Book5, GetEnumPlayer(), "0")
action=CommentString("Ввод изображения")
action=IfThenElseMultiple()
>action:2=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0", "0", "0", "0")
>action:2=CinematicModeExBJ(OnOffOff, GetPlayersAll(), "0.60")
>action:1=CustomScriptCode("call SetDayNightModels( \"\",\"\")")
>action:1=ShowInterfaceForceOn(GetPlayersAll(), "1.00")
>action:1=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.80", CineFilterTextureBlack, "100.00", "100.00", "100.00", "0")
>condition:0=OperatorCompareBoolean($Book_open_Bool, OperatorEqualENE, "true")
