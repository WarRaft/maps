[trigger]
name="Cinematic Marauder"
description="Я уже думал, что мне конец! Всю мою команду перебили скелеты, а меня чуть не сожрали эти чертовы крысы. Но мне повезло.\r\n\r\nЭтот Замок - очень страшное и опасное место! А стены его прячут несметные богатства. Мы думали, что сможем быстро разбогатеть, если проберемся сюда. \r\n\r\nНо раз уж я остался в живых, могу вам кое-что предложить за скромненькую сумму. Мы нашли здесь драгоценные камни и древние книги. Мне они ни к чему, а вот золотишко лишним не будет."
initially_off=1
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=SetVariable($Hero_any, GetTriggerUnit())
>>condition:0=OperatorCompareBoolean(IsTriggerEnabled(GetTriggeringTrigger()), OperatorEqualENE, "true")
>action:1=DisableTrigger(GetTriggeringTrigger())
>action:1=SetVariable($Cinematic_skipped, "false")
>action:1=FogModifierStop($Eye["1"])
>action:1=CommentString("НАЧАЛО СЪЁМОК")
>action:1=CinematicFadeBJ(FadeTypeOptionFadeOut, "0.50", CineFilterTextureBlack, "0", "0", "0", "0")
>action:1=TriggerSleepAction("0.40")
>action:1=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
>action:1=PauseAllUnitsBJ(PauseUnpauseOptionPause)
>action:1=IssueImmediateOrder($Hero_mechanic, UnitOrderStop)
>action:1=IssueImmediateOrder($Hero_shaman, UnitOrderStop)
>action:1=IssueImmediateOrder($Hero_warrior, UnitOrderStop)
>action:1=SetUnitFacingToFaceUnitTimed($UNIT_Marauder, $Hero_any, "0.50")
>action:1=SetUnitFacingToFaceUnitTimed($Hero_any, $UNIT_Marauder, "0.50")
>action:1=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "0.00")
>action:1=DisableTrigger($gg_trg_Z_coordinate_check)
>action:1=CameraSetSmoothingFactorBJ("0.00")
>action:1=CommentString("Выбор начального положения камеры")
>action:1=ForForceMultiple($Players)
>>action:0=ClearSelectionForPlayer(GetEnumPlayer())
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Marauder1, GetEnumPlayer(), "0.00")
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Marauder2, GetEnumPlayer(), "40.00")
>action:1=CommentString("Ввод изображения")
>action:1=CinematicModeExBJ(OnOffOn, GetPlayersAll(), "0.60")
>action:1=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0", "0", "0", "0")
>action:1=CommentString("ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК")
>action:1=CommentString("Таймер ожидания 1 с.")
>action:1=IfThenElseMultiple()
>>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=IfThenElseMultiple()
>>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=CommentString("Сообщение Мародера 1")
>action:1=IfThenElseMultiple()
>>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Marauder, "TRIGSTR_2878", $gg_snd_Marauder04, "TRIGSTR_2879", AddSetToSet, "8.80", WaitDontDont)
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=CommentString("Таймер ожидания 9.3 с.")
>action:1=IfThenElseMultiple()
>>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "9.30")
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=IfThenElseMultiple()
>>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=CommentString("Сообщение Мародера 2")
>action:1=IfThenElseMultiple()
>>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Marauder, "TRIGSTR_2942", $gg_snd_Marauder05, "TRIGSTR_2943", AddSetToSet, "11.60", WaitDontDont)
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=CommentString("Таймер ожидания 12.1 с.")
>action:1=IfThenElseMultiple()
>>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "12.10")
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=IfThenElseMultiple()
>>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=CommentString("Сообщение Мародера 3")
>action:1=IfThenElseMultiple()
>>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Marauder, "TRIGSTR_2944", $gg_snd_Marauder06, "TRIGSTR_2945", AddSetToSet, "13.00", WaitDontDont)
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=CommentString("Таймер ожидания 13.5 с.")
>action:1=IfThenElseMultiple()
>>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "13.50")
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=IfThenElseMultiple()
>>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>>action:2=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>>action:2=ReturnAction()
>>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
>action:1=CommentString("ЗАВЕРШЕНИЕ СЪЁМОК")
>action:1=TriggerExecute($gg_trg_Cinematic_Marauder_Ending)
>action:2=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $gg_unit_n01P_0376, "TRIGSTR_2880", $gg_snd_Marauder07, "TRIGSTR_2881", AddSetToAdd, "0.00", WaitDontDont)
>condition:0=OperatorCompareInteger(CountUnitsInGroup($Rats_Group), OperatorEqual, "0")
condition=OperatorCompareBoolean(IsUnitType(GetTriggerUnit(), UnitTypeHero), OperatorEqualENE, "true")
condition=OperatorCompareInteger(GetUnitUserData($UNIT_Marauder), OperatorEqual, "1")
