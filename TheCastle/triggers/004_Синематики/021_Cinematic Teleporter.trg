[trigger]
name="Cinematic Teleporter"
description="Переместитель? Не думал, что когда-нибудь увижу его. Он может перенести нас в другое место, если мы сможем настроить его!"
initially_off=1
action=SetVariable($Cinematic_skipped, "false")
action=CommentString("НАЧАЛО СЪЁМОК")
action=CinematicFadeBJ(FadeTypeOptionFadeOut, "0.50", CineFilterTextureBlack, "0", "0", "0", "0")
action=TriggerSleepAction("0.40")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=PauseAllUnitsBJ(PauseUnpauseOptionPause)
action=IssueImmediateOrder($Hero_mechanic, UnitOrderStop)
action=IssueImmediateOrder($Hero_shaman, UnitOrderStop)
action=IssueImmediateOrder($Hero_warrior, UnitOrderStop)
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "0.00")
action=DisableTrigger($gg_trg_Z_coordinate_check)
action=CameraSetSmoothingFactorBJ("0.00")
action=ShowUnitShow($gg_unit_n022_0203)
action=SetUnitAnimation($gg_unit_n022_0203, "birth")
action=UnitAddAbilityBJ("A043", $gg_unit_n022_0203)
action=AddItemToStockBJ("I01Z", $gg_unit_n022_0203, "1", "1")
action=AddItemToStockBJ("I020", $gg_unit_n022_0203, "1", "1")
action=AddItemToStockBJ("I021", $gg_unit_n022_0203, "1", "1")
action=ForLoopBMultiple("1", "3")
>action:0=ShowUnitShow($Spatial_Cube[GetForLoopIndexB()])
>action:0=SetUnitAnimation($Spatial_Cube[GetForLoopIndexB()], "birth")
>action:0=UnitAddAbilityBJ("A050", $Spatial_Cube[GetForLoopIndexB()])
action=CommentString("Выбор начального положения камеры")
action=ForForceMultiple($Players)
>action:0=ClearSelectionForPlayer(GetEnumPlayer())
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Teleporter1, Player00, "0.00")
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Teleporter2, Player00, "50.00")
action=CommentString("Ввод изображения")
action=CinematicModeExBJ(OnOffOn, GetPlayersAll(), "0.60")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0", "0", "0", "0")
action=CommentString("ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК")
action=CommentString("Таймер ожидания 1.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Teleporter_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Teleporter_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Эффект появления")
action=IfThenElseMultiple()
>action:1=AddSpecialEffectLocBJ(GetUnitLoc($gg_unit_n022_0203), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
>action:1=SetUnitAnimation($gg_unit_n022_0203, "stand")
>action:1=ForLoopBMultiple("1", "3")
>>action:0=AddSpecialEffectLocBJ(GetUnitLoc($Spatial_Cube[GetForLoopIndexB()]), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
>>action:0=SetUnitAnimation($Spatial_Cube[GetForLoopIndexB()], "stand")
>action:2=TriggerExecute($gg_trg_Cinematic_Teleporter_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Teleporter_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Teleporter_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Тетинумми")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic20, $TEXT_Mechanic["20"], AddSetToSet, "10.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_Teleporter_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 10 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "10.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Teleporter_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Teleporter_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("ЗАВЕРШЕНИЕ СЪЁМОК")
action=TriggerExecute($gg_trg_Cinematic_Teleporter_Ending)
