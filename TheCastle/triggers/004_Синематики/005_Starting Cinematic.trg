[trigger]
name="Starting Cinematic"
description="TEXT_Warrior[1] = Вот, мы и добрались.\r\n\r\nTEXT_Mechanic[1] = В этом Замке нас ждут трудные испытания. Нам нужно держаться вместе, чтобы преодолеть их все.\r\n\r\nTEXT_Shaman[1] = Мы - надежда наших народов. Наши навыки и умения помогут нам справиться с любой опасностью. Вперёд, друзья!\r\n"
initially_off=1
action=SetVariable($Cinematic_skipped, "false")
action=CommentString("НАЧАЛО СЪЁМОК")
action=CinematicFadeBJ(FadeTypeOptionFadeOut, "0.00", CineFilterTextureBlack, "0", "0", "0", "0")
action=ShowInterfaceForceOff(GetPlayersAll(), "0.00")
action=TriggerSleepAction("0.30")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "0.00")
action=DisableTrigger($gg_trg_Z_coordinate_check)
action=CameraSetSmoothingFactorBJ("0.00")
action=IssuePointOrderLoc($Hero_warrior, UnitOrderMove, GetRectCenter($gg_rct_REG_Warrior_Start))
action=IssuePointOrderLoc($Hero_shaman, UnitOrderMove, GetRectCenter($gg_rct_REG_Shaman_Start))
action=IssuePointOrderLoc($Hero_mechanic, UnitOrderMove, GetRectCenter($gg_rct_REG_Mechanic_Start))
action=CommentString("Выбор начального положения камеры")
action=ForForceMultiple($Players)
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Intro_001, GetEnumPlayer(), "0")
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Intro_002, GetEnumPlayer(), "15.00")
action=CommentString("Ввод изображения")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "1.00", CineFilterTextureBlack, "0", "0", "0", "0")
action=CommentString("ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК")
action=CommentString("Таймер ожидания 1.6 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.60")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.40")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Смена камеры")
action=IfThenElseMultiple()
>action:1=ForForceMultiple($Players)
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Intro_003, GetEnumPlayer(), "0.00")
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Intro_004, GetEnumPlayer(), "20.00")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Нитнарака")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_warrior, GetHeroProperName($Hero_warrior), $gg_snd_Warrior01, $TEXT_Warrior["1"], AddSetToSet, "2.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 2.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "2.50")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Тетинумми")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic01, $TEXT_Mechanic["1"], AddSetToSet, "7.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 8.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "8.50")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Смена камеры")
action=IfThenElseMultiple()
>action:1=ForForceMultiple($Players)
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Intro_005, GetEnumPlayer(), "0.00")
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Intro_006, GetEnumPlayer(), "15.00")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=TriggerSleepAction("0.40")
action=CommentString("Сообщение Акнеладу")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman01, $TEXT_Shaman["1"], AddSetToSet, "7.50", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 8 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "8.50")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Starting_Game)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("ЗАВЕРШЕНИЕ СЪЁМОК")
action=TriggerExecute($gg_trg_Starting_Game)
