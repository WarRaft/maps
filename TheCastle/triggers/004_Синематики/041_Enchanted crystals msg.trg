[trigger]
name="Enchanted crystals msg"
description=""
action=DisableTrigger(GetTriggeringTrigger())
action=SetVariable($Talking_Hero, GetEnteringUnit())
action=VolumeGroupSetVolumeBJ(VolumeGroupUnitSounds, "0.00")
action=TriggerSleepAction("1.00")
action=CommentString("Сообщение Акнеладу")
action=IfThenElseMultiple()
>action:1=UnitAddIndicatorBJ($Hero_shaman, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman05, $TEXT_Shaman["5"], AddSetToSet, "7.00", WaitDontDont)
>action:1=TriggerSleepAction("10.00")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman07, $TEXT_Shaman["7"], AddSetToSet, "4.00", WaitDontDont)
>action:1=TriggerSleepAction("7.00")
>condition:0=OperatorCompareUnit($Talking_Hero, OperatorEqualENE, $Hero_shaman)
action=CommentString("Сообщение Нитнарак")
action=IfThenElseMultiple()
>action:1=UnitAddIndicatorBJ($Hero_warrior, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_warrior, GetHeroProperName($Hero_warrior), $gg_snd_Warrior02, $TEXT_Warrior["2"], AddSetToSet, "1.00", WaitDontDont)
>action:1=TriggerSleepAction("4.00")
>action:1=UnitAddIndicatorBJ($Hero_shaman, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman06, $TEXT_Shaman["6"], AddSetToSet, "4.00", WaitDontDont)
>action:1=TriggerSleepAction("7.00")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman07, $TEXT_Shaman["7"], AddSetToSet, "4.00", WaitDontDont)
>action:1=TriggerSleepAction("7.00")
>condition:0=OperatorCompareUnit($Talking_Hero, OperatorEqualENE, $Hero_warrior)
action=CommentString("Сообщение Тетинумми")
action=IfThenElseMultiple()
>action:1=UnitAddIndicatorBJ($Hero_mechanic, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic03, $TEXT_Mechanic["3"], AddSetToSet, "1.00", WaitDontDont)
>action:1=TriggerSleepAction("3.00")
>action:1=UnitAddIndicatorBJ($Hero_shaman, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman06, $TEXT_Shaman["6"], AddSetToSet, "4.00", WaitDontDont)
>action:1=TriggerSleepAction("7.00")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman07, $TEXT_Shaman["7"], AddSetToSet, "4.00", WaitDontDont)
>action:1=TriggerSleepAction("7.00")
>condition:0=OperatorCompareUnit($Talking_Hero, OperatorEqualENE, $Hero_mechanic)
action=VolumeGroupSetVolumeBJ(VolumeGroupUnitSounds, "100.00")
event=TriggerRegisterEnterRectSimple($gg_rct_REG_Rat1)
