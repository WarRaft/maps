[trigger]
name="Cinematic Lattice2 Ending"
description=""
initially_off=1
action=CinematicFadeBJ(FadeTypeOptionFadeOut, "1.00", CineFilterTextureBlack, "0", "0", "0", "0")
action=TriggerSleepAction("0.90")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=PauseAllUnitsBJ(PauseUnpauseOptionUnpause)
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "100.00")
action=EnableTrigger($gg_trg_Z_coordinate_check)
action=CameraSetSmoothingFactorBJ("0.30")
action=KillDestructable($gg_dest_B00S_0759)
action=RemoveDestructable($gg_dest_B00Y_0757)
action=DisableTrigger($gg_trg_Portal_Blocking2)
action=IfThenElseMultiple()
>condition:0=OperatorCompareBoolean(IsDestructableDeadBJ($gg_dest_B00S_0760), OperatorEqualENE, "true")
>action:1=EnumDestructablesInRectAllMultiple($gg_rct_REG_Portal_Blocking1)
>>action:0=IfThenElseMultiple()
>>>action:1=RemoveDestructable(GetEnumDestructable())
>>>condition:0=OperatorCompareDestructableCode(GetDestructableTypeId(GetEnumDestructable()), OperatorEqualENE, "B00Y")
>action:1=DisableTrigger($gg_trg_Portal_Blocking1)
action=FogModifierStop($Eye["4"])
action=CommentString("Выбор положения камеры")
action=ForForceMultiple($Players)
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Lattice4, GetEnumPlayer(), "0")
action=CommentString("Ввод изображения")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0", "0", "0", "0")
action=ShowInterfaceForceOn(GetPlayersAll(), "0.60")
