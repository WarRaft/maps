[trigger]
name="Cinematic Victory alternate"
description="Приняв тёмную силу Архилича Дивока и уничтожив всех защитников своих народов, герои получили власть и могущество, о которых так мечтали. А тьма, поглотившая их рассудок окончательно, получила себе жестоких и непобедимых слуг, способных распространить тёмное влияние по всему свету.\r\n\r\nТеперь им предстояло выбраться из Замка. Но с той силой, что теперь была у них, путь обратно не представлял никакой опасности . . .\r\n\r\nГерои покинули Замок, а стены его продолжали хранить секреты. Кто знает, сколько еще тайн скрыто в коридорах Замка? Быть может, прямо сейчас в одной из дальних и забытых комнат зарождается нечто более ужасное и могущественное . . .\r\n\r\nТИТРЫ\r\n\r\n|cffffcc00ИДЕЯ И РЕАЛИЗАЦИЯ|r\r\nАртемий Фёдоров (Teo/Lord_Teo)\r\n\r\n|cffffcc00МУЗЫКА|r\r\nAtrium Carceri - Ego Death\r\nAtrium Carceri & Cities Last Broadcast - Prepare the Stage of Night\r\nDavid Chas - Legions Are Marching\r\nRok Nardin - Where is Your God Now\r\n\r\nЕсли Вам понравилась карта, то можете оставить положительный отзыв на сайте XGM.GURU - ресурс |cffffcc00\"Замок (The Castle)\"|r. Или можете оставить критику и замечания, если были найдены какие-либо ошибки или неприятные моменты.\r\nСпасибо за игру!\r\n|cffffcc00ТЕСТИРОВАНИЕ|r\r\nLord_Teo\r\nABATAPA_PEKCAPA\r\nАндреич\r\n\r\n|cffffcc00МОДЕЛИ|r\r\nИспользовались мод"
action=DisableTrigger(GetTriggeringTrigger())
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "0.00")
action=StopMusicBJ(FadeDontDont)
action=PlayThematicMusicBJ(MusicThemeDarkVictory)
action=ForForceMultiple($Players)
>action:0=SetCameraFieldForPlayer(GetEnumPlayer(), CameraFieldTargetDistance, "80.00", "50.00")
action=TriggerSleepAction("5.00")
action=SetVariable($Cinematic_skipped, "false")
action=CommentString("НАЧАЛО СЪЁМОК")
action=CinematicFadeBJ(FadeTypeOptionFadeOut, "1.00", CineFilterTextureBlack, "0", "0", "0", "0")
action=TriggerSleepAction("0.90")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=PauseAllUnitsBJ(PauseUnpauseOptionPause)
action=DisableTrigger($gg_trg_Z_coordinate_check)
action=CameraSetSmoothingFactorBJ("0.00")
action=CommentString("Выбор начального положения камеры")
action=ForForceMultiple($Players)
>action:0=ClearSelectionForPlayer(GetEnumPlayer())
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Victory_01, GetEnumPlayer(), "0.00")
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Victory_02, GetEnumPlayer(), "40.00")
action=CommentString("Ввод изображения")
action=CinematicModeExBJ(OnOffOn, GetPlayersAll(), "0.60")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0.00", "0", "0", "0")
action=CommentString("ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК")
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Victory_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Victory_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение 1")
action=IfThenElseMultiple()
>action:1=DisplayTimedTextToForce(GetPlayersAll(), "17.00", "TRIGSTR_4449")
>action:2=TriggerExecute($gg_trg_Cinematic_Victory_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 13 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "13.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Victory_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Victory_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=ClearTextMessagesBJ(GetPlayersAll())
action=TriggerSleepAction("0.30")
action=CommentString("Сообщение 2")
action=IfThenElseMultiple()
>action:1=DisplayTimedTextToForce(GetPlayersAll(), "10.00", "TRIGSTR_4450")
>action:2=TriggerExecute($gg_trg_Cinematic_Victory_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 7 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "7.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Victory_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_Victory_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Смена камеры")
action=IfThenElseMultiple()
>action:1=ForForceMultiple($Players)
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Victory_03, GetEnumPlayer(), "0.00")
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Victory_04, GetEnumPlayer(), "30.00")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
