>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner1_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Смена камеры")
action=IfThenElseMultiple()
>action:1=ForForceMultiple($Players)
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Prisoner4, GetEnumPlayer(), "0.00")
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Prisoner3, GetEnumPlayer(), "50.00")
>action:2=TriggerExecute($gg_trg_Cinematic_Prisoner1_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
