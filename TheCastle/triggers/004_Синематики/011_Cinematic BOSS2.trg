[trigger]
name="Cinematic BOSS2"
description=""
action=DisableTrigger(GetTriggeringTrigger())
action=SetVariable($Cinematic_skipped, "false")
action=CommentString("НАЧАЛО СЪЁМОК")
condition=OperatorCompareBoolean(IsUnitType(GetEnteringUnit(), UnitTypeHero), OperatorEqualENE, "true")
event=TriggerRegisterEnterRectSimple($gg_rct_REG_Boss2_Intro)
action=CinematicFadeBJ(FadeTypeOptionFadeOut, "0.50", CineFilterTextureBlack, "0", "0", "0", "0")
action=TriggerSleepAction("0.40")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=CustomScriptCode("call SetDayNightModels( \"Environment\\\\DNC\\\\DNCLordaeron\\\\DNCLordaeronTerrain\\\\DNCLordaeronTerrain.mdl \",\"Environment\\\\DNC\\\\DNCLordaeron\\\\DNCLordaeronUnit\\\\DNCLordaeronUnit.mdl\")")
action=SetTerrainFogExBJ(FogStyleLinear, "6000.00", "6000.00", "100.00", "0.00", "0.00", "0.00")
action=PauseAllUnitsBJ(PauseUnpauseOptionPause)
action=IssueImmediateOrder($Hero_mechanic, UnitOrderStop)
action=IssueImmediateOrder($Hero_shaman, UnitOrderStop)
action=IssueImmediateOrder($Hero_warrior, UnitOrderStop)
action=ForGroupMultiple(GetUnitsOfPlayerAll(Player11))
>action:0=PauseUnitBJ(PauseUnpauseOptionUnpause, GetEnumUnit())
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "0.00")
action=StopMusicBJ(FadeDontDont)
action=PlayMusicBJ($gg_snd_Boss2)
action=DisableTrigger($gg_trg_Z_coordinate_check)
action=TriggerExecute($gg_trg_Init_Boss2)
action=EnableTrigger($gg_trg_Tanks_respawn)
action=CameraSetSmoothingFactorBJ("0.00")
action=CommentString("Выбор начального положения камеры")
action=ForForceMultiple($Players)
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Boss2_01, GetEnumPlayer(), "0.00")
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Boss2_02, GetEnumPlayer(), "25.00")
action=CommentString("Ввод изображения")
action=CinematicModeExBJ(OnOffOn, GetPlayersAll(), "0.60")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0.00", "0", "0", "0")
action=CommentString("ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК")
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Нитнарак")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_warrior, GetHeroProperName($Hero_warrior), $gg_snd_Warrior03, $TEXT_Warrior["3"], AddSetToSet, "1.50", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 3 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "3.00")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Акнеладу")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman13, $TEXT_Shaman["13"], AddSetToSet, "6.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 7.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "7.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Тетинумми")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic08, $TEXT_Mechanic["8"], AddSetToSet, "9.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Смена камеры")
action=IfThenElseMultiple()
>action:1=ForForceMultiple($Players)
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Boss2_03, GetEnumPlayer(), "0.00")
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Boss2_04, GetEnumPlayer(), "25.00")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS2_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
