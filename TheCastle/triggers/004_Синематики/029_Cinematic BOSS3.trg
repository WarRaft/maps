[trigger]
name="Cinematic BOSS3"
description="Запускается триггером Choice of ending в папке \"_Босс3 (Финальный)\" при выполнении условия репутации\r\n--------------------------------------------------------\r\nНаконец-то! Я ждал вас. Все время, пока вы находились в моем Замке, я наблюдал за вами. Вашей отваге и сообразительности можно позавидовать. Я с большим удовольствием заберу ваши души. \r\n\r\nВы пришли сюда, чтобы избавиться от тьмы, медленно пожирающей ваши племена. Ну, что ж, источник этой тьмы перед вами! Но что вы можете противопоставить моей сокрушительной силе, ничтожные существа?\r\n\r\nМоя тьма поглотит весь этот жалкий мир и вы не сможете этому помешать!\r\n\r\n\r\n"
initially_off=1
action=SetVariable($Cinematic_skipped, "false")
action=CommentString("НАЧАЛО СЪЁМОК")
action=StopMusicBJ(FadeDontDont)
action=PlayMusicBJ($gg_snd_Boss3)
action=CinematicFadeBJ(FadeTypeOptionFadeOut, "0.50", CineFilterTextureBlack, "0", "0", "0", "0")
action=TriggerSleepAction("0.40")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=PauseAllUnitsBJ(PauseUnpauseOptionPause)
action=IssueImmediateOrder($Hero_mechanic, UnitOrderStop)
action=IssueImmediateOrder($Hero_shaman, UnitOrderStop)
action=IssueImmediateOrder($Hero_warrior, UnitOrderStop)
action=SetUnitPositionLocFacingBJ($Hero_warrior, GetRectCenter($gg_rct_REG_Warrior_Ending1), "90.00")
action=SetUnitPositionLocFacingBJ($Hero_shaman, GetRectCenter($gg_rct_REG_Shaman_Ending1), "90.00")
action=SetUnitPositionLocFacingBJ($Hero_mechanic, GetRectCenter($gg_rct_REG_Mechanic_Ending1), "90.00")
action=TriggerSleepAction("0.10")
action=PauseUnitBJ(PauseUnpauseOptionUnpause, $Hero_warrior)
action=PauseUnitBJ(PauseUnpauseOptionUnpause, $Hero_shaman)
action=PauseUnitBJ(PauseUnpauseOptionUnpause, $Hero_mechanic)
action=IssuePointOrderLoc($Hero_warrior, UnitOrderMove, GetRectCenter($gg_rct_REG_Warrior_Ending2))
action=IssuePointOrderLoc($Hero_shaman, UnitOrderMove, GetRectCenter($gg_rct_REG_Shaman_Ending2))
action=IssuePointOrderLoc($Hero_mechanic, UnitOrderMove, GetRectCenter($gg_rct_REG_Mechanic_Ending2))
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "0.00")
action=DisableTrigger($gg_trg_Z_coordinate_check)
action=CameraSetSmoothingFactorBJ("0.00")
action=CommentString("Выбор начального положения камеры")
action=ForForceMultiple($Players)
>action:0=ClearSelectionForPlayer(GetEnumPlayer())
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Boss3_01, GetEnumPlayer(), "0.00")
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Boss3_02, GetEnumPlayer(), "50.00")
action=CommentString("Ввод изображения")
action=CinematicModeExBJ(OnOffOn, GetPlayersAll(), "0.60")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "0.60", CineFilterTextureBlack, "0", "0", "0", "0")
action=CommentString("ОСНОВНЫЕ ДЕЙСТВИЯ СЪЁМОК")
action=CommentString("Таймер ожидания 1.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Дивока 1")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Boss3_Archmage, "TRIGSTR_4256", $gg_snd_Archmage1, "TRIGSTR_4257", AddSetToSet, "20.20", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 21.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "21.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Дивока 2")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Boss3_Archmage, "TRIGSTR_4264", $gg_snd_Archmage2, "TRIGSTR_4265", AddSetToSet, "19.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 19.5 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "19.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Сообщение Дивока 3")
action=IfThenElseMultiple()
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Boss3_Archmage, "TRIGSTR_4266", $gg_snd_Archmage3, "TRIGSTR_4267", AddSetToSet, "7.00", WaitDontDont)
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Смена камеры")
action=IfThenElseMultiple()
>action:1=ForForceMultiple($Players)
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Boss3_03, GetEnumPlayer(), "0.00")
>>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Boss3_04, GetEnumPlayer(), "20.00")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 1 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "1.00")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Восстанавливаем решетку")
action=IfThenElseMultiple()
>action:1=DestructableRestoreLife($gg_dest_B00S_9043, "500.00", ShowHideShow)
>action:1=DestructableRestoreLife($gg_dest_B00S_9044, "500.00", ShowHideShow)
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("Таймер ожидания 6 с.")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($Cinematic_Timer, PeriodicOptionOneTime, "6.00")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:1=WaitForCondition(condition:OperatorCompareReal(TimerGetRemaining($Cinematic_Timer), OperatorEqual, "0.00") ~"", "0.50")
>action:2=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
>action:2=ReturnAction()
>condition:0=OperatorCompareBoolean($Cinematic_skipped, OperatorEqualENE, "false")
action=CommentString("ЗАВЕРШЕНИЕ СЪЁМОК")
action=TriggerExecute($gg_trg_Cinematic_BOSS3_Ending)
