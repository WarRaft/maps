[trigger]
name="First Activating robot"
description="Оказывается, синие генераторы связаны не только с подъемником, но и с этой машиной. Они не дают ей разрушиться. А заводы каким-то образом дают энергию для этих генераторов. Поэтому нужно уничтожить как можно больше танков, прежде чем последний завод будет разрушен.\r\n\r\nА зaвoды кaким-тo oбpaзoм дaют энepгию для этиx гeнepaтopoв. Пoэтoмy нyжнo yничтoжить кaк мoжнo бoльшe тaнкoв, пpeждe чeм пocлeдний зaвoд бyдeт рaзpyшeн."
action=DisableTrigger(GetTriggeringTrigger())
action=SetVariable($Robot_Activation_Bool, "true")
action=RescueUnitBJ($UNIT_Robot, GetOwningPlayer(GetTriggerUnit()), ChangeColorFalse)
action=IssueTargetOrder($Hero_mechanic, UnitOrderBoard, $UNIT_Robot)
action=UnitRemoveAbilityBJ("Avul", $UNIT_Robot)
action=UnitAddAbilityBJ("A050", $UNIT_Robot)
action=SetUnitTimeScalePercent($UNIT_Robot, "100.00")
action=SetVariable($Hero_mechanic, $UNIT_Robot)
action=SelectUnitForPlayerSingle($Hero_mechanic, GetOwningPlayer($Hero_mechanic))
action=CommentString("См. папку \"_Босс2 (Адская колесница)\"")
action=EnableTrigger($gg_trg_Activation_robot)
action=EnableTrigger($gg_trg_Deactivation_robot)
action=VolumeGroupSetVolumeBJ(VolumeGroupUnitSounds, "0.00")
action=TriggerSleepAction("1.00")
action=UnitAddIndicatorBJ($UNIT_Robot, "100", "100", "100", "0")
action=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, $Name_Mechanic, $gg_snd_Mechanic12, $TEXT_Mechanic["12"], AddSetToSet, "7.00", WaitDontDont)
action=TriggerSleepAction("10.00")
action=UnitAddIndicatorBJ($UNIT_Robot, "100", "100", "100", "0")
action=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, $Name_Mechanic, $gg_snd_Mechanic13, $TEXT_Mechanic["13"], AddSetToSet, "10.00", WaitDontDont)
action=TriggerSleepAction("13.00")
action=VolumeGroupSetVolumeBJ(VolumeGroupUnitSounds, "100.00")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A009")
condition=OperatorCompareUnit(GetSpellTargetUnit(), OperatorEqualENE, $UNIT_Robot)
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventSpellEffect)
