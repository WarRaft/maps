[trigger]
name="Cinematic BOSS3 alternate Ending"
description=""
initially_off=1
action=IfThenElseMultiple()
>action:1=CinematicFadeBJ(FadeTypeOptionFadeOut, "1.00", CineFilterTextureBlack, "0", "0", "0", "0")
>action:1=TriggerSleepAction("0.90")
>condition:0=OperatorCompareBoolean($Darkening_Bool, OperatorEqualENE, "false")
action=CommentString("Необходимые действия за кадром (звук, перемещение юнитов)")
action=PauseAllUnitsBJ(PauseUnpauseOptionUnpause)
action=VolumeGroupSetVolumeBJ(VolumeGroupSpells, "100.00")
action=EnableTrigger($gg_trg_Z_coordinate_check)
action=TriggerExecute($gg_trg_Init_Boss3_alternate)
action=DestructableRestoreLife($gg_dest_B00S_9043, "500.00", ShowHideHide)
action=DestructableRestoreLife($gg_dest_B00S_9044, "500.00", ShowHideHide)
action=DestructableRestoreLife($gg_dest_B00S_1954, "500.00", ShowHideHide)
action=RemoveUnit($UNIT_Boss3_Archmage)
action=SetUnitPositionLocFacingBJ($Hero_warrior, GetRectCenter($gg_rct_REG_Warrior_Ending3_alternate), "0.00")
action=SetUnitPositionLocFacingBJ($Hero_mechanic, GetRectCenter($gg_rct_REG_Mechanic_Ending3_alternate), "0.00")
action=SetUnitPositionLocFacingBJ($Hero_shaman, GetRectCenter($gg_rct_REG_Shaman_Ending3_alternate), "0.00")
action=TriggerExecute($gg_trg_Heroes_Transformation)
action=SetVariable($Portal_num, "20")
action=TriggerExecute($gg_trg_PORTAL_OPENING)
action=SetVariable($Portal_num, "21")
action=TriggerExecute($gg_trg_PORTAL_OPENING)
action=SetVariable($Portal_num, "22")
action=TriggerExecute($gg_trg_PORTAL_OPENING)
action=CameraSetSmoothingFactorBJ("0.30")
action=CommentString("Выбор положения камеры")
action=ForForceMultiple($Players)
>action:0=CameraSetupApplyForPlayer(CameraApply, $gg_cam_CAM_Boss3_08_alternate, GetEnumPlayer(), "0")
action=CommentString("Ввод изображения")
action=CinematicFadeBJ(FadeTypeOptionFadeIn, "1.00", CineFilterTextureBlack, "0", "0", "0", "0")
action=CinematicModeExBJ(OnOffOff, GetPlayersAll(), "1.00")
action=TriggerSleepAction("1.30")
action=TriggerExecute($gg_trg_Help10)
action=TriggerSleepAction("5.00")
action=TriggerExecute($gg_trg_Help11)
