[trigger]
name="Comment05"
description="Сообщение о цвете светильника.\r\n---------------------------------------------------------\r\nКакое потрясающее пламя! Этот Рыцарь Тьмы знает толк в интерьерах."
action=DisableTrigger(GetTriggeringTrigger())
action=SetVariable($Talking_Hero, GetTriggerUnit())
action=VolumeGroupSetVolumeBJ(VolumeGroupUnitSounds, "0.00")
action=TriggerSleepAction("1.00")
action=CommentString("Сообщение Акнеладу")
action=IfThenElseMultiple()
>action:1=UnitAddIndicatorBJ($Hero_shaman, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_shaman, GetHeroProperName($Hero_shaman), $gg_snd_Shaman11, $TEXT_Shaman["11"], AddSetToSet, "3.00", WaitDontDont)
>action:1=TriggerSleepAction("5.50")
>condition:0=OperatorCompareUnit($Talking_Hero, OperatorEqualENE, $Hero_shaman)
action=CommentString("Сообщение Нитнарак")
action=IfThenElseMultiple()
>action:1=UnitAddIndicatorBJ($Hero_warrior, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_warrior, GetHeroProperName($Hero_warrior), $gg_snd_Warrior09, $TEXT_Warrior["9"], AddSetToSet, "4.00", WaitDontDont)
>action:1=TriggerSleepAction("7.00")
>condition:0=OperatorCompareUnit($Talking_Hero, OperatorEqualENE, $Hero_warrior)
action=CommentString("Сообщение Тетинумми")
action=IfThenElseMultiple()
>action:1=UnitAddIndicatorBJ($Hero_mechanic, "100", "100", "100", "0")
>action:1=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $Hero_mechanic, GetHeroProperName($Hero_mechanic), $gg_snd_Mechanic07, $TEXT_Mechanic["7"], AddSetToSet, "4.00", WaitDontDont)
>action:1=TriggerSleepAction("7.00")
>condition:0=OperatorCompareUnit($Talking_Hero, OperatorEqualENE, $Hero_mechanic)
action=VolumeGroupSetVolumeBJ(VolumeGroupUnitSounds, "100.00")
condition=OperatorCompareBoolean(IsUnitType(GetTriggerUnit(), UnitTypeHero), OperatorEqualENE, "true")
event=TriggerRegisterUnitInRangeSimple("800.00", $gg_unit_nrvd_0042)
