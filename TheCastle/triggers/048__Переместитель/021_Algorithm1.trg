[trigger]
name="Algorithm1"
description=""
action=CommentString("Дотронуться до шара")
action=IfThenElseMultiple()
>action:1=SetUnitAnimation($gg_unit_n022_0203, "stand work")
>action:1=RemoveItemFromStockBJ("I020", $gg_unit_n022_0203)
>action:1=RemoveItemFromStockBJ("I021", $gg_unit_n022_0203)
>action:1=TriggerSleepAction("0.70")
>action:1=SetUnitAnimation($gg_unit_n022_0203, "stand")
>action:1=AddItemToStockBJ("I01Z", $gg_unit_n022_0203, "0", "1")
>action:1=AddItemToStockBJ("I020", $gg_unit_n022_0203, "0", "1")
>action:1=AddItemToStockBJ("I021", $gg_unit_n022_0203, "0", "1")
>action:1=CommentString("Действие")
>action:1=CreateNUnitsAtLoc("1", "n023", PlayerNP, GetUnitLoc($gg_unit_n022_0203), RealUnitFacing)
>action:1=UnitApplyTimedLifeBJ("2.00", TimedLifeBuffCodeGeneric, GetLastCreatedUnit())
>action:1=IssueTargetOrder(GetLastCreatedUnit(), UnitOrderChainLightning, GetBuyingUnit())
>action:1=ReturnAction()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I01Z")
action=CommentString("Ударить структуру")
action=IfThenElseMultiple()
>action:1=SetUnitAnimation($gg_unit_n022_0203, "stand work")
>action:1=RemoveItemFromStockBJ("I01Z", $gg_unit_n022_0203)
>action:1=RemoveItemFromStockBJ("I020", $gg_unit_n022_0203)
>action:1=TriggerSleepAction("0.70")
>action:1=TriggerExecute($gg_trg_Security1)
>action:1=TriggerSleepAction("1.00")
>action:1=SetUnitAnimation($gg_unit_n022_0203, "stand")
>action:1=TriggerSleepAction("4.00")
>action:1=AddItemToStockBJ("I01Z", $gg_unit_n022_0203, "0", "1")
>action:1=AddItemToStockBJ("I020", $gg_unit_n022_0203, "0", "1")
>action:1=AddItemToStockBJ("I021", $gg_unit_n022_0203, "0", "1")
>action:1=ReturnAction()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I021")
action=CommentString("Дотронуться до рисунков")
action=IfThenElseMultiple()
>action:1=DisableTrigger(GetTriggeringTrigger())
>action:1=EnableTrigger($gg_trg_Algorithm2)
>action:1=SetUnitAnimation($gg_unit_n022_0203, "stand work")
>action:1=RemoveItemFromStockBJ("I01Z", $gg_unit_n022_0203)
>action:1=RemoveItemFromStockBJ("I021", $gg_unit_n022_0203)
>action:1=TriggerSleepAction("0.70")
>action:1=SetUnitAnimation($gg_unit_n022_0203, "stand")
>action:1=AddItemToStockBJ("I022", $gg_unit_n022_0203, "1", "1")
>action:1=ReturnAction()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I020")
condition=OrMultiple()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I01Z")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I020")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I021")
event=TriggerRegisterPlayerUnitEventSimple(PlayerNP, PlayerUnitEventSellItem)
