[trigger]
name="Algorithm3"
description=""
initially_off=1
action=SetUnitAnimation($gg_unit_n022_0203, "stand work")
action=RemoveItemFromStockBJ("I023", $gg_unit_n022_0203)
action=TriggerSleepAction("0.70")
action=CommentString("Если комбинация правильная")
action=IfThenElseMultiple()
>action:1=DisableTrigger(GetTriggeringTrigger())
>action:2=ForLoopAMultiple("1", "3")
>>action:0=SetUnitAnimation($gg_unit_n022_0203, "stand")
>>action:0=SetUnitAnimation($Spatial_Cube[GetForLoopIndexA()], "stand")
>>action:0=SetUnitColor($Spatial_Cube[GetForLoopIndexA()], Color12)
>>action:0=RemoveItemFromStockBJ("I028", $Spatial_Cube[GetForLoopIndexA()])
>>action:0=AddItemToStockBJ("I027", $Spatial_Cube[GetForLoopIndexA()], "0", "1")
>>action:0=AddItemToStockBJ("I025", $Spatial_Cube[GetForLoopIndexA()], "0", "1")
>>action:0=AddItemToStockBJ("I026", $Spatial_Cube[GetForLoopIndexA()], "0", "1")
>>action:0=AddItemToStockBJ("I024", $Spatial_Cube[GetForLoopIndexA()], "0", "1")
>>action:0=SetVariable($Spatial_Cubes_Checking[GetForLoopIndexA()], "0")
>>action:0=AddItemToStockBJ("I023", $gg_unit_n022_0203, "0", "1")
>action:1=AddItemToStockBJ("I029", $gg_unit_n022_0203, "1", "1")
>action:1=UnitRemoveAbilityBJ("A00K", $gg_unit_n022_0203)
>action:1=ForLoopAMultiple("1", "3")
>>action:0=RemoveItemFromStockBJ("I028", $Spatial_Cube[GetForLoopIndexA()])
>>action:0=UnitRemoveAbilityBJ("A043", $Spatial_Cube[GetForLoopIndexA()])
>condition:0=OperatorCompareInteger($Spatial_Cubes_Checking["1"], OperatorEqual, "1")
>condition:0=OperatorCompareInteger($Spatial_Cubes_Checking["2"], OperatorEqual, "1")
>condition:0=OperatorCompareInteger($Spatial_Cubes_Checking["3"], OperatorEqual, "1")
condition=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I023")
event=TriggerRegisterPlayerUnitEventSimple(PlayerNP, PlayerUnitEventSellItem)
