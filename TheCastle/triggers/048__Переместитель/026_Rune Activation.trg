[trigger]
name="Rune Activation"
description=""
action=SetUnitAnimation(GetTriggerUnit(), "stand work")
action=RemoveItemFromStockBJ("I027", GetTriggerUnit())
action=RemoveItemFromStockBJ("I025", GetTriggerUnit())
action=RemoveItemFromStockBJ("I026", GetTriggerUnit())
action=RemoveItemFromStockBJ("I024", GetTriggerUnit())
action=AddItemToStockBJ("I028", GetTriggerUnit(), "0", "1")
condition=OrMultiple()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I027")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I025")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I026")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I024")
action=CommentString("Желтая руна")
action=IfThenElseMultiple()
>action:1=SetUnitColor(GetTriggerUnit(), Color04)
>action:1=ReturnAction()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I027")
action=CommentString("Зеленая руна")
action=IfThenElseMultiple()
>action:1=SetUnitColor(GetTriggerUnit(), Color06)
>action:1=IfThenElseMultiple()
>>action:1=SetVariable($Spatial_Cubes_Checking["3"], "1")
>>condition:0=OperatorCompareUnit(GetTriggerUnit(), OperatorEqualENE, $Spatial_Cube["3"])
>action:1=ReturnAction()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I025")
action=CommentString("Красная руна")
action=IfThenElseMultiple()
>action:1=SetUnitColor(GetTriggerUnit(), Color00)
>action:1=ReturnAction()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I026")
action=CommentString("Синяя руна")
action=IfThenElseMultiple()
>action:1=SetUnitColor(GetTriggerUnit(), Color01)
>action:1=IfThenElseMultiple()
>>action:1=SetVariable($Spatial_Cubes_Checking["1"], "1")
>>condition:0=OperatorCompareUnit(GetTriggerUnit(), OperatorEqualENE, $Spatial_Cube["1"])
>action:1=IfThenElseMultiple()
>>action:1=SetVariable($Spatial_Cubes_Checking["2"], "1")
>>condition:0=OperatorCompareUnit(GetTriggerUnit(), OperatorEqualENE, $Spatial_Cube["2"])
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetSoldItem()), OperatorEqualENE, "I024")
event=TriggerRegisterPlayerUnitEventSimple(PlayerNP, PlayerUnitEventSellItem)
