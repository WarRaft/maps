[trigger]
name="Init Boss2"
description=""
initially_off=1
action=CommentString("Для робота")
action=SetUnitAnimation($UNIT_Robot, "stand ready")
action=SetUnitTimeScalePercent($UNIT_Robot, "0.00")
action=CommentString("Массив силовых полей")
action=SetVariable($Force_field["1"], $gg_dest_XTmx_1346)
action=SetVariable($Force_field["2"], $gg_dest_XTmx_1344)
action=SetVariable($Force_field["3"], $gg_dest_XTmx_1345)
action=SetVariable($Force_field["4"], $gg_dest_XTmx_0657)
action=SetVariable($Force_field["5"], $gg_dest_XTmx_0662)
action=SetVariable($Force_field["6"], $gg_dest_XTmx_0839)
action=SetVariable($Force_field["7"], $gg_dest_XTmx_0840)
action=SetVariable($Force_field["8"], $gg_dest_XTmx_2298)
action=SetVariable($Force_field["9"], $gg_dest_XTmx_2297)
action=SetVariable($Force_field["10"], $gg_dest_XTmx_2296)
action=SetVariable($Force_field["11"], $gg_dest_XTmx_2295)
action=SetVariable($Force_field["12"], $gg_dest_XTmx_2294)
action=SetVariable($Force_field["13"], $gg_dest_XTmx_2293)
action=CommentString("Массив генераторов силового поля")
action=SetVariable($Force_Generator["1"], $gg_unit_h005_0179)
action=SetVariable($Force_Generator["2"], $gg_unit_h005_0277)
action=SetVariable($Force_Generator["3"], $gg_unit_h005_0283)
action=AddTriggerEvent($gg_trg_Force_Generator, event:TriggerRegisterUnitEvent($Force_Generator["1"], UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Force_Generator, event:TriggerRegisterUnitEvent($Force_Generator["2"], UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Force_Generator, event:TriggerRegisterUnitEvent($Force_Generator["3"], UnitEventDeath) ~"")
action=CommentString("Массив генераторов Боевой машины")
action=SetVariable($Robot_Generator["1"], $gg_unit_h004_0282)
action=SetVariable($Robot_Generator["2"], $gg_unit_h004_0361)
action=SetVariable($Robot_Generator["3"], $gg_unit_h004_0281)
action=SetVariable($Robot_Generator["4"], $gg_unit_h004_0280)
action=AddTriggerEvent($gg_trg_Robot_Generator, event:TriggerRegisterUnitEvent($Robot_Generator["1"], UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Robot_Generator, event:TriggerRegisterUnitEvent($Robot_Generator["2"], UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Robot_Generator, event:TriggerRegisterUnitEvent($Robot_Generator["3"], UnitEventDeath) ~"")
action=AddTriggerEvent($gg_trg_Robot_Generator, event:TriggerRegisterUnitEvent($Robot_Generator["4"], UnitEventDeath) ~"")
action=CommentString("---")
action=SetUnitAnimation($gg_unit_h000_0031, "stand work")
action=SetUnitAnimation($gg_unit_h000_0027, "stand work")
action=ChangeElevatorHeight($gg_dest_DTrx_2378, "3")
action=ChangeElevatorWalls(ElevatorWallOpClose, ElevatorWallTypeAll, $gg_dest_DTrx_2378)
action=EnumDestructablesInRectAllMultiple($gg_rct_REG_Boss2_Elevator)
>action:0=IfThenElseMultiple()
>>condition:0=OperatorCompareDestructableCode(GetDestructableTypeId(GetEnumDestructable()), OperatorNotEqualENE, "DTrx")
>>action:1=ShowDestructableBJ(ShowHideHide, GetEnumDestructable())
action=ForLoopAMultiple("1", "13")
>action:0=SetDestructableAnimationBJ($Force_field[GetForLoopIndexA()], "stand")
>action:0=SetDestructableInvulnerableBJ($Force_field[GetForLoopIndexA()], InvulnerabilityInvulnerable)
