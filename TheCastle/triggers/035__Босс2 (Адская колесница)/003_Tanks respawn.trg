[trigger]
name="Tanks respawn"
description=""
initially_off=1
action=CustomScriptCode("local unit tank_unit1")
action=CustomScriptCode("local unit tank_unit2")
action=CustomScriptCode("local location point1 = GetRectCenter(gg_rct_REG_Factory1)")
action=CustomScriptCode("local location point2 = GetRectCenter(gg_rct_REG_Factory2)")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set tank_unit1 = TeoCreateUnit( Player(11), 'h001', GetLocationX(point1),GetLocationY(point1), 315.00 )")
>action:1=CustomScriptCode("call GroupAddUnitSimple( tank_unit1, udg_Tanks_Group )")
>action:1=CustomScriptCode("call RemoveLocation(point1)")
>action:1=CustomScriptCode("set point1 = null")
>action:1=CustomScriptCode("set tank_unit1 = null")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($gg_unit_h000_0031), OperatorEqualENE, "true")
>condition:0=OperatorCompareInteger(CountUnitsInGroup($Tanks_Group), OperatorLess, "6")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set tank_unit2 = TeoCreateUnit( Player(11), 'h001', GetLocationX(point2),GetLocationY(point2), 45.00 )")
>action:1=CustomScriptCode("call GroupAddUnitSimple( tank_unit2, udg_Tanks_Group )")
>action:1=CustomScriptCode("call RemoveLocation(point2)")
>action:1=CustomScriptCode("set point2 = null")
>action:1=CustomScriptCode("set tank_unit2 = null")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($gg_unit_h000_0027), OperatorEqualENE, "true")
>condition:0=OperatorCompareInteger(CountUnitsInGroup($Tanks_Group), OperatorLess, "6")
action=ForGroupMultiple($Tanks_Group)
>action:0=CustomScriptCode("local unit temp_unit = GetEnumUnit()")
>action:0=CustomScriptCode("local location point = GetRandomLocInRect(gg_rct_REG_Tanks)")
>action:0=CustomScriptCode("call IssuePointOrderLocBJ( temp_unit, \"attack\", point )")
>action:0=CustomScriptCode("call RemoveLocation(point)")
>action:0=CustomScriptCode("set point = null")
>action:0=CustomScriptCode("set temp_unit = null")
event=TriggerRegisterTimerEventPeriodic("14.00")
