[trigger]
name="Robot Generator"
description=""
action=CustomScriptCode("local unit dummy_unit")
action=DisableTrigger(GetTriggeringTrigger())
action=IfThenElseMultiple()
>action:1=SetVariable($TempGenerator["1"], $Robot_Generator["1"])
>action:1=SetVariable($TempGenerator["2"], $Robot_Generator["2"])
>action:1=SetVariable($TempGenerator["3"], $Robot_Generator["3"])
>action:1=SetVariable($TempGenerator["4"], $Robot_Generator["4"])
>action:2=IfThenElseMultiple()
>>action:1=SetVariable($TempGenerator["1"], $Robot_Generator["2"])
>>action:1=SetVariable($TempGenerator["2"], $Robot_Generator["3"])
>>action:1=SetVariable($TempGenerator["3"], $Robot_Generator["4"])
>>action:1=SetVariable($TempGenerator["4"], $Robot_Generator["1"])
>>action:2=IfThenElseMultiple()
>>>action:1=SetVariable($TempGenerator["1"], $Robot_Generator["3"])
>>>action:1=SetVariable($TempGenerator["2"], $Robot_Generator["4"])
>>>action:1=SetVariable($TempGenerator["3"], $Robot_Generator["1"])
>>>action:1=SetVariable($TempGenerator["4"], $Robot_Generator["2"])
>>>action:2=IfThenElseMultiple()
>>>>action:1=SetVariable($TempGenerator["1"], $Robot_Generator["4"])
>>>>action:1=SetVariable($TempGenerator["2"], $Robot_Generator["1"])
>>>>action:1=SetVariable($TempGenerator["3"], $Robot_Generator["2"])
>>>>action:1=SetVariable($TempGenerator["4"], $Robot_Generator["3"])
>>>>condition:0=OperatorCompareUnit(GetDyingUnit(), OperatorEqualENE, $Robot_Generator["4"])
>>>condition:0=OperatorCompareUnit(GetDyingUnit(), OperatorEqualENE, $Robot_Generator["3"])
>>condition:0=OperatorCompareUnit(GetDyingUnit(), OperatorEqualENE, $Robot_Generator["2"])
>condition:0=OperatorCompareUnit(GetDyingUnit(), OperatorEqualENE, $Robot_Generator["1"])
action=CustomScriptCode("set dummy_unit = TeoCreateDummyUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'n00X', GetUnitX(udg_TempGenerator[1]), GetUnitY(udg_TempGenerator[1]), 'A02X' )")
action=CustomScriptCode("call IssueTargetOrder( dummy_unit, \"fingerofdeath\", udg_TempGenerator[2] )")
action=TriggerSleepAction("0.05")
action=IssueTargetOrder($TempGenerator["2"], UnitOrderFingerOfDeath, $TempGenerator["3"])
action=TriggerSleepAction("0.05")
action=KillUnit($TempGenerator["2"])
action=IssueTargetOrder($TempGenerator["3"], UnitOrderFingerOfDeath, $TempGenerator["4"])
action=TriggerSleepAction("0.05")
action=KillUnit($TempGenerator["3"])
action=TriggerSleepAction("0.05")
action=KillUnit($TempGenerator["4"])
action=KillUnit($UNIT_Robot)
action=TriggerExecute($gg_trg_Boss2_Elevator)
