[trigger]
name="Reload robot"
description=""
action=CustomScriptCode("local texttag msg")
action=CustomScriptCode("local string text")
action=DisableTrigger(GetTriggeringTrigger())
action=CommentString("Останавливаем боевую машину")
action=SetUnitMoveSpeed($UNIT_Robot, "0.00")
action=SetUnitTurnSpeedBJ($UNIT_Robot, "0.00")
action=SetVariable($Robot_Repair_Bool, "true")
action=CommentString("Создаём предупреждение")
action=TriggerSleepAction("0.10")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set text = \"Т Р Е Б У Е Т С Я   Р Е М О Н Т\"")
>action:1=CustomScriptCode("set msg = CreateTextTagUnitBJ( text, udg_UNIT_Robot, 0, 10, 100, 0.00, 0.00, 0 )")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Robot), OperatorEqualENE, "true")
action=TriggerSleepAction("0.05")
action=CustomScriptCode("set text = \" \"")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=TriggerSleepAction("0.05")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set text = \"Т Р Е Б У Е Т С Я   Р Е М О Н Т\"")
>action:1=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Robot), OperatorEqualENE, "true")
action=TriggerSleepAction("0.05")
action=CustomScriptCode("set text = \" \"")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=TriggerSleepAction("0.05")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set text = \"Т Р Е Б У Е Т С Я   Р Е М О Н Т\"")
>action:1=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Robot), OperatorEqualENE, "true")
action=TriggerSleepAction("0.05")
action=CustomScriptCode("set text = \" \"")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=TriggerSleepAction("0.05")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set text = \"Т Р Е Б У Е Т С Я   Р Е М О Н Т\"")
>action:1=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Robot), OperatorEqualENE, "true")
action=TriggerSleepAction("0.05")
action=CustomScriptCode("set text = \" \"")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=TriggerSleepAction("0.05")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set text = \"Т Р Е Б У Е Т С Я   Р Е М О Н Т\"")
>action:1=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Robot), OperatorEqualENE, "true")
action=TriggerSleepAction("0.05")
action=CustomScriptCode("set text = \" \"")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=TriggerSleepAction("0.05")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set text = \"Т Р Е Б У Е Т С Я   Р Е М О Н Т\"")
>action:1=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Robot), OperatorEqualENE, "true")
action=TriggerSleepAction("0.05")
action=CustomScriptCode("set text = \" \"")
action=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
action=TriggerSleepAction("0.05")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set text = \"Т Р Е Б У Е Т С Я   Р Е М О Н Т\"")
>action:1=CustomScriptCode("call SetTextTagTextBJ(msg, text, 10 )")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Robot), OperatorEqualENE, "true")
action=TriggerSleepAction("0.05")
action=CustomScriptCode("call DestroyTextTagBJ( msg )")
action=IfThenElseMultiple()
>action:1=SetUnitMoveSpeed($UNIT_Robot, "270.00")
>action:1=SetUnitTurnSpeedBJ($UNIT_Robot, "0.50")
>action:1=UnitAddAbilityBJ("A02H", $UNIT_Robot)
>action:1=StartTimerBJ($Repair_Timer, PeriodicOptionOneTime, "0.50")
>action:1=IfThenElseMultiple()
>>action:1=IssueTargetOrder($UNIT_Robot, UnitOrderUnload, $UNIT_Robot_Mechanic)
>>condition:0=OperatorCompareBoolean($Robot_Activation_Bool, OperatorEqualENE, "true")
>condition:0=OperatorCompareBoolean(IsUnitAliveBJ($UNIT_Robot), OperatorEqualENE, "true")
action=EnableTrigger(GetTriggeringTrigger())
condition=OperatorCompareReal(GetUnitStateSwap(UnitStateLife, GetTriggerUnit()), OperatorLessEq, "1500.00")
