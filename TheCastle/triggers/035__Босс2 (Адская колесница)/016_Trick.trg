[trigger]
name="Trick"
description=""
action=CustomScriptCode("local real angle = GetUnitFacing(udg_UNIT_Robot)")
action=CustomScriptCode("local real x = GetUnitX(udg_UNIT_Robot)")
action=CustomScriptCode("local real y = GetUnitY(udg_UNIT_Robot)")
action=CustomScriptCode("local real dx  = x")
action=CustomScriptCode("local real dy = y")
action=CommentString("Перемещение")
action=CustomScriptCode("set dx = x + 200 * Cos(angle * 0.0174) ")
action=CustomScriptCode("set dy = y + 200 * Sin(angle * 0.0174) ")
action=CommentString("Выбираем группу юнитов")
action=CustomScriptCode("call GroupEnumUnitsInRange (udg_TempGroup, dx, dy, 250, null) ")
action=ForGroupMultiple($TempGroup)
>action:0=CustomScriptCode("local player dummy_player = Player(PLAYER_NEUTRAL_PASSIVE)")
>action:0=CustomScriptCode("local unit dummy_unit")
>action:0=IfThenElseMultiple()
>>action:1=UnitDamageTargetBJ($UNIT_Robot, GetEnumUnit(), "1000.00", AttackTypeNormal, DamageTypeNormal)
>>condition:0=OperatorComparePlayer(GetOwningPlayer(GetEnumUnit()), OperatorNotEqualENE, Player00)
>>condition:0=OperatorComparePlayer(GetOwningPlayer(GetEnumUnit()), OperatorNotEqualENE, Player01)
>>condition:0=OperatorComparePlayer(GetOwningPlayer(GetEnumUnit()), OperatorNotEqualENE, Player02)
>>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetEnumUnit()), OperatorNotEqualENE, "nmgv")
>>condition:0=OperatorCompareUnit(GetEnumUnit(), OperatorNotEqualENE, $UNIT_Boss2)
>>condition:0=OperatorCompareBoolean(IsUnitAliveBJ(GetEnumUnit()), OperatorEqualENE, "true")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A00I")
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventSpellEffect)
