[trigger]
name="Timer Mechanic"
description="Game_Stage - отвечает за область воскрешения героев, если воскрешение происходит не около Камня воскрешения\r\n0 - воскрешение в стартовой области\r\n1- воскрешение в конечной области\r\n2- воскрешение в альтернативной области"
action=CommentString("Если ни один из камней Воскрешения не активирован")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:1=ReviveHeroLoc($Hero_mechanic, GetRectCenter($gg_rct_REG_Resurrection_1), ShowHideShow)
>>action:2=IfThenElseMultiple()
>>>action:2=CommentString("Альтернативный Босс")
>>>action:2=ReviveHeroLoc($Hero_mechanic, GetRectCenter($gg_rct_REG_Resurrection_3), ShowHideShow)
>>>action:2=CommentString("Добавляем навыки для трансформы")
>>>action:2=IfThenElseMultiple()
>>>>action:2=IfThenElseMultiple()
>>>>>action:2=IfThenElseMultiple()
>>>>>>action:1=UnitAddAbilityBJ("A01P", $Hero_mechanic)
>>>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A01S", $Hero_mechanic), OperatorEqual, "3")
>>>>>action:1=UnitAddAbilityBJ("A01R", $Hero_mechanic)
>>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A01S", $Hero_mechanic), OperatorEqual, "2")
>>>>action:1=UnitAddAbilityBJ("A01Q", $Hero_mechanic)
>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A01S", $Hero_mechanic), OperatorEqual, "1")
>>>action:2=IfThenElseMultiple()
>>>>action:2=IfThenElseMultiple()
>>>>>action:2=IfThenElseMultiple()
>>>>>>action:1=UnitAddAbilityBJ("A01O", $Hero_mechanic)
>>>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A01I", $Hero_mechanic), OperatorEqual, "3")
>>>>>action:1=UnitAddAbilityBJ("A01M", $Hero_mechanic)
>>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A01I", $Hero_mechanic), OperatorEqual, "2")
>>>>action:1=UnitAddAbilityBJ("A01N", $Hero_mechanic)
>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A01I", $Hero_mechanic), OperatorEqual, "1")
>>>action:2=UnitAddAbilityBJ("A01Z", $Hero_mechanic)
>>>action:1=ReviveHeroLoc($Hero_mechanic, GetRectCenter($gg_rct_REG_Resurrection_2), ShowHideShow)
>>>condition:0=OperatorCompareInteger($Game_Stage, OperatorEqual, "1")
>>condition:0=OperatorCompareInteger($Game_Stage, OperatorEqual, "0")
>action:2=ForLoopAMultiple("1", $ResurrectionStones_num)
>>action:0=IfThenElseMultiple()
>>>action:1=ReviveHeroLoc($Hero_mechanic, GetUnitLoc($ResurrectionCircle[GetForLoopIndexA()]), ShowHideShow)
>>>condition:0=OperatorCompareBoolean($ResurrectionsStones_condition[GetForLoopIndexA()], OperatorEqualENE, "true")
>condition:0=OperatorCompareBoolean($ResurrectionsStones_condition["0"], OperatorEqualENE, "false")
action=CommentString("Если никто из героев не выделен, то выбираем воскресшего героя")
action=IfThenElseMultiple()
>action:1=SelectUnitForPlayerSingle($Hero_mechanic, GetOwningPlayer($Hero_mechanic))
>action:1=IfThenElseMultiple()
>>action:1=PanCameraToTimedLocForPlayer(GetOwningPlayer($Hero_mechanic), GetUnitLoc($Hero_mechanic), "0")
>>condition:0=OperatorCompareBoolean($FREECAM[GetConvertedPlayerId(GetOwningPlayer($Hero_mechanic))], OperatorEqualENE, "true")
>condition:0=OperatorCompareBoolean(IsUnitGroupEmptyBJ(GetUnitsSelectedAll(GetOwningPlayer($Hero_mechanic))), OperatorEqualENE, "true")
event=TriggerRegisterTimerExpireEventBJ($Hero_Timer["1"])
