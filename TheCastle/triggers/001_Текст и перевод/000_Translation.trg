[trigger]
name="Translation"
description=""
run_on_init=1
action=CommentString("Текст орка-воина")
action=SetVariable($RU_Warrior["1"], "Вот, мы и добрались.")
action=SetVariable($EN_Warrior["1"], "Here we are, we have arrived.")
action=SetVariable($RU_Warrior["2"], "Я чувствую сильную слабость.")
action=SetVariable($EN_Warrior["2"], "I feel a strong weakness.")
action=SetVariable($RU_Warrior["3"], "Это ещё что такое?")
action=SetVariable($EN_Warrior["3"], "What is this?")
action=SetVariable($RU_Warrior["4"], "Я сотру их в порошок!")
action=SetVariable($EN_Warrior["4"], "I'll grind them to powder!")
action=SetVariable($RU_Warrior["5"], "Что означают эти рисунки?")
action=SetVariable($EN_Warrior["5"], "What do these drawings mean?")
action=SetVariable($RU_Warrior["6"], "Проклятье! Куда она исчезла?")
action=SetVariable($EN_Warrior["6"], "Damn it! Where did it disappear?")
action=SetVariable($RU_Warrior["7"], "Похоже, что каждой руне соответствует своя кнопка.")
action=SetVariable($EN_Warrior["7"], "It is like that each rune matches its button.")
action=SetVariable($RU_Warrior["8"], "Этот Пожиратель Мёртвых постепенно умирает сам от своего же зловония. Но что-то поддерживает в нем жизнь.")
action=SetVariable($EN_Warrior["8"], "The devourer of the dead. He is gradually dying from his stench. But something is keeping it alive. ")
action=SetVariable($RU_Warrior["9"], "Какое потрясающее пламя! Этот Рыцарь Тьмы знает толк в интерьерах.")
action=SetVariable($EN_Warrior["9"], "What an amazing flame! This death knight knows a lot about interiors.")
action=SetVariable($RU_Warrior["10"], "Это сумка что ли?")
action=SetVariable($EN_Warrior["10"], " ")
action=CommentString("Текст гоблина-механика")
action=SetVariable($RU_Mechanic["1"], "В этом Замке нас ждут трудные испытания. Нам нужно держаться вместе, чтобы преодолеть их все.")
action=SetVariable($EN_Mechanic["1"], "Difficult challenges are waiting for us in the castle. We need to keep together to overcome them all.")
action=SetVariable($RU_Mechanic["2"], "Подожди, Акнеладу! Опять ты со своими легендами. Лучше посмотри внимательнее на эти обелиски!")
action=SetVariable($EN_Mechanic["2"], "Wait, Akneladu! Here you go with your legends again. Better look at these obelisks more attentively!")
action=SetVariable($RU_Mechanic["3"], "Я чувствую сильную слабость.")
action=SetVariable($EN_Mechanic["3"], "I feel a strong weakness.")
action=SetVariable($RU_Mechanic["4"], "Похоже, что каждой руне соответствует своя кнопка.")
action=SetVariable($EN_Mechanic["4"], "It is like that each rune matches its button.")
action=SetVariable($RU_Mechanic["5"], "Oни сдeлaны из арканита! Похоже, что они каким-то образом сдерживают его невероятную силу. Нужно попробовать активировать их.")
action=SetVariable($EN_Mechanic["5"], "They are made of arcane! It's like they are somehow restaining his incredible force! We need to try to activate them.")
action=SetVariable($RU_Mechanic["6"], "Этот Пожиратель Мёртвых постепенно умирает сам от своего же зловония. Но что-то поддерживает в нем жизнь.")
action=SetVariable($EN_Mechanic["6"], "The devourer of the dead. He is gradually dying from his stench. But something is keeping it alive. ")
action=SetVariable($RU_Mechanic["7"], "Какое потрясающее пламя! Этот Рыцарь Тьмы знает толк в интерьерах.")
action=SetVariable($EN_Mechanic["7"], "What an amazing flame! This death knight knows a lot about interiors.")
action=SetVariable($RU_Mechanic["8"], "Похоже, что синие генераторы обеспечивают работу подъемника. Но прежде, чем их уничтожить, необходимо остановить заводы.")
action=SetVariable($EN_Mechanic["8"], "It's like the blue generators are powering the lift operation. We need to shut down the factories before we destroy them.")
action=SetVariable($RU_Mechanic["9"], "Погоди, Нитнарак! Не всё так просто. Танков слишком много.")
action=SetVariable($EN_Mechanic["9"], "Wait, Nitnarak! It's not that simple. There are too many tanks.")
action=SetVariable($RU_Mechanic["10"], "Cмoтpитe, этa бoeвaя мaшинa oтключeнa. Я мoг бы eй вocпoльзoвaтьcя! Нyжнo тoлькo дeaктивиpoвaть силовое поле, чтобы я смог подобраться поближе.")
action=SetVariable($EN_Mechanic["10"], "Look it, this is a combat vehicle disabled. I could use it! I need to deactivate a power field, so that i can get closer.")
action=SetVariable($RU_Mechanic["11"], "Эти красные генераторы как раз должны отвечать за работу силового поля. Поэтому давайте разрушим их в первую очередь.")
action=SetVariable($EN_Mechanic["11"], "These red generators must be just responsible for the operation of the power field. So let's destroy them first.")
action=SetVariable($RU_Mechanic["12"], "Оказывается, синие генераторы связаны не только с подъёмником, но и с этой машиной. Они не дают ей разрушиться.")
action=SetVariable($EN_Mechanic["12"], "It turns out, the blue generators are not just connected to lift, but with this machine. They are not letting it destroy.")
action=SetVariable($RU_Mechanic["13"], "А зaвoды кaким-тo oбpaзoм дaют энepгию для этиx гeнepaтopoв. Пoэтoмy нyжнo yничтoжить кaк мoжнo бoльшe тaнкoв, пpeждe чeм пocлeдний зaвoд бyдeт рaзpyшeн.")
action=SetVariable($EN_Mechanic["13"], "And factories are somehow powering for these generators. Therefore it's necessary to destroy as many tanks as possible, before the final factory is destroyed.")
action=SetVariable($RU_Mechanic["14"], "Это же легендарный Тессеракт! Древний магический артефакт, способный уменьшать предметы внутри себя до мельчайших частиц.")
action=SetVariable($EN_Mechanic["14"], " ")
action=SetVariable($RU_Mechanic["15"], "При этом сам Тессеракт и предметы внутри него не имеют массы.")
action=SetVariable($EN_Mechanic["15"], " ")
action=SetVariable($RU_Mechanic["16"], "Тессеракт может вместить в себя до шести предметов. Маги часто использовали его в своих опытах.")
action=SetVariable($EN_Mechanic["16"], " ")
action=SetVariable($RU_Mechanic["17"], "Ну, можно и так сказать.")
action=SetVariable($EN_Mechanic["17"], " ")
action=SetVariable($RU_Mechanic["18"], "Похоже, что когда мы встаём вместе на руны, то на небольшой промежуток времени появляется эта книга.")
action=SetVariable($EN_Mechanic["18"], "It's like that when we step on runes together, this book shows up for a short period of time.")
action=SetVariable($RU_Mechanic["19"], "Уверен, что нам нужна эта информация. Но для чего?")
action=SetVariable($EN_Mechanic["19"], "I'm sure that we need this information, but for what?")
action=SetVariable($RU_Mechanic["20"], "Переместитель! Не думал, что когда-нибудь увижу его. Он может перенести нас в другое место, если мы сможем настроить его!")
action=SetVariable($EN_Mechanic["20"], " ")
action=CommentString("Текст тролля-шамана")
action=SetVariable($RU_Shaman["1"], "Мы - надежда наших народов. Наши навыки и умения помогут нам справиться с любой опасностью. Вперёд, друзья!")
action=SetVariable($EN_Shaman["1"], "We are the hope of our people! Our skills will help us to cope with any danger! Forward, friends!")
action=SetVariable($RU_Shaman["2"], "Это же Демон Огня Суртур! Его мощь безгранична. Ходит легенда, что победить его невозможно.")
action=SetVariable($EN_Shaman["2"], "This is Surtur a fire demon his power is limitless! According to legend it is impossible to defeat him!")
action=SetVariable($RU_Shaman["3"], "Смотрите! Какая-то книга!")
action=SetVariable($EN_Shaman["3"], "Look it! What kind of book is this?!")
action=SetVariable($RU_Shaman["4"], "Я мог бы попробовать перескочить через этих скелетов.")
action=SetVariable($EN_Shaman["4"], "I can try to jump over these skeletons.")
action=SetVariable($RU_Shaman["5"], "Я чувствую сильную слабость. Должно быть, это оберег. Маги, которые обитали здесь раньше, использовали их для защиты Зaмкa, ocлaбляя врагов.")
action=SetVariable($EN_Shaman["5"], "I feel a strong weakness. It must be amulet. The mages who lived here they were using the amulet in order to defend the castle, weakening enemies.")
action=SetVariable($RU_Shaman["6"], "Должно быть, это оберег. Маги, которые обитали здесь раньше, использовали их для защиты Замка, ослабляя врагов.")
action=SetVariable($EN_Shaman["6"], "It must be amulet. The mages who lived here they were using the amulet in order to defend the castle, weakening enemies.")
action=SetVariable($RU_Shaman["7"], "Нужно найти и уничтожить его или смириться  с этой ужасной слабостью.")
action=SetVariable($EN_Shaman["7"], "We need to find and destroy it or we can just accept this terrible weakness.")
action=SetVariable($RU_Shaman["8"], "Похоже, что каждой руне соответствует своя кнопка.")
action=SetVariable($EN_Shaman["8"], "It is like that each rune matches its button.")
action=SetVariable($RU_Shaman["9"], "Этот Пожиратель Мёртвых постепенно умирает сам от своего же зловония. Но что-то поддерживает в нем жизнь.")
action=SetVariable($EN_Shaman["9"], "The devourer of the dead. He is gradually dying from his stench. But something is keeping it alive. ")
action=SetVariable($RU_Shaman["10"], "Кровавые кристаллы... Похоже, что тьма действительно поглощает этот Замок.")
action=SetVariable($EN_Shaman["10"], "The blood crystals... It's like that darkness indeed absorbs this Castle.")
action=SetVariable($RU_Shaman["11"], "Какое потрясающее пламя! Этот Рыцарь Тьмы знает толк в интерьерах.")
action=SetVariable($EN_Shaman["11"], "What an amazing flame! This death knight knows a lot about interiors.")
action=SetVariable($RU_Shaman["12"], "Эти тени словно растворились. Но что же их уничтожило?")
action=SetVariable($EN_Shaman["12"], "These shadows look like upset. But what were they eliminated? ")
action=SetVariable($RU_Shaman["13"], "Значит, нам придётся уничтожить эту штуковину, чтобы пройти дальше. Но как нам до неё добраться?")
action=SetVariable($EN_Shaman["13"], "It means, we have to destroy this thing to pass further. But how can we get to it?")
action=CommentString("Текст подсказок")
action=SetVariable($RU_Hint["1"], "|cff32cd32ПОДСКАЗКА:|r Обыщите лагерь разбойников!")
action=SetVariable($EN_Hint["1"], "|cff32cd32HINT:|r Search the camp of the robbers!")
action=SetVariable($RU_Hint["2"], "|cff32cd32ПОДСКАЗКА:|r Используйте умение Гоблина-механика |cffF2D800\"Энергетический щит\"|r, чтобы увеличить защиту Героев.")
action=SetVariable($EN_Hint["2"], "|cff32cd32HINT:|r Use Goblin Mechanic skill |cffF2D800\"Energy shield\"|r, to enhance the defense of the heroes.")
action=SetVariable($RU_Hint["3"], "|cff32cd32ПОДСКАЗКА:|r Используйте умение Тролля-шамана |cffF2D800\"Массовое лечение\"|r, чтобы после боя восстановить здоровье Героев.")
action=SetVariable($EN_Hint["3"], "|cff32cd32HINT:|r Use the Shaman Troll skill |cffF2D800\"Mass Treatment\"|r, to restore the health of the heroes after the fight.")
action=SetVariable($RU_Hint["4"], "|cff32cd32ПОДСКАЗКА:|r Используйте умение Гоблина-механика |cffF2D800\"Книга чертежей\"|r, чтобы произвести взрывчатку.")
action=SetVariable($EN_Hint["4"], "|cff32cd32HINT:|r Use Goblin Mechanic skill |cffF2D800\"The Book of Drawings\"|r, to make explosives.")
action=SetVariable($RU_Hint["5"], "|cff32cd32ПОДСКАЗКА:|r Используйте взрывчатку, чтобы уничтожить ворота.")
action=SetVariable($EN_Hint["5"], "|cff32cd32HINT:|r Use explosives to eliminate the gate.")
action=SetVariable($RU_Hint["6"], "|cff32cd32ПОДСКАЗКА:|r Найдите Дневник ученика около фонтана!")
action=SetVariable($EN_Hint["6"], "|cff32cd32HINT:|r Find the apprentice's diary near the fountain!")
action=SetVariable($RU_Hint["7"], "|cff32cd32ПОДСКАЗКА:|r Изyчитe дoпoлнитeльныe нaвыки чepeз |cffF2D800\"Cпocoбнocти\"|r. Изyчeнныe нaвыки бyдyт oтoбpaжaтьcя в видe икoнoк в cтaтyce Героя.")
action=SetVariable($EN_Hint["7"], "|cff32cd32HINT:|r Learn the extra skills through |cffF2D800\"Skills\"|r. Skills will be reflected in the form of icons in the hero status.")
action=SetVariable($RU_Hint["8"], "|cff32cd32ПОДСКАЗКА:|r Koгдa Гepoй yмиpaeт, тo pacxoдyeтcя oднo |cffF2D800Bocкpeшeниe|r. Игpa бyдeт oкoнчeнa, ecли пpи cмepти Гepoя нe бyдeт ни oднoгo |cffF2D800Воскрешения|r.")
action=SetVariable($EN_Hint["8"], "|cff32cd32HINT:|r When hero dies you will lose one |cffF2D800Resurrection|r. The game will be over, if at the death of the hero there will not be a single |cffF2D800Resurrection|r.")
action=SetVariable($RU_Hint["9"], "|cff32cd32ПОДСКАЗКА:|r Изучен новый чертёж.")
action=SetVariable($EN_Hint["9"], " ")
action=SetVariable($RU_Hint["10"], "|cff32cd32ПОДСКАЗКА:|r Камень Воскрешения позволяет воскрешать убитых Героев. Необходимо  |cffF2D800активировать|r.")
action=SetVariable($EN_Hint["10"], "|cff32cd32HINT:|r The resurrection stone lets resurrect the killed heroes. It's necessary |cffF2D800activate|r.")
action=SetVariable($RU_Hint["11"], "|cff32cd32ПОДСКАЗКА:|r Нужен ключ, чтобы открыть эти ворота.")
action=SetVariable($EN_Hint["11"], "  ")
action=SetVariable($RU_Hint["12"], "|cff32cd32ПОДСКАЗКА:|r Эти ворота заперты каким-то механизмом!")
action=SetVariable($EN_Hint["12"], "  ")
action=SetVariable($RU_Hint["13"], "|cff32cd32ПОДСКАЗКА:|r Эти ворота совсем прогнили!")
action=SetVariable($EN_Hint["13"], "  ")
action=SetVariable($RU_Hint["14"], "|cff32cd32ПОДСКАЗКА:|r Главные ворота Замка надёжно закрыты!")
action=SetVariable($EN_Hint["14"], "  ")
action=SetVariable($RU_Hint["15"], "|cff32cd32ПОДСКАЗКА:|r Используйте умение Гоблина-механика |cffF2D800\"Использовать механизм\"|r, чтобы переключить рычаг.")
action=SetVariable($EN_Hint["15"], "  ")
action=SetVariable($RU_Hint["16"], "|cff32cd32ПОДСКАЗКА:|r Найден торговец.")
action=SetVariable($EN_Hint["16"], "  ")
action=SetVariable($RU_Hint["17"], "|cff32cd32ПОДСКАЗКА:|r Силовое поле отключено.")
action=SetVariable($EN_Hint["17"], "  ")
action=SetVariable($RU_Hint["18"], "|cff32cd32ПОДСКАЗКА:|r Способности Героев изменились.")
action=SetVariable($EN_Hint["18"], "  ")
action=CommentString("Текст различных сообщений")
action=SetVariable($RU_Msg["1"], "|cffffcc00В инвентаре нет необходимого предмета|r")
action=SetVariable($EN_Msg["1"], " ")
action=SetVariable($RU_Msg["2"], "|cffffcc00Недостаточно материалов|r")
action=SetVariable($EN_Msg["2"], " ")
action=SetVariable($RU_Msg["3"], "|cffffcc00Невозможно изучить|r")
action=SetVariable($EN_Msg["3"], " ")
action=CommentString("Текст для команд чата")
action=SetVariable($RU_Cheat["1"], "|cffff0000Свободная камера включена|r")
action=SetVariable($EN_Cheat["1"], " ")
action=SetVariable($RU_Cheat["2"], "|cffff0000Свободная камера отключена|r")
action=SetVariable($EN_Cheat["2"], " ")
action=SetVariable($RU_Cheat["3"], "Репутация")
action=SetVariable($EN_Cheat["3"], "Reputation")
action=SetVariable($RU_Cheat["4"], "|cff32cd32Репутация изменена на положительную|r")
action=SetVariable($EN_Cheat["4"], " ")
action=SetVariable($RU_Cheat["5"], "|cffff0000Репутация изменена на отрицательную|r")
action=SetVariable($EN_Cheat["5"], " ")
action=CommentString("Текст заданий")
action=SetVariable($RU_Quest["1"], "Начало испытаний")
action=SetVariable($EN_Quest["1"], "The beginning")
action=SetVariable($RU_Quest["2"], "Блуждающие во тьме")
action=SetVariable($EN_Quest["2"], "Wandering in the dark")
action=SetVariable($RU_Quest["3"], "Исследование")
action=SetVariable($EN_Quest["3"], "Research")
action=SetVariable($RU_Req["1"], "Для начала необходимо открыть ворота Замка, чтобы начать приключение.")
action=SetVariable($EN_Req["1"], "At first you need to open the gate of the сastle to start adventure.")
action=SetVariable($RU_Req["2"], "Необходимо найти источник тьмы и уничтожить его.")
action=SetVariable($EN_Req["2"], "It's necessary to find the source of the darkness and destroy it.")
action=CommentString("                                                                           ")
action=CommentString("ТЕКСТ ВТОРОСТЕПЕННЫХ ПЕРСОНАЖЕЙ")
action=CommentString("                                                                           ")
action=CommentString("Текст странника")
action=SetVariable($RU_Traveler["1"], "Как хорошо, что я встретил вас, а не бандитов. Не откажите в помощи бедному страннику.")
action=SetVariable($EN_Traveler["1"], " ")
action=SetVariable($RU_Traveler["2"], "Моя бедная ящерка! Моя Дори! Её что-то спугнуло и она убежала. Я видел, как она пролезла под стену Замка.")
action=SetVariable($EN_Traveler["2"], " ")
action=SetVariable($RU_Traveler["3"], "Если вы вдруг встретите её, угостите листьями этого растения. Она должна сразу вспомнить меня и вернуться.")
action=SetVariable($EN_Traveler["3"], " ")
action=SetVariable($RU_Traveler["4"], "Только, пожалуйста, аккуратнее! Дори сильно напугана и может быть агрессивной.")
action=SetVariable($EN_Traveler["4"], " ")
action=SetVariable($RU_Traveler["5"], "К сожалению, мне нечего вам предложить. Но если вы поможете мне, то я буду молиться за вас всю свою жизнь!")
action=SetVariable($EN_Traveler["5"], " ")
action=CommentString("Текст зомби")
action=SetVariable($RU_Zombie["1"], "Вам никогда не подобрать комбинацию, глупцы!")
action=SetVariable($EN_Zombie["1"], " ")
action=SetVariable($RU_Zombie["2"], "Вы сгинете в этом Замке, глупцы!")
action=SetVariable($EN_Zombie["2"], " ")
action=CommentString("Текст Тралла")
action=SetVariable($RU_Thrall["1"], "Предатели! Сейчас вы все умрёте!")
action=SetVariable($EN_Thrall["1"], " ")
action=IfThenElseMultiple()
>action:2=ForLoopVarMultiple($TEXT_N, "1", "30")
>>action:0=SetVariable($TEXT_Quest[$TEXT_N], $EN_Quest[$TEXT_N])
>>action:0=SetVariable($TEXT_Req[$TEXT_N], $EN_Req[$TEXT_N])
>>action:0=SetVariable($TEXT_Hint[$TEXT_N], $EN_Hint[$TEXT_N])
>>action:0=SetVariable($TEXT_Msg[$TEXT_N], $EN_Msg[$TEXT_N])
>>action:0=SetVariable($TEXT_Warrior[$TEXT_N], $EN_Warrior[$TEXT_N])
>>action:0=SetVariable($TEXT_Mechanic[$TEXT_N], $EN_Mechanic[$TEXT_N])
>>action:0=SetVariable($TEXT_Shaman[$TEXT_N], $EN_Shaman[$TEXT_N])
>>action:0=SetVariable($TEXT_Zombie[$TEXT_N], $EN_Zombie[$TEXT_N])
>>action:0=SetVariable($TEXT_Traveler[$TEXT_N], $EN_Traveler[$TEXT_N])
>>action:0=SetVariable($TEXT_Thrall[$TEXT_N], $EN_Thrall[$TEXT_N])
>>action:0=SetVariable($TEXT_Cheat[$TEXT_N], $EN_Cheat[$TEXT_N])
>action:1=ForLoopVarMultiple($TEXT_N, "1", "30")
>>action:0=SetVariable($TEXT_Quest[$TEXT_N], $RU_Quest[$TEXT_N])
>>action:0=SetVariable($TEXT_Req[$TEXT_N], $RU_Req[$TEXT_N])
>>action:0=SetVariable($TEXT_Hint[$TEXT_N], $RU_Hint[$TEXT_N])
>>action:0=SetVariable($TEXT_Msg[$TEXT_N], $RU_Msg[$TEXT_N])
>>action:0=SetVariable($TEXT_Warrior[$TEXT_N], $RU_Warrior[$TEXT_N])
>>action:0=SetVariable($TEXT_Mechanic[$TEXT_N], $RU_Mechanic[$TEXT_N])
>>action:0=SetVariable($TEXT_Shaman[$TEXT_N], $RU_Shaman[$TEXT_N])
>>action:0=SetVariable($TEXT_Zombie[$TEXT_N], $RU_Zombie[$TEXT_N])
>>action:0=SetVariable($TEXT_Traveler[$TEXT_N], $RU_Traveler[$TEXT_N])
>>action:0=SetVariable($TEXT_Thrall[$TEXT_N], $RU_Thrall[$TEXT_N])
>>action:0=SetVariable($TEXT_Cheat[$TEXT_N], $RU_Cheat[$TEXT_N])
>condition:0=OperatorCompareString($CONSTANT_LANGUAGE, OperatorEqualENE, "RU")
event=MapInitializationEvent()
