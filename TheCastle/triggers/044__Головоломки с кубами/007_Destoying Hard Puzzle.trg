[trigger]
name="Destoying Hard Puzzle"
description=""
initially_off=1
action=CustomScriptCode("local location point")
action=CustomScriptCode("local unit temp_unit")
action=SetVariable($BoxSize, "0.00")
action=ForLoopAMultiple("1", "18")
>action:0=SetVariable($HardPuzzle_Available_Box[GetForLoopIndexA()], "false")
action=GroupClear($HardPuzzle_Group_New)
action=CommentString("Убиваем всех юнитов в области (кроме ящиков), а также уничтожаем ящики, которые находятся не на нужных местах")
action=ForGroupMultiple(GetUnitsInRectAll($gg_rct_REG_Hard_Puzzle))
>action:0=CustomScriptCode("local unit enum_unit = GetEnumUnit()")
>action:0=CustomScriptCode("if ( GetUnitTypeId(enum_unit) != 'nmgv') then")
>action:0=CustomScriptCode("    call KillUnit( enum_unit )")
>action:0=CustomScriptCode("    call DestroyEffect(AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\", GetUnitX(enum_unit), GetUnitY(enum_unit) ))")
>action:0=CustomScriptCode("    set enum_unit = null")
>action:0=CustomScriptCode("else")
>action:0=CustomScriptCode("    if (RectContainsCoords(udg_HardPuzzle_Region[1], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("        if (RectContainsCoords(udg_HardPuzzle_Region[2], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("            if (RectContainsCoords(udg_HardPuzzle_Region[3], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("                if (RectContainsCoords(udg_HardPuzzle_Region[4], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[5], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[6], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[7], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[8], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[9], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[10], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[11], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[12], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[13], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[14], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[15], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[16], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[17], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("if (RectContainsCoords(udg_HardPuzzle_Region[18], GetUnitX(enum_unit), GetUnitY(enum_unit)) == false) then")
>action:0=CustomScriptCode("call KillUnit( enum_unit )")
>action:0=CustomScriptCode("call DestroyEffect(AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\", GetUnitX(enum_unit), GetUnitY(enum_unit) ))")
>action:0=CustomScriptCode("set enum_unit = null")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("            endif")
>action:0=CustomScriptCode("        endif")
>action:0=CustomScriptCode("    endif")
>action:0=CustomScriptCode("endif")
action=TriggerSleepAction("0.70")
action=EnableTrigger($gg_trg_Death_of_HardPuzzleBox)
action=CommentString("Проверяем места на необходимость создания ящика")
action=ForGroupMultiple($HardPuzzle_Group)
>action:0=CustomScriptCode("local unit enum_unit = GetEnumUnit()")
>action:0=ForLoopAMultiple("1", "18")
>>action:0=CustomScriptCode("if ( (RectContainsCoords(udg_HardPuzzle_Region[GetForLoopIndexA()], GetUnitX(enum_unit), GetUnitY(enum_unit)) == true) and (udg_HardPuzzle_Available_Box[GetForLoopIndexA()] == false) ) then")
>>action:0=CustomScriptCode("set udg_HardPuzzle_Available_Box[GetForLoopIndexA()] = true")
>>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("set enum_unit = null")
action=CommentString("Создаем ящики, в нужных местах, если там нет ящика")
action=ForLoopAMultiple("1", "18")
>action:0=IfThenElseMultiple()
>>action:1=CustomScriptCode("set point = GetRectCenter(udg_HardPuzzle_Region[GetForLoopIndexA()])")
>>action:1=CustomScriptCode("set temp_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'nmgv', GetLocationX(point),GetLocationY(point), 45.00 )")
>>action:1=CustomScriptCode("call GroupAddUnitSimple( temp_unit, udg_HardPuzzle_Group )")
>>action:1=CustomScriptCode("call GroupAddUnitSimple( temp_unit, udg_HardPuzzle_Group_New )")
>>action:1=CustomScriptCode("call SetUnitScalePercent( temp_unit, 0.00, 0.00, 0.00 )")
>>action:1=CustomScriptCode("call DestroyEffect(AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\MassTeleport\\\\MassTeleportTarget.mdl\", GetLocationX(point), GetLocationY(point) ))")
>>action:1=CustomScriptCode("call RemoveLocation(point)")
>>action:1=CustomScriptCode("set point = null")
>>action:1=CustomScriptCode("set temp_unit = null")
>>condition:0=OperatorCompareBoolean($HardPuzzle_Available_Box[GetForLoopIndexA()], OperatorEqualENE, "false")
action=TriggerSleepAction("0.20")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($HardPuzzle_Size_Timer, PeriodicOptionOneTime, OperatorReal("1.00", OperatorDivide, "30.00"))
>condition:0=OperatorCompareBoolean(IsUnitGroupEmptyBJ($HardPuzzle_Group_New), OperatorEqualENE, "false")
