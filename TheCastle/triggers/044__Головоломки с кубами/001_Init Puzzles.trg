[trigger]
name="Init Puzzles"
description="AnimationStep - шаг анимации\r\n"
initially_off=1
action=CustomScriptCode("local location point")
action=CustomScriptCode("local unit temp_unit")
action=SetVariable($AnimationStep, "20.00")
action=CommentString("-------------------------------------------------------------------")
action=CommentString("ЛЁГКАЯ ГОЛОВОЛОМКА (Easy Puzzle) ")
action=CommentString("-------------------------------------------------------------------")
action=CommentString("Области расположения ящиков в лёгкой головоломке")
action=SetVariable($EasyPuzzle_Region["1"], $gg_rct_REG_EP01)
action=SetVariable($EasyPuzzle_Region["2"], $gg_rct_REG_EP02)
action=SetVariable($EasyPuzzle_Region["3"], $gg_rct_REG_EP03)
action=SetVariable($EasyPuzzle_Region["4"], $gg_rct_REG_EP04)
action=SetVariable($EasyPuzzle_Region["5"], $gg_rct_REG_EP05)
action=SetVariable($EasyPuzzle_Region["6"], $gg_rct_REG_EP06)
action=SetVariable($EasyPuzzle_Region["7"], $gg_rct_REG_EP07)
action=SetVariable($EasyPuzzle_Region["8"], $gg_rct_REG_EP08)
action=CommentString("Создаем и разворачиваем ящики лёгкой головоломки")
action=ForLoopAMultiple("1", "8")
>action:0=CustomScriptCode("set point = GetRectCenter(udg_EasyPuzzle_Region[GetForLoopIndexA()])")
>action:0=CustomScriptCode("set temp_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'nmgv', GetLocationX(point),GetLocationY(point), 45.00 )")
>action:0=CustomScriptCode("call GroupAddUnitSimple( temp_unit, udg_EasyPuzzle_Group )")
>action:0=CustomScriptCode("call RemoveLocation(point)")
>action:0=CustomScriptCode("set point = null")
>action:0=CustomScriptCode("set temp_unit = null")
action=CommentString("-----------------------------------------------------------------------")
action=CommentString("СЛОЖНАЯ ГОЛОВОЛОМКА (Hard Puzzle) ")
action=CommentString("-----------------------------------------------------------------------")
action=CommentString("Области расположения ящиков в сложной головоломке")
action=SetVariable($HardPuzzle_Region["1"], $gg_rct_REG_HP01)
action=SetVariable($HardPuzzle_Region["2"], $gg_rct_REG_HP02)
action=SetVariable($HardPuzzle_Region["3"], $gg_rct_REG_HP03)
action=SetVariable($HardPuzzle_Region["4"], $gg_rct_REG_HP04)
action=SetVariable($HardPuzzle_Region["5"], $gg_rct_REG_HP05)
action=SetVariable($HardPuzzle_Region["6"], $gg_rct_REG_HP06)
action=SetVariable($HardPuzzle_Region["7"], $gg_rct_REG_HP07)
action=SetVariable($HardPuzzle_Region["8"], $gg_rct_REG_HP08)
action=SetVariable($HardPuzzle_Region["9"], $gg_rct_REG_HP09)
action=SetVariable($HardPuzzle_Region["10"], $gg_rct_REG_HP10)
action=SetVariable($HardPuzzle_Region["11"], $gg_rct_REG_HP11)
action=SetVariable($HardPuzzle_Region["12"], $gg_rct_REG_HP12)
action=SetVariable($HardPuzzle_Region["13"], $gg_rct_REG_HP13)
action=SetVariable($HardPuzzle_Region["14"], $gg_rct_REG_HP14)
action=SetVariable($HardPuzzle_Region["15"], $gg_rct_REG_HP15)
action=SetVariable($HardPuzzle_Region["16"], $gg_rct_REG_HP16)
action=SetVariable($HardPuzzle_Region["17"], $gg_rct_REG_HP17)
action=SetVariable($HardPuzzle_Region["18"], $gg_rct_REG_HP18)
action=CommentString("Создаем и разворачиваем ящики сложной головоломки")
action=ForLoopAMultiple("1", "18")
>action:0=CustomScriptCode("set point = GetRectCenter(udg_HardPuzzle_Region[GetForLoopIndexA()])")
>action:0=CustomScriptCode("set temp_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'nmgv', GetLocationX(point),GetLocationY(point), 45.00 )")
>action:0=CustomScriptCode("call GroupAddUnitSimple( temp_unit, udg_HardPuzzle_Group )")
>action:0=CustomScriptCode("call RemoveLocation(point)")
>action:0=CustomScriptCode("set point = null")
>action:0=CustomScriptCode("set temp_unit = null")
