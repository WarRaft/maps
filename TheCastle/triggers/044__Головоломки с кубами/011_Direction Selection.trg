[trigger]
name="Direction Selection"
description=""
initially_off=1
action=SetVariable($Movements_num, "4")
action=CommentString("ВПРАВО")
action=IfThenElseMultiple()
>action:1=SetVariable($FS_Direction, "0.00")
>action:1=CustomScriptCode("if (GetUnitX(udg_FS_Target_Unit) >=0) then")
>action:1=CustomScriptCode("    set udg_FS_Step = 70")
>action:1=CustomScriptCode("else")
>action:1=CustomScriptCode("    set udg_FS_Step = 10")
>action:1=CustomScriptCode("endif")
>action:1=TriggerExecute($gg_trg_Lock_Check)
>action:1=ReturnAction()
>condition:0=OrMultiple()
>>condition:0=AndMultiple()
>>>condition:0=OperatorCompareReal($FS_Angle, OperatorLess, "25.00")
>>>condition:0=OperatorCompareReal($FS_Angle, OperatorGreaterEq, "0.00")
>>condition:0=AndMultiple()
>>>condition:0=OperatorCompareReal($FS_Angle, OperatorLess, "0.00")
>>>condition:0=OperatorCompareReal($FS_Angle, OperatorGreaterEq, "-25.00")
action=CommentString("ВЛЕВО")
action=IfThenElseMultiple()
>condition:0=OrMultiple()
>>condition:0=AndMultiple()
>>>condition:0=OperatorCompareReal($FS_Angle, OperatorGreater, "155.00")
>>>condition:0=OperatorCompareReal($FS_Angle, OperatorLessEq, "180.00")
>>condition:0=AndMultiple()
>>>condition:0=OperatorCompareReal($FS_Angle, OperatorLess, "-155.00")
>>>condition:0=OperatorCompareReal($FS_Angle, OperatorGreater, "-180.00")
>action:1=SetVariable($FS_Direction, "180.00")
>action:1=CustomScriptCode("if (GetUnitX(udg_FS_Target_Unit) >=0) then")
>action:1=CustomScriptCode("    set udg_FS_Step = 10")
>action:1=CustomScriptCode("else")
>action:1=CustomScriptCode("    set udg_FS_Step = 70")
>action:1=CustomScriptCode("endif")
>action:1=TriggerExecute($gg_trg_Lock_Check)
>action:1=ReturnAction()
action=CommentString("ВНИЗ")
action=IfThenElseMultiple()
>action:1=SetVariable($FS_Direction, "270.00")
>action:1=CustomScriptCode("if (GetUnitY(udg_FS_Target_Unit) >=0) then")
>action:1=CustomScriptCode("    set udg_FS_Step = 10")
>action:1=CustomScriptCode("else")
>action:1=CustomScriptCode("    set udg_FS_Step = 70")
>action:1=CustomScriptCode("endif")
>action:1=TriggerExecute($gg_trg_Lock_Check)
>action:1=ReturnAction()
>condition:0=OperatorCompareReal($FS_Angle, OperatorGreater, "-125.00")
>condition:0=OperatorCompareReal($FS_Angle, OperatorLess, "-65.00")
action=CommentString("ВВЕРХ")
action=IfThenElseMultiple()
>action:1=SetVariable($FS_Direction, "90.00")
>action:1=CustomScriptCode("if (GetUnitY(udg_FS_Target_Unit) >=0) then")
>action:1=CustomScriptCode("    set udg_FS_Step = 70")
>action:1=CustomScriptCode("else")
>action:1=CustomScriptCode("    set udg_FS_Step = 10")
>action:1=CustomScriptCode("endif")
>action:1=TriggerExecute($gg_trg_Lock_Check)
>action:1=ReturnAction()
>condition:0=OperatorCompareReal($FS_Angle, OperatorLess, "115.00")
>condition:0=OperatorCompareReal($FS_Angle, OperatorGreater, "65.00")
