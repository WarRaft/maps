[trigger]
name="Destoying Easy Puzzle"
description=""
initially_off=1
action=CustomScriptCode("local location point")
action=CustomScriptCode("local unit temp_unit")
action=SetVariable($BoxSize, "0.00")
action=ForLoopAMultiple("1", "8")
>action:0=SetVariable($EasyPuzzle_Available_Box[GetForLoopIndexA()], "false")
action=GroupClear($EasyPuzzle_Group_New)
action=CommentString("Убиваем всех юнитов в области (кроме ящиков), а также уничтожаем ящики, которые находятся не на нужных местах")
action=ForGroupMultiple(GetUnitsInRectAll($gg_rct_REG_Easy_Puzzle))
>action:0=CustomScriptCode("local unit enum_unit = GetEnumUnit()")
>action:0=CustomScriptCode("local real x = GetUnitX(enum_unit)")
>action:0=CustomScriptCode("local real y = GetUnitY(enum_unit)")
>action:0=CustomScriptCode("if ( GetUnitTypeId(enum_unit) != 'nmgv') then")
>action:0=CustomScriptCode("    call KillUnit( enum_unit )")
>action:0=CustomScriptCode("    call DestroyEffect(AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\", x, y ))")
>action:0=CustomScriptCode("    set enum_unit = null")
>action:0=CustomScriptCode("else")
>action:0=CustomScriptCode("    if (RectContainsCoords(udg_EasyPuzzle_Region[1], x, y) == false) then")
>action:0=CustomScriptCode("        if (RectContainsCoords(udg_EasyPuzzle_Region[2], x, y) == false) then")
>action:0=CustomScriptCode("            if (RectContainsCoords(udg_EasyPuzzle_Region[3], x, y) == false) then")
>action:0=CustomScriptCode("                if (RectContainsCoords(udg_EasyPuzzle_Region[4], x, y) == false) then")
>action:0=CustomScriptCode("                    if (RectContainsCoords(udg_EasyPuzzle_Region[5], x, y) == false) then")
>action:0=CustomScriptCode("                        if (RectContainsCoords(udg_EasyPuzzle_Region[6], x, y) == false) then")
>action:0=CustomScriptCode("                            if (RectContainsCoords(udg_EasyPuzzle_Region[7], x, y) == false) then")
>action:0=CustomScriptCode("                                if (RectContainsCoords(udg_EasyPuzzle_Region[8], x, y) == false) then")
>action:0=CustomScriptCode("                                    call KillUnit( enum_unit )")
>action:0=CustomScriptCode("                                    call DestroyEffect(AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\", x, y ))")
>action:0=CustomScriptCode("                                    set enum_unit = null")
>action:0=CustomScriptCode("                                endif")
>action:0=CustomScriptCode("                           endif")
>action:0=CustomScriptCode("                        endif")
>action:0=CustomScriptCode("                    endif")
>action:0=CustomScriptCode("                endif")
>action:0=CustomScriptCode("            endif")
>action:0=CustomScriptCode("        endif")
>action:0=CustomScriptCode("    endif")
>action:0=CustomScriptCode("endif")
action=TriggerSleepAction("0.70")
action=EnableTrigger($gg_trg_Death_of_EasyPuzzleBox)
action=CommentString("Проверяем места на необходимость создания ящика")
action=ForGroupMultiple($EasyPuzzle_Group)
>action:0=CustomScriptCode("local unit enum_unit = GetEnumUnit()")
>action:0=ForLoopAMultiple("1", "8")
>>action:0=CustomScriptCode("if ( (RectContainsCoords(udg_EasyPuzzle_Region[GetForLoopIndexA()], GetUnitX(enum_unit), GetUnitY(enum_unit)) == true) and (udg_EasyPuzzle_Available_Box[GetForLoopIndexA()] == false) ) then")
>>action:0=CustomScriptCode("    set udg_EasyPuzzle_Available_Box[GetForLoopIndexA()] = true")
>>action:0=CustomScriptCode("endif")
>action:0=CustomScriptCode("set enum_unit = null")
action=CommentString("Создаем ящики, в нужных местах, если там нет ящика")
action=ForLoopAMultiple("1", "8")
>action:0=IfThenElseMultiple()
>>action:1=CustomScriptCode("set point = GetRectCenter(udg_EasyPuzzle_Region[GetForLoopIndexA()])")
>>action:1=CustomScriptCode("set temp_unit = TeoCreateUnit( Player(PLAYER_NEUTRAL_PASSIVE), 'nmgv', GetLocationX(point),GetLocationY(point), 45.00 )")
>>action:1=CustomScriptCode("call GroupAddUnitSimple( temp_unit, udg_EasyPuzzle_Group )")
>>action:1=CustomScriptCode("call GroupAddUnitSimple( temp_unit, udg_EasyPuzzle_Group_New )")
>>action:1=CustomScriptCode("call SetUnitScalePercent( temp_unit, 0.00, 0.00, 0.00 )")
>>action:1=CustomScriptCode("call DestroyEffect(AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\MassTeleport\\\\MassTeleportTarget.mdl\", GetLocationX(point), GetLocationY(point) ))")
>>action:1=CustomScriptCode("call RemoveLocation(point)")
>>action:1=CustomScriptCode("set point = null")
>>action:1=CustomScriptCode("set temp_unit = null")
>>condition:0=OperatorCompareBoolean($EasyPuzzle_Available_Box[GetForLoopIndexA()], OperatorEqualENE, "false")
action=TriggerSleepAction("0.20")
action=IfThenElseMultiple()
>action:1=StartTimerBJ($EasyPuzzle_Size_Timer, PeriodicOptionOneTime, "0.04")
>condition:0=OperatorCompareBoolean(IsUnitGroupEmptyBJ($EasyPuzzle_Group_New), OperatorEqualENE, "false")
