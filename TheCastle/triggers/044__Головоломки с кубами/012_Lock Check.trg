[trigger]
name="Lock Check"
description=""
initially_off=1
action=CustomScriptCode("local real x = GetUnitX(udg_FS_Target_Unit)")
action=CustomScriptCode("local real y = GetUnitY(udg_FS_Target_Unit)")
action=CustomScriptCode("local location pos = Location(x, y)")
action=CustomScriptCode("local location point = Location(GetLocationX(pos) + 250.00 * Cos(udg_FS_Direction * bj_DEGTORAD), GetLocationY(pos) + 250.00 * Sin(udg_FS_Direction * bj_DEGTORAD))")
action=CustomScriptCode("local rect blocking_area = Rect(GetLocationX(point) - 150, GetLocationY(point) - 150, GetLocationX(point) + 150, GetLocationY(point) + 150 )")
action=CustomScriptCode("local real dx")
action=CustomScriptCode("local real dy")
action=CustomScriptCode("local item dummy_item")
action=CustomScriptCode("local group blocking_units")
action=SetVariable($HaveBlock, "false")
action=CommentString("    Если помехой является юнит    ")
action=CustomScriptCode("set blocking_units = GetUnitsInRectAll(blocking_area)")
action=CustomScriptCode("if (CountUnitsInGroup(blocking_units) !=0 ) then")
action=CustomScriptCode("    set udg_HaveBlock = true")
action=CustomScriptCode("    // ----------- Обнуление переменных ----------- ")
action=CustomScriptCode("    call RemoveLocation(pos)")
action=CustomScriptCode("    call RemoveLocation(point)")
action=CustomScriptCode("    call RemoveRect(blocking_area)")
action=CustomScriptCode("    call DestroyGroup(blocking_units)")
action=CustomScriptCode("    set pos = null")
action=CustomScriptCode("    set point = null")
action=CustomScriptCode("    set blocking_area = null")
action=CustomScriptCode("    set blocking_units = null")
action=ReturnAction()
action=CustomScriptCode("endif")
action=CustomScriptCode("call GroupClear( blocking_units )")
action=CommentString("    Если помехой является непроходимая точка    ")
action=CustomScriptCode("set dummy_item = CreateItem( 'ratf', GetLocationX(point), GetLocationY(point) )")
action=CustomScriptCode("set dx = IAbsBJ( R2I( GetItemX(dummy_item) - GetLocationX(point) ) ) ")
action=CustomScriptCode("set dy = IAbsBJ( R2I( GetItemY(dummy_item) - GetLocationY(point) ) ) ")
action=CustomScriptCode("call SetItemVisible( dummy_item, false)")
action=CustomScriptCode("if ( dx > 0 or dy > 0 ) then")
action=CustomScriptCode("    set udg_HaveBlock = true")
action=CustomScriptCode("    // ----------- Обнуление переменных ----------- ")
action=CustomScriptCode("    call RemoveItem( dummy_item )")
action=CustomScriptCode("    call RemoveLocation(pos)")
action=CustomScriptCode("    call RemoveLocation(point)")
action=CustomScriptCode("    call RemoveRect(blocking_area)")
action=CustomScriptCode("    call DestroyGroup(blocking_units)")
action=CustomScriptCode("    set pos = null")
action=CustomScriptCode("    set point = null")
action=CustomScriptCode("    set blocking_area = null")
action=CustomScriptCode("    set blocking_units = null")
action=ReturnAction()
action=CustomScriptCode("endif")
action=CustomScriptCode("call RemoveItem( dummy_item )")
action=CommentString("    Если помехой является точка-блокиратор    ")
action=ForLoopAMultiple("1", "4")
>action:0=CustomScriptCode("if (RectContainsLoc(blocking_area, udg_Blocking_Point[GetForLoopIndexA()]) == true ) then")
>action:0=CustomScriptCode("    set udg_HaveBlock = true")
>action:0=CustomScriptCode("    // ----------- Обнуление переменных ----------- ")
>action:0=CustomScriptCode("    call RemoveLocation(pos)")
>action:0=CustomScriptCode("    call RemoveLocation(point)")
>action:0=CustomScriptCode("    call RemoveRect(blocking_area)")
>action:0=CustomScriptCode("    call DestroyGroup(blocking_units)")
>action:0=CustomScriptCode("    set pos = null")
>action:0=CustomScriptCode("    set point = null")
>action:0=CustomScriptCode("    set blocking_area = null")
>action:0=CustomScriptCode("    set blocking_units = null")
>action:0=ReturnAction()
>action:0=CustomScriptCode("endif")
action=StartTimerBJ($Movement_Timer, PeriodicOptionOneTime, "0.03")
action=CustomScriptCode("// ----------- Обнуление переменных ----------- ")
action=CustomScriptCode("call RemoveLocation(pos)")
action=CustomScriptCode("call RemoveLocation(point)")
action=CustomScriptCode("call RemoveRect(blocking_area)")
action=CustomScriptCode("call DestroyGroup(blocking_units)")
action=CustomScriptCode("set pos = null")
action=CustomScriptCode("set point = null")
action=CustomScriptCode("set blocking_area = null")
action=CustomScriptCode("set blocking_units = null")
