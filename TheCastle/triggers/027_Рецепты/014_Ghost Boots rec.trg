[trigger]
name="Ghost Boots rec"
description=""
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventSpellEffect)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventSpellEffect)
action=IfThenElseMultiple()
>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I014"), OperatorEqualENE, "true")
>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00H"), OperatorEqualENE, "true")
>condition:0=OrMultiple()
>>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00B"), OperatorEqualENE, "true")
>>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00C"), OperatorEqualENE, "true")
>>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00D"), OperatorEqualENE, "true")
>action:2=PlaySoundOnUnitBJ($gg_snd_Error, "100", GetTriggerUnit())
>action:2=DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), $TEXT_Msg["2"])
>action:1=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I014"))
>action:1=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00H"))
>action:1=SetVariable($Random, GetRandomInt("1", "3"))
>action:1=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=IfThenElseMultiple()
>>>action:2=IfThenElseMultiple()
>>>>action:2=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00C"))
>>>>action:1=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00D"))
>>>>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00D"), OperatorEqualENE, "true")
>>>action:1=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00B"))
>>>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00B"), OperatorEqualENE, "true")
>>condition:0=OperatorCompareInteger($Random, OperatorEqual, "1")
>action:1=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=IfThenElseMultiple()
>>>action:1=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00D"))
>>>action:2=IfThenElseMultiple()
>>>>action:2=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00B"))
>>>>action:1=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00C"))
>>>>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00C"), OperatorEqualENE, "true")
>>>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00D"), OperatorEqualENE, "true")
>>condition:0=OperatorCompareInteger($Random, OperatorEqual, "2")
>action:1=IfThenElseMultiple()
>>action:1=IfThenElseMultiple()
>>>action:1=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00C"))
>>>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00C"), OperatorEqualENE, "true")
>>>action:2=IfThenElseMultiple()
>>>>action:2=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00D"))
>>>>action:1=RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), "I00B"))
>>>>condition:0=OperatorCompareBoolean(UnitHasItemOfTypeBJ(GetTriggerUnit(), "I00B"), OperatorEqualENE, "true")
>>condition:0=OperatorCompareInteger($Random, OperatorEqual, "3")
>action:1=UnitAddItemByIdSwapped("I034", GetTriggerUnit())
>action:1=AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl")
>action:1=DestroyEffectBJ(GetLastCreatedEffectBJ())
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A05M")
