[trigger]
name="Array of Items"
description=""
condition=OrMultiple()
>condition:0=OperatorCompareItemType(GetItemType(GetManipulatedItem()), OperatorEqualENE, ItemTypePermanent)
>condition:0=OperatorCompareItemType(GetItemType(GetManipulatedItem()), OperatorEqualENE, ItemTypeCharged)
>condition:0=OperatorCompareItemType(GetItemType(GetManipulatedItem()), OperatorEqualENE, ItemTypePowerup)
>condition:0=OperatorCompareItemType(GetItemType(GetManipulatedItem()), OperatorEqualENE, ItemTypeArtifact)
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetManipulatedItem()), OperatorEqualENE, "I00K")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetManipulatedItem()), OperatorEqualENE, "I00Z")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetManipulatedItem()), OperatorEqualENE, "I00Y")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetManipulatedItem()), OperatorEqualENE, "I010")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetManipulatedItem()), OperatorEqualENE, "I00X")
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetManipulatedItem()), OperatorEqualENE, "I00W")
action=CommentString("Руна Воскрешения")
action=IfThenElseMultiple()
>action:1=SetVariable($Count_Life, OperatorInt($Count_Life, OperatorAdd, "1"))
>action:1=ForForceMultiple($Players)
>>action:0=SetPlayerState(GetEnumPlayer(), PlayerStateLumber, OperatorInt($Count_Life, OperatorSubtract, "1"))
>action:1=ReturnAction()
>condition:0=OperatorCompareItemCode(GetItemTypeId(GetManipulatedItem()), OperatorEqualENE, "I012")
action=SetVariable($All_Items_num, OperatorInt($All_Items_num, OperatorAdd, "1"))
action=SetVariable($All_Items[$All_Items_num], GetManipulatedItem())
action=ForLoopAMultiple("0", OperatorInt($All_Items_num, OperatorSubtract, "1"))
>action:0=IfThenElseMultiple()
>>action:1=SetVariable($All_Items_num, OperatorInt($All_Items_num, OperatorSubtract, "1"))
>>condition:0=OperatorCompareItem(GetManipulatedItem(), OperatorEqualENE, $All_Items[GetForLoopIndexA()])
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventHeroPickUpItem)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventHeroPickUpItem)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventHeroPickUpItem)
