[trigger]
name="Tesseract Picking Up"
description=""
action=CustomScriptCode("local unit Hero_unit = GetTriggerUnit()")
action=CustomScriptCode("local location Hero_point = GetUnitLoc(Hero_unit)")
action=CustomScriptCode("local location Item_point = GetUnitLoc(udg_UNIT_Backpack)")
action=CommentString("Проверяем расстояние")
action=CustomScriptCode("if (DistanceBetweenPoints(Hero_point, Item_point) <= 150.00) then")
action=CommentString("Проверяем слоты инвентаря")
action=CustomScriptCode("    if (UnitInventoryCount(Hero_unit) < 6) then")
action=CustomScriptCode("        call PauseUnitBJ( true,Hero_unit )")
action=CustomScriptCode("        call IssueImmediateOrder( Hero_unit,\"stop\" )")
action=CustomScriptCode("        call SetUnitFacingToFaceLocTimed(Hero_unit, Item_point, 0)")
action=CustomScriptCode("        call PauseUnitBJ( false,Hero_unit )")
action=CustomScriptCode("        call ShowUnitHide( udg_UNIT_Backpack )")
action=CustomScriptCode("         call UnitAddItemByIdSwapped( 'I038', Hero_unit )")
action=CustomScriptCode("    endif")
action=CustomScriptCode("endif")
action=CommentString("Обнуление переменных")
action=CustomScriptCode("call RemoveLocation(Hero_point)")
action=CustomScriptCode("call RemoveLocation(Item_point)")
action=CustomScriptCode("set Hero_point = null")
action=CustomScriptCode("set Item_point = null")
action=CustomScriptCode("set Hero_unit = null")
condition=OperatorCompareUnit(GetOrderTargetUnit(), OperatorEqualENE, $UNIT_Backpack)
condition=OperatorCompareOrderCode(GetUnitCurrentOrder(GetTriggerUnit()), OperatorNotEqualENE, String2OrderIdBJ("attack"))
condition=OperatorCompareBoolean(IsUnitHiddenBJ($UNIT_Backpack), OperatorEqualENE, "false")
event=TriggerRegisterPlayerUnitEventSimple(Player00, PlayerUnitEventIssued_Unit_Order)
event=TriggerRegisterPlayerUnitEventSimple(Player01, PlayerUnitEventIssued_Unit_Order)
event=TriggerRegisterPlayerUnitEventSimple(Player02, PlayerUnitEventIssued_Unit_Order)
