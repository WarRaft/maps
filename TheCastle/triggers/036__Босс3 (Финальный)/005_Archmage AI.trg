[trigger]
name="Archmage AI"
description="1 - Цепная молния\r\n2 - Шторм молний\r\n3 - Призыв скелетов-целителей\r\n4 - Затуманенный разум\r\n\r\n\r\n\r\n"
initially_off=1
action=CustomScriptCode("local location archmage_point = GetUnitLoc(udg_UNIT_Boss3_Archmage)")
action=CustomScriptCode("local location hero_point1 = GetUnitLoc(udg_Hero_mechanic)")
action=CustomScriptCode("local location hero_point2 = GetUnitLoc(udg_Hero_shaman)")
action=CustomScriptCode("local location hero_point3 = GetUnitLoc(udg_Hero_warrior)")
action=CustomScriptCode("local real distance1 = DistanceBetweenPoints(archmage_point, hero_point1)")
action=CustomScriptCode("local real distance2 = DistanceBetweenPoints(archmage_point, hero_point2)")
action=CustomScriptCode("local real distance3 = DistanceBetweenPoints(archmage_point, hero_point3)")
action=CustomScriptCode("if ( distance1 > 600 and distance2 > 600 and distance3 > 600 ) then")
action=CustomScriptCode("    set udg_Archmage_type_attack = GetRandomInt(1, 3)")
action=CustomScriptCode("else")
action=CustomScriptCode("    if ( distance1 < 200 and distance2 < 200 and distance3 < 200 ) then")
action=CustomScriptCode("        set udg_Archmage_type_attack = GetRandomInt(2, 4)")
action=CustomScriptCode("    else")
action=CustomScriptCode("        set udg_Archmage_type_attack = GetRandomInt(1, 4)")
action=CustomScriptCode("    endif")
action=CustomScriptCode("endif")
action=IfThenElseMultiple()
>action:1=IfThenElseMultiple()
>>action:2=SetUnitUserData($UNIT_Boss3_Archmage, $Archmage_type_attack)
>>action:2=CustomScriptCode("call IssueImmediateOrder( udg_UNIT_Boss3_Archmage, \"fanofknives\" )")
>>action:2=ReturnAction()
>>action:1=TriggerExecute(GetTriggeringTrigger())
>>action:1=ReturnAction()
>>condition:0=OperatorCompareInteger(GetUnitUserData($UNIT_Boss3_Archmage), OperatorEqual, "1")
>action:2=IfThenElseMultiple()
>>action:1=IfThenElseMultiple()
>>>action:2=SetUnitUserData($UNIT_Boss3_Archmage, $Archmage_type_attack)
>>>action:2=CustomScriptCode("call IssueImmediateOrder( udg_UNIT_Boss3_Archmage, \"evileye\" )")
>>>action:2=ReturnAction()
>>>action:1=TriggerExecute(GetTriggeringTrigger())
>>>action:1=ReturnAction()
>>>condition:0=OperatorCompareInteger(GetUnitUserData($UNIT_Boss3_Archmage), OperatorEqual, "2")
>>action:2=IfThenElseMultiple()
>>>action:2=IfThenElseMultiple()
>>>>action:1=IfThenElseMultiple()
>>>>>action:2=SetUnitUserData($UNIT_Boss3_Archmage, $Archmage_type_attack)
>>>>>action:2=IssueImmediateOrder($UNIT_Boss3_Archmage, UnitOrderHowlOfTerror)
>>>>>action:2=ReturnAction()
>>>>>action:1=TriggerExecute(GetTriggeringTrigger())
>>>>>action:1=ReturnAction()
>>>>>condition:0=OperatorCompareInteger(GetUnitUserData($UNIT_Boss3_Archmage), OperatorEqual, "4")
>>>>condition:0=OperatorCompareInteger($Archmage_type_attack, OperatorEqual, "4")
>>>action:1=IfThenElseMultiple()
>>>>action:2=SetUnitUserData($UNIT_Boss3_Archmage, $Archmage_type_attack)
>>>>action:2=CustomScriptCode("call IssueImmediateOrder( udg_UNIT_Boss3_Archmage, \"militia\" )")
>>>>action:2=ReturnAction()
>>>>action:1=TriggerExecute(GetTriggeringTrigger())
>>>>action:1=ReturnAction()
>>>>condition:0=OperatorCompareInteger(GetUnitUserData($UNIT_Boss3_Archmage), OperatorEqual, "3")
>>>condition:0=OperatorCompareInteger($Archmage_type_attack, OperatorEqual, "3")
>>condition:0=OperatorCompareInteger($Archmage_type_attack, OperatorEqual, "2")
>condition:0=OperatorCompareInteger($Archmage_type_attack, OperatorEqual, "1")
event=TriggerRegisterTimerEventPeriodic("10.00")
