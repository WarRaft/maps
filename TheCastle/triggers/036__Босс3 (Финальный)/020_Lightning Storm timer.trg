[trigger]
name="Lightning Storm timer"
description=""
initially_off=1
action=CustomScriptCode("local player dummy_player = Player(PLAYER_NEUTRAL_PASSIVE)")
action=CustomScriptCode("local unit dummy_unit")
action=CustomScriptCode("local real x1 = LoadRealBJ(31, 1, GetLastCreatedHashtableBJ())")
action=CustomScriptCode("local real y1 = LoadRealBJ(31, 2, GetLastCreatedHashtableBJ())")
action=CustomScriptCode("local real x2 = LoadRealBJ(32, 1, GetLastCreatedHashtableBJ())")
action=CustomScriptCode("local real y2 = LoadRealBJ(32, 2, GetLastCreatedHashtableBJ())")
action=CustomScriptCode("local real x3 = LoadRealBJ(33, 1, GetLastCreatedHashtableBJ())")
action=CustomScriptCode("local real y3 = LoadRealBJ(33, 2, GetLastCreatedHashtableBJ())")
action=CommentString("Если применение умения не прерывалось")
action=IfThenElseMultiple()
>action:1=CustomScriptCode("set dummy_unit = TeoCreateDummyUnit( dummy_player, 'n00X', x1, y1, null )")
>action:1=CustomScriptCode("call UnitDamagePoint(dummy_unit, 0, 190.00, x1, y1,1000.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)")
>action:1=CustomScriptCode("call UnitDamagePoint(dummy_unit, 0, 190.00, x2, y2,1000.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)")
>action:1=CustomScriptCode("call UnitDamagePoint(dummy_unit, 0, 190.00, x3, y3,1000.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)")
>action:1=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"EFFECTS\\\\Stormfall.mdx\", x1, y1) )")
>action:1=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"EFFECTS\\\\Stormfall.mdx\", x2, y2) )")
>action:1=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"EFFECTS\\\\Stormfall.mdx\", x3, y3) )")
>action:1=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\", x1, y1) )")
>action:1=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\", x2, y2) )")
>action:1=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\", x3, y3) )")
>condition:0=OperatorCompareBoolean(LoadBooleanBJ("30", "3", GetLastCreatedHashtableBJ()), OperatorEqualENE, "true")
action=CommentString("Обнуление переменных")
action=CustomScriptCode("set dummy_player = null")
action=CustomScriptCode("set dummy_unit = null")
event=TriggerRegisterTimerExpireEventBJ($Lighting_Storm_Timer)
