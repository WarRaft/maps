[trigger]
name="Boss3 Waves settings"
description="При добавлении юнитов также необходимо увеличить размерность массива Boss3_MonsterGroups в настройках переменных.\r\n\r\nНачальные параметры волны.\r\n\r\nМаксимальное количество монстров (итоговое):\r\nОхотник за головами - 6\r\nОрк-воин - 6\r\nТролль-охотник - 2\r\nШаман лесных троллей - 2\r\nГоблинский Резак - 2\r\nТролль-берсерк - 1"
initially_off=1
action=SetVariable($Boss3_NumMonsters, "6")
action=CommentString("Заполнение массива данных по монстрам")
action=SetVariable($Boss3_MonsterTypes["1"], "o006")
action=SetVariable($Boss3_SpawnRegions["1"], $gg_rct_REG_Portal22)
action=SetVariable($Boss3_MaxMonsters["1"], "6")
action=SetVariable($Boss3_SpawnFrequence["1"], "4")
action=CommentString("-")
action=SetVariable($Boss3_MonsterTypes["2"], "o007")
action=SetVariable($Boss3_SpawnRegions["2"], $gg_rct_REG_Portal21)
action=SetVariable($Boss3_MaxMonsters["2"], "6")
action=SetVariable($Boss3_SpawnFrequence["2"], "5")
action=CommentString("-")
action=SetVariable($Boss3_MonsterTypes["3"], "n02I")
action=SetVariable($Boss3_SpawnRegions["3"], $gg_rct_REG_Portal22)
action=SetVariable($Boss3_MaxMonsters["3"], "1")
action=SetVariable($Boss3_SpawnFrequence["3"], "9")
action=CommentString("-")
action=SetVariable($Boss3_MonsterTypes["4"], "n02J")
action=SetVariable($Boss3_SpawnRegions["4"], $gg_rct_REG_Portal22)
action=SetVariable($Boss3_MaxMonsters["4"], "0")
action=SetVariable($Boss3_SpawnFrequence["4"], "11")
action=CommentString("-")
action=SetVariable($Boss3_MonsterTypes["5"], "n02G")
action=SetVariable($Boss3_SpawnRegions["5"], $gg_rct_REG_Portal20)
action=SetVariable($Boss3_MaxMonsters["5"], "1")
action=SetVariable($Boss3_SpawnFrequence["5"], "17")
action=CommentString("-")
action=SetVariable($Boss3_MonsterTypes["6"], "o005")
action=SetVariable($Boss3_SpawnRegions["6"], $gg_rct_REG_Portal22)
action=SetVariable($Boss3_MaxMonsters["6"], "0")
action=SetVariable($Boss3_SpawnFrequence["6"], "13")
action=CommentString("-")
action=ForLoopA("1", $Boss3_NumMonsters, action:SetVariable($Boss3_InitialSpawnFrequence[GetForLoopIndexA()], $Boss3_SpawnFrequence[GetForLoopIndexA()]) ~"")
