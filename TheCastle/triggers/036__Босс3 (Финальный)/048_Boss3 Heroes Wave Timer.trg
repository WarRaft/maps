[trigger]
name="Boss3 Heroes Wave Timer"
description=""
initially_off=1
action=DisableTrigger(GetTriggeringTrigger())
action=CommentString("Создание героев")
action=CreateNUnitsAtLoc("1", "O004", PlayerNA, GetRectCenter($gg_rct_REG_Portal22), "90.00")
action=SetVariable($UNIT_Boss3_Troll, GetLastCreatedUnit())
action=CreateNUnitsAtLoc("1", "N02H", PlayerNA, GetRectCenter($gg_rct_REG_Portal20), "270.00")
action=SetVariable($UNIT_Boss3_Goblin, GetLastCreatedUnit())
action=CreateNUnitsAtLoc("1", "O003", PlayerNA, GetRectCenter($gg_rct_REG_Portal21), "0.00")
action=SetVariable($UNIT_Boss3_Orc, GetLastCreatedUnit())
action=CommentString("------------------------------------------------------------------------")
action=CommentString("ДЕЙСТВИЯ ПОСЛЕ СОЗДАНИЯ ГЕРОЕВ")
action=CommentString("------------------------------------------------------------------------")
action=CommentString("Изменение цвета")
action=SetUnitColor($UNIT_Boss3_Troll, Color00)
action=SetUnitColor($UNIT_Boss3_Goblin, Color00)
action=SetUnitColor($UNIT_Boss3_Orc, Color00)
action=CommentString("Уровень героев")
action=SetHeroLevel($UNIT_Boss3_Troll, "13", ShowHideHide)
action=SetHeroLevel($UNIT_Boss3_Goblin, "13", ShowHideHide)
action=SetHeroLevel($UNIT_Boss3_Orc, "13", ShowHideHide)
action=CommentString("Умения")
action=SelectHeroSkill($UNIT_Boss3_Troll, "A051")
action=SelectHeroSkill($UNIT_Boss3_Orc, "A056")
action=CommentString("Артефакты героев")
action=UnitAddItemByIdSwapped("I013", $UNIT_Boss3_Troll)
action=UnitAddItemByIdSwapped("I02G", $UNIT_Boss3_Troll)
action=SetVariable($Boss3_Troll_Item, GetLastCreatedItem())
action=UnitAddItemByIdSwapped("I005", $UNIT_Boss3_Goblin)
action=UnitAddItemByIdSwapped("I02H", $UNIT_Boss3_Goblin)
action=SetVariable($Boss3_Goblin_Item, GetLastCreatedItem())
action=UnitAddItemByIdSwapped("I009", $UNIT_Boss3_Orc)
action=UnitAddItemByIdSwapped("I02I", $UNIT_Boss3_Orc)
action=SetVariable($Boss3_Orc_Item, GetLastCreatedItem())
action=CommentString("События триггеров")
action=AddTriggerEvent($gg_trg_Troll_Invulnerability, event:TriggerRegisterUnitEvent($UNIT_Boss3_Troll, UnitEventDamaged) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Troll, event:TriggerRegisterUnitEvent($UNIT_Boss3_Troll, UnitEventDeath) ~"")
action=EnableTrigger($gg_trg_Trolls_Count)
action=AddTriggerEvent($gg_trg_Goblin_Invulnerability, event:TriggerRegisterUnitEvent($UNIT_Boss3_Goblin, UnitEventDamaged) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Goblin, event:TriggerRegisterUnitEvent($UNIT_Boss3_Goblin, UnitEventDeath) ~"")
action=EnableTrigger($gg_trg_Goblin_Count)
action=AddTriggerEvent($gg_trg_Orc_Invulnerability, event:TriggerRegisterUnitEvent($UNIT_Boss3_Orc, UnitEventDamaged) ~"")
action=AddTriggerEvent($gg_trg_Death_of_Orc, event:TriggerRegisterUnitEvent($UNIT_Boss3_Orc, UnitEventDeath) ~"")
action=EnableTrigger($gg_trg_Orc_Count)
action=TriggerExecute($gg_trg_Lightning_Discharge_Events)
action=TriggerExecute($gg_trg_Poisonous_puddle_Events)
action=EnableTrigger($gg_trg_Poisonous_puddle)
action=SetVariable($Talking_Hero, GetEnteringUnit())
action=CommentString("Сообщение Тралла")
action=SetCineModeVolumeGroupsBJ()
action=TriggerSleepAction("1.00")
action=UnitAddIndicatorBJ($UNIT_Boss3_Orc, "100", "100", "100", "0")
action=TransmissionFromUnitWithNameBJ(GetPlayersAll(), $UNIT_Boss3_Orc, GetHeroProperName($UNIT_Boss3_Orc), $gg_snd_Thrall01, $TEXT_Thrall["1"], AddSetToSet, "1.00", WaitDontDont)
action=TriggerSleepAction("4.00")
action=VolumeGroupResetBJ()
event=TriggerRegisterTimerExpireEventBJ($Boss3_Wave_Timer)
