[trigger]
name="Summon Skeleton healers"
description=""
initially_off=1
action=CustomScriptCode("local unit healer_unit1")
action=CustomScriptCode("local real x1 = 130")
action=CustomScriptCode("local real y1 = -7930")
action=CustomScriptCode("local unit healer_unit2")
action=CustomScriptCode("local real x2 = 580")
action=CustomScriptCode("local real y2 = -8190")
action=CustomScriptCode("local unit healer_unit3")
action=CustomScriptCode("local real x3 = 1020")
action=CustomScriptCode("local real y3 = -7930")
action=CustomScriptCode("set healer_unit1 = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'u00F', x1, y1, 45 )")
action=CustomScriptCode("set healer_unit2 = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'u00F', x2, y2, 90 )")
action=CustomScriptCode("set healer_unit3 = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'u00F', x3, y3, 135 )")
action=CustomScriptCode("call GroupAddUnitSimple( healer_unit1, udg_Archmage_Heal_Group )")
action=CustomScriptCode("call GroupAddUnitSimple( healer_unit2, udg_Archmage_Heal_Group )")
action=CustomScriptCode("call GroupAddUnitSimple( healer_unit3, udg_Archmage_Heal_Group )")
action=CustomScriptCode("call UnitApplyTimedLife( healer_unit1, 'BTLF', 60 )")
action=CustomScriptCode("call UnitApplyTimedLife( healer_unit2, 'BTLF', 60 )")
action=CustomScriptCode("call UnitApplyTimedLife( healer_unit3, 'BTLF', 60 )")
action=CommentString("Создание эффекта появления")
action=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Undead\\\\AnimateDead\\\\AnimateDeadTarget.mdl\", x1, y1 ) )")
action=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Undead\\\\AnimateDead\\\\AnimateDeadTarget.mdl\", x2, y2 ) )")
action=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Undead\\\\AnimateDead\\\\AnimateDeadTarget.mdl\", x3, y3 ) )")
action=CommentString("Обнуление переменных")
action=CustomScriptCode("set healer_unit1 = null")
action=CustomScriptCode("set healer_unit2 = null")
action=CustomScriptCode("set healer_unit3 = null")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A05J")
