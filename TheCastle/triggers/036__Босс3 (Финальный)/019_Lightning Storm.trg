[trigger]
name="Lightning Storm"
description="Структура хэш-таблицы для умения:\r\nx.1 - координата X точки применения умения\r\nx.2 - координата Y точки применения умения\r\nx.3 - значение boolean для определения процесса применения умения \r\n"
initially_off=1
action=CustomScriptCode("local player dummy_player = Player(PLAYER_NEUTRAL_PASSIVE)")
action=CustomScriptCode("local unit dummy_unit1")
action=CustomScriptCode("local unit dummy_unit2")
action=CustomScriptCode("local unit dummy_unit3")
action=CustomScriptCode("local real x1 = GetUnitX (udg_Hero_warrior)")
action=CustomScriptCode("local real y1 = GetUnitY (udg_Hero_warrior)")
action=CustomScriptCode("local real x2 = GetUnitX (udg_Hero_shaman)")
action=CustomScriptCode("local real y2 = GetUnitY (udg_Hero_shaman)")
action=CustomScriptCode("local real x3 = GetUnitX (udg_Hero_mechanic)")
action=CustomScriptCode("local real y3 = GetUnitY (udg_Hero_mechanic)")
action=CommentString("Сохраняем координаты точек применения умения в хэш-таблицу")
action=CustomScriptCode("call SaveRealBJ( x1, 31, 1, GetLastCreatedHashtableBJ() )")
action=CustomScriptCode("call SaveRealBJ( y1, 31, 2, GetLastCreatedHashtableBJ() )")
action=CustomScriptCode("call SaveRealBJ( x2, 32, 1, GetLastCreatedHashtableBJ() )")
action=CustomScriptCode("call SaveRealBJ( y2, 32, 2, GetLastCreatedHashtableBJ() )")
action=CustomScriptCode("call SaveRealBJ( x3, 33, 1, GetLastCreatedHashtableBJ() )")
action=CustomScriptCode("call SaveRealBJ( y3, 33, 2, GetLastCreatedHashtableBJ() )")
action=CommentString("Сохраняем значение \"Да\" для нашего умения в хэш-таблицу для фиксации процесса начала применения")
action=SaveBooleanBJ("true", "30", "3", GetLastCreatedHashtableBJ())
action=CommentString("Создаем юниты-пустышки в виде маркеров в точках применения умения")
action=CustomScriptCode("set dummy_unit1 = TeoCreateUnit (dummy_player, 'n02L', x1, y1, 0)")
action=CustomScriptCode("call UnitApplyTimedLife( dummy_unit1, 'BTLF', 2 )")
action=CustomScriptCode("set dummy_unit2 = TeoCreateUnit (dummy_player, 'n02L', x2, y2, 0)")
action=CustomScriptCode("call UnitApplyTimedLife( dummy_unit2, 'BTLF', 2 )")
action=CustomScriptCode("set dummy_unit3 = TeoCreateUnit (dummy_player, 'n02L', x3, y3, 0)")
action=CustomScriptCode("call UnitApplyTimedLife( dummy_unit3, 'BTLF', 2 )")
action=CustomScriptCode("call SetUnitAnimation( dummy_unit1, \"birth\" )")
action=CustomScriptCode("call SetUnitAnimation( dummy_unit2, \"birth\" )")
action=CustomScriptCode("call SetUnitAnimation( dummy_unit3, \"birth\" )")
action=CustomScriptCode("call QueueUnitAnimationBJ( dummy_unit1, \"stand\" )")
action=CustomScriptCode("call QueueUnitAnimationBJ( dummy_unit2, \"stand\" )")
action=CustomScriptCode("call QueueUnitAnimationBJ( dummy_unit3, \"stand\" )")
action=StartTimerBJ($Lighting_Storm_Timer, PeriodicOptionOneTime, "2.20")
action=CommentString("Обнуление переменных")
action=CustomScriptCode("set dummy_player = null")
action=CustomScriptCode("set dummy_unit1 = null")
action=CustomScriptCode("set dummy_unit2 = null")
action=CustomScriptCode("set dummy_unit3 = null")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A05H")
