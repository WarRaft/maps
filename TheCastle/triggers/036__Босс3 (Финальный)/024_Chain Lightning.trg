[trigger]
name="Chain Lightning"
description=""
initially_off=1
action=CustomScriptCode("local location point1 = GetRectCenter(gg_rct_REG_Boss3_Sphere1)")
action=CustomScriptCode("local location point2 = GetRectCenter(gg_rct_REG_Boss3_Sphere2)")
action=SetVariable($Random, GetRandomInt("1", "2"))
action=IfThenElseMultiple()
>action:2=CustomScriptCode("set udg_Boss3_Archmage_Sphere = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'n02V', GetLocationX(point2), GetLocationY(point2), 0 )")
>action:2=UnitApplyTimedLifeBJ("2.70", TimedLifeBuffCodeGeneric, $Boss3_Archmage_Sphere)
>action:2=SetUnitFlyHeightBJ($Boss3_Archmage_Sphere, "160.00", "50.00")
>action:2=CommentString("Создание эффекта появления")
>action:2=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Weapons\\\\Bolt\\\\BoltImpact.mdl\", GetLocationX(point2), GetLocationY(point2) ) )")
>action:2=TriggerSleepAction("1.00")
>action:2=IssueTargetOrder($Boss3_Archmage_Sphere, UnitOrderChainLightning, $gg_unit_n02U_0598)
>action:1=CustomScriptCode("set udg_Boss3_Archmage_Sphere = TeoCreateUnit( Player(PLAYER_NEUTRAL_AGGRESSIVE), 'n02V', GetLocationX(point1), GetLocationY(point1), 0 )")
>action:1=UnitApplyTimedLifeBJ("2.70", TimedLifeBuffCodeGeneric, $Boss3_Archmage_Sphere)
>action:1=SetUnitFlyHeightBJ($Boss3_Archmage_Sphere, "160.00", "50.00")
>action:1=CommentString("Создание эффекта появления")
>action:1=CustomScriptCode("call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Weapons\\\\Bolt\\\\BoltImpact.mdl\", GetLocationX(point1), GetLocationY(point1) ) )")
>action:1=TriggerSleepAction("1.00")
>action:1=IssueTargetOrder($Boss3_Archmage_Sphere, UnitOrderChainLightning, $gg_unit_n02U_0595)
>condition:0=OperatorCompareInteger($Random, OperatorEqual, "1")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A05K")
action=CommentString("Обнуление переменных")
action=CustomScriptCode("call RemoveLocation(point1)")
action=CustomScriptCode("call RemoveLocation(point2)")
action=CustomScriptCode("set point1 = null")
action=CustomScriptCode("set point2 = null")
