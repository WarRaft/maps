[trigger]
name="Foggy Mind Object Warrior"
description=""
initially_off=1
condition=OperatorCompareBoolean(UnitHasBuffBJ(GetTriggerUnit(), "B015"), OperatorEqualENE, "true")
action=CustomScriptCode("local unit hero = udg_Hero_warrior")
action=CustomScriptCode("local unit hero1 = udg_Hero_shaman")
action=CustomScriptCode("local unit hero2 = udg_Hero_mechanic")
action=CustomScriptCode("local unit target_unit")
action=CustomScriptCode("local location point_hero = GetUnitLoc(hero)")
action=CustomScriptCode("local location point_1")
action=CustomScriptCode("local location point_2")
action=CommentString("Если юнит живой, то запоминаем его местоположение")
action=CustomScriptCode("if (IsUnitAliveBJ(hero1) ) then")
action=CustomScriptCode("    set point_1 = GetUnitLoc(hero1)")
action=CustomScriptCode("else")
action=CustomScriptCode("    set point_1 = Location (-13000, -13000)")
action=CustomScriptCode("endif")
action=CustomScriptCode("if (IsUnitAliveBJ(hero2) ) then")
action=CustomScriptCode("    set point_2 = GetUnitLoc(hero2)")
action=CustomScriptCode("else")
action=CustomScriptCode("    set point_2 = Location (-13000, -13000)")
action=CustomScriptCode("endif")
action=CommentString("Определяем ближайшего к Герою юнита")
action=CustomScriptCode("if ( DistanceBetweenPoints(point_hero, point_1) < DistanceBetweenPoints(point_hero, point_2) ) then")
action=CustomScriptCode("    set target_unit = hero1")
action=CustomScriptCode("else")
action=CustomScriptCode("    set target_unit = hero2")
action=CustomScriptCode("endif")
action=DisableTrigger(GetTriggeringTrigger())
action=CustomScriptCode("call IssueTargetOrder( hero, \"attack\", target_unit )")
action=EnableTrigger(GetTriggeringTrigger())
action=CommentString("Обнуление переменных")
action=CustomScriptCode("call RemoveLocation(point_hero)")
action=CustomScriptCode("call RemoveLocation(point_1)")
action=CustomScriptCode("call RemoveLocation(point_2)")
action=CustomScriptCode("set point_hero = null")
action=CustomScriptCode("set point_1 = null")
action=CustomScriptCode("set point_2 = null")
action=CustomScriptCode("set hero = null")
action=CustomScriptCode("set hero1 = null")
action=CustomScriptCode("set hero2 = null")
action=CustomScriptCode("set target_unit = null")
