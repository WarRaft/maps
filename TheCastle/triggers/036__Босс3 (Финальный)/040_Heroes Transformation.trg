[trigger]
name="Heroes Transformation"
description=""
initially_off=1
action=CommentString("Трансформация Орка-воина")
action=SetUnitColor($Hero_warrior, Color02)
action=SetUnitVertexColorBJ($Hero_warrior, "93.00", "93.00", "93.00", "0")
action=CommentString("Умения")
action=UnitRemoveAbilityBJ("A002", $Hero_warrior)
action=UnitAddAbilityBJ("A04Z", $Hero_warrior)
action=UnitRemoveAbilityBJ("A03U", $Hero_warrior)
action=UnitAddAbilityBJ("A061", $Hero_warrior)
action=CommentString("Трансформация Тролля-шамана")
action=SetUnitColor($Hero_shaman, Color02)
action=SetUnitVertexColorBJ($Hero_shaman, "93.00", "93.00", "93.00", "0")
action=CommentString("Умения")
action=UnitRemoveAbilityBJ("A05A", $Hero_shaman)
action=ForForceMultiple($Players)
>action:0=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A02Z", GetEnumPlayer())
>action:0=SetPlayerAbilityAvailableBJ(EnableDisableEnable, "A05B", GetEnumPlayer())
action=IfThenElseMultiple()
>action:1=UnitAddAbilityBJ("A05C", $Hero_shaman)
>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A05B", $Hero_shaman), OperatorEqual, "0")
action=IfThenElseMultiple()
>action:1=UnitAddAbilityBJ("A05C", $Hero_shaman)
>action:1=SetUnitAbilityLevelSwapped("A05C", $Hero_shaman, "2")
>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A05B", $Hero_shaman), OperatorEqual, "1")
action=IfThenElseMultiple()
>action:1=UnitAddAbilityBJ("A05C", $Hero_shaman)
>action:1=SetUnitAbilityLevelSwapped("A05C", $Hero_shaman, "3")
>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A05B", $Hero_shaman), OperatorEqual, "2")
action=IfThenElseMultiple()
>action:1=UnitAddAbilityBJ("A05C", $Hero_shaman)
>action:1=SetUnitAbilityLevelSwapped("A05C", $Hero_shaman, "4")
>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A05B", $Hero_shaman), OperatorEqual, "3")
action=UnitRemoveAbilityBJ("A003", $Hero_shaman)
action=UnitRemoveAbilityBJ("A041", $Hero_shaman)
action=UnitRemoveAbilityBJ("A00O", $Hero_shaman)
action=UnitAddAbilityBJ("A04U", $Hero_shaman)
action=UnitAddAbilityBJ("A04V", $Hero_shaman)
action=UnitAddAbilityBJ("A04T", $Hero_shaman)
action=CommentString("Трансформация Гоблина-механика")
action=SetUnitColor($Hero_mechanic, Color02)
action=SetUnitVertexColorBJ($Hero_mechanic, "93.00", "93.00", "93.00", "0")
action=CommentString("Умения")
action=UnitRemoveAbilityBJ("A001", $Hero_mechanic)
action=UnitAddAbilityBJ("A04R", $Hero_mechanic)
action=UnitAddAbilityBJ("A04W", $Hero_mechanic)
