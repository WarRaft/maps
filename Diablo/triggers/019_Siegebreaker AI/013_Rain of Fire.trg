[trigger]
name="Rain of Fire"
description=""
initially_off=1
action=SetVariable($RainOfFire_No, GetRandomInt("1", "9"))
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_072)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "1")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_071)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "2")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_169)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "3")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_170)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "4")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_142)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "5")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_171)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "6")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_069)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "7")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_172)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "8")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_070)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "9")
action=AddSpecialEffectLocBJ(GetRectCenter($FireRegion), "war3mapImported\\Meteor.mdx")
action=SetVariable($RainOfFire, GetLastCreatedEffectBJ())
action=TriggerSleepAction("1.00")
action=ForGroupMultiple(GetUnitsInRangeOfLocMatching("250.00", GetRectCenter($FireRegion), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player00) ~""))
>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "350.00"))
action=ForGroupMultiple(GetUnitsInRangeOfLocMatching("250.00", GetRectCenter($FireRegion), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player01) ~""))
>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "350.00"))
action=ForGroupMultiple(GetUnitsInRangeOfLocMatching("250.00", GetRectCenter($FireRegion), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player02) ~""))
>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "350.00"))
action=ForGroupMultiple(GetUnitsInRangeOfLocMatching("250.00", GetRectCenter($FireRegion), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player03) ~""))
>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "350.00"))
action=ForGroupMultiple(GetUnitsInRangeOfLocMatching("250.00", GetRectCenter($FireRegion), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player04) ~""))
>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "350.00"))
action=ForGroupMultiple(GetUnitsInRangeOfLocMatching("250.00", GetRectCenter($FireRegion), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player05) ~""))
>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "350.00"))
action=TriggerSleepAction("1.00")
action=DestroyEffectBJ($RainOfFire)
event=TriggerRegisterTimerEventPeriodic("2.50")
