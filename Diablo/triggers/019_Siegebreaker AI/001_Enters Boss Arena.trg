[trigger]
name="Enters Boss Arena"
description=""
condition=OrMultiple()
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "Hamg")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "Otch")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "Ulic")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "O002")
action=DisableTrigger(GetTriggeringTrigger())
action=EnableTrigger($gg_trg_Intro_Triggers)
action=TriggerSleepAction("2")
action=PauseUnitBJ(PauseUnpauseOptionUnpause, $gg_unit_n00G_0079)
action=PauseUnitBJ(PauseUnpauseOptionUnpause, $gg_unit_n00G_0002)
action=PauseUnitBJ(PauseUnpauseOptionUnpause, $gg_unit_n00G_0077)
action=PauseUnitBJ(PauseUnpauseOptionUnpause, $gg_unit_n00G_0078)
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n00G_0002, "Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl")
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n00G_0079, "Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl")
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n00G_0077, "Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl")
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n00G_0078, "Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl")
action=SetUnitAnimation($gg_unit_n00G_0079, "stand 4")
action=SetUnitAnimation($gg_unit_n00G_0002, "stand 4")
action=SetUnitAnimation($gg_unit_n00G_0078, "stand 4")
action=SetUnitAnimation($gg_unit_n00G_0077, "stand 4")
action=UnitAddAbilityBJ("ACah", $gg_unit_n00G_0079)
action=UnitAddAbilityBJ("ACah", $gg_unit_n00G_0002)
action=UnitAddAbilityBJ("ACah", $gg_unit_n00G_0078)
action=UnitAddAbilityBJ("ACah", $gg_unit_n00G_0077)
action=TriggerSleepAction("2")
action=SetUnitOwner($gg_unit_n00G_0079, Player10, ChangeColorFalse)
action=SetUnitOwner($gg_unit_n00G_0002, Player10, ChangeColorFalse)
action=SetUnitOwner($gg_unit_n00G_0078, Player10, ChangeColorFalse)
action=SetUnitOwner($gg_unit_n00G_0077, Player10, ChangeColorFalse)
action=IssuePointOrderLoc($gg_unit_n00G_0079, UnitOrderAttack, GetRectCenter($gg_rct_Rect_142))
action=IssuePointOrderLoc($gg_unit_n00G_0002, UnitOrderAttack, GetRectCenter($gg_rct_Rect_142))
action=IssuePointOrderLoc($gg_unit_n00G_0078, UnitOrderAttack, GetRectCenter($gg_rct_Rect_142))
action=IssuePointOrderLoc($gg_unit_n00G_0077, UnitOrderAttack, GetRectCenter($gg_rct_Rect_142))
action=SetUnitInvulnerable($gg_unit_n00G_0079, InvulnerabilityVulnerable)
action=SetUnitInvulnerable($gg_unit_n00G_0077, InvulnerabilityVulnerable)
action=SetUnitInvulnerable($gg_unit_n00G_0078, InvulnerabilityVulnerable)
action=SetUnitInvulnerable($gg_unit_n00G_0002, InvulnerabilityVulnerable)
event=TriggerRegisterEnterRectSimple($gg_rct_Rect_142)
