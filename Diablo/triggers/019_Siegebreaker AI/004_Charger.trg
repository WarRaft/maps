[trigger]
name="Charger"
description=""
condition=OperatorCompareReal(GetUnitStateSwap(UnitStateLife, GetTriggerUnit()), OperatorLessEq, OperatorReal(OperatorReal("26000.00", OperatorMultiply, $Boss_HP), OperatorMultiply, "0.90"))
event=TriggerRegisterUnitEvent($gg_unit_n007_0225, UnitEventAttacked)
action=DisableTrigger(GetTriggeringTrigger())
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n007_0225, "Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl")
action=DestroyEffectBJ(GetLastCreatedEffectBJ())
action=UnitRemoveBuffsBJ(BuffTypeAll, $gg_unit_n007_0225)
action=SetUnitMoveSpeed($gg_unit_n007_0225, "600.00")
action=IssuePointOrderLoc($gg_unit_n007_0225, UnitOrderMove, GetRectCenter($gg_rct_Rect_069))
action=SetUnitAnimation($gg_unit_n007_0225, "walk fast")
action=SetVariable($BossDamageGroup["0"], GetUnitsInRangeOfLocMatching("300.00", GetUnitLoc($gg_unit_n007_0225), condition:GetBooleanAnd(condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player10) ~"", condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player11) ~"") ~""))
action=ForGroupMultiple($BossDamageGroup["0"])
>action:0=UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), "500.00", AttackTypeMelee, DamageTypeNormal)
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n007_0225, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
action=DestroyEffectBJ(GetLastCreatedEffectBJ())
action=CustomScriptCode("call DestroyGroup (udg_BossDamageGroup[0])")
action=PolledWait("0.50")
action=SetVariable($BossDamageGroup["0"], GetUnitsInRangeOfLocMatching("300.00", GetUnitLoc($gg_unit_n007_0225), condition:GetBooleanAnd(condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player10) ~"", condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player11) ~"") ~""))
action=ForGroupMultiple($BossDamageGroup["0"])
>action:0=UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), "500.00", AttackTypeMelee, DamageTypeNormal)
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n007_0225, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
action=DestroyEffectBJ(GetLastCreatedEffectBJ())
action=CustomScriptCode("call DestroyGroup (udg_BossDamageGroup[0])")
action=PolledWait("0.50")
action=SetVariable($BossDamageGroup["0"], GetUnitsInRangeOfLocMatching("300.00", GetUnitLoc($gg_unit_n007_0225), condition:GetBooleanAnd(condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player10) ~"", condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player11) ~"") ~""))
action=ForGroupMultiple($BossDamageGroup["0"])
>action:0=UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), "500.00", AttackTypeMelee, DamageTypeNormal)
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n007_0225, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
action=DestroyEffectBJ(GetLastCreatedEffectBJ())
action=CustomScriptCode("call DestroyGroup (udg_BossDamageGroup[0])")
action=PolledWait("0.50")
action=SetVariable($BossDamageGroup["0"], GetUnitsInRangeOfLocMatching("300.00", GetUnitLoc($gg_unit_n007_0225), condition:GetBooleanAnd(condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player10) ~"", condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player11) ~"") ~""))
action=ForGroupMultiple($BossDamageGroup["0"])
>action:0=UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), "500.00", AttackTypeMelee, DamageTypeNormal)
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n007_0225, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
action=DestroyEffectBJ(GetLastCreatedEffectBJ())
action=CustomScriptCode("call DestroyGroup (udg_BossDamageGroup[0])")
action=IssueImmediateOrder($gg_unit_n007_0225, UnitOrderStop)
