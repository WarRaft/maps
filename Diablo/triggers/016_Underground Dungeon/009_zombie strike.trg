[trigger]
name="zombie strike"
description=""
condition=OrMultiple()
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "Hamg")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "Otch")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "Ulic")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "O002")
action=DisableTrigger(GetTriggeringTrigger())
action=CreateNUnitsAtLoc("6", "n005", Player11, GetRectCenter($gg_rct_Rect_028), RealUnitFacing)
action=CreateNUnitsAtLoc("1", "n001", Player11, GetRectCenter($gg_rct_Rect_028), RealUnitFacing)
action=ForGroupMultiple(GetUnitsInRectAll($gg_rct_Rect_028))
>action:0=IssuePointOrderLoc(GetEnumUnit(), UnitOrderAttack, GetRectCenter($gg_rct_Rect_029))
action=TriggerSleepAction("5.00")
action=CreateNUnitsAtLoc("6", "n005", Player11, GetRectCenter($gg_rct_Rect_028), RealUnitFacing)
action=ForGroupMultiple(GetUnitsInRectAll($gg_rct_Rect_028))
>action:0=IssuePointOrderLoc(GetEnumUnit(), UnitOrderAttack, GetRectCenter($gg_rct_Rect_029))
event=TriggerRegisterEnterRectSimple($gg_rct_Rect_027)
action=TriggerSleepAction("10.00")
action=CreateNUnitsAtLoc("6", "n005", Player11, GetRectCenter($gg_rct_Rect_028), RealUnitFacing)
action=CreateNUnitsAtLoc("1", "n001", Player11, GetRectCenter($gg_rct_Rect_028), RealUnitFacing)
action=ForGroupMultiple(GetUnitsInRectAll($gg_rct_Rect_028))
>action:0=IssuePointOrderLoc(GetEnumUnit(), UnitOrderAttack, GetRectCenter($gg_rct_Rect_029))
action=ForGroupMultiple(GetUnitsInRectAll($gg_rct_Rect_026))
>action:0=IssuePointOrderLoc(GetEnumUnit(), UnitOrderAttack, GetRectCenter($gg_rct_Rect_025))
