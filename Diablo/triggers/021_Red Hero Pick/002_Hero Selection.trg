[trigger]
name="Hero Selection"
description=""
condition=OperatorCompareBoolean($PlayerSelectsUnit[GetConvertedPlayerId(GetTriggerPlayer())], OperatorEqualENE, "false")
action=IfThenElseMultiple()
>condition:0=OperatorCompareUnit($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())], OperatorNotEqualENE, GetTriggerUnit())
>action:1=ClearTextMessagesBJ(GetForceOfPlayer(GetTriggerPlayer()))
>action:1=DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_6688")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "Hamg")
action=IfThenElseMultiple()
>condition:0=OperatorCompareUnit($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())], OperatorNotEqualENE, GetTriggerUnit())
>action:1=ClearTextMessagesBJ(GetForceOfPlayer(GetTriggerPlayer()))
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "O002")
>action:1=DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_6681")
action=IfThenElseMultiple()
>condition:0=OperatorCompareUnit($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())], OperatorNotEqualENE, GetTriggerUnit())
>action:1=ClearTextMessagesBJ(GetForceOfPlayer(GetTriggerPlayer()))
>action:1=DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_6689")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "Otch")
action=IfThenElseMultiple()
>condition:0=OperatorCompareUnit($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())], OperatorNotEqualENE, GetTriggerUnit())
>action:1=ClearTextMessagesBJ(GetForceOfPlayer(GetTriggerPlayer()))
>action:1=DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_6690")
>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetTriggerUnit()), OperatorEqualENE, "Ulic")
action=SetVariable($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())], GetTriggerUnit())
event=TriggerRegisterPlayerSelectionEventBJ(Player00, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player01, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player02, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player03, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player04, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player05, SelDeselOptionSel)
