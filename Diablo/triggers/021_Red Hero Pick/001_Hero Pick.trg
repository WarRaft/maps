[trigger]
name="Hero Pick"
description="// Character Selection Modification (Barbarian Mana Leak Tie In)\r\n// May 21 2009\r\n// Ray Maloney\r\n\r\n1. A Barbarian comes into play with 0 mana.\r\n"
action=SetVariable($PlayerViewing[GetConvertedPlayerId(GetTriggerPlayer())], GetConvertedPlayerId(GetTriggerPlayer()))
action=SetVariable($TempUnitGroup, GetUnitsSelectedAll(GetTriggerPlayer()))
action=ClearTextMessagesBJ(GetForceOfPlayer(GetTriggerPlayer()))
action=IfThenElseMultiple()
>condition:0=OperatorCompareUnitCode("Otch", OperatorEqualENE, GetUnitTypeId($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())]))
>action:1=SetPlayerName(GetTriggerPlayer(), OperatorString($PlayerNames[GetConvertedPlayerId(GetTriggerPlayer())], " [Barbarian]"))
>action:1=DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_6614")
>action:1=CreateNUnitsAtLoc("1", GetUnitTypeId($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())]), GetTriggerPlayer(), GetRectCenter($gg_rct_Rect_019), RealUnitFacing)
>action:1=UnitAddAbilityBJ("A04V", GetLastCreatedUnit())
>action:1=SetPlayerAbilityAvailableBJ(EnableDisableDisable, "A04V", GetTriggerPlayer())
>action:1=SetVariable($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], GetLastCreatedUnit())
>action:1=SetUnitManaBJ($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], "0")
>action:1=ReplaceUnitBJ($Inventory_Dummy[OperatorInt(GetConvertedPlayerId(GetTriggerPlayer()), OperatorSubtract, "1")], "h003", UnitStateMethodRelative)
>action:1=SetVariable($Inventory_Dummy[OperatorInt(GetConvertedPlayerId(GetTriggerPlayer()), OperatorSubtract, "1")], GetLastReplacedUnitBJ())
action=IfThenElseMultiple()
>action:1=SetPlayerName(GetTriggerPlayer(), OperatorString($PlayerNames[GetConvertedPlayerId(GetTriggerPlayer())], " [Wizard]"))
>condition:0=OperatorCompareUnitCode("Hamg", OperatorEqualENE, GetUnitTypeId($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())]))
>action:1=DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_6615")
>action:1=CreateNUnitsAtLoc("1", GetUnitTypeId($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())]), GetTriggerPlayer(), GetRectCenter($gg_rct_Rect_019), RealUnitFacing)
>action:1=SetUnitColor(GetLastCreatedUnit(), GetPlayerColor(GetTriggerPlayer()))
>action:1=SetVariable($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], GetLastCreatedUnit())
>action:1=ReplaceUnitBJ($Inventory_Dummy[OperatorInt(GetConvertedPlayerId(GetTriggerPlayer()), OperatorSubtract, "1")], "h002", UnitStateMethodRelative)
>action:1=SetVariable($Inventory_Dummy[OperatorInt(GetConvertedPlayerId(GetTriggerPlayer()), OperatorSubtract, "1")], GetLastReplacedUnitBJ())
action=IfThenElseMultiple()
>condition:0=OperatorCompareUnitCode("Ulic", OperatorEqualENE, GetUnitTypeId($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())]))
>action:1=SetPlayerName(GetTriggerPlayer(), OperatorString($PlayerNames[GetConvertedPlayerId(GetTriggerPlayer())], " [Witch Doctor]"))
>action:1=DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_6616")
>action:1=CreateNUnitsAtLoc("1", GetUnitTypeId($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())]), GetTriggerPlayer(), GetRectCenter($gg_rct_Rect_019), RealUnitFacing)
>action:1=SetVariable($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], GetLastCreatedUnit())
>action:1=ReplaceUnitBJ($Inventory_Dummy[OperatorInt(GetConvertedPlayerId(GetTriggerPlayer()), OperatorSubtract, "1")], "h004", UnitStateMethodRelative)
>action:1=SetVariable($Inventory_Dummy[OperatorInt(GetConvertedPlayerId(GetTriggerPlayer()), OperatorSubtract, "1")], GetLastReplacedUnitBJ())
action=IfThenElseMultiple()
>condition:0=OperatorCompareUnitCode("O002", OperatorEqualENE, GetUnitTypeId($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())]))
>action:1=SetPlayerName(GetTriggerPlayer(), OperatorString($PlayerNames[GetConvertedPlayerId(GetTriggerPlayer())], " [Monk]"))
>action:1=DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_6617")
>action:1=CreateNUnitsAtLoc("1", GetUnitTypeId($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())]), GetTriggerPlayer(), GetRectCenter($gg_rct_Rect_019), RealUnitFacing)
>action:1=SetVariable($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], GetLastCreatedUnit())
>action:1=ReplaceUnitBJ($Inventory_Dummy[OperatorInt(GetConvertedPlayerId(GetTriggerPlayer()), OperatorSubtract, "1")], "h005", UnitStateMethodRelative)
>action:1=SetVariable($Inventory_Dummy[OperatorInt(GetConvertedPlayerId(GetTriggerPlayer()), OperatorSubtract, "1")], GetLastReplacedUnitBJ())
action=IssuePointOrderLoc($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], UnitOrderMove, GetRectCenter($gg_rct_Rect_003))
action=SetCameraFieldForPlayer(GetTriggerPlayer(), CameraFieldTargetDistance, "1800.00", "0")
action=SetPlayerState(GetTriggerPlayer(), PlayerStateLumber, "3")
action=SetVariable($Inventory_Revive_Count[GetConvertedPlayerId(GetTriggerPlayer())], "3")
action=SelectUnitForPlayerSingle($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], GetTriggerPlayer())
action=SetVariable($PlayerSelectsUnit[GetConvertedPlayerId(GetTriggerPlayer())], "true")
action=SetVariable($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())], UnitNull)
action=CommentString("Balance System")
action=ConditionalTriggerExecute($gg_trg_PlayerAutoAdjust)
condition=OperatorCompareBoolean($PlayerSelectsUnit[GetConvertedPlayerId(GetTriggerPlayer())], OperatorEqualENE, "false")
condition=OperatorCompareUnit($TempUnitArray[GetConvertedPlayerId(GetTriggerPlayer())], OperatorEqualENE, GetTriggerUnit())
event=TriggerRegisterPlayerSelectionEventBJ(Player00, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player01, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player02, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player03, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player04, SelDeselOptionSel)
event=TriggerRegisterPlayerSelectionEventBJ(Player05, SelDeselOptionSel)
