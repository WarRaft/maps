[trigger]
name="Unit Resizing"
description=""
event=MapInitializationEvent()
action=ForGroupMultiple(GetUnitsOfTypeIdAll("n000"))
>action:0=SetVariable($Zombie_Size, GetRandomInt("1", "3"))
>action:0=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=SetUnitScalePercent(GetEnumUnit(), "130.00", "130.00", "130.00")
>>condition:0=OperatorCompareInteger($Zombie_Size, OperatorEqual, "1")
>action:0=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=SetUnitScalePercent(GetEnumUnit(), "140.00", "140.00", "140.00")
>>condition:0=OperatorCompareInteger($Zombie_Size, OperatorEqual, "2")
>action:0=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=SetUnitScalePercent(GetEnumUnit(), "120.00", "120.00", "120.00")
>>condition:0=OperatorCompareInteger($Zombie_Size, OperatorEqual, "3")
action=ForGroupMultiple(GetUnitsOfTypeIdAll("n005"))
>action:0=SetVariable($Zombie_Size, GetRandomInt("1", "4"))
>action:0=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=SetUnitScalePercent(GetEnumUnit(), "130.00", "130.00", "130.00")
>>condition:0=OperatorCompareInteger($Zombie_Size, OperatorEqual, "1")
>action:0=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=SetUnitScalePercent(GetEnumUnit(), "140.00", "140.00", "140.00")
>>condition:0=OperatorCompareInteger($Zombie_Size, OperatorEqual, "2")
>action:0=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=SetUnitScalePercent(GetEnumUnit(), "150.00", "150.00", "150.00")
>>condition:0=OperatorCompareInteger($Zombie_Size, OperatorEqual, "3")
>action:0=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=SetUnitScalePercent(GetEnumUnit(), "160.00", "160.00", "160.00")
>>condition:0=OperatorCompareInteger($Zombie_Size, OperatorEqual, "4")
