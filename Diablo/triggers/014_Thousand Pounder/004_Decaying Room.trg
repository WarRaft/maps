[trigger]
name="Decaying Room"
description=""
initially_off=1
action=SetVariable($RainOfFire_No, GetRandomInt("1", "12"))
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_186)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "1")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_183)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "2")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_185)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "3")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_083)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "4")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_184)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "5")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_082)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "6")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_081)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "7")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_187)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "8")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_191)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "9")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_190)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "10")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_189)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "11")
action=IfThenElseMultiple()
>action:1=SetVariable($FireRegion, $gg_rct_Rect_188)
>condition:0=OperatorCompareInteger($RainOfFire_No, OperatorEqual, "12")
action=AddSpecialEffectLocBJ(GetRectCenter($FireRegion), "Doodads\\Cinematic\\CavernDust\\CavernDust.mdl")
action=SetVariable($RainOfFire, GetLastCreatedEffectBJ())
action=TriggerSleepAction("1.00")
action=AddSpecialEffectLocBJ(GetRectCenter($FireRegion), "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
action=SetVariable($rock_slide, GetLastCreatedEffectBJ())
action=SetVariable($BossDamageGroup["0"], GetUnitsInRangeOfLocMatching("200.00", GetRectCenter($FireRegion), condition:GetBooleanAnd(condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player10) ~"", condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player11) ~"") ~""))
action=ForGroupMultiple($BossDamageGroup["0"])
>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "280.00"))
action=TriggerSleepAction("1.00")
action=DestroyEffectBJ($RainOfFire)
action=DestroyEffectBJ($rock_slide)
event=TriggerRegisterTimerEventPeriodic("2.20")
