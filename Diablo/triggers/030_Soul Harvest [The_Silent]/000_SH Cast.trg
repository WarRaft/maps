[trigger]
name="SH Cast"
description="SH_Area = base area of the spell effect\r\nSH_Area_Increasement = area increasement of the spell per level, including level 1\r\n-----------------------------------------------------------------\r\nSH_Damage = base damage dealt to targets\r\nSH_Damage_Increasement = damage dealt increasement per level, including level 1\r\n-----------------------------------------------------------------\r\nSH_ManaBoost = base procent of the targets full health restored in mana to the witch docter with each kill \r\nSH_ManaBoost_Increasement = procent additional mana restored per level, including level 1\r\n-----------------------------------------------------------------\r\nSH_HealthBoost = base procent of the targets full health restored in health to the witch docter with each kill \r\nSH_HealthBoost_Increasement = procent additional health restored per level, including level 1"
action=SetVariable($SH_Area, "150.00")
action=SetVariable($SH_Area_Increasement, "50.00")
action=SetVariable($SH_Damage, "0.00")
action=SetVariable($SH_Damage_Increasement, "80.00")
action=SetVariable($SH_ManaBoost, "0.15")
action=SetVariable($SH_ManaBoost_Increasement, "0.10")
action=SetVariable($SH_HealthBoost, "0.15")
action=SetVariable($SH_HealthBoost_Increasement, "0.10")
action=SetVariable($SH_loc["2"], GetUnitLoc(GetSpellAbilityUnit()))
action=SetVariable($SH_Group, GetUnitsInRangeOfLocMatching(OperatorReal($SH_Area, OperatorAdd, OperatorReal($SH_Area_Increasement, OperatorMultiply, I2R(GetUnitAbilityLevelSwapped("A01G", GetSpellAbilityUnit())))), $SH_loc["2"], condition:GetBooleanAnd(condition:OperatorCompareBoolean(IsPlayerEnemy(GetOwningPlayer(GetFilterUnit()), GetOwningPlayer(GetSpellAbilityUnit())), OperatorEqualENE, "true") ~"", condition:GetBooleanAnd(condition:OperatorCompareBoolean(IsUnitAliveBJ(GetFilterUnit()), OperatorEqualENE, "true") ~"", condition:OperatorCompareBoolean(IsUnitType(GetFilterUnit(), UnitTypeUndead), OperatorEqualENE, "true") ~"") ~"") ~""))
action=ForGroupMultiple($SH_Group)
>action:0=SetVariable($SH_loc["1"], GetUnitLoc(GetEnumUnit()))
>action:0=AddSpecialEffectLocBJ($SH_loc["1"], "SoulHarvest2.mdx")
>action:0=CustomScriptCode("call RemoveLocation(udg_SH_loc[1])")
>action:0=IfThenElseMultiple()
>>condition:0=OperatorCompareReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorLessEq, OperatorReal($SH_Damage, OperatorAdd, OperatorReal($SH_Damage_Increasement, OperatorMultiply, I2R(GetUnitAbilityLevelSwapped("A01G", GetSpellAbilityUnit())))))
>>action:1=ConditionalTriggerExecute($gg_trg_SH_Effect)
>>action:1=SetUnitLifeBJ(GetSpellAbilityUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetSpellAbilityUnit()), OperatorAdd, OperatorReal(OperatorReal($SH_HealthBoost, OperatorAdd, OperatorReal($SH_HealthBoost_Increasement, OperatorMultiply, I2R(GetUnitAbilityLevelSwapped("A000", GetSpellAbilityUnit())))), OperatorMultiply, GetUnitStateSwap(UnitStateMaxLife, GetEnumUnit()))))
>>action:1=SetUnitManaBJ(GetSpellAbilityUnit(), OperatorReal(GetUnitStateSwap(UnitStateMana, GetSpellAbilityUnit()), OperatorAdd, OperatorReal($SH_ManaBoost, OperatorAdd, OperatorReal($SH_ManaBoost_Increasement, OperatorMultiply, I2R(GetUnitAbilityLevelSwapped("A000", GetSpellAbilityUnit()))))))
>>action:1=KillUnit(GetEnumUnit())
>action:0=UnitDamageTargetBJ(GetSpellAbilityUnit(), GetEnumUnit(), OperatorReal($SH_Damage, OperatorAdd, OperatorReal($SH_Damage_Increasement, OperatorMultiply, I2R(GetUnitAbilityLevelSwapped("A000", GetSpellAbilityUnit())))), AttackTypeMagic, DamageTypeDeath)
action=CustomScriptCode("call RemoveLocation(udg_SH_loc[2])")
action=CustomScriptCode("call DestroyGroup(udg_SH_Group)")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A01O")
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventSpellEffect)
