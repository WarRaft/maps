[trigger]
name="SK Inferno 1"
description=""
event=TriggerRegisterUnitEvent($gg_unit_n002_0047, UnitEventAttacked)
condition=OperatorCompareReal(GetUnitStateSwap(UnitStateLife, GetTriggerUnit()), OperatorLessEq, OperatorReal(OperatorReal("16000.00", OperatorMultiply, $Boss_HP), OperatorMultiply, "0.70"))
action=DisableTrigger(GetTriggeringTrigger())
action=DisplayTextToForce(GetPlayersAll(), "TRIGSTR_235")
action=PauseUnitBJ(PauseUnpauseOptionPause, $gg_unit_n002_0047)
action=SetUnitAnimation($gg_unit_n002_0047, "stand channel")
action=TriggerSleepAction("1.00")
action=AddSpecialEffectLocBJ(GetRectCenter($gg_rct_Region_032_Copy_13), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrike1.mdl")
action=SetVariable($SK_Inferno["0"], GetLastCreatedEffectBJ())
action=SetVariable($BossDamageGroup["0"], GetUnitsInRangeOfLocMatching("300.00", GetRectCenter($gg_rct_Region_032_Copy_13), condition:GetBooleanAnd(condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player10) ~"", condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorNotEqualENE, Player11) ~"") ~""))
action=ForGroupMultiple($BossDamageGroup["0"])
>action:0=UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), "150.00", AttackTypeMelee, DamageTypeNormal)
action=CustomScriptCode("call DestroyGroup (udg_BossDamageGroup[0])")
