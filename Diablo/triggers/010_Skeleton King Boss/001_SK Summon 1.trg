[trigger]
name="SK Summon 1"
description=""
event=TriggerRegisterUnitEvent($gg_unit_n002_0047, UnitEventAttacked)
condition=OperatorCompareReal(GetUnitStateSwap(UnitStateLife, GetTriggerUnit()), OperatorLessEq, OperatorReal(OperatorReal("16000.00", OperatorMultiply, $Boss_HP), OperatorMultiply, "0.90"))
action=DisableTrigger(GetTriggeringTrigger())
action=AddSpecialEffectTargetUnitBJ("origin", $gg_unit_n002_0047, "Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl")
action=SetVariable($SK_Summon["0"], GetLastCreatedEffectBJ())
action=TriggerSleepAction("1.00")
action=AddSpecialEffectLocBJ(GetRectCenter($gg_rct_Rect_151), "Objects\\Spawnmodels\\NightElf\\NEDeathMedium\\NEDeath.mdl")
action=SetVariable($SK_Summon["1"], GetLastCreatedEffectBJ())
action=AddSpecialEffectLocBJ(GetRectCenter($gg_rct_Rect_151_Copy_3), "Objects\\Spawnmodels\\NightElf\\NEDeathMedium\\NEDeath.mdl")
action=SetVariable($SK_Summon["2"], GetLastCreatedEffectBJ())
action=AddSpecialEffectLocBJ(GetRectCenter($gg_rct_Rect_151_Copy_4), "Objects\\Spawnmodels\\NightElf\\NEDeathMedium\\NEDeath.mdl")
action=SetVariable($SK_Summon["3"], GetLastCreatedEffectBJ())
action=AddSpecialEffectLocBJ(GetRectCenter($gg_rct_Rect_151_Copy_7), "Objects\\Spawnmodels\\NightElf\\NEDeathMedium\\NEDeath.mdl")
action=SetVariable($SK_Summon["4"], GetLastCreatedEffectBJ())
action=CreateNUnitsAtLocFacingLocBJ("1", "n00N", Player10, GetRectCenter($gg_rct_Rect_151), GetUnitLoc($gg_unit_n002_0047))
action=CreateNUnitsAtLocFacingLocBJ("1", "n00N", Player10, GetRectCenter($gg_rct_Rect_151_Copy_3), GetUnitLoc($gg_unit_n002_0047))
action=CreateNUnitsAtLocFacingLocBJ("1", "n00N", Player10, GetRectCenter($gg_rct_Rect_151_Copy_4), GetUnitLoc($gg_unit_n002_0047))
action=CreateNUnitsAtLocFacingLocBJ("1", "n00N", Player10, GetRectCenter($gg_rct_Rect_151_Copy_7), GetUnitLoc($gg_unit_n002_0047))
action=ForGroupMultiple(GetUnitsInRectAll($gg_rct_SKArena))
>action:0=IfThenElseMultiple()
>>action:2=DoNothing()
>>action:1=IssuePointOrderLoc(GetEnumUnit(), UnitOrderAttack, GetRectCenter($gg_rct_Rect_021_Copy))
>>condition:0=OperatorComparePlayer(GetOwningPlayer(GetEnumUnit()), OperatorEqualENE, Player10)
action=TriggerSleepAction("4.00")
action=DestroyEffectBJ($SK_Summon["0"])
action=DestroyEffectBJ($SK_Summon["1"])
action=DestroyEffectBJ($SK_Summon["2"])
action=DestroyEffectBJ($SK_Summon["3"])
action=DestroyEffectBJ($SK_Summon["4"])
