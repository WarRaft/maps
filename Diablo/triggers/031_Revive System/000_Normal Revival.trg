[trigger]
name="Normal Revival"
description="// Revival System Modification (Barbarian Mana Leak Tie In)\r\n// May 21 2009\r\n// Ray Maloney\r\n\r\n1. A Barbarian comes back from the dead with 0 mana.\r\n"
action=IfThenElseMultiple()
>action:2=IfThenElseMultiple()
>>action:1=SetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateLumber, OperatorInt(GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateLumber), OperatorSubtract, "1"))
>>action:1=TriggerSleepAction("6.00")
>>action:1=SetVariable($rect, GetUnitLoc($Heroes[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]))
>>action:1=ReviveHeroLoc(GetTriggerUnit(), $rect, ShowHideShow)
>>action:1=CustomScriptCode("call RemoveLocation(udg_rect)")
>>action:1=SetUnitLifePercentBJ(GetTriggerUnit(), "100")
>>action:1=IfThenElseMultiple()
>>>condition:0=OperatorCompareBoolean(IsUnitInGroup(GetTriggerUnit(), GetUnitsOfTypeIdAll("Otch")), OperatorEqualENE, "true")
>>>action:1=SetUnitManaPercentBJ(GetTriggerUnit(), "0.00")
>>>action:2=SetUnitManaPercentBJ(GetTriggerUnit(), "100")
>>action:1=SetUnitInvulnerable(GetTriggerUnit(), InvulnerabilityInvulnerable)
>>action:1=TriggerSleepAction("3.00")
>>action:1=SetUnitInvulnerable(GetTriggerUnit(), InvulnerabilityVulnerable)
>>action:1=SelectUnitAddForPlayer(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
>>condition:0=OperatorCompareBoolean($HeroIsRevivable[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], OperatorEqualENE, "true")
>action:1=DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_6087")
>action:1=SetVariable($HeroIsRevivable[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "false")
>action:1=SetVariable($TempInt, GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit())))
>action:1=SetVariable($DeathCam_CurrentHero[GetConvertedPlayerId(GetTriggerPlayer())], GetConvertedPlayerId(GetTriggerPlayer()))
>action:1=ConditionalTriggerExecute($gg_trg_DropItems)
>action:1=ConditionalTriggerExecute($gg_trg_PlayerAutoAdjust)
>condition:0=OperatorCompareInteger(GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateLumber), OperatorEqual, "0")
condition=OperatorCompareUnit(GetTriggerUnit(), OperatorEqualENE, $Heroes[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventDeath)
