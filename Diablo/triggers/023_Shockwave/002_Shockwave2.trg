[trigger]
name="Shockwave2"
description=""
action=IfThenElseMultiple()
>action:1=EnableTrigger($gg_trg_Shockwave3)
>condition:0=OperatorCompareInteger($JD_Integers["1"], OperatorEqual, "0")
action=SetVariable($JD_Integers["1"], OperatorInt($JD_Integers["1"], OperatorAdd, "1"))
action=SetVariable($JD_Integers["2"], OperatorInt($JD_Integers["2"], OperatorAdd, "1"))
action=CommentString("The Integers above are counting the current active shockwave missiles.")
action=CommentString("This trigger always starts as soon as Shockwave1 ended. Shockwave1 starts with casting the ability, so this trigger is able to count the number of the current shockwaves.")
action=CommentString("The If-Then-Else Action activates the Shockwave3 trigger if the newest Shockwave casted is the only current active shockwave.")
action=CommentString("Below, i´m storing the variables of Shockwave1 into variables with arrays to make the spell MUI.")
action=SetVariable($JD_TempPoint["1"], GetUnitLoc($JDA_Unit))
action=SetVariable($JD_Distances[$JD_Integers["2"]], DistanceBetweenPoints($JD_TempPoint["1"], $JDA_TargetPoint))
action=SetVariable($JD_ReachedDistance[$JD_Integers["2"]], "0.00")
action=SetVariable($JD_LevelOfAbility[$JD_Integers["2"]], $JDA_LevelOfAbility)
action=SetVariable($JD_SpeedUnits[$JD_Integers["2"]], $JDA_Speed)
action=SetVariable($JD_Unit[$JD_Integers["2"]], $JDA_Unit)
action=SetVariable($JD_Angle[$JD_Integers["2"]], AngleBetweenPoints($JD_TempPoint["1"], $JDA_TargetPoint))
action=SetVariable($JD_Effect[$JD_Integers["2"]], $JDA_SpecialEffect)
action=SetVariable($JD_TreesDestroy[$JD_Integers["2"]], $JDA_DestroyTrees_Dash)
action=CommentString("I´m turning the collusion of the dummy unit off to prevent some bugs.")
action=SetUnitPathing($JDA_Unit, PathingOff)
action=CommentString("I´m adding the dummy to a group. This group consists of all current shockwave-dummies in the map.")
action=GroupAddUnitSimple($JDA_Unit, $JD_Group)
action=CommentString("This removes leaks to increase the effectivity of the spell.")
action=CustomScriptCode("call RemoveLocation (udg_JD_TempPoint[1])")
action=CustomScriptCode("call RemoveLocation (udg_JDA_TargetPoint)")
action=CommentString(" ")
action=CommentString("What have we done?")
action=CommentString(" ")
action=CommentString("We counted the current active shockwave spells and actiavted the Shockwave3 trigger.")
action=CommentString("We converted every variable of the Shockwave1 trigger to variables using arrays to allow us to make the spell (in the Shockwave3 trigger) MUI.")
action=CommentString("Additionally, we prevented some bugs by turning the dummy´s collusion off.")
action=CommentString("We added the dummy to the group of all dummy units.")
action=CommentString("Continue with Shockwave3")
