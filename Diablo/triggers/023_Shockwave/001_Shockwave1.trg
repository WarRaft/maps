[trigger]
name="Shockwave1"
description=""
action=CommentString("First of all, i´m storing the position of the casting unit, the targeted location and the target location of the shockwave missile in three variables.")
action=CommentString("This allows me to use these locations for the rest of my trigger.")
action=SetVariable($Shockwave_Point["1"], GetUnitLoc(GetTriggerUnit()))
action=SetVariable($Shockwave_Point["2"], GetSpellTargetLoc())
action=CommentString("I´m checking whether the targeted location is (graphical) on the casting unit.")
action=CommentString("If so, the shockwave will be released in the direction of the casting unit´s facing angle.")
action=CommentString("It simply avoids a bug.")
action=IfThenElseMultiple()
>action:2=SetVariable($Shockwave_Angle, AngleBetweenPoints($Shockwave_Point["1"], $Shockwave_Point["2"]))
>action:1=SetVariable($Shockwave_Angle, GetUnitFacing(GetTriggerUnit()))
>condition:0=OperatorCompareReal(DistanceBetweenPoints($Shockwave_Point["1"], $Shockwave_Point["2"]), OperatorLess, "100.00")
action=CommentString("Q: Why isn´t the targeted point equal to the target of the shockwave missile?")
action=CommentString("A: The range of the shockwave missile does not depend on the targeted location.")
action=CommentString("A: The default range of each shockwave is 800. If you change this value in the Object Editor, remember replacing the \"offset by 800\" in the variable below aswell.")
action=SetVariable($Shockwave_Point["3"], PolarProjectionBJ($Shockwave_Point["1"], "800.00", $Shockwave_Angle))
action=CommentString("Now i´m creating an invisible dummy at the caster´s position. The dummy belongs to the casting unit´s player.")
action=CommentString("Q: Why are you creating the dummy?")
action=CommentString("A: Moving the dummy along with the shockwave missile allows me to refer to the position of the missile by referring to the dummy.")
action=CreateNUnitsAtLoc("1", "n00K", GetOwningPlayer(GetTriggerUnit()), $Shockwave_Point["1"], $Shockwave_Angle)
action=CommentString("Now i´m starting the dummy´s movement.")
action=CommentString("I created a little system for it.")
action=CommentString("First of all, i´m storing all later necessary and available data in variables.")
action=SetVariable($JDA_Unit, GetLastCreatedUnit())
action=SetVariable($JDA_TargetPoint, $Shockwave_Point["3"])
action=CommentString("The speed will return the movementspeed of the dummy.")
action=SetVariable($JDA_Speed, "25.00")
action=CommentString("This special effect will appear if the dummy is moving.")
action=SetVariable($JDA_SpecialEffect, "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl")
action=CommentString("This checks whether tress in the shockwaves path should be destroyed.")
action=CommentString("Set to False to disable the destruction of environment.")
action=SetVariable($JDA_DestroyTrees_Dash, "true")
action=CommentString("Returns the level of the ability casted.")
action=SetVariable($JDA_LevelOfAbility, GetUnitAbilityLevelSwapped("A001", GetTriggerUnit()))
action=CommentString("Now i´m starting the Shockwave2 trigger.")
action=ConditionalTriggerExecute($gg_trg_Shockwave2)
action=CommentString("This removes leaks to increase the effectivity of the spell.")
action=CustomScriptCode("call RemoveLocation (udg_Shockwave_Point[1])")
action=CustomScriptCode("call RemoveLocation (udg_Shockwave_Point[2])")
action=CustomScriptCode("call RemoveLocation (udg_Shockwave_Point[3])")
action=CommentString(" ")
action=CommentString("What have we done?")
action=CommentString(" ")
action=CommentString("We created an invisible dummy at the casters location and stored multiple values and locations of the spell´s data to refer to them later.")
action=CommentString("Continue with Shockwave2")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A01K")
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventSpellEffect)
