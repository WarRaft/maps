[trigger]
name="Shockwave3"
description=""
initially_off=1
action=CommentString("I´ll try to explain this trigger as good as i´m able to.")
action=CommentString("I don´t expect you to understand this trigger immediately.")
action=CommentString("But trying to reproduce my steps may give you some ideas how to handle some aspects of GUI and Spells.")
action=CommentString("Now, we are kinda picking each current shockwave missile to refer to it´s own variable data and settings.")
action=ForLoopVarMultiple($JD_Integers["3"], "1", $JD_Integers["2"])
>action:0=CommentString("This checks if the dummy of the picked shockwave is still in the dummy group.")
>action:0=CommentString("I´m doing this to prevent a rare bug.")
>action:0=IfThenElseMultiple()
>>action:1=CommentString("Now wer are checking whether the travelled distance of the dummy is below the required distance to travel.")
>>action:1=IfThenElseMultiple()
>>>action:2=CommentString("If the dummy and the shockwave missile are reaching their end, the following actions are running.")
>>>action:2=CommentString("The counter for the special effect creation gets resetted.")
>>>action:1=CommentString("If the travelled distance of the dummy hasn´t reached the required distance yet, we are storing the current position of the dummy in a variable.")
>>>action:2=SetVariable($JD_Counter[$JD_Integers["3"]], "0.00")
>>>action:2=CommentString("The units, picked for the knockback, are removed from the unit group.")
>>>action:2=ForGroupMultiple($Shockwave_Group[$JD_Integers["3"]])
>>>>action:0=GroupRemoveUnitSimple(GetEnumUnit(), $Shockwave_Group[$JD_Integers["3"]])
>>>action:2=CommentString("The dummy is killed and removed from the dummy group.")
>>>action:2=GroupRemoveUnitSimple($JD_Unit[$JD_Integers["3"]], $JD_Group)
>>>action:2=KillUnit($JD_Unit[$JD_Integers["3"]])
>>>action:2=CommentString("The counter of the current active shockwaves decreases by one.")
>>>action:2=SetVariable($JD_Integers["1"], OperatorInt($JD_Integers["1"], OperatorSubtract, "1"))
>>>action:2=CommentString("The triggers are resetted if no active shockwaves left.")
>>>action:2=IfThenElseMultiple()
>>>>action:1=SetVariable($JD_Integers["2"], "0")
>>>>action:1=DisableTrigger(GetTriggeringTrigger())
>>>>condition:0=OperatorCompareInteger($JD_Integers["1"], OperatorEqual, "0")
>>>action:1=SetVariable($JD_TempPoint["1"], GetUnitLoc($JD_Unit[$JD_Integers["3"]]))
>>>action:1=CommentString("Now we are storing the loaction, to which the dummy should jump, in a variable.")
>>>action:1=SetVariable($JD_TempPoint["2"], PolarProjectionBJ($JD_TempPoint["1"], $JD_SpeedUnits[$JD_Integers["3"]], $JD_Angle[$JD_Integers["3"]]))
>>>action:1=CommentString("This checks whether this shockwave destroyes trees. If so, it destroys them.")
>>>action:1=IfThenElseMultiple()
>>>>action:1=EnumDestructablesInCircleBJ("150.00", $JD_TempPoint["2"], action:KillDestructable(GetEnumDestructable()) ~"DoNothing")
>>>>condition:0=OperatorCompareBoolean($JD_TreesDestroy[$JD_Integers["3"]], OperatorEqualENE, "true")
>>>action:1=CommentString("This moves the dummy to the just stored location to jump to.")
>>>action:1=SetUnitPositionLoc($JD_Unit[$JD_Integers["3"]], $JD_TempPoint["2"])
>>>action:1=CommentString("This stores the covered distance of the dummy.")
>>>action:1=CommentString("We are using this variable to check the required distance to move left.")
>>>action:1=SetVariable($JD_ReachedDistance[$JD_Integers["3"]], OperatorReal($JD_ReachedDistance[$JD_Integers["3"]], OperatorAdd, $JD_SpeedUnits[$JD_Integers["3"]]))
>>>action:1=CommentString("This is an individual counter. Every time running this trigger (every 0.02 seconds) the counter grows by 1.00.")
>>>action:1=CommentString("As soon as he´s reaching 5.00, he is resetted to 0.00 and a special effect will spawn at the dummys position (the dust effect).")
>>>action:1=SetVariable($JD_Counter[$JD_Integers["3"]], OperatorReal($JD_Counter[$JD_Integers["3"]], OperatorAdd, "1.00"))
>>>action:1=IfThenElseMultiple()
>>>>action:1=SetVariable($JD_Counter[$JD_Integers["3"]], "0.00")
>>>>action:1=AddSpecialEffectLocBJ($JD_TempPoint["2"], $JD_Effect[$JD_Integers["3"]])
>>>>action:1=DestroyEffectBJ(GetLastCreatedEffectBJ())
>>>>condition:0=OperatorCompareReal($JD_Counter[$JD_Integers["3"]], OperatorGreaterEq, "5.00")
>>>action:1=CommentString("Now we are picking every enemied unit in 150 AoE of the shockwave´s location to knock the picked units back.")
>>>action:1=CommentString("Units in a specific group (explained below) are not picked.")
>>>action:1=SetVariable($JD_PickGroup, GetUnitsInRangeOfLocMatching("150.00", $JD_TempPoint["2"], condition:GetBooleanAnd(condition:GetBooleanAnd(condition:OperatorCompareBoolean(IsUnitInGroup(GetFilterUnit(), $Shockwave_Group[$JD_Integers["3"]]), OperatorEqualENE, "false") ~"", condition:OperatorCompareBoolean(IsUnitType(GetFilterUnit(), UnitTypeStructure), OperatorEqualENE, "false") ~"") ~"", condition:GetBooleanAnd(condition:OperatorCompareBoolean(IsUnitType(GetFilterUnit(), UnitTypeMagicImmune), OperatorEqualENE, "false") ~"", condition:GetBooleanAnd(condition:OperatorCompareBoolean(IsUnitAliveBJ(GetFilterUnit()), OperatorEqualENE, "true") ~"", condition:OperatorCompareBoolean(IsUnitEnemy(GetFilterUnit(), GetOwningPlayer($JD_Unit[$JD_Integers["3"]])), OperatorEqualENE, "true") ~"") ~"") ~"") ~""))
>>>action:1=ForGroupMultiple($JD_PickGroup)
>>>>action:0=CommentString(" ")
>>>>action:0=CommentString("Knockback System by Paladon")
>>>>action:0=CommentString("I won´t explain the usage of my Knockback System here, i recommend you to download the System including a documentation at the Hiveworkshop.")
>>>>action:0=SetVariable($KBA_Caster, $JD_Unit[$JD_Integers["3"]])
>>>>action:0=SetVariable($KBA_TargetUnit, GetEnumUnit())
>>>>action:0=SetVariable($KBA_StartingPosition, $JD_TempPoint["2"])
>>>>action:0=SetVariable($KBA_Level, $JD_LevelOfAbility[$JD_Integers["3"]])
>>>>action:0=SetVariable($KBA_Speed, "7.00")
>>>>action:0=SetVariable($KBA_DistancePerLevel, "100.00")
>>>>action:0=SetVariable($KBA_SpecialEffects["1"], "Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl")
>>>>action:0=SetVariable($KBA_SpecialEffects["2"], "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
>>>>action:0=SetVariable($KBA_DestroyTrees, "true")
>>>>action:0=ConditionalTriggerExecute($gg_trg_Cast_A_Knockback)
>>>>action:0=CommentString("End of Knockback System by Paladon")
>>>>action:0=CommentString(" ")
>>>>action:0=CommentString("To prevent picking the picked units again (by this specific shockwave missile) we are adding them to an individual group.")
>>>>action:0=GroupAddUnitSimple(GetEnumUnit(), $Shockwave_Group[$JD_Integers["3"]])
>>>action:1=CommentString("This removes leaks to increase the effectivity of the spell.")
>>>action:1=CustomScriptCode("call DestroyGroup (udg_JD_PickGroup)")
>>>action:1=CustomScriptCode("call RemoveLocation (udg_JD_TempPoint[1])")
>>>action:1=CustomScriptCode("call RemoveLocation (udg_JD_TempPoint[2])")
>>>condition:0=OperatorCompareReal($JD_ReachedDistance[$JD_Integers["3"]], OperatorLess, $JD_Distances[$JD_Integers["3"]])
>>condition:0=OperatorCompareBoolean(IsUnitInGroup($JD_Unit[$JD_Integers["3"]], $JD_Group), OperatorEqualENE, "true")
event=TriggerRegisterTimerEventPeriodic("0.02")
