[trigger]
name="PlayerDifficulty"
description="// Difficulty Setter\r\n// May 21 2009\r\n// Ray Maloney\r\n\r\n1. Sets the xp gain and monster hp based on the number of players in the game"
action=SetPlayerHandicapBJ(Player11, $GameHandicap)
action=SetPlayerHandicapBJ(Player10, $GameHandicap)
action=SetPlayerHandicapXPBJ(Player00, $XPHandicap)
action=SetPlayerHandicapXPBJ(Player01, $XPHandicap)
action=SetPlayerHandicapXPBJ(Player02, $XPHandicap)
action=SetPlayerHandicapXPBJ(Player03, $XPHandicap)
action=SetPlayerHandicapXPBJ(Player04, $XPHandicap)
action=SetPlayerHandicapXPBJ(Player05, $XPHandicap)
