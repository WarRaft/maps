[trigger]
name="Cast A Knockback"
description=""
action=IfThenElseMultiple()
>action:1=GroupRemoveUnitSimple($KBA_TargetUnit, $KB_KnockbackedUnits)
>action:1=SetVariable($KB_CountBuffs, OperatorInt($KB_CountBuffs, OperatorSubtract, "1"))
>action:1=ForLoopVarMultiple($KB_GeneralIntegers["2"], "1", $KB_TotalKnockUnits)
>>action:0=IfThenElseMultiple()
>>>action:1=SetVariable($KB_GeneralIntegers["1"], $KB_GeneralIntegers["2"])
>>>action:1=SetVariable($KB_GeneralIntegers["2"], $KB_TotalKnockUnits)
>>>condition:0=OperatorCompareUnit($KB_Units[$KB_GeneralIntegers["1"]], OperatorEqualENE, $KBA_TargetUnit)
>action:1=IfThenElseMultiple()
>>condition:0=OperatorCompareInteger($KB_TotalKnockUnits, OperatorGreater, $KB_GeneralIntegers["1"])
>>action:1=SetVariable($KB_Levels[$KB_GeneralIntegers["1"]], $KB_Levels[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_Units[$KB_GeneralIntegers["1"]], $KB_Units[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_Angle[$KB_GeneralIntegers["1"]], $KB_Angle[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_MaxDistance[$KB_GeneralIntegers["1"]], $KB_MaxDistance[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_ReachedDistance[$KB_GeneralIntegers["1"]], $KB_ReachedDistance[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_ReduceSpeedReal[$KB_GeneralIntegers["1"]], $KB_ReduceSpeedReal[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_SpecificSpeed[$KB_GeneralIntegers["1"]], $KB_SpecificSpeed[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_Effects_1[$KB_GeneralIntegers["1"]], $KB_Effects_1[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_Effects_2[$KB_GeneralIntegers["1"]], $KB_Effects_2[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_DestroyTrees[$KB_GeneralIntegers["1"]], $KB_DestroyTrees[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_EffectCounter[$KB_GeneralIntegers["1"]], $KB_EffectCounter[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_EffectCounter2[$KB_GeneralIntegers["1"]], $KB_EffectCounter2[$KB_TotalKnockUnits])
>>action:1=SetVariable($KB_GeneralIntegers["1"], OperatorInt($KB_GeneralIntegers["1"], OperatorSubtract, "1"))
>action:1=SetVariable($KB_Units[$KB_TotalKnockUnits], UnitNull)
>action:1=SetVariable($KB_TotalKnockUnits, OperatorInt($KB_TotalKnockUnits, OperatorSubtract, "1"))
>action:1=IfThenElseMultiple()
>>action:1=SetVariable($KB_TotalKnockUnits, "0")
>>action:1=DisableTrigger($gg_trg_Get_Knockback)
>>condition:0=OperatorCompareInteger($KB_CountBuffs, OperatorEqual, "0")
>condition:0=OperatorCompareBoolean(IsUnitInGroup($KBA_TargetUnit, $KB_KnockbackedUnits), OperatorEqualENE, "true")
action=IfThenElseMultiple()
>action:1=EnableTrigger($gg_trg_Get_Knockback)
>condition:0=OperatorCompareInteger($KB_CountBuffs, OperatorEqual, "0")
action=SetVariable($KB_CountBuffs, OperatorInt($KB_CountBuffs, OperatorAdd, "1"))
action=SetVariable($KB_TotalKnockUnits, OperatorInt($KB_TotalKnockUnits, OperatorAdd, "1"))
action=SetVariable($KB_Casters[$KB_TotalKnockUnits], $KBA_Caster)
action=SetVariable($KB_Levels[$KB_TotalKnockUnits], $KBA_Level)
action=SetVariable($KB_Units[$KB_TotalKnockUnits], $KBA_TargetUnit)
action=SetVariable($KB_StartPositions[$KB_TotalKnockUnits], $KBA_StartingPosition)
action=SetVariable($KB_TempPoint[$KB_TotalKnockUnits], GetUnitLoc($KBA_TargetUnit))
action=SetVariable($KB_Angle[$KB_TotalKnockUnits], AngleBetweenPoints($KB_StartPositions[$KB_TotalKnockUnits], $KB_TempPoint[$KB_TotalKnockUnits]))
action=SetVariable($KB_MaxDistance[$KB_TotalKnockUnits], OperatorReal($KBA_DistancePerLevel, OperatorMultiply, I2R($KBA_Level)))
action=SetVariable($KB_ReachedDistance[$KB_TotalKnockUnits], "0.00")
action=SetVariable($KB_ReduceSpeedReal[$KB_GeneralIntegers["1"]], "0.00")
action=SetVariable($KB_SpecificSpeed[$KB_TotalKnockUnits], $KBA_Speed)
action=SetVariable($KB_Effects_1[$KB_TotalKnockUnits], $KBA_SpecialEffects["1"])
action=SetVariable($KB_Effects_2[$KB_TotalKnockUnits], $KBA_SpecialEffects["2"])
action=SetVariable($KB_DestroyTrees[$KB_TotalKnockUnits], $KBA_DestroyTrees)
action=SetVariable($KB_EffectCounter[$KB_GeneralIntegers["1"]], "0")
action=SetVariable($KB_EffectCounter2[$KB_GeneralIntegers["1"]], "0")
action=GroupAddUnitSimple($KBA_TargetUnit, $KB_KnockbackedUnits)
action=CustomScriptCode("call RemoveLocation (udg_KBA_StartingPosition)")
action=CustomScriptCode("call RemoveLocation (udg_KB_TempPoint [udg_KB_TotalKnockUnits] )")
action=CustomScriptCode("call RemoveLocation (udg_KB_StartPositions [udg_KB_TotalKnockUnits] )")
