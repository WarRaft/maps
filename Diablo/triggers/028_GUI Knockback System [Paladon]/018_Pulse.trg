[trigger]
name="Pulse"
description=""
action=CommentString("This are spell effects. They don´t affect the knockback.")
action=PolledWait("0.20")
action=SetVariable($Sample_Point, GetUnitLoc(GetTriggerUnit()))
action=SetVariable($Sample_Group, GetUnitsInRangeOfLocMatching("250.00", $Sample_Point, condition:GetBooleanAnd(condition:OperatorCompareBoolean(IsUnitType(GetFilterUnit(), UnitTypeStructure), OperatorEqualENE, "false") ~"", condition:GetBooleanAnd(condition:OperatorCompareBoolean(IsUnitType(GetFilterUnit(), UnitTypeMagicImmune), OperatorEqualENE, "false") ~"", condition:GetBooleanAnd(condition:OperatorCompareBoolean(IsUnitAliveBJ(GetFilterUnit()), OperatorEqualENE, "true") ~"", condition:OperatorCompareBoolean(IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())), OperatorEqualENE, "true") ~"") ~"") ~"") ~""))
action=CommentString(" ")
action=CommentString("This are the applied actions of the 'Actions to apply' trigger. They are in a loop to affect more than one unit.")
action=ForGroupMultiple($Sample_Group)
>action:0=SetVariable($KBA_Caster, GetTriggerUnit())
>action:0=SetVariable($KBA_TargetUnit, GetEnumUnit())
>action:0=SetVariable($KBA_Level, GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()))
>action:0=SetVariable($KBA_StartingPosition, GetUnitLoc(GetTriggerUnit()))
>action:0=SetVariable($KBA_Speed, "5.00")
>action:0=SetVariable($KBA_DistancePerLevel, "80.00")
>action:0=SetVariable($KBA_SpecialEffects["1"], "Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl")
>action:0=SetVariable($KBA_SpecialEffects["2"], "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
>action:0=SetVariable($KBA_DestroyTrees, "false")
>action:0=ConditionalTriggerExecute($gg_trg_Cast_A_Knockback)
action=CommentString(" ")
action=CustomScriptCode("call RemoveLocation (udg_Sample_Point)")
action=CustomScriptCode("call DestroyGroup (udg_Sample_Group)")
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A00N")
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventSpellCast)
