[trigger]
name="Get Knockback"
description=""
initially_off=1
action=ForLoopVarMultiple($KB_GeneralIntegers["1"], "1", $KB_TotalKnockUnits)
>action:0=IfThenElseMultiple()
>>condition:0=OperatorCompareBoolean(IsUnitInGroup($KB_Units[$KB_GeneralIntegers["1"]], $KB_KnockbackedUnits), OperatorEqualENE, "true")
>>action:1=IfThenElseMultiple()
>>>action:1=GroupRemoveUnitSimple($KB_Units[$KB_GeneralIntegers["1"]], $KB_KnockbackedUnits)
>>>action:1=SetVariable($KB_CountBuffs, OperatorInt($KB_CountBuffs, OperatorSubtract, "1"))
>>>action:1=IfThenElseMultiple()
>>>>condition:0=OperatorCompareInteger($KB_TotalKnockUnits, OperatorGreater, $KB_GeneralIntegers["1"])
>>>>action:1=SetVariable($KB_Levels[$KB_GeneralIntegers["1"]], $KB_Levels[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_Units[$KB_GeneralIntegers["1"]], $KB_Units[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_Angle[$KB_GeneralIntegers["1"]], $KB_Angle[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_MaxDistance[$KB_GeneralIntegers["1"]], $KB_MaxDistance[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_ReachedDistance[$KB_GeneralIntegers["1"]], $KB_ReachedDistance[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_ReduceSpeedReal[$KB_GeneralIntegers["1"]], $KB_ReduceSpeedReal[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_SpecificSpeed[$KB_GeneralIntegers["1"]], $KB_SpecificSpeed[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_Effects_1[$KB_GeneralIntegers["1"]], $KB_Effects_1[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_Effects_2[$KB_GeneralIntegers["1"]], $KB_Effects_2[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_DestroyTrees[$KB_GeneralIntegers["1"]], $KB_DestroyTrees[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_EffectCounter[$KB_GeneralIntegers["1"]], $KB_EffectCounter[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_EffectCounter2[$KB_GeneralIntegers["1"]], $KB_EffectCounter2[$KB_TotalKnockUnits])
>>>>action:1=SetVariable($KB_GeneralIntegers["1"], OperatorInt($KB_GeneralIntegers["1"], OperatorSubtract, "1"))
>>>action:1=SetVariable($KB_Units[$KB_TotalKnockUnits], UnitNull)
>>>action:1=SetVariable($KB_TotalKnockUnits, OperatorInt($KB_TotalKnockUnits, OperatorSubtract, "1"))
>>>action:1=IfThenElseMultiple()
>>>>action:1=SetVariable($KB_TotalKnockUnits, "0")
>>>>action:1=DisableTrigger(GetTriggeringTrigger())
>>>>condition:0=OperatorCompareInteger($KB_CountBuffs, OperatorEqual, "0")
>>>action:2=SetVariable($KB_ReducedReal, OperatorReal(OperatorReal($KB_SpecificSpeed[$KB_GeneralIntegers["1"]], OperatorDivide, $KB_MaxDistance[$KB_GeneralIntegers["1"]]), OperatorMultiply, $KB_ReachedDistance[$KB_GeneralIntegers["1"]]))
>>>action:2=SetVariable($KB_ReduceSpeedReal[$KB_GeneralIntegers["1"]], OperatorReal($KB_ReducedReal, OperatorSubtract, OperatorReal($KB_ReduceSpeedReal[$KB_GeneralIntegers["1"]], OperatorMultiply, "0.10")))
>>>action:2=SetVariable($KB_TempReal, OperatorReal(OperatorReal($KB_SpecificSpeed[$KB_GeneralIntegers["1"]], OperatorSubtract, $KB_ReduceSpeedReal[$KB_GeneralIntegers["1"]]), OperatorMultiply, "2.00"))
>>>action:2=SetVariable($KB_TempPoint["1"], GetUnitLoc($KB_Units[$KB_GeneralIntegers["1"]]))
>>>action:2=SetVariable($KB_TempPoint["2"], PolarProjectionBJ($KB_TempPoint["1"], $KB_TempReal, $KB_Angle[$KB_GeneralIntegers["1"]]))
>>>action:2=SetVariable($KB_EffectCounter[$KB_GeneralIntegers["1"]], OperatorInt($KB_EffectCounter[$KB_GeneralIntegers["1"]], OperatorAdd, "1"))
>>>action:2=SetVariable($KB_EffectCounter2[$KB_GeneralIntegers["1"]], OperatorInt($KB_EffectCounter2[$KB_GeneralIntegers["1"]], OperatorAdd, "1"))
>>>action:2=IfThenElseMultiple()
>>>>condition:0=OperatorCompareBoolean($KB_DestroyTrees[$KB_GeneralIntegers["1"]], OperatorEqualENE, "true")
>>>>action:1=EnumDestructablesInCircleBJMultiple("200.00", $KB_TempPoint["2"])
>>>>>action:0=KillDestructable(GetEnumDestructable())
>>>action:2=IfThenElseMultiple()
>>>>action:1=SetVariable($KB_EffectCounter[$KB_GeneralIntegers["1"]], "0")
>>>>action:1=AddSpecialEffectLocBJ($KB_TempPoint["1"], $KB_Effects_1[$KB_GeneralIntegers["1"]])
>>>>action:1=DestroyEffectBJ(GetLastCreatedEffectBJ())
>>>>condition:0=OperatorCompareInteger($KB_EffectCounter[$KB_GeneralIntegers["1"]], OperatorEqual, "6")
>>>action:2=IfThenElseMultiple()
>>>>condition:0=OperatorCompareInteger($KB_EffectCounter2[$KB_GeneralIntegers["1"]], OperatorEqual, "8")
>>>>action:1=SetVariable($KB_EffectCounter2[$KB_GeneralIntegers["1"]], "0")
>>>>action:1=AddSpecialEffectLocBJ($KB_TempPoint["1"], $KB_Effects_2[$KB_GeneralIntegers["1"]])
>>>>action:1=DestroyEffectBJ(GetLastCreatedEffectBJ())
>>>action:2=SetUnitPositionLoc($KB_Units[$KB_GeneralIntegers["1"]], $KB_TempPoint["2"])
>>>action:2=CustomScriptCode("call RemoveLocation (udg_KB_TempPoint[1])")
>>>action:2=CustomScriptCode("call RemoveLocation (udg_KB_TempPoint[2])")
>>>action:2=SetVariable($KB_ReachedDistance[$KB_GeneralIntegers["1"]], OperatorReal($KB_ReachedDistance[$KB_GeneralIntegers["1"]], OperatorAdd, $KB_TempReal))
>>>condition:0=OperatorCompareReal($KB_ReachedDistance[$KB_GeneralIntegers["1"]], OperatorGreaterEq, $KB_MaxDistance[$KB_GeneralIntegers["1"]])
event=TriggerRegisterTimerEventPeriodic("0.02")
