[trigger]
name="Actions to apply"
description=""
enabled=0
action=CommentString("This is the caster of the knockback.")
action=CommentString("If you use spells, it´s mostly the 'triggering unit' or the 'casting unit'.")
action=SetVariable($KBA_Caster, GetTriggerUnit())
action=CommentString(" ")
action=CommentString("This is the unit knocked back. Set this variable to the unit which should receive the knockback.")
action=CommentString("Use for example 'Target unit of ability being cast' or 'picked unit', 'attacking unit', 'casting unit', 'triggering unit' or whatever.")
action=SetVariable($KBA_TargetUnit, GetSpellTargetUnit())
action=CommentString(" ")
action=CommentString("This is the location from where the unit should be knocked back.")
action=CommentString("Don´t set this location to the position of the unit which should be knocked back.")
action=SetVariable($KBA_StartingPosition, GetUnitLoc(GetSpellAbilityUnit()))
action=CommentString(" ")
action=CommentString("This saves the level of the spell.")
action=CommentString("If the level shouldn´t influence the knockback, set the variable to 1.")
action=SetVariable($KBA_Level, GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()))
action=CommentString(" ")
action=CommentString("This determines the speed of the knockback.")
action=CommentString("If you set the speed to 0, the unit won´t move.")
action=SetVariable($KBA_Speed, "7.00")
action=CommentString(" ")
action=CommentString("This determines the distance knockbacked per level of the spell.")
action=CommentString("If the level shouldn´t influence the knockback, simply set this variable to the distance you wish.")
action=SetVariable($KBA_DistancePerLevel, "100.00")
action=CommentString(" ")
action=CommentString("The following both variables store the path of the effects used.")
action=CommentString("Effect[1] is more often used than Effect[2].")
action=SetVariable($KBA_SpecialEffects["1"], "Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl")
action=SetVariable($KBA_SpecialEffects["2"], "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
action=CommentString(" ")
action=CommentString("Set the following variable to 'false' to allow trees to survive a collision with a knocked unit.")
action=CommentString("Set the following variable to 'true' to kill trees upon collision with a knocked unit.")
action=SetVariable($KBA_DestroyTrees, "false")
action=CommentString(" ")
action=CommentString("After setting the needed variables we start the knockback.")
action=ConditionalTriggerExecute($gg_trg_Cast_A_Knockback)
action=CommentString("Done. The unit knockbacked if the trigger triggers.")
