[trigger]
name="Barbarian Fury Gain"
description=""
action=IfThenElseMultiple()
>action:2=IfThenElseMultiple()
>>action:2=SetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateGold, OperatorInt(GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateGold), OperatorAdd, "1"))
>>action:1=SetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateGold, "5")
>>condition:0=OperatorCompareInteger(GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateGold), OperatorGreaterEq, "5")
>action:1=SetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateGold, OperatorInt(GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateGold), OperatorAdd, "1"))
>action:1=SetVariable($Fury_Integer, GetRandomInt("1", "4"))
>action:1=IfThenElseMultiple()
>>action:2=IfThenElseMultiple()
>>>action:2=IfThenElseMultiple()
>>>>action:2=DoNothing()
>>>>action:2=IfThenElseMultiple()
>>>>>action:2=DoNothing()
>>>>>action:1=UnitAddAbilityBJ("A04N", GetTriggerUnit())
>>>>>condition:0=OrMultiple()
>>>>>>condition:0=OperatorCompareInteger($Fury_Integer, OperatorEqual, "4")
>>>>action:1=UnitAddAbilityBJ("A041", GetTriggerUnit())
>>>>condition:0=OrMultiple()
>>>>>condition:0=OperatorCompareInteger($Fury_Integer, OperatorEqual, "3")
>>>action:1=UnitAddAbilityBJ("A01L", GetTriggerUnit())
>>>condition:0=OrMultiple()
>>>>condition:0=OperatorCompareInteger($Fury_Integer, OperatorEqual, "2")
>>action:1=UnitAddAbilityBJ("A01J", GetTriggerUnit())
>>condition:0=OrMultiple()
>>>condition:0=OperatorCompareInteger($Fury_Integer, OperatorEqual, "1")
>condition:0=OperatorCompareInteger(GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateGold), OperatorEqual, "4")
condition=OrMultiple()
>condition:0=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "AUim")
>condition:0=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "AOws")
>condition:0=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A002")
>condition:0=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A01B")
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventSpellEffect)
