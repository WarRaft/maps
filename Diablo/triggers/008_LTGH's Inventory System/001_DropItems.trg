[trigger]
name="DropItems"
description=""
action=CommentString("Player 1")
action=IfThenElseMultiple()
>condition:0=OperatorCompareInteger($TempInt, OperatorEqual, "1")
>action:1=ForLoopAMultiple("1", "34")
>>action:0=SetVariable($rect, GetUnitLoc($Heroes[$TempInt]))
>>action:0=CreateItemLoc($A_Item_Type_1[GetForLoopIndexA()], $rect)
>>action:0=CustomScriptCode("call RemoveLocation(udg_rect)")
action=CommentString("Player 2")
action=IfThenElseMultiple()
