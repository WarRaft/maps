[trigger]
name="TESTING"
description=""
enabled=0
action=SetVariable($TempBoolean, "false")
action=SetVariable($TempInt, GetForLoopIndexA())
action=SetVariable($Temp_Item_Array["1"], ItemNull)
action=SetVariable($Temp_Item_Array["2"], ItemNull)
action=SetVariable($Temp_Item_Array["3"], ItemNull)
action=SetVariable($Temp_Item_Array["4"], ItemNull)
action=ForLoopBMultiple("1", "4")
>action:0=IfThenElseMultiple()
>>action:1=IfThenElseMultiple()
>>>action:1=IfThenElseMultiple()
>>>>action:1=UnitAddItemByIdSwapped("ratf", $Heroes[GetConvertedPlayerId(GetTriggerPlayer())])
>>>>action:1=SetVariable($Temp_Item_Array[GetForLoopIndexB()], GetLastCreatedItem())
>>>>condition:0=OperatorCompareItem(UnitItemInSlotBJ($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], GetForLoopIndexB()), OperatorEqualENE, ItemNull)
>>>action:2=RemoveItem($Temp_Item_Array["1"])
>>>action:2=SetVariable($Temp_Item_Array["1"], ItemNull)
>>>action:2=RemoveItem($Temp_Item_Array["2"])
>>>action:2=SetVariable($Temp_Item_Array["2"], ItemNull)
>>>action:2=RemoveItem($Temp_Item_Array["3"])
>>>action:2=SetVariable($Temp_Item_Array["3"], ItemNull)
>>>action:2=RemoveItem($Temp_Item_Array["4"])
>>>action:2=SetVariable($Temp_Item_Array["4"], ItemNull)
>>>action:2=SetVariable($TempBoolean, "true")
>>>condition:0=OperatorCompareInteger(OperatorInt(GetUnitUserData(GetTriggerUnit()), OperatorSubtract, "15"), OperatorNotEqual, GetForLoopIndexB())
>>condition:0=OperatorCompareBoolean($TempBoolean, OperatorEqualENE, "false")
