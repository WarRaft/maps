[trigger]
name="Inventory Switch Camera"
description=""
initially_off=1
condition=OperatorCompareUnit($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], OperatorNotEqualENE, UnitNull)
condition=OperatorCompareBoolean($TurnCameraOff, OperatorEqualENE, "false")
action=IfThenElseMultiple()
>action:2=PauseUnitBJ(PauseUnpauseOptionUnpause, $Heroes[GetConvertedPlayerId(GetTriggerPlayer())])
>action:1=PauseUnitBJ(PauseUnpauseOptionPause, $Heroes[GetConvertedPlayerId(GetTriggerPlayer())])
>action:1=SetVariable($Inventory_Player_Is_Viewing[GetConvertedPlayerId(GetTriggerPlayer())], "true")
>action:1=CustomScriptCode("if ( GetLocalPlayer() == GetTriggerPlayer() ) then")
>action:1=DisplayCineFilterBJ(ShowHideHide)
>action:1=EnableDragSelect(EnableDisableDisable, EnableDisableDisable)
>action:1=EnablePreSelect(EnableDisableDisable, EnableDisableDisable)
>action:1=CustomScriptCode("endif")
>action:1=CreateFogModifierRectBJ(EnabledDisabledEnabled, GetTriggerPlayer(), FogStateVisible, $Inventory_Visibility_Over_Invt[GetConvertedPlayerId(GetTriggerPlayer())])
>action:1=CameraSetupApplyForPlayer(CameraApply, $Inventory_Camera[GetConvertedPlayerId(GetTriggerPlayer())], GetTriggerPlayer(), "0")
>action:1=SelectUnitForPlayerSingle($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], GetTriggerPlayer())
>action:1=EnumDestructablesInRectAllMultiple($Inventory_Visibility_Over_Invt[GetConvertedPlayerId(GetTriggerPlayer())])
>>action:0=ShowDestructableBJ(ShowHideShow, GetEnumDestructable())
>action:1=CustomScriptCode("set DEAD[IND[GetPlayerId(GetTriggerPlayer())]] = true")
>action:2=SetVariable($Inventory_Player_Is_Viewing[GetConvertedPlayerId(GetTriggerPlayer())], "false")
>action:2=CustomScriptCode("if ( GetLocalPlayer() == GetTriggerPlayer() ) then")
>action:2=EnableDragSelect(EnableDisableEnable, EnableDisableEnable)
>action:2=EnablePreSelect(EnableDisableEnable, EnableDisableEnable)
>action:2=DisplayCineFilterBJ(ShowHideShow)
>action:2=CustomScriptCode("endif")
>action:2=CreateFogModifierRectBJ(EnabledDisabledEnabled, GetTriggerPlayer(), FogStateFogged, $Inventory_Visibility_Over_Invt[GetConvertedPlayerId(GetTriggerPlayer())])
>action:2=SetVariable($rect, GetUnitLoc($Heroes[GetConvertedPlayerId(GetTriggerPlayer())]))
>action:2=PanCameraToTimedLocForPlayer(GetTriggerPlayer(), $rect, "0")
>action:2=CustomScriptCode("call RemoveLocation(udg_rect)")
>action:2=SetCameraFieldForPlayer(GetTriggerPlayer(), CameraFieldTargetDistance, "1800.00", "0.00")
>action:2=SelectUnitForPlayerSingle($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], GetTriggerPlayer())
>action:2=EnumDestructablesInRectAllMultiple($Inventory_Visibility_Over_Invt[GetConvertedPlayerId(GetTriggerPlayer())])
>>action:0=ShowDestructableBJ(ShowHideHide, GetEnumDestructable())
>action:2=CommentString("Delete Selection Circle")
>action:2=RemoveDestructable($Selection_Circle[GetConvertedPlayerId(GetTriggerPlayer())])
>action:2=SetVariable($Selection_Circle[GetConvertedPlayerId(GetTriggerPlayer())], DestructableNull)
>action:2=SetVariable($Inventory_Selected_True_False[GetConvertedPlayerId(GetTriggerPlayer())], "0")
>action:2=SetVariable($Inventory_Selected_Slot[GetConvertedPlayerId(GetTriggerPlayer())], "0")
>action:2=CommentString("Hide multiboard")
>action:2=ForLoopAMultiple("1", "100")
>>action:0=CustomScriptCode("if ( GetLocalPlayer() == GetTriggerPlayer() ) then")
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Helmet[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Shoulders[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Neckless[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Gloves[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Chest[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Pants[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Belt[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Boots[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Ring[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Weapons[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Ress[GetForLoopIndexA()])
>>action:0=MultiboardDisplayBJ(ShowHideHide, $A_Multiboard_Potions[GetForLoopIndexA()])
>>action:0=CustomScriptCode("endif")
>action:2=CustomScriptCode("set DEAD[IND[GetPlayerId(GetTriggerPlayer())]] = false")
>condition:0=OperatorCompareBoolean($Inventory_Player_Is_Viewing[GetConvertedPlayerId(GetTriggerPlayer())], OperatorEqualENE, "false")
event=TriggerRegisterPlayerEventEndCinematic(Player00)
event=TriggerRegisterPlayerEventEndCinematic(Player01)
event=TriggerRegisterPlayerEventEndCinematic(Player02)
event=TriggerRegisterPlayerEventEndCinematic(Player03)
event=TriggerRegisterPlayerEventEndCinematic(Player04)
event=TriggerRegisterPlayerEventEndCinematic(Player05)
