[trigger]
name="Inventory Use potion"
description=""
action=CommentString("Player 1")
action=IfThenElseMultiple()
>condition:0=OperatorCompareUnit(GetManipulatingUnit(), OperatorEqualENE, $Heroes["1"])
>action:1=ForLoopAMultiple("1", "4")
>>action:0=IfThenElseMultiple()
>>>condition:0=OperatorCompareItem(GetManipulatedItem(), OperatorEqualENE, UnitItemInSlotBJ(GetManipulatingUnit(), GetForLoopIndexA()))
>>>action:1=CommentString("Remove Value")
>>>action:1=SetVariable($A_Item_Class_1[OperatorInt(GetForLoopIndexA(), OperatorAdd, "15")], GetItemType(ItemNull))
>>>action:1=SetVariable($A_Item_Type_1[OperatorInt(GetForLoopIndexA(), OperatorAdd, "15")], GetItemTypeId(ItemNull))
>>>action:1=CommentString("Delete icon & Selection Circle")
>>>action:1=RemoveDestructable($Inventory_Item_Player1[OperatorInt(GetForLoopIndexA(), OperatorAdd, "15")])
>>>action:1=RemoveDestructable($Selection_Circle[OperatorInt(GetForLoopIndexA(), OperatorAdd, "15")])
>>>action:1=CommentString("Reset Selection")
>>>action:1=SetVariable($Inventory_Item_Player1[OperatorInt(GetForLoopIndexA(), OperatorAdd, "15")], DestructableNull)
>>>action:1=SetVariable($A_Inventory_Item_ID_Player1[OperatorInt(GetForLoopIndexA(), OperatorAdd, "15")], "0")
>>>action:1=SetVariable($Inventory_Selected_Is_True[OperatorInt(GetForLoopIndexA(), OperatorAdd, "15")], "false")
>>>action:1=SetVariable($Inventory_Selected_Slot[OperatorInt(GetForLoopIndexA(), OperatorAdd, "15")], "0")
>>>action:1=RemoveItem(GetManipulatedItem())
action=CommentString("Player 2")
