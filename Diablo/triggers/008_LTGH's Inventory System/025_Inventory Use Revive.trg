[trigger]
name="Inventory Use Revive"
description=""
enabled=0
condition=OperatorCompareUnit(GetDyingUnit(), OperatorEqualENE, $Heroes[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))])
action=SetVariable($DeathLocations[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))], GetUnitLoc($Heroes[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]))
action=IfThenElseMultiple()
>action:1=SetVariable($ReviveAlreadyInUse[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))], "true")
>action:1=CustomScriptCode("set DEAD[IND[GetPlayerId(GetTriggerPlayer())]] = true")
>action:1=SetVariable($Inventory_Revive_Count[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], OperatorInt($Inventory_Revive_Count[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], OperatorSubtract, "1"))
>action:1=SetPlayerState(GetOwningPlayer(GetTriggerUnit()), PlayerStateLumber, $Inventory_Revive_Count[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
>action:1=SetVariable($rect, GetUnitLoc(GetDyingUnit()))
>action:1=CreateNUnitsAtLoc("1", "n00K", PlayerNP, $rect, RealUnitFacing)
>action:1=ShowUnitHide(GetLastCreatedUnit())
>action:1=SetVariable($Inventory_Revive_Dummy[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], GetLastCreatedUnit())
>action:1=CreateDestructableLoc("B01D", $rect, "315.00", "1", "0")
>action:1=SetDestructableInvulnerableBJ(GetLastCreatedDestructable(), InvulnerabilityInvulnerable)
>action:1=SetVariable($Inventory_Revive_Stone[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], GetLastCreatedDestructable())
>action:1=CustomScriptCode("call RemoveLocation(udg_rect)")
>action:1=TriggerSleepAction("7.00")
>action:1=SetVariable($ReviveAlreadyInUse[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))], "false")
>action:1=CustomScriptCode("set DEAD[IND[GetPlayerId(GetTriggerPlayer())]] = false")
>action:1=RemoveDestructable($Inventory_Revive_Stone[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
>action:1=SetVariable($rect, GetUnitLoc(GetDyingUnit()))
>action:1=ReviveHeroLoc(GetTriggerUnit(), $rect, ShowHideShow)
>action:1=CustomScriptCode("call RemoveLocation(udg_rect)")
>action:1=RemoveUnit($Inventory_Revive_Dummy[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
>action:1=ReturnAction()
>action:1=CommentString("Delete Selection Circle")
>action:1=RemoveDestructable($Selection_Circle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
>action:1=SetVariable($Selection_Circle[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], DestructableNull)
>action:1=CommentString("Reset Selection")
>action:1=SetVariable($Inventory_Selected_True_False[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "0")
>action:1=SetVariable($Inventory_Selected_Slot[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "0")
>condition:0=OperatorCompareUnit($Heroes[GetConvertedPlayerId(GetTriggerPlayer())], OperatorEqualENE, GetDyingUnit())
>condition:0=OperatorCompareInteger($Inventory_Revive_Count[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], OperatorGreater, "0")
>action:2=DisplayTextToForce(GetPlayersAll(), OperatorString($Colour[GetConvertedPlayerId(GetTriggerPlayer())], OperatorString(GetPlayerName(GetOwningPlayer(GetDyingUnit())), " has no more lives left.|r")))
>action:2=DisplayTextToForce(GetPlayersAll(), "TRIGSTR_5684")
>action:2=CustomScriptCode("set DEAD[IND[GetPlayerId(GetTriggerPlayer())]] = true")
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventDeath)
