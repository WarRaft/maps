[trigger]
name="Inventory Variables ALSO IMPORTANT"
description=""
action=CommentString("Camera hovering over the inventory areas - Change camera according to the players locations.")
action=SetVariable($Colour["1"], "|cffffda06")
action=SetVariable($Colour["2"], "|cffffda06")
action=SetVariable($Colour["3"], "|cffffda06")
action=SetVariable($Colour["4"], "|cffffda06")
action=SetVariable($Colour["5"], "|cffffda06")
action=SetVariable($Colour["6"], "|cffffda06")
action=SetVariable($Inventory_Camera["1"], $gg_cam_Inventory_P1)
action=SetVariable($Inventory_Camera["2"], $gg_cam_Inventory_P2)
action=SetVariable($Inventory_Camera["3"], $gg_cam_Inventory_P3)
action=SetVariable($Inventory_Camera["4"], $gg_cam_Inventory_P4)
action=SetVariable($Inventory_Camera["5"], $gg_cam_Inventory_P5)
action=SetVariable($Inventory_Camera["6"], $gg_cam_Inventory_P6)
action=CommentString("Turn Off/On ItemPickUp to prevent conflict")
action=SetVariable($PickItemTrigger["1"], $gg_trg_ItemPickup_P1_vJass)
action=SetVariable($PickItemTrigger["2"], $gg_trg_ItemPickup_P2_vJass)
action=SetVariable($PickItemTrigger["3"], $gg_trg_ItemPickup_P3_vJass)
action=SetVariable($PickItemTrigger["4"], $gg_trg_ItemPickup_P4_vJass)
action=SetVariable($PickItemTrigger["5"], $gg_trg_ItemPickup_P5_vJass)
action=SetVariable($PickItemTrigger["6"], $gg_trg_ItemPickup_P6_vJass)
action=CommentString("Regions covering the inventory area - Set the regions to their areas.")
action=SetVariable($Inventory_Visibility_Over_Invt["1"], $gg_rct_Inventory_Part_1)
action=SetVariable($Inventory_Visibility_Over_Invt["2"], $gg_rct_Inventory_Part_2)
action=SetVariable($Inventory_Visibility_Over_Invt["3"], $gg_rct_Inventory_Part_3)
action=SetVariable($Inventory_Visibility_Over_Invt["4"], $gg_rct_Inventory_Part_4)
action=SetVariable($Inventory_Visibility_Over_Invt["5"], $gg_rct_Inventory_Part_5)
action=SetVariable($Inventory_Visibility_Over_Invt["6"], $gg_rct_Inventory_Part_6)
action=ForLoopAMultiple("1", "6")
>action:0=ForGroupMultiple(GetUnitsInRectAll($Inventory_Visibility_Over_Invt[GetForLoopIndexA()]))
>>action:0=SetUnitVertexColorBJ(GetEnumUnit(), "100", "100", "100", "100.00")
action=EnableTrigger($gg_trg_Inventory_Camera)
action=StartTimerBJ($Inventory_Camera_Test, PeriodicOptionOneTime, "0.01")
action=EnableTrigger($gg_trg_Inventory_Switch_Camera)
event=MapInitializationEvent()
