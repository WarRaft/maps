[trigger]
name="Hundred Fists"
description=""
action=IfThenElseMultiple()
>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A051", GetTriggerUnit()), OperatorEqual, "1")
>action:2=IfThenElseMultiple()
>>action:2=IfThenElseMultiple()
>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A051", GetTriggerUnit()), OperatorEqual, "3")
>>>action:2=IfThenElseMultiple()
>>>>action:2=IfThenElseMultiple()
>>>>>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "110.00")
>>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A051", GetTriggerUnit()), OperatorEqual, "5")
>>>>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "90.00")
>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A051", GetTriggerUnit()), OperatorEqual, "4")
>>>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "70.00")
>>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "50.00")
>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("A051", GetTriggerUnit()), OperatorEqual, "2")
>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "30.00")
action=SetUnitAnimation(GetTriggerUnit(), "ATTACK ALTERNATE")
action=AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\Human\\Slow\\SlowCaster.mdl")
action=SetVariable($FistSFX[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], GetLastCreatedEffectBJ())
action=UnitAddAbilityBJ("A04X", GetTriggerUnit())
action=TriggerSleepAction("0.50")
action=SetUnitPositionLoc(GetTriggerUnit(), GetUnitLoc(GetSpellTargetUnit()))
action=DestroyEffectBJ($FistSFX[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
action=AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\Undead\\ReplenishHealth\\ReplenishHealthCasterOverhead.mdl")
action=SetVariable($FistSFX[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], GetLastCreatedEffectBJ())
action=AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl")
action=DestroyEffectBJ(GetLastCreatedEffectBJ())
action=CameraSetEQNoiseForPlayer(GetOwningPlayer(GetTriggerUnit()), "5.00")
action=ForGroupMultiple(GetUnitsInRangeOfLocMatching("200.00", GetUnitLoc(GetTriggerUnit()), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player11) ~""))
>action:0=UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), $Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], AttackTypeHero, DamageTypeNormal)
action=ForGroupMultiple(GetUnitsInRangeOfLocMatching("200.00", GetUnitLoc(GetTriggerUnit()), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player10) ~""))
>action:0=UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), $Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], AttackTypeHero, DamageTypeNormal)
action=TriggerSleepAction("1.00")
action=UnitRemoveAbilityBJ("A04X", GetTriggerUnit())
action=DestroyEffectBJ($FistSFX[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
action=CameraClearNoiseForPlayer(GetOwningPlayer(GetTriggerUnit()))
condition=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A051")
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventSpellEffect)
