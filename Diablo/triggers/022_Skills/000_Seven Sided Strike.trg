[trigger]
name="Seven Sided Strike"
description=""
action=UnitAddAbilityBJ("A04X", GetTriggerUnit())
action=IfThenElseMultiple()
>action:2=IfThenElseMultiple()
>>action:2=IfThenElseMultiple()
>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("AHtb", GetTriggerUnit()), OperatorEqual, "3")
>>>action:2=IfThenElseMultiple()
>>>>action:2=IfThenElseMultiple()
>>>>>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "8.00")
>>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("AHtb", GetTriggerUnit()), OperatorEqual, "5")
>>>>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "6.50")
>>>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("AHtb", GetTriggerUnit()), OperatorEqual, "4")
>>>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "5.00")
>>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "3.50")
>>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("AHtb", GetTriggerUnit()), OperatorEqual, "2")
>action:1=SetVariable($Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "2.00")
>condition:0=OperatorCompareInteger(GetUnitAbilityLevelSwapped("AHtb", GetTriggerUnit()), OperatorEqual, "1")
action=SetUnitInvulnerable(GetTriggerUnit(), InvulnerabilityInvulnerable)
action=SetUnitVertexColorBJ(GetTriggerUnit(), "100", "100", "100", "100.00")
action=SetUnitAnimation(GetTriggerUnit(), "ATTACK - 2")
action=CreateNUnitsAtLoc("1", "n012", GetTriggerPlayer(), GetSpellTargetLoc(), RealUnitFacing)
action=SetVariable($Seven_Strike[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], GetLastCreatedUnit())
action=SetUnitPositionLoc(GetTriggerUnit(), OffsetLocation(GetUnitLoc($Seven_Strike[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]), "0", "0.00"))
action=PauseUnitBJ(PauseUnpauseOptionPause, GetTriggerUnit())
action=SetUnitAnimation(GetTriggerUnit(), "ATTACK - 2")
action=CreateNUnitsAtLocFacingLocBJ("1", "n013", PlayerNP, OffsetLocation(GetUnitLoc($Seven_Strike[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]), "0", "200.00"), GetUnitLoc($Seven_Strike[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]))
action=SetVariable($SevenStrike_01[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], GetLastCreatedUnit())
action=SetUnitVertexColorBJ(GetLastCreatedUnit(), "0.00", "0.00", "0.00", "20.00")
action=TriggerSleepAction("0.20")
action=UnitRemoveAbilityBJ("A04X", GetTriggerUnit())
action=SetUnitPositionLoc($SevenStrike_01[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], OffsetLocation(GetUnitLoc($Seven_Strike[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]), "0", "-200.00"))
action=SetUnitAnimation($SevenStrike_01[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "ATTACK - 2")
action=ForGroupMultiple(GetUnitsInRangeOfLocMatching("300.00", GetUnitLoc($Seven_Strike[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player11) ~""))
>action:0=UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), OperatorReal("10.00", OperatorMultiply, $Damage[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]), AttackTypeHero, DamageTypeNormal)
