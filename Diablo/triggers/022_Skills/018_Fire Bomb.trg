[trigger]
name="Fire Bomb"
description=""
action=IfThenElseMultiple()
>action:2=DoNothing()
>action:1=AddSpecialEffectLocBJ(GetSpellTargetLoc(), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrike1.mdl")
>action:1=SetVariable($FireBomb["0"], GetLastCreatedEffectBJ())
>action:1=CreateNUnitsAtLoc("1", "h000", PlayerNP, GetSpellTargetLoc(), RealUnitFacing)
>action:1=SetVariable($FireBomb_Unit["0"], GetLastCreatedUnit())
>action:1=ShowUnitHide($FireBomb_Unit["0"])
>action:1=TriggerSleepAction("1.00")
>action:1=SetVariable($FireBomb_Level, GetUnitAbilityLevelSwapped("ANab", GetTriggerUnit()))
>action:1=IfThenElseMultiple()
>>condition:0=OperatorCompareInteger($FireBomb_Level, OperatorEqual, "1")
>>action:1=ForGroupMultiple(GetUnitsInRangeOfLocMatching("200.00", GetSpellTargetLoc(), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player10) ~""))
>>>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "75.00"))
>>action:1=ForGroupMultiple(GetUnitsInRangeOfLocMatching("200.00", GetSpellTargetLoc(), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player11) ~""))
>>>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "75.00"))
>action:1=IfThenElseMultiple()
>>condition:0=OperatorCompareInteger($FireBomb_Level, OperatorEqual, "2")
>>action:1=ForGroupMultiple(GetUnitsInRangeOfLocMatching("200.00", GetSpellTargetLoc(), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player10) ~""))
>>>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "125.00"))
>>action:1=ForGroupMultiple(GetUnitsInRangeOfLocMatching("200.00", GetSpellTargetLoc(), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player11) ~""))
>>>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, "125.00"))
>action:1=IfThenElseMultiple()
>>condition:0=OperatorCompareInteger($FireBomb_Level, OperatorEqual, "3")
