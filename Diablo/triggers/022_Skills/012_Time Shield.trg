[trigger]
name="Time Shield"
description=""
enabled=0
action=IfThenElseMultiple()
>action:1=CreateNUnitsAtLoc("1", "n00O", GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), RealUnitFacing)
>action:1=SetVariable($TimeShield["0"], GetLastCreatedUnit())
>action:1=SetUnitAbilityLevelSwapped("A00H", GetLastCreatedUnit(), GetUnitAbilityLevelSwapped("A00R", GetTriggerUnit()))
>action:1=UnitAddAbilityBJ("A00N", GetTriggerUnit())
>action:1=SetUnitAbilityLevelSwapped("A00N", GetTriggerUnit(), GetUnitAbilityLevelSwapped("A00R", GetTriggerUnit()))
>action:1=SetVariable($Time_Shield_Level["0"], GetUnitAbilityLevelSwapped("A00R", GetTriggerUnit()))
>action:1=UnitRemoveAbilityBJ("A00R", GetTriggerUnit())
>action:1=PolledWait("12.00")
>action:1=KillUnit($TimeShield["0"])
>action:1=UnitRemoveAbilityBJ("A00N", GetTriggerUnit())
>action:1=UnitAddAbilityBJ("A00R", GetTriggerUnit())
>action:1=SetUnitAbilityLevelSwapped("A00R", GetTriggerUnit(), $Time_Shield_Level["0"])
>condition:0=OperatorComparePlayer(GetOwningPlayer(GetTriggerUnit()), OperatorEqualENE, Player00)
