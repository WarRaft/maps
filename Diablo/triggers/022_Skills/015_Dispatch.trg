[trigger]
name="Dispatch"
description=""
action=IfThenElseMultiple()
>condition:0=OrMultiple()
>>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetSpellTargetUnit()), OperatorEqualENE, "osw1")
>>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetSpellTargetUnit()), OperatorEqualENE, "osw2")
>>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetSpellTargetUnit()), OperatorEqualENE, "osw3")
>>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetSpellTargetUnit()), OperatorEqualENE, "o000")
>>condition:0=OperatorCompareUnitCode(GetUnitTypeId(GetSpellTargetUnit()), OperatorEqualENE, "o001")
>action:1=AddSpecialEffectLocBJ(GetUnitLoc(GetSpellTargetUnit()), "war3mapImported\\ExplosionBIG.mdx")
>action:1=SetVariable($Dispatch["0"], GetLastCreatedEffectBJ())
>action:1=SetVariable($Dispatch_Level, GetUnitStateSwap(UnitStateMaxMana, GetSpellTargetUnit()))
>action:1=ForGroupMultiple(GetUnitsInRangeOfLocMatching("200.00", GetUnitLoc(GetSpellTargetUnit()), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player11) ~""))
>>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, OperatorReal($Dispatch_Level, OperatorMultiply, "75.00")))
>action:1=ForGroupMultiple(GetUnitsInRangeOfLocMatching("200.00", GetUnitLoc(GetSpellTargetUnit()), condition:OperatorComparePlayer(GetOwningPlayer(GetFilterUnit()), OperatorEqualENE, Player10) ~""))
>>action:0=SetUnitLifeBJ(GetEnumUnit(), OperatorReal(GetUnitStateSwap(UnitStateLife, GetEnumUnit()), OperatorSubtract, OperatorReal($Dispatch_Level, OperatorMultiply, "75.00")))
>action:1=ExplodeUnitBJ(GetSpellTargetUnit())
>action:1=CameraSetEQNoiseForPlayer(GetOwningPlayer(GetTriggerUnit()), "5.00")
>action:1=PolledWait("0.50")
>action:1=CameraClearNoiseForPlayer(GetOwningPlayer(GetTriggerUnit()))
>action:1=PolledWait("1.00")
>action:1=DestroyEffectBJ($Dispatch["0"])
condition=AndMultiple()
>condition:0=OperatorCompareAbilityId(GetSpellAbilityId(), OperatorEqualENE, "A01C")
event=TriggerRegisterAnyUnitEventBJ(PlayerUnitEventSpellEffect)
